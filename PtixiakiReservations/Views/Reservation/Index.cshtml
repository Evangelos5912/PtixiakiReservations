@model IEnumerable<PtixiakiReservations.Models.Reservation>

@{
    ViewData["Title"] = "My Reservations";

    var upcomingReservations = Model.Where(r => !r.IsPastReservation).ToList();
    var pastReservations = Model.Where(r => r.IsPastReservation).ToList();
}

<div class="bg-gradient-to-br from-gray-50 to-blue-50/50 min-h-screen py-8 px-4 sm:px-6 lg:px-8 font-sans">
    <div class="max-w-7xl mx-auto space-y-6">
        
        <!-- Header Section -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden">
            <div class="bg-gradient-to-r from-blue-600 to-indigo-700 px-6 sm:px-8 py-8 md:flex md:items-center md:justify-between gap-4">
                <div>
                    <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">
                        My Reservations
                    </h1>
                    <p class="mt-2 text-blue-100 text-sm sm:text-base max-w-3xl">
                        View and manage all your event bookings, check-in statuses, and reviews.
                    </p>
                </div>

                <div class="shrink-0 mt-4 md:mt-0">
                    <a href="@Url.Action("EventsForToday", "Events")"
                       class="inline-flex items-center px-5 py-2.5 bg-white text-indigo-700 font-bold rounded-lg shadow-sm hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-all transform hover:-translate-y-0.5 justify-center w-full md:w-auto">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
                        </svg>
                        Book New Reservation
                    </a>
                </div>
            </div>

            <!-- Stats Section -->
            <div class="bg-white px-6 py-5 border-t border-gray-100">
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                    <div class="flex items-center p-3 bg-gray-50 rounded-xl border border-gray-100">
                        <div class="flex-shrink-0 h-10 w-10 rounded-lg bg-blue-100 flex items-center justify-center">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z" />
                            </svg>
                        </div>
                        <div class="ml-4">
                            <p class="text-xs font-bold text-gray-400 uppercase tracking-wider">Total Reservations</p>
                            <p class="text-xl font-extrabold text-gray-900">@Model.Count()</p>
                        </div>
                    </div>

                    <div class="flex items-center p-3 bg-gray-50 rounded-xl border border-gray-100">
                        <div class="flex-shrink-0 h-10 w-10 rounded-lg bg-indigo-100 flex items-center justify-center">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                            </svg>
                        </div>
                        <div class="ml-4">
                            <p class="text-xs font-bold text-gray-400 uppercase tracking-wider">Upcoming Events</p>
                            <p class="text-xl font-extrabold text-gray-900">@Model.Count(r => r.Date > DateTime.Now)</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Filters Section -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-4 sm:p-5">
            <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
                <div class="flex items-center w-full sm:w-auto">
                    <span class="text-sm font-bold text-gray-500 mr-3 shrink-0">Filter by:</span>
                    <select id="filterSelect" class="w-full sm:w-48 px-4 py-2.5 border border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm font-semibold text-gray-700 bg-gray-50 cursor-pointer">
                        <option value="all">All Reservations</option>
                        <option value="upcoming">Upcoming</option>
                        <option value="past">Past</option>
                    </select>
                </div>

                <div class="relative w-full sm:w-80">
                    <input type="text" id="searchInput" placeholder="Search reservations..."
                           class="w-full pl-10 pr-4 py-2.5 border border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm font-medium placeholder-gray-400">
                    <div class="absolute left-3.5 top-1/2 transform -translate-y-1/2 pointer-events-none">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                        </svg>
                    </div>
                </div>
            </div>
        </div>

        <!-- Reservation Cards (Mobile View) -->
        <div class="lg:hidden grid grid-cols-1 gap-4 mb-8">
            @foreach (var item in Model)
            {
                <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
                    <div class="bg-gradient-to-r from-blue-600 to-indigo-600 px-4 py-3 flex justify-between items-center text-white">
                        <h3 class="font-bold truncate text-sm">@item.Event.Name</h3>
                        <span class="text-[10px] font-extrabold uppercase bg-white/20 px-2.5 py-1 rounded-full">
                            @(item.Date > DateTime.Now ? "Upcoming" : "Past")
                        </span>
                    </div>

                    <div class="p-4 space-y-3">
                        <div class="grid grid-cols-2 gap-3 text-xs">
                            <div>
                                <p class="text-gray-400 font-bold uppercase">Date</p>
                                <p class="font-semibold text-gray-800">@item.Date.ToString("MMM dd, yyyy")</p>
                            </div>
                            <div>
                                <p class="text-gray-400 font-bold uppercase">Venue</p>
                                <p class="font-semibold text-gray-800">@item.Seat.Layout.Venue.Name</p>
                            </div>
                            <div>
                                <p class="text-gray-400 font-bold uppercase">Area</p>
                                <p class="font-semibold text-gray-800">@item.Seat.Layout.AreaName</p>
                            </div>
                            <div>
                                <p class="text-gray-400 font-bold uppercase">Seat</p>
                                <p class="font-semibold text-gray-800">@item.Seat.Name</p>
                            </div>
                        </div>

                        <div class="pt-3 border-t border-gray-100 flex justify-between items-center text-xs font-bold">
                            <a asp-action="Details" asp-route-id="@item.ID" class="text-indigo-600 hover:text-indigo-800 flex items-center !no-underline">
                                Details →
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.ID" class="text-red-600 hover:text-red-800 flex items-center !no-underline">
                                Delete
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Reservation Table (Desktop View) -->
        <div class="hidden lg:block bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden">
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead>
                    <tr class="bg-gray-50 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">
                        <th class="px-6 py-4">Attendee</th>
                        <th class="px-6 py-4">Date & Time</th>
                        <th class="px-6 py-4">Event</th>
                        <th class="px-6 py-4">Venue</th>
                        <th class="px-6 py-4">Area & Seat</th>
                        <th class="px-6 py-4">Status / Check-In</th>
                        <th class="px-6 py-4 text-right">Actions</th>
                    </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-100 text-sm" id="reservationTableBody">
                    @foreach (var item in Model)
                    {
                        <tr class="hover:bg-indigo-50/30 transition-colors reservation-row @(item.Date > DateTime.Now ? "upcoming" : "past")">
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="flex items-center">
                                    <div class="h-8 w-8 bg-indigo-50 border border-indigo-100 rounded-full flex items-center justify-center text-indigo-700 font-bold text-xs">
                                        @(item.ApplicationUser?.FirstName?.Substring(0, 1) ?? "U")
                                    </div>
                                    <div class="ml-3 font-semibold text-gray-900">
                                        @item.ApplicationUser?.FirstName @item.ApplicationUser?.LastName
                                    </div>
                                </div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="font-semibold text-gray-900">@item.Date.ToString("MMM dd, yyyy")</div>
                                <div class="text-xs font-bold text-gray-400">@item.Date.ToString("h:mm tt")</div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap font-bold text-gray-900">
                                @item.Event.Name
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-gray-700 font-medium">
                                @item.Seat.Layout.Venue.Name
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <span class="bg-gray-100 text-gray-700 font-semibold px-2.5 py-1 rounded-md text-xs border border-gray-200">
                                    @item.Seat.Layout.AreaName / @item.Seat.Name
                                </span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                @if (item.IsPastReservation)
                                {
                                    @if (item.Attended == null)
                                    {
                                        <div class="flex items-center gap-2">
                                            <form asp-action="MarkAttendance" method="post" class="inline">
                                                <input type="hidden" name="reservationId" value="@item.ID" />
                                                <input type="hidden" name="attended" value="true" />
                                                <button type="submit" class="px-2.5 py-1 rounded-lg bg-emerald-50 text-emerald-700 hover:bg-emerald-100 text-xs font-bold border border-emerald-200 transition-colors">
                                                    Check-In
                                                </button>
                                            </form>
                                            <form asp-action="MarkAttendance" method="post" class="inline">
                                                <input type="hidden" name="reservationId" value="@item.ID" />
                                                <input type="hidden" name="attended" value="false" />
                                                <button type="submit" class="px-2.5 py-1 rounded-lg bg-red-50 text-red-700 hover:bg-red-100 text-xs font-bold border border-red-200 transition-colors">
                                                    Missed
                                                </button>
                                            </form>
                                        </div>
                                    }
                                    else if (item.Attended == true)
                                    {
                                        <span class="inline-flex items-center text-xs font-bold text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-full border border-emerald-200">
                                            ✓ Attended
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center text-xs font-bold text-red-700 bg-red-50 px-2.5 py-1 rounded-full border border-red-200">
                                            ✗ Absent
                                        </span>
                                    }
                                }
                                else
                                {
                                    <span class="inline-flex items-center text-xs font-bold text-blue-700 bg-blue-50 px-2.5 py-1 rounded-full border border-blue-200">
                                        Upcoming
                                    </span>
                                }
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-semibold">
                                <div class="flex items-center justify-end space-x-3">
                                    <a asp-action="Details" asp-route-id="@item.ID"
                                       class="inline-flex items-center px-3 py-1.5 bg-white border border-gray-300 rounded-lg text-xs font-bold text-gray-700 hover:bg-gray-50 shadow-sm transition-colors !no-underline">
                                        Details
                                    </a>
                                    @if (item.IsPastReservation && item.Attended == true && !item.Rating.HasValue)
                                    {
                                        <button onclick="openReviewModal(@item.ID)"
                                                class="inline-flex items-center px-3 py-1.5 bg-amber-50 border border-amber-200 rounded-lg text-xs font-bold text-amber-700 hover:bg-amber-100 shadow-sm transition-colors">
                                            ★ Review
                                        </button>
                                    }
                                    <a asp-action="Delete" asp-route-id="@item.ID"
                                       class="inline-flex items-center px-3 py-1.5 bg-red-50 border border-red-200 rounded-lg text-xs font-bold text-red-700 hover:bg-red-100 shadow-sm transition-colors !no-underline">
                                        Delete
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Empty State -->
        @if (!Model.Any())
        {
            <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-16 text-center">
                <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-indigo-50 mb-4 text-indigo-600">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z" />
                    </svg>
                </div>
                <h3 class="text-lg font-bold text-gray-900 mb-1">No Reservations Found</h3>
                <p class="text-sm text-gray-500 max-w-sm mx-auto mb-6">
                    You haven't made any reservations yet. Browse upcoming events to book your first ticket.
                </p>
                <a href="@Url.Action("EventsForToday", "Events")"
                   class="inline-flex items-center px-6 py-3 bg-indigo-600 hover:bg-indigo-700 text-white font-bold rounded-xl shadow-md transition-all text-sm !no-underline">
                    Browse Events
                </a>
            </div>
        }
    </div>
</div>

<!-- Review Modal -->
<div id="reviewModal" class="fixed inset-0 bg-gray-900/60 backdrop-blur-sm hidden items-center justify-center z-50">
    <div class="bg-white rounded-2xl shadow-2xl w-full max-w-lg p-8 relative border border-gray-200 mx-4">
        <button onclick="closeReviewModal()" class="absolute top-5 right-5 text-gray-400 hover:text-gray-600 transition-colors">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>

        <h2 class="text-2xl font-extrabold text-gray-900 mb-2">Leave a Review</h2>
        <p class="text-sm text-gray-500 mb-6">Share your experience to help improve future events.</p>

        <form id="ajaxReviewForm" class="space-y-6">
            @Html.AntiForgeryToken()
            <input type="hidden" id="reservationId" name="reservationId" />
            <input type="hidden" name="attended" value="true" />
            <input type="hidden" id="selectedRating" name="rating" value="5" />

            <div>
                <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-2">Rating</label>
                <div class="flex gap-2 text-3xl cursor-pointer select-none bg-gray-50 p-4 rounded-xl border border-gray-200 justify-center">
                    <span onclick="setRating(1)" id="star1" class="text-yellow-400 hover:scale-125 transition-transform">★</span>
                    <span onclick="setRating(2)" id="star2" class="text-yellow-400 hover:scale-125 transition-transform">★</span>
                    <span onclick="setRating(3)" id="star3" class="text-yellow-400 hover:scale-125 transition-transform">★</span>
                    <span onclick="setRating(4)" id="star4" class="text-yellow-400 hover:scale-125 transition-transform">★</span>
                    <span onclick="setRating(5)" id="star5" class="text-yellow-400 hover:scale-125 transition-transform">★</span>
                </div>
            </div>

            <div>
                <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-2">Comments (Optional)</label>
                <textarea name="review" rows="4" class="w-full border border-gray-300 rounded-xl p-3 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm outline-none resize-none" placeholder="What did you think of the event?"></textarea>
            </div>

            <button type="submit" id="submitReviewBtn" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-3.5 rounded-xl transition-all shadow-md text-sm">
                Submit Review
            </button>
        </form>
    </div>
</div>

<style>
    .highlight { font-weight: 700; color: #4f46e5; background-color: #eef2ff; padding: 0 2px; border-radius: 4px; }
</style>

@section Scripts {
    <script>
        document.getElementById('searchInput').addEventListener('input', function () {
            filterReservations();
            const query = this.value.trim();
            clearHighlights();
            if (!query) return;

            document.querySelectorAll("#reservationTableBody td:nth-child(1), td:nth-child(3), td:nth-child(4), td:nth-child(5)").forEach(td => {
                highlightNode(td, query);
            });
        });

        document.getElementById('filterSelect').addEventListener('change', function () {
            filterReservations();
        });

        function highlightNode(node, query) {
            if (!query) return;
            const regex = new RegExp(`(${query})`, "gi");
            const walker = document.createTreeWalker(node, NodeFilter.SHOW_TEXT, null);
            const textNodes = [];
            while (walker.nextNode()) textNodes.push(walker.currentNode);

            textNodes.forEach(textNode => {
                const parent = textNode.parentNode;
                if (!textNode.nodeValue.trim()) return;
                const replaced = textNode.nodeValue.replace(regex, '<span class="highlight">$1</span>');
                if (replaced !== textNode.nodeValue) {
                    const span = document.createElement("span");
                    span.innerHTML = replaced;
                    parent.replaceChild(span, textNode);
                }
            });
        }

        function clearHighlights() {
            document.querySelectorAll("span.highlight").forEach(mark => {
                const parent = mark.parentNode;
                parent.replaceChild(document.createTextNode(mark.textContent), mark);
                parent.normalize();
            });
        }

        function filterReservations() {
            const searchTerm = document.getElementById('searchInput').value.toLowerCase();
            const filterValue = document.getElementById('filterSelect').value;
            const rows = document.querySelectorAll('.reservation-row');

            rows.forEach(row => {
                const textContent = row.textContent.toLowerCase();
                const matchesSearch = searchTerm === '' || textContent.includes(searchTerm);
                let matchesFilter = true;

                if (filterValue === 'upcoming') matchesFilter = row.classList.contains('upcoming');
                else if (filterValue === 'past') matchesFilter = row.classList.contains('past');

                row.style.display = matchesSearch && matchesFilter ? '' : 'none';
            });
        }

        function openReviewModal(id) {
            document.getElementById("reviewModal").classList.remove("hidden");
            document.getElementById("reviewModal").classList.add("flex");
            document.getElementById("reservationId").value = id;
            document.querySelector('textarea[name="review"]').value = "";
            setRating(5);
        }

        function closeReviewModal() {
            document.getElementById("reviewModal").classList.add("hidden");
            document.getElementById("reviewModal").classList.remove("flex");
        }

        function setRating(rating) {
            document.getElementById("selectedRating").value = rating;
            for (let i = 1; i <= 5; i++) {
                const star = document.getElementById("star" + i);
                if (i <= rating) {
                    star.classList.remove("text-gray-300");
                    star.classList.add("text-yellow-400");
                } else {
                    star.classList.remove("text-yellow-400");
                    star.classList.add("text-gray-300");
                }
            }
        }

        // AJAX Review Submission
        $('#ajaxReviewForm').on('submit', function (e) {
            e.preventDefault();
            const form = $(this);
            const submitBtn = $('#submitReviewBtn');
            const token = $('input[name="__RequestVerificationToken"]').val();

            submitBtn.prop('disabled', true).text('Submitting...');

            $.ajax({
                url: '/Reservation/SubmitReview',
                type: 'POST',
                data: form.serialize(),
                headers: { "RequestVerificationToken": token },
                success: function () {
                    closeReviewModal();
                    location.reload();
                },
                error: function (xhr) {
                    console.error("Review submission failed", xhr);
                    alert("Failed to submit review. Please try again.");
                    submitBtn.prop('disabled', false).text('Submit Review');
                }
            });
        });

        document.addEventListener("DOMContentLoaded", function () {
            setRating(5);
        });
    </script>
}