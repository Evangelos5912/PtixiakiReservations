@model PtixiakiReservations.Models.Event

@{
    ViewData["Title"] = "Reserve Seats";
    var venueId = Model.Venue.Id;
    var eventId = Model.Id;
    var layoutId = Model.LayoutId;
}

<div class="min-h-screen bg-gray-50/50 py-6 sm:py-10 px-4 sm:px-6 lg:px-8 pb-32 sm:pb-12">
    <div class="max-w-6xl mx-auto">
        
        <!-- Page Header & Breadcrumbs -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between mb-8 gap-4">
            <div>
                <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">Seat Reservation</h1>
                <p class="mt-1 text-gray-500 text-sm">Select and lock in your seats for <span class="font-bold text-gray-700">@Model.Name</span></p>
            </div>
        </div>

        <div class="bg-white rounded-2xl shadow-lg border border-gray-200 overflow-hidden">
            
            <!-- Hero Banner -->
            <div class="bg-gradient-to-r from-blue-600 to-indigo-700 px-6 sm:px-8 py-6 sm:py-8 relative overflow-hidden">
                <div class="absolute -right-10 -top-10 w-40 h-40 bg-white opacity-10 rounded-full blur-3xl pointer-events-none"></div>
                <div class="relative z-10 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
                    <div>
                        <h2 class="text-2xl font-bold text-white mb-1">@Model.Name</h2>
                        <div class="flex flex-wrap items-center gap-3 text-blue-100 text-sm font-medium">
                            <span class="flex items-center">
                                <svg class="w-4 h-4 mr-1.5 opacity-80" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                                @Model.StartDateTime.ToString("MMM d, yyyy")
                            </span>
                            <span class="flex items-center">
                                <svg class="w-4 h-4 mr-1.5 opacity-80" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                @Model.StartDateTime.ToString("h:mm tt") - @Model.EndTime.ToString("h:mm tt")
                            </span>
                        </div>
                    </div>
                    <div class="bg-black/20 backdrop-blur-md border border-white/20 rounded-lg px-4 py-2 text-right">
                        <p class="text-[11px] text-blue-200 uppercase tracking-wider font-bold">Venue & Floorplan</p>
                        <p class="text-white font-bold text-sm">@Model.Venue.Name</p>
                        @if (Model.Layout != null) { <p class="text-blue-100 text-xs mt-0.5">Area: @Model.Layout.AreaName</p> }
                    </div>
                </div>
            </div>

            <div class="p-4 sm:p-8">
                
                <!-- Timing Configurator -->
                <div class="bg-gray-50 rounded-xl p-5 border border-gray-200 mb-8 shadow-sm">
                    <div class="flex items-center mb-4">
                        <div class="h-8 w-8 rounded-lg bg-indigo-100 border border-indigo-200 flex items-center justify-center mr-3">
                            <svg class="h-4 w-4 text-indigo-700" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                        </div>
                        <div>
                            <h3 class="text-md font-bold text-gray-900">Reservation Duration</h3>
                            <p class="text-xs text-gray-500">Adjust the times below if you only need the seats for part of the event.</p>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <!-- Hidden Context Payload -->
                        <div class="hidden">
                            <input type="hidden" id="startTime" value="@Model.StartDateTime.TimeOfDay" />
                            <input type="hidden" id="endTime" value="@Model.EndTime.TimeOfDay" />
                            <input type="hidden" id="eventDate" value="@Model.StartDateTime.ToString("yyyy-MM-dd")" />
                            <input type="hidden" id="layoutId" value="@layoutId" />
                            <input type="hidden" id="eventId" value="@eventId" />
                        </div>

                        <div>
                            <label class="block text-xs font-bold text-gray-600 uppercase mb-1.5">Arrival Time</label>
                            <div class="flex items-center gap-3">
                                <input type="time" id="reservationStartTime" value="@Model.StartDateTime.ToString("HH:mm")" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 disabled:opacity-60 disabled:bg-gray-100 font-bold text-gray-800 transition-all shadow-sm" />
                                <label class="flex items-center cursor-pointer min-w-max bg-white border border-gray-200 px-3 py-2 rounded-lg shadow-sm hover:bg-gray-50 transition-colors">
                                    <input type="checkbox" id="useEventStartTime" class="h-4 w-4 text-indigo-600 border-gray-300 rounded focus:ring-indigo-500 cursor-pointer" checked>
                                    <span class="ml-2 text-sm font-bold text-gray-700">Full Event</span>
                                </label>
                            </div>
                        </div>

                        <div>
                            <label class="block text-xs font-bold text-gray-600 uppercase mb-1.5">Departure Time</label>
                            <div class="flex items-center gap-3">
                                <input type="time" id="reservationEndTime" value="@Model.EndTime.ToString("HH:mm")" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 disabled:opacity-60 disabled:bg-gray-100 font-bold text-gray-800 transition-all shadow-sm" />
                                <label class="flex items-center cursor-pointer min-w-max bg-white border border-gray-200 px-3 py-2 rounded-lg shadow-sm hover:bg-gray-50 transition-colors">
                                    <input type="checkbox" id="useEventEndTime" class="h-4 w-4 text-indigo-600 border-gray-300 rounded focus:ring-indigo-500 cursor-pointer" checked>
                                    <span class="ml-2 text-sm font-bold text-gray-700">Full Event</span>
                                </label>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Interactive Seat Map -->
                @if (layoutId == null || layoutId == 0)
                {
                    <div class="bg-yellow-50 border border-yellow-200 rounded-xl p-6 flex items-start shadow-sm">
                        <div class="flex-shrink-0 bg-yellow-100 p-2 rounded-full mr-4">
                            <svg class="h-6 w-6 text-yellow-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.082 16.5c-.77.833.192 2.5 1.732 2.5z" /></svg>
                        </div>
                        <div>
                            <h3 class="text-lg font-bold text-yellow-800">No Floorplan Configured</h3>
                            <p class="text-yellow-700 text-sm mt-1">This event does not have an interactive floorplan assigned. Physical seat selection is currently unavailable.</p>
                        </div>
                    </div>
                }
                else
                {
                    <div class="mb-4 flex flex-col sm:flex-row justify-between items-start sm:items-end gap-4">
                        <div>
                            <h3 class="text-xl font-bold text-gray-900">Select Your Seats</h3>
                            <p class="text-sm text-gray-500 mt-1">Drag to pan the map. Scroll to zoom. Click on green seats to reserve them.</p>
                        </div>
                        
                        <!-- Map Legend -->
                        <div class="flex flex-wrap gap-3 sm:gap-4 bg-gray-50 border border-gray-200 rounded-lg px-4 py-2 shadow-sm">
                            <div class="flex items-center" title="Available to reserve">
                                <div class="w-4 h-4 bg-emerald-500 rounded border border-emerald-600 mr-2 shadow-inner"></div>
                                <span class="text-xs font-bold text-gray-700 uppercase tracking-wider">Open</span>
                            </div>
                            <div class="flex items-center" title="Taken or blocked">
                                <div class="w-4 h-4 bg-red-500 rounded border border-red-600 mr-2 shadow-inner"></div>
                                <span class="text-xs font-bold text-gray-700 uppercase tracking-wider">Taken</span>
                            </div>
                            <div class="flex items-center" title="Currently selected by you">
                                <div class="w-4 h-4 bg-blue-500 rounded border border-blue-600 mr-2 shadow-inner"></div>
                                <span class="text-xs font-bold text-gray-700 uppercase tracking-wider">Selected</span>
                            </div>
                        </div>
                    </div>

                    <!-- Canvas Container -->
                    <div class="mb-8 relative z-10">
                        <div id="canvas-wrapper" class="bg-gray-100 rounded-xl border border-gray-200 overflow-hidden relative shadow-inner w-full" style="height: 65vh; min-height: 500px; max-height: 800px;">
                            
                            <!-- Camera Controls -->
                            <div class="absolute bottom-4 right-4 z-50 flex items-center gap-1 bg-white/90 backdrop-blur-sm p-1.5 rounded-lg shadow-md border border-gray-200">
                                <button type="button" onclick="ZoomOut()" class="p-1.5 hover:bg-gray-100 rounded text-gray-700 transition-colors" title="Zoom Out">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM13 10H7"/></svg>
                                </button>
                                <span id="zoom-level" class="w-12 text-center text-sm font-extrabold text-gray-800 select-none">100%</span>
                                <button type="button" onclick="ZoomIn()" class="p-1.5 hover:bg-gray-100 rounded text-gray-700 transition-colors" title="Zoom In">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"/></svg>
                                </button>
                                <div class="w-px h-5 bg-gray-300 mx-1"></div>
                                <button type="button" onclick="ResetZoom()" class="p-1.5 hover:bg-gray-100 rounded text-gray-700 transition-colors" title="Reset View to Fit Everything">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                                </button>
                            </div>

                            <canvas id="seatCanvas"></canvas>
                        </div>
                    </div>

                    <!-- Selected Seats Feedback Tray -->
                    <div id="selection-summary" class="mb-8 hidden animate-fade-in-up">
                        <div class="bg-indigo-50 border border-indigo-200 rounded-xl p-5 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                            <div>
                                <h3 class="text-indigo-900 font-bold mb-1 flex items-center">
                                    <svg class="w-5 h-5 mr-2 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                    Ready for Checkout
                                </h3>
                                <div class="flex items-center text-indigo-800">
                                    <span class="mr-2">Selected: <span id="selected-count" class="font-extrabold text-lg">0</span> seats</span>
                                    <span class="text-indigo-300 mx-2">|</span>
                                    <span id="selected-seats-list" class="text-sm font-bold truncate max-w-xs sm:max-w-md"></span>
                                </div>
                            </div>
                            <button id="clear-selection" class="text-sm font-bold text-indigo-600 hover:text-indigo-800 bg-white border border-indigo-200 hover:bg-indigo-50 px-4 py-2 rounded-lg shadow-sm transition-colors whitespace-nowrap">
                                Clear Selection
                            </button>
                        </div>
                    </div>
                }
            </div>

            <!-- Sticky Bottom Action Bar -->
            @if (layoutId != null && layoutId != 0)
            {
                <div class="bg-gray-50 border-t border-gray-200 p-4 sm:p-6 flex flex-col sm:flex-row justify-end gap-3 shadow-[0_-4px_6px_-1px_rgba(0,0,0,0.05)] relative z-30">
                    <a href="@Url.Action("Details", "Events", new { id = Model.Id })" class="px-6 py-2.5 bg-white border border-gray-300 text-gray-700 font-bold rounded-xl hover:bg-gray-50 transition-colors shadow-sm text-center">
                        Cancel
                    </a>
                    <button id="confirm-reservation" class="px-8 py-2.5 bg-indigo-600 text-white font-bold rounded-xl shadow-md hover:bg-indigo-700 transition-all flex items-center justify-center focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                        <span>Complete Reservation</span>
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                        </svg>
                    </button>
                </div>
            }
        </div>
    </div>
</div>

<style>
    @@keyframes fadeInUp {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .animate-fade-in-up {
        animation: fadeInUp 0.3s ease-out forwards;
    }
</style>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/fabric.js/5.3.0/fabric.min.js"></script>
    <script>
        const eventId = @eventId;
        const layoutId = @(layoutId ?? 0);
        
        let selectedSeats = [];
        let seatNames = {};
        let currentSeatsCache = [];
        let currentShapesCache = [];
        let currentGroupsCache = [];
        let fabricCanvas;

        // --- FABRIC VIEWPORT ENGINES ---
        
        function updateZoomText() {
            const zoomText = document.getElementById('zoom-level');
            if (zoomText && fabricCanvas) {
                zoomText.textContent = `${Math.round(fabricCanvas.getZoom() * 100)}%`;
            }
        }

        function ZoomIn() {
            if (!fabricCanvas) return;
            let zoom = fabricCanvas.getZoom() * 1.1;
            if (zoom > 5) zoom = 5;
            fabricCanvas.zoomToPoint({ x: fabricCanvas.width / 2, y: fabricCanvas.height / 2 }, zoom);
            updateZoomText();
        }

        function ZoomOut() {
            if (!fabricCanvas) return;
            let zoom = fabricCanvas.getZoom() / 1.1;
            if (zoom < 0.1) zoom = 0.1;
            fabricCanvas.zoomToPoint({ x: fabricCanvas.width / 2, y: fabricCanvas.height / 2 }, zoom);
            updateZoomText();
        }

        function ResetZoom() {
            if (!fabricCanvas) return;
            fitLayoutToViewport();
        }

        /** 
         * Automatically calculates the bounding box of ALL mapped objects, 
         * expands the canvas if necessary, and scales/pans the viewport to frame them nicely.
         */
        function fitLayoutToViewport() {
            if (!fabricCanvas) return;

            const allItems = [...(currentSeatsCache || []), ...(currentShapesCache || [])];
            
            if (allItems.length === 0) return;

            // Calculate extreme boundaries of all placed items
            const xs = allItems.map(s => parseFloat(s.x) || parseFloat(s.X) || 0);
            const ys = allItems.map(s => parseFloat(s.y) || parseFloat(s.Y) || 0);
            const maxXs = allItems.map(s => (parseFloat(s.x) || parseFloat(s.X) || 0) + (parseFloat(s.width) || 60));
            const maxYs = allItems.map(s => (parseFloat(s.y) || parseFloat(s.Y) || 0) + (parseFloat(s.height) || 60));

            const minX = Math.min(...xs);
            const minY = Math.min(...ys);
            const maxX = Math.max(...maxXs);
            const maxY = Math.max(...maxYs);

            const padding = 100; 
            const contentWidth = (maxX - minX) + (padding * 2);
            const contentHeight = (maxY - minY) + (padding * 2);

            const container = document.getElementById('canvas-wrapper');
            const viewportWidth = container.clientWidth;
            const viewportHeight = container.clientHeight;

            fabricCanvas.setWidth(viewportWidth);
            fabricCanvas.setHeight(viewportHeight);

            // Determine zoom level
            const scaleX = viewportWidth / contentWidth;
            const scaleY = viewportHeight / contentHeight;
            const optimalScale = Math.max(0.1, Math.min(scaleX, scaleY, 1.2)); 

            // Center camera strictly around the deployed items
            const centerX = (minX + maxX) / 2;
            const centerY = (minY + maxY) / 2; 
            
            const vpt = fabricCanvas.viewportTransform.slice();
            vpt[0] = optimalScale; 
            vpt[3] = optimalScale; 
            vpt[4] = (viewportWidth / 2) - (centerX * optimalScale); 
            vpt[5] = (viewportHeight / 2) - (centerY * optimalScale); 
            
            fabricCanvas.setViewportTransform(vpt);
            fabricCanvas.calcOffset(); 
            updateZoomText();
        }

        // --- DOM INITIALIZATION PIPELINE ---

        document.addEventListener('DOMContentLoaded', function () {
            
            if (layoutId === 0) return; 

            fabricCanvas = new fabric.Canvas('seatCanvas', { selection: false });

            // Implements drag-to-pan across empty background sectors
            fabricCanvas.on('mouse:down', function (opt) {
                const evt = opt.e;
                if (!opt.target || (opt.target && opt.target.selectable === false && !opt.target.seatId)) {
                    this.isDragging = true;
                    this.lastPosX = evt.clientX;
                    this.lastPosY = evt.clientY;
                    this.selection = false;
                }
            });
            
            fabricCanvas.on('mouse:move', function (opt) {
                if (this.isDragging) {
                    const e = opt.e;
                    const vpt = this.viewportTransform.slice();
                    vpt[4] += e.clientX - this.lastPosX;
                    vpt[5] += e.clientY - this.lastPosY;
                    
                    this.setViewportTransform(vpt);
                    
                    this.lastPosX = e.clientX;
                    this.lastPosY = e.clientY;
                }
            });
            
            fabricCanvas.on('mouse:up', function () {
                this.isDragging = false;
                this.calcOffset();
            });

            fabricCanvas.on('mouse:wheel', function(opt) {
                let delta = opt.e.deltaY;
                let zoom = fabricCanvas.getZoom() * (0.999 ** delta);
                if (zoom > 5) zoom = 5;
                if (zoom < 0.1) zoom = 0.1;
                
                fabricCanvas.zoomToPoint({ x: opt.e.offsetX, y: opt.e.offsetY }, zoom);
                fabricCanvas.calcOffset(); 
                
                opt.e.preventDefault();
                opt.e.stopPropagation();
                updateZoomText();
            });

            window.addEventListener('resize', () => {
                if (fabricCanvas) fitLayoutToViewport();
            });

            loadSeatMap(layoutId, eventId);
        });

        async function loadSeatMap(layoutId, eventId) {
            showLoadingOnFabric(fabricCanvas);

            try {
                const [seatRes, shapeRes, layoutRes] = await Promise.all([
                    fetch(`/Seat/get_data?LayoutId=${layoutId}&eventId=${eventId}`),
                    fetch(`/NonSelectable/GetElements?layoutId=${layoutId}`),
                    fetch(`/Seat/GetCompleteLayout?layoutId=${layoutId}`)
                ]);

                const seatData = seatRes.ok ? await seatRes.json() : [];
                const shapeData = shapeRes.ok ? await shapeRes.json() : [];
                const layoutData = layoutRes.ok ? await layoutRes.json() : { groups: [] };
                const groupsData = layoutData.groups || [];

                currentSeatsCache = seatData;
                currentShapesCache = shapeData;
                currentGroupsCache = groupsData;

                fabricCanvas.clear();

                renderMap(fabricCanvas, seatData, shapeData, groupsData);
                fitLayoutToViewport();
                
            } catch (error) {
                console.error("Failed to load map data:", error);
                fabricCanvas.clear();
                showErrorMessageOnFabric(fabricCanvas);
            }
        }

        // --- FORM DATA & API SUBMISSION ---

        $(document).ready(function () {
            
            $("#useEventStartTime").on("change", function() {
                if ($(this).is(':checked')) {
                    $("#reservationStartTime").val('@Model.StartDateTime.ToString("HH:mm")');
                    $("#reservationStartTime").prop('disabled', true);
                } else {
                    $("#reservationStartTime").prop('disabled', false);
                }
            });

            $("#useEventEndTime").on("change", function() {
                 if ($(this).is(':checked')) {
                     $("#reservationEndTime").val('@Model.EndTime.ToString("HH:mm")');
                     $("#reservationEndTime").prop('disabled', true);
                 } else {
                     $("#reservationEndTime").prop('disabled', false);
                }
            });

            if ($("#useEventStartTime").is(':checked')) $("#reservationStartTime").prop('disabled', true);
            if ($("#useEventEndTime").is(':checked')) $("#reservationEndTime").prop('disabled', true);

            $("#confirm-reservation").on("click", function () {
                if (selectedSeats.length > 0) {
                    if (!layoutId || layoutId === 0) {
                        showNotification('No Layout assigned to this event.', 'warning');
                        return;
                    }

                    $(this).prop('disabled', true)
                        .html('<svg class="animate-spin -ml-1 mr-2 h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg> Processing...');

                    const startTime = $("#useEventStartTime").is(":checked") ? $("#startTime").val() : $("#reservationStartTime").val();
                    const endTime = $("#useEventEndTime").is(":checked") ? $("#endTime").val() : $("#reservationEndTime").val();

                    const timeStart = new Date(`2000-01-01T${startTime}`);
                    const timeEnd = new Date(`2000-01-01T${endTime}`);
                    const difference = timeEnd - timeStart;

                    if (difference <= 0) {
                        showNotification('End time must be after start time.', 'error');
                        $(this).prop('disabled', false).html('<span>Complete Reservation</span><svg class="h-5 w-5 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>');
                        return;
                    }

                    const duration = `${Math.floor(difference / 3600000).toString().padStart(2, '0')}:${Math.floor((difference % 3600000) / 60000).toString().padStart(2, '0')}:${Math.floor((difference % 60000) / 1000).toString().padStart(2, '0')}`;
                    const reservationDate = `${$("#eventDate").val()}T${startTime}`;

                    $.ajax({
                        url: `/Reservation/MakeRes`,
                        type: "POST",
                        contentType: "application/json",
                        data: JSON.stringify({
                            seatIds: selectedSeats,
                            eventId: eventId,
                            layoutId: layoutId,
                            duration: duration,
                            resDate: reservationDate
                        }),
                        success: function() {
                            showNotification('Reservation successful!', 'success');
                            setTimeout(() => window.location.href = "/Reservation/Index", 1500);
                        },
                        error: function(xhr) {
                            $("#confirm-reservation").prop('disabled', false).html('<span>Complete Reservation</span><svg class="h-5 w-5 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>');
                            let msg = "Failed to reserve seats.";
                            try { msg = JSON.parse(xhr.responseText) || msg; } catch(e) { msg = xhr.responseText || msg; }
                            showNotification(msg, 'error');
                        }
                    });
                } else {
                    showNotification('Please select at least one seat.', 'warning');
                }
            });

            $("#clear-selection").on("click", () => clearAllSelections(fabricCanvas));
        });

        // --- MAP RENDERING ---

        function renderMap(canvas, seats, shapes, groups) {
            canvas.clear();

            // 1. Render Logical Group Regions
            if (groups) {
                groups.forEach(group => {
                    const childNames = new Set();
                    if(group.selectableUnits) group.selectableUnits.forEach(u => childNames.add(u.name));
                    if(group.nonSelectableUnits) group.nonSelectableUnits.forEach(u => childNames.add(u.name));

                    const bounds = [];
                    seats.forEach(s => { if(childNames.has(s.name)) bounds.push({ x: s.x||s.X, y: s.y||s.Y, w: 60, h: 60 }); });
                    shapes.forEach(s => { if(childNames.has(s.name)) bounds.push({ x: s.x||s.X, y: s.y||s.Y, w: s.width||100, h: s.height||100 }); });

                    if (bounds.length === 0) return;

                    const minX = Math.min(...bounds.map(c => parseFloat(c.x) || 0));
                    const minY = Math.min(...bounds.map(c => parseFloat(c.y) || 0));
                    const maxX = Math.max(...bounds.map(c => (parseFloat(c.x) || 0) + (parseFloat(c.w) || 0)));
                    const maxY = Math.max(...bounds.map(c => (parseFloat(c.y) || 0) + (parseFloat(c.h) || 0)));

                    const groupRect = new fabric.Rect({
                        left: minX - 15, top: minY - 15,
                        width: (maxX - minX) + 30, height: (maxY - minY) + 30,
                        fill: 'rgba(99, 102, 241, 0.05)', 
                        stroke: '#6366f1', strokeWidth: 2,
                        strokeDashArray: [5, 5],
                        rx: 8, ry: 8,
                        selectable: false, evented: false
                    });
                    
                    canvas.add(groupRect);
                });
            }

            // 2. Render Aesthetic Shapes
            if (shapes) {
                shapes.forEach(shape => {
                    let fabricShape;
                    const fill = shape.backgroundColor || '#D1D5DB';
                    const width = shape.width || 100;
                    const height = shape.height || 100;
                    const posX = parseFloat(shape.x) || parseFloat(shape.X) || 0;
                    const posY = parseFloat(shape.y) || parseFloat(shape.Y) || 0;

                    if (shape.shapeType === 'ellipse') {
                        fabricShape = new fabric.Ellipse({
                            rx: width / 2, ry: height / 2,
                            fill: fill, opacity: 0.8, stroke: '#9CA3AF', strokeWidth: 1,
                            originX: 'left', originY: 'top' 
                        });
                    } else if (shape.shapeType === 'triangle') {
                        fabricShape = new fabric.Triangle({
                            width: width, height: height, fill: fill, opacity: 0.8,
                            originX: 'left', originY: 'top'
                        });
                    } else {
                        fabricShape = new fabric.Rect({
                            width: width, height: height,
                            fill: fill, opacity: 0.8, stroke: '#9CA3AF', strokeWidth: 1,
                            originX: 'left', originY: 'top'
                        });
                    }

                    const shapeText = new fabric.Text(shape.name, {
                        originX: 'center', originY: 'center',
                        left: width / 2, top: height / 2,
                        fill: fill === '#4B5563' ? '#FFFFFF' : '#1F2937', 
                        fontSize: 14, fontFamily: 'Arial', fontWeight: 'bold'
                    });
                    
                    if (shape.shapeType === 'triangle') shapeText.set('top', height / 1.5);

                    const shapeGroup = new fabric.Group([fabricShape, shapeText], {
                        left: posX, top: posY,
                        selectable: false, evented: false
                    });
                    canvas.add(shapeGroup);
                });
            }

            // 3. Render Selectable Seats
            if (seats) {
                seats.forEach(seat => {
                    seatNames[seat.id] = seat.name;
                    const posX = parseFloat(seat.x) || parseFloat(seat.X) || 0;
                    const posY = parseFloat(seat.y) || parseFloat(seat.Y) || 0;
                    
                    const seatRect = new fabric.Rect({
                        width: 60, height: 60, 
                        fill: seat.available ? '#10b981' : '#ef4444', 
                        stroke: seat.available ? '#059669' : '#b91c1c', strokeWidth: 1, rx: 6, ry: 6,
                        originX: 'left', originY: 'top', shadow: new fabric.Shadow({ color: 'rgba(0,0,0,0.1)', blur: 2 })
                    });

                    const seatText = new fabric.Text(seat.name, {
                        originX: 'center', originY: 'center',
                        left: 30, top: 30,
                        fill: 'white', fontSize: 12, fontFamily: 'Arial', fontWeight: 'bold'
                    });

                    const seatGroup = new fabric.Group([seatRect, seatText], {
                        left: posX, top: posY,
                        selectable: seat.available,

                        hasControls: false, 
                        hasBorders: false,
                        lockMovementX: true, 
                        lockMovementY: true,
                        lockRotation: true,
                        lockScalingX: true,
                        lockScalingY: true,
                        
                        hoverCursor: seat.available ? 'pointer' : 'default'
                    });

                    seatGroup.seatId = seat.id;
                    seatGroup.seatName = seat.name;
                    seatGroup.available = seat.available;

                    if (seat.available) {
                        seatGroup.on('mousedown', function() { toggleSeatSelection(this, canvas); });
                    }
                    canvas.add(seatGroup);
                });
            }
            canvas.renderAll();
        }

        function toggleSeatSelection(seatGroup, canvas) {
            const seatId = seatGroup.seatId;
            const rect = seatGroup.item(0);

            if (selectedSeats.includes(seatId)) {
                selectedSeats = selectedSeats.filter(id => id !== seatId);
                rect.set('fill', '#10b981'); // Emerald for open
            } else {
                selectedSeats.push(seatId);
                rect.set('fill', '#4f46e5'); // Indigo for selected
            }

            updateSelectionSummary();
            canvas.renderAll();
        }

        function updateSelectionSummary() {
            const count = selectedSeats.length;
            if (count > 0) {
                $('#selection-summary').removeClass('hidden');
                $('#clear-selection').removeClass('hidden');
                $('#selected-count').text(count);
                $('#selected-seats-list').text(selectedSeats.map(id => seatNames[id]).join(', '));
            } else {
                $('#selection-summary').addClass('hidden');
                $('#clear-selection').addClass('hidden');
            }
        }

        function clearAllSelections(canvas) {
            canvas.getObjects('group').forEach(group => {
                if (group.available && group.seatId) {
                    group.item(0).set('fill', '#10b981'); 
                }
            });
            selectedSeats = [];
            updateSelectionSummary();
            canvas.renderAll();
        }

        // --- UI ALERT NOTIFICATIONS ---

        function showLoadingOnFabric(canvas) {
            canvas.add(new fabric.Text('Loading interactive map...', { left: canvas.width/2, top: canvas.height/2, originX: 'center', originY: 'center', fill: '#4a5568', fontSize: 18, fontFamily: 'Arial', fontWeight: 'bold' }));
            canvas.renderAll();
        }
        function showNoSeatsMessageOnFabric(canvas) {
            canvas.add(new fabric.Text('No seats have been placed in this floorplan yet.', { left: canvas.width/2, top: canvas.height/2, originX: 'center', originY: 'center', fill: '#6b7280', fontSize: 18, fontFamily: 'Arial', fontWeight: 'bold' }));
            canvas.renderAll();
        }
        function showErrorMessageOnFabric(canvas) {
            canvas.add(new fabric.Text('Failed to load map data. Please refresh.', { left: canvas.width/2, top: canvas.height/2, originX: 'center', originY: 'center', fill: '#ef4444', fontSize: 18, fontFamily: 'Arial', fontWeight: 'bold' }));
            canvas.renderAll();
        }
        function showNotification(message, type = 'info') {
            $('.notification').remove();
            let bgColor = type === 'success' ? 'bg-emerald-500' : type === 'error' ? 'bg-red-500' : type === 'warning' ? 'bg-yellow-500' : 'bg-indigo-500';
            const notification = $(`<div class="notification fixed top-6 right-6 ${bgColor} text-white font-bold px-6 py-4 rounded-xl shadow-lg z-[120] border border-white/20">${message}</div>`);
            $('body').append(notification);
            setTimeout(() => notification.fadeOut(() => notification.remove()), 5000);
        }
    </script>
}