@model PtixiakiReservations.Models.Event

@{
    ViewData["Title"] = "Reserve Seats";
    var venueId = Model.Venue.Id;
    var eventId = Model.Id;
    var layoutId = Model.LayoutId;
}

<div class="container mx-auto px-4 py-8 max-w-6xl">
    <div class="bg-white rounded-xl shadow-lg overflow-hidden">
        <!-- Header Banner Section -->
        <div class="bg-gradient-to-r from-blue-600 to-indigo-700 py-6 px-8">
            <h1 class="text-3xl font-bold text-white">Reserve Seats</h1>
            <p class="text-blue-100 mt-2">@Model.Name</p>
            @if (Model.Layout != null)
            {
                <p class="text-blue-200 text-sm mt-1">Layout: @Model.Layout.AreaName</p>
            }
        </div>

        <div class="p-6">
            <!-- Event Summary & Time Selection Container -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
                <!-- Static Event Details Panel -->
                <div class="md:col-span-1 bg-blue-50 p-5 rounded-lg border border-blue-100">
                    <h3 class="text-lg font-semibold text-gray-800 mb-3">Event Details</h3>

                    <div class="space-y-3">
                        <div class="flex items-start">
                            <svg class="h-5 w-5 text-blue-600 mr-2 mt-0.5 flex-shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                            </svg>
                            <div>
                                <p class="text-sm font-medium text-gray-800">
                                    @Model.StartDateTime.ToString("dddd, MMMM d, yyyy")
                                </p>
                                <p class="text-sm text-gray-600">
                                    @Model.StartDateTime.ToString("h:mm tt") - @Model.EndTime.ToString("h:mm tt")
                                </p>
                            </div>
                        </div>

                        <div class="flex items-start">
                            <svg class="h-5 w-5 text-blue-600 mr-2 mt-0.5 flex-shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                            </svg>
                            <div>
                                <p class="text-sm font-medium text-gray-800">@Model.Venue.Name</p>
                                @if (Model.Venue.City != null)
                                {
                                    <p class="text-sm text-gray-600">@Model.Venue.City.Name</p>
                                }
                                @if (Model.Layout != null)
                                {
                                    <p class="text-sm text-gray-600">Area: @Model.Layout.AreaName</p>
                                }
                            </div>
                        </div>

                        @if (Model.EventType != null)
                        {
                            <div class="flex items-start">
                                <svg class="h-5 w-5 text-blue-600 mr-2 mt-0.5 flex-shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
                                </svg>
                                <p class="text-sm font-medium text-gray-800">@Model.EventType.Name</p>
                            </div>
                        }
                    </div>
                </div>

                <!-- Custom Time Frame Selection Panel -->
                <div class="md:col-span-2 bg-blue-50 p-5 rounded-lg border border-blue-100">
                    <h3 class="text-lg font-semibold text-gray-800 mb-3">Reservation Time</h3>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <!-- System Data Payload (Hidden) -->
                        <div class="hidden">
                            <input type="hidden" id="startTime" value="@Model.StartDateTime.TimeOfDay" />
                            <input type="hidden" id="endTime" value="@Model.EndTime.TimeOfDay" />
                            <input type="hidden" id="eventDate" value="@Model.StartDateTime.ToString("yyyy-MM-dd")" />
                            <input type="hidden" id="layoutId" value="@layoutId" />
                            <input type="hidden" id="eventId" value="@eventId" />
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Start Time</label>
                            <div class="flex items-center space-x-3">
                                <input class="form-input w-full rounded-md shadow-sm border-gray-300 bg-white text-gray-800 transition-colors focus:ring-blue-500 focus:border-blue-500"
                                       type="time" id="reservationStartTime"
                                       value="@Model.StartDateTime.ToString("HH:mm")" />
                                <div class="flex items-center">
                                    <input type="checkbox" id="useEventStartTime" class="h-4 w-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500" checked>
                                    <label for="useEventStartTime" class="ml-2 text-sm text-gray-700 font-medium whitespace-nowrap">From Start</label>
                                </div> 
                            </div>
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">End Time</label>
                            <div class="flex items-center space-x-3">
                                <input class="form-input w-full rounded-md shadow-sm border-gray-300 bg-white text-gray-800 transition-colors focus:ring-blue-500 focus:border-blue-500"
                                       type="time" id="reservationEndTime"
                                       value="@Model.EndTime.ToString("HH:mm")" />
                                <div class="flex items-center">
                                    <input type="checkbox" id="useEventEndTime" class="h-4 w-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500" checked>
                                    <label for="useEventEndTime" class="ml-2 text-sm text-gray-700 font-medium whitespace-nowrap">Until End</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Exception Handling: Empty Layout State -->
            @if (layoutId == null || layoutId == 0)
            {
                <div class="mb-8 bg-yellow-50 border border-yellow-200 rounded-lg p-6">
                    <div class="flex items-center">
                        <svg class="h-6 w-6 text-yellow-600 mr-3" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.082 16.5c-.77.833.192 2.5 1.732 2.5z" />
                        </svg>
                        <div>
                            <h3 class="text-yellow-800 font-bold">No Layout Selected</h3>
                            <p class="text-yellow-700 text-sm mt-1">This event doesn't have a specific Layout assigned. Seat selection is not available.</p>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="mb-8">
                    <h3 class="text-xl font-semibold text-gray-800 mb-4">Select Your Seats</h3>

                    <div class="mb-6 flex justify-center">
                        <div id="canvas-container" class="relative w-full border-2 border-gray-200 rounded-lg overflow-hidden bg-[radial-gradient(#e5e7eb_1px,transparent_1px)] [background-size:20px_20px] bg-gray-50" style="height: 600px;">
                            
                            <!-- Internal Viewport Controls -->
                            <div class="absolute bottom-4 right-4 z-50 flex items-center gap-1 bg-white p-1.5 rounded-lg shadow-md border border-gray-200">
                                <button type="button" onclick="ZoomOut()" class="p-1.5 hover:bg-gray-100 rounded text-gray-600 transition-colors" title="Zoom Out">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM13 10H7"/></svg>
                                </button>
                                <span id="zoom-level" class="w-12 text-center text-sm font-bold text-gray-700 select-none">100%</span>
                                <button type="button" onclick="ZoomIn()" class="p-1.5 hover:bg-gray-100 rounded text-gray-600 transition-colors" title="Zoom In">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"/></svg>
                                </button>
                                <div class="w-px h-5 bg-gray-300 mx-1"></div>
                                <button type="button" onclick="ResetZoom()" class="p-1.5 hover:bg-gray-100 rounded text-gray-600 transition-colors" title="Reset Zoom">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                                </button>
                            </div>

                            <canvas id="seatCanvas"></canvas>
                        </div>
                    </div>

                    <!-- Map Legend Key -->
                    <div class="mb-6 bg-gray-50 border border-gray-200 p-4 rounded-lg">
                        <h3 class="text-center text-gray-700 font-semibold mb-3">Seat Legend</h3>
                        <div class="flex justify-center flex-wrap gap-6">
                            <div class="flex items-center">
                                <div class="w-5 h-5 bg-green-500 rounded border border-green-600 mr-2 shadow-sm"></div>
                                <span class="text-sm font-medium text-gray-700">Available</span>
                            </div>
                            <div class="flex items-center">
                                <div class="w-5 h-5 bg-red-500 rounded border border-red-600 mr-2 shadow-sm"></div>
                                <span class="text-sm font-medium text-gray-700">Reserved / Unavailable</span>
                            </div>
                            <div class="flex items-center">
                                <div class="w-5 h-5 bg-blue-500 rounded border border-blue-600 mr-2 shadow-sm"></div>
                                <span class="text-sm font-medium text-gray-700">Selected</span>
                            </div>
                        </div>
                    </div>

                    <!-- Selected Seats Feedback Tray -->
                    <div id="selection-summary" class="mb-6 hidden">
                        <div class="bg-blue-50 border border-blue-200 rounded-lg p-4 transition-all">
                            <h3 class="text-blue-800 font-bold mb-2">Your Selection</h3>
                            <div class="flex items-center">
                                <div class="mr-3">
                                    <span id="selected-count" class="text-2xl font-black text-blue-600">0</span>
                                    <span class="text-blue-600 font-medium">seats</span>
                                </div>
                                <div id="selected-seats-list" class="text-sm font-semibold text-blue-800 flex-wrap">
                                    <!-- Rendered dynamically by javascript handler -->
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Submission Actions -->
                <div class="flex flex-col sm:flex-row gap-3 justify-center">
                    <button id="clear-selection" class="px-5 py-3 border border-gray-300 text-gray-700 font-medium rounded-md shadow-sm hover:bg-gray-100 transition-colors hidden focus:outline-none focus:ring-2 focus:ring-gray-300">
                        Clear Selection
                    </button>

                    <button id="confirm-reservation" class="px-6 py-3 bg-blue-600 text-white font-bold rounded-md shadow-md hover:bg-blue-700 transition-colors flex items-center justify-center focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2">
                        <span>Complete Reservation</span>
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                        </svg>
                    </button>
                </div>
            }
        </div>
    </div>

    <!-- Navigation Breadcrumb -->
    <div class="mt-8 text-center sm:text-left">
        <a href="@Url.Action("Details", "Events", new { id = Model.Id })" class="inline-flex items-center text-blue-600 font-medium hover:text-blue-800 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
            </svg>
            Back to Event Details
        </a>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/fabric.js/5.3.0/fabric.min.js"></script>
    <script>
        const eventId = @eventId;
        const venueId = @venueId;
        const layoutId = @(layoutId ?? 0);
        
        let selectedSeats = [];
        let seatNames = {};
        let currentSeatsCache = [];
        let currentShapesCache = [];
        let currentGroupsCache = [];
        let fabricCanvas;

        // --- FABRIC VIEWPORT ENGINES ---
        
        /** 
         * Updates the percentage indicator in the bottom right of the canvas 
         */
        function updateZoomText() {
            const zoomText = document.getElementById('zoom-level');
            if (zoomText && fabricCanvas) {
                zoomText.textContent = `${Math.round(fabricCanvas.getZoom() * 100)}%`;
            }
        }

        /** 
         * Steps up the canvas scale incrementally 
         */
        function ZoomIn() {
            if (!fabricCanvas) return;
            let zoom = fabricCanvas.getZoom() * 1.1;
            if (zoom > 5) zoom = 5;
            fabricCanvas.zoomToPoint({ x: fabricCanvas.width / 2, y: fabricCanvas.height / 2 }, zoom);
            updateZoomText();
        }

        /** 
         * Steps down the canvas scale incrementally 
         */
        function ZoomOut() {
            if (!fabricCanvas) return;
            let zoom = fabricCanvas.getZoom() / 1.1;
            if (zoom < 0.1) zoom = 0.1;
            fabricCanvas.zoomToPoint({ x: fabricCanvas.width / 2, y: fabricCanvas.height / 2 }, zoom);
            updateZoomText();
        }

        /** 
         * Restores canvas transformation to 1:1 scale at origin 
         */
        function ResetZoom() {
            if (!fabricCanvas) return;
            fabricCanvas.setZoom(1);
            fabricCanvas.viewportTransform = [1, 0, 0, 1, 0, 0];
            fabricCanvas.calcOffset();
            fabricCanvas.requestRenderAll();
            updateZoomText();
        }

        /** 
         * Automatically calculates the bounding box of all map objects, expands the 
         * canvas if necessary, and scales/pans the viewport to frame them cleanly on load.
         * Utilizes setViewportTransform to ensure click event hitboxes align natively.
         */
        function fitLayoutToViewport(seats, shapes, groups) {
            if (!fabricCanvas) return;

            const allItems = [...(seats || []), ...(shapes || [])];
            if (allItems.length === 0) return;

            // Secure coordinate extraction parsing safely as floats
            const xs = allItems.map(s => parseFloat(s.x) || parseFloat(s.X) || 0);
            const ys = allItems.map(s => parseFloat(s.y) || parseFloat(s.Y) || 0);
            const maxXs = allItems.map(s => (parseFloat(s.x) || parseFloat(s.X) || 0) + (parseFloat(s.width) || 60));
            const maxYs = allItems.map(s => (parseFloat(s.y) || parseFloat(s.Y) || 0) + (parseFloat(s.height) || 60));

            const minX = Math.min(...xs);
            const minY = Math.min(...ys);
            const maxX = Math.max(...maxXs);
            const maxY = Math.max(...maxYs);

            const padding = 100; 

            const contentWidth = (maxX - minX) + (padding * 2);
            const contentHeight = (maxY - minY) + (padding * 2);

            // Sync structural canvas dimensions to exactly match CSS wrapper layout constraints
            const container = document.getElementById('canvas-container');
            const viewportWidth = container.clientWidth;
            const viewportHeight = container.clientHeight;

            fabricCanvas.setWidth(viewportWidth);
            fabricCanvas.setHeight(viewportHeight);

            // Determine scaling factor capped at 1.2x max zoom
            const scaleX = viewportWidth / contentWidth;
            const scaleY = viewportHeight / contentHeight;
            const optimalScale = Math.max(0.1, Math.min(scaleX, scaleY, 1.2)); 

            // Execute programmatic pan to layout centerpoint
            const centerX = (minX + maxX) / 2;
            const centerY = (minY + Math.max(maxY, minY + 10)) / 2; 
            
            const vpt = fabricCanvas.viewportTransform.slice();
            vpt[0] = optimalScale; 
            vpt[3] = optimalScale; 
            vpt[4] = (viewportWidth / 2) - (centerX * optimalScale); 
            vpt[5] = (viewportHeight / 2) - (centerY * optimalScale); 
            
            fabricCanvas.setViewportTransform(vpt);
            fabricCanvas.calcOffset(); 
            updateZoomText();
        }

        // --- DOM INITIALIZATION PIPELINE ---

        document.addEventListener('DOMContentLoaded', function () {
            fabricCanvas = new fabric.Canvas('seatCanvas', { selection: false });

            // Implements drag-to-pan across empty background sectors
            fabricCanvas.on('mouse:down', function (opt) {
                const evt = opt.e;
                if (!opt.target || (opt.target && opt.target.selectable === false && !opt.target.seatId)) {
                    this.isDragging = true;
                    this.lastPosX = evt.clientX;
                    this.lastPosY = evt.clientY;
                    this.selection = false;
                }
            });
            
            fabricCanvas.on('mouse:move', function (opt) {
                if (this.isDragging) {
                    const e = opt.e;
                    const vpt = this.viewportTransform.slice();
                    vpt[4] += e.clientX - this.lastPosX;
                    vpt[5] += e.clientY - this.lastPosY;
                    
                    this.setViewportTransform(vpt);
                    
                    this.lastPosX = e.clientX;
                    this.lastPosY = e.clientY;
                }
            });
            
            fabricCanvas.on('mouse:up', function () {
                this.isDragging = false;
                this.calcOffset();
            });

            // Translates mouse wheel events into smooth zooming transformations
            fabricCanvas.on('mouse:wheel', function(opt) {
                let delta = opt.e.deltaY;
                let zoom = fabricCanvas.getZoom() * (0.999 ** delta);
                if (zoom > 5) zoom = 5;
                if (zoom < 0.1) zoom = 0.1;
                
                fabricCanvas.zoomToPoint({ x: opt.e.offsetX, y: opt.e.offsetY }, zoom);
                fabricCanvas.calcOffset(); 
                
                opt.e.preventDefault();
                opt.e.stopPropagation();
                updateZoomText();
            });

            // Adjust scaling automatically if user resizes browser window
            window.addEventListener('resize', () => {
                if (currentSeatsCache.length > 0) {
                    fitLayoutToViewport(currentSeatsCache, currentShapesCache, currentGroupsCache);
                }
            });

            if (layoutId && layoutId !== 0) {
                loadSeatMap(layoutId, eventId);
            }
        });

        /** 
         * Executes parallel asynchronous data fetches for map generation constraints 
         */
        async function loadSeatMap(layoutId, eventId) {
            showLoadingOnFabric(fabricCanvas);

            try {
                // Fetch dynamic seat availability, non-selectable environments, and group outlines concurrently
                const [seatRes, shapeRes, layoutRes] = await Promise.all([
                    fetch(`/Seat/get_data?LayoutId=${layoutId}&eventId=${eventId}`),
                    fetch(`/NonSelectable/GetElements?layoutId=${layoutId}`),
                    fetch(`/Seat/GetCompleteLayout?layoutId=${layoutId}`)
                ]);

                const seatData = seatRes.ok ? await seatRes.json() : [];
                const shapeData = shapeRes.ok ? await shapeRes.json() : [];
                const layoutData = layoutRes.ok ? await layoutRes.json() : { groups: [] };
                const groupsData = layoutData.groups || [];

                currentSeatsCache = seatData;
                currentShapesCache = shapeData;
                currentGroupsCache = groupsData;

                fabricCanvas.clear();

                if ((seatData && seatData.length > 0) || (shapeData && shapeData.length > 0)) {
                    renderMap(fabricCanvas, seatData, shapeData, groupsData);
                    fitLayoutToViewport(seatData, shapeData, groupsData);
                } else {
                    showNoSeatsMessageOnFabric(fabricCanvas);
                }
            } catch (error) {
                console.error("Failed to load map data:", error);
                fabricCanvas.clear();
                showErrorMessageOnFabric(fabricCanvas);
            }
        }

        // --- FORM DATA & API SUBMISSION ---

        $(document).ready(function () {
            // Logic mapping checkmarks to input control states
            $("#useEventStartTime").on("change", function() {
                if ($(this).is(':checked')) {
                    $("#reservationStartTime").val('@Model.StartDateTime.ToString("HH:mm")');
                    $("#reservationStartTime").prop('disabled', true);
                } else {
                    $("#reservationStartTime").prop('disabled', false);
                }
            });

            $("#useEventEndTime").on("change", function() {
                 if ($(this).is(':checked')) {
                     $("#reservationEndTime").val('@Model.EndTime.ToString("HH:mm")');
                     $("#reservationEndTime").prop('disabled', true);
                 } else {
                     $("#reservationEndTime").prop('disabled', false);
                }
            });

            if ($("#useEventStartTime").is(':checked')) $("#reservationStartTime").prop('disabled', true);
            if ($("#useEventEndTime").is(':checked')) $("#reservationEndTime").prop('disabled', true);

            /** Assembles transactional reservation payload and dispatches to system endpoints */
            $("#confirm-reservation").on("click", function () {
                if (selectedSeats.length > 0) {
                    if (!layoutId || layoutId === 0) {
                        showNotification('No Layout assigned to this event.', 'warning');
                        return;
                    }

                    $(this).prop('disabled', true)
                        .html('<svg class="animate-spin -ml-1 mr-2 h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg> Processing...');

                    const startTime = $("#useEventStartTime").is(":checked") ? $("#startTime").val() : $("#reservationStartTime").val();
                    const endTime = $("#useEventEndTime").is(":checked") ? $("#endTime").val() : $("#reservationEndTime").val();

                    const timeStart = new Date(`2000-01-01T${startTime}`);
                    const timeEnd = new Date(`2000-01-01T${endTime}`);
                    const difference = timeEnd - timeStart;

                    if (difference <= 0) {
                        showNotification('End time must be after start time.', 'error');
                        $(this).prop('disabled', false).html('<span>Complete Reservation</span><svg class="h-5 w-5 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>');
                        return;
                    }

                    // Standardize span into timespan layout required by .NET API
                    const duration = `${Math.floor(difference / 3600000).toString().padStart(2, '0')}:${Math.floor((difference % 3600000) / 60000).toString().padStart(2, '0')}:${Math.floor((difference % 60000) / 1000).toString().padStart(2, '0')}`;
                    const reservationDate = `${$("#eventDate").val()}T${startTime}`;

                    $.ajax({
                        url: `/Reservation/MakeRes`,
                        type: "POST",
                        contentType: "application/json",
                        data: JSON.stringify({
                            seatIds: selectedSeats,
                            eventId: eventId,
                            layoutId: layoutId,
                            duration: duration,
                            resDate: reservationDate
                        }),
                        success: function() {
                            showNotification('Reservation successful!', 'success');
                            setTimeout(() => window.location.href = "/Reservation/Index", 1500);
                        },
                        error: function(xhr) {
                            $("#confirm-reservation").prop('disabled', false).html('<span>Complete Reservation</span><svg class="h-5 w-5 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>');
                            let msg = "Failed to reserve seats.";
                            try { msg = JSON.parse(xhr.responseText) || msg; } catch(e) { msg = xhr.responseText || msg; }
                            showNotification(msg, 'error');
                        }
                    });
                } else {
                    showNotification('Please select at least one seat.', 'warning');
                }
            });

            $("#clear-selection").on("click", () => clearAllSelections(fabricCanvas));
        });

        // --- MAP RENDERING ---

        /** 
         * Constructs graphic layers for all items bound to coordinate layout 
         */
        function renderMap(canvas, seats, shapes, groups) {
            canvas.clear();

            // 1. Render Logical Group Regions
            if (groups) {
                groups.forEach(group => {
                    const childNames = new Set();
                    if(group.selectableUnits) group.selectableUnits.forEach(u => childNames.add(u.name));
                    if(group.nonSelectableUnits) group.nonSelectableUnits.forEach(u => childNames.add(u.name));

                    const bounds = [];
                    seats.forEach(s => { if(childNames.has(s.name)) bounds.push({ x: s.x||s.X, y: s.y||s.Y, w: 60, h: 60 }); });
                    shapes.forEach(s => { if(childNames.has(s.name)) bounds.push({ x: s.x||s.X, y: s.y||s.Y, w: s.width||100, h: s.height||100 }); });

                    if (bounds.length === 0) return;

                    const minX = Math.min(...bounds.map(c => parseFloat(c.x) || 0));
                    const minY = Math.min(...bounds.map(c => parseFloat(c.y) || 0));
                    const maxX = Math.max(...bounds.map(c => (parseFloat(c.x) || 0) + (parseFloat(c.w) || 0)));
                    const maxY = Math.max(...bounds.map(c => (parseFloat(c.y) || 0) + (parseFloat(c.h) || 0)));

                    const groupRect = new fabric.Rect({
                        left: minX - 15, top: minY - 15,
                        width: (maxX - minX) + 30, height: (maxY - minY) + 30,
                        fill: 'rgba(99, 102, 241, 0.05)', 
                        stroke: '#6366f1', strokeWidth: 2,
                        strokeDashArray: [5, 5],
                        rx: 8, ry: 8,
                        selectable: false, evented: false
                    });
                    
                    canvas.add(groupRect);
                });
            }

            // 2. Render Aesthetic Shapes (Scenery, structural items)
            if (shapes) {
                shapes.forEach(shape => {
                    let fabricShape;
                    const fill = shape.backgroundColor || '#D1D5DB';
                    const width = shape.width || 100;
                    const height = shape.height || 100;
                    const posX = parseFloat(shape.x) || parseFloat(shape.X) || 0;
                    const posY = parseFloat(shape.y) || parseFloat(shape.Y) || 0;

                    if (shape.shapeType === 'ellipse') {
                        fabricShape = new fabric.Ellipse({
                            rx: width / 2, ry: height / 2,
                            fill: fill, opacity: 0.8, stroke: '#9CA3AF', strokeWidth: 1,
                            originX: 'left', originY: 'top' 
                        });
                    } else if (shape.shapeType === 'triangle') {
                        fabricShape = new fabric.Triangle({
                            width: width, height: height, fill: fill, opacity: 0.8,
                            originX: 'left', originY: 'top'
                        });
                    } else {
                        fabricShape = new fabric.Rect({
                            width: width, height: height,
                            fill: fill, opacity: 0.8, stroke: '#9CA3AF', strokeWidth: 1,
                            originX: 'left', originY: 'top'
                        });
                    }

                    const shapeText = new fabric.Text(shape.name, {
                        originX: 'center', originY: 'center',
                        left: width / 2, top: height / 2,
                        fill: fill === '#4B5563' ? '#FFFFFF' : '#1F2937', 
                        fontSize: 14, fontFamily: 'Arial', fontWeight: 'bold'
                    });
                    
                    if (shape.shapeType === 'triangle') shapeText.set('top', height / 1.5);

                    const shapeGroup = new fabric.Group([fabricShape, shapeText], {
                        left: posX, top: posY,
                        selectable: false, evented: false
                    });
                    canvas.add(shapeGroup);
                });
            }

            // 3. Render Selectable Seats (Core reservation logic)
            if (seats) {
                seats.forEach(seat => {
                    seatNames[seat.id] = seat.name;
                    const posX = parseFloat(seat.x) || parseFloat(seat.X) || 0;
                    const posY = parseFloat(seat.y) || parseFloat(seat.Y) || 0;
                    
                    const seatRect = new fabric.Rect({
                        width: 60, height: 60, 
                        fill: seat.available ? '#4CAF50' : '#f44336', 
                        stroke: seat.available ? '#2E7D32' : '#c62828', strokeWidth: 1, rx: 6, ry: 6,
                        originX: 'left', originY: 'top'
                    });

                    const seatText = new fabric.Text(seat.name, {
                        originX: 'center', originY: 'center',
                        left: 30, top: 30,
                        fill: 'white', fontSize: 12, fontFamily: 'Arial', fontWeight: 'bold'
                    });

                    const seatGroup = new fabric.Group([seatRect, seatText], {
                        left: posX, top: posY,
                        selectable: seat.available,

                        hasControls: false, 
                        hasBorders: false,
                        lockMovementX: true, 
                        lockMovementY: true,
                        lockRotation: true,
                        lockScalingX: true,
                        lockScalingY: true,
                        
                        hoverCursor: seat.available ? 'pointer' : 'default'
                    });

                    seatGroup.seatId = seat.id;
                    seatGroup.seatName = seat.name;
                    seatGroup.available = seat.available;

                    if (seat.available) {
                        seatGroup.on('mousedown', function() { toggleSeatSelection(this, canvas); });
                    }
                    canvas.add(seatGroup);
                });
            }
            canvas.renderAll();
        }

        /** 
         * Mutates visual properties bound to selected reservation array 
         */
        function toggleSeatSelection(seatGroup, canvas) {
            const seatId = seatGroup.seatId;
            const rect = seatGroup.item(0);

            if (selectedSeats.includes(seatId)) {
                selectedSeats = selectedSeats.filter(id => id !== seatId);
                rect.set('fill', '#4CAF50'); 
            } else {
                selectedSeats.push(seatId);
                rect.set('fill', '#3b82f6'); 
            }

            updateSelectionSummary();
            canvas.renderAll();
        }

        /** 
         * Propagates state modifications mapping reservation context downwards 
         */
        function updateSelectionSummary() {
            const count = selectedSeats.length;
            if (count > 0) {
                $('#selection-summary').removeClass('hidden');
                $('#clear-selection').removeClass('hidden');
                $('#selected-count').text(count);
                $('#selected-seats-list').text(selectedSeats.map(id => seatNames[id]).join(', '));
            } else {
                $('#selection-summary').addClass('hidden');
                $('#clear-selection').addClass('hidden');
            }
        }

        /** 
         * Empties cache mapping array restoring layout objects visual defaults 
         */
        function clearAllSelections(canvas) {
            canvas.getObjects('group').forEach(group => {
                if (group.available && group.seatId) {
                    group.item(0).set('fill', '#4CAF50'); 
                }
            });
            selectedSeats = [];
            updateSelectionSummary();
            canvas.renderAll();
        }

        // --- UI ALERT NOTIFICATIONS ---

        function showLoadingOnFabric(canvas) {
            canvas.add(new fabric.Text('Loading map...', { left: canvas.width/2, top: canvas.height/2, originX: 'center', originY: 'center', fill: '#4a5568', fontSize: 18, fontFamily: 'Arial' }));
            canvas.renderAll();
        }
        function showNoSeatsMessageOnFabric(canvas) {
            canvas.add(new fabric.Text('No seats or layout available for this area', { left: canvas.width/2, top: canvas.height/2, originX: 'center', originY: 'center', fill: '#666', fontSize: 18, fontFamily: 'Arial' }));
            canvas.renderAll();
        }
        function showErrorMessageOnFabric(canvas) {
            canvas.add(new fabric.Text('Failed to load map data. Please try again.', { left: canvas.width/2, top: canvas.height/2, originX: 'center', originY: 'center', fill: '#e53e3e', fontSize: 18, fontFamily: 'Arial' }));
            canvas.renderAll();
        }
        function showNotification(message, type = 'info') {
            $('.notification').remove();
            let bgColor = type === 'success' ? 'bg-green-500' : type === 'error' ? 'bg-red-500' : type === 'warning' ? 'bg-yellow-500' : 'bg-blue-500';
            const notification = $(`<div class="notification fixed top-4 right-4 ${bgColor} text-white px-6 py-3 rounded-lg shadow-lg z-50">${message}</div>`);
            $('body').append(notification);
            setTimeout(() => notification.fadeOut(() => notification.remove()), 5000);
        }
    </script>
}