@model PtixiakiReservations.Models.ViewModels.RoleRequestViewModel
@{
    ViewData["Title"] = "Request Roles";
}

<div class="min-h-screen bg-gray-50/50 py-10 px-4 sm:px-6 lg:px-8 flex items-start justify-center">
    <div class="max-w-3xl w-full bg-white rounded-2xl shadow-xl border border-gray-100 overflow-hidden">
        
        <!-- Header Section -->
        <div class="bg-gradient-to-r from-blue-600 to-indigo-700 px-6 sm:px-10 py-10 relative overflow-hidden">
            <!-- Decorative background pattern -->
            <div class="absolute top-0 right-0 -mt-4 -mr-4 w-32 h-32 bg-white opacity-10 rounded-full blur-2xl"></div>
            <div class="relative z-10">
                <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">Request Account Upgrade</h1>
                <p class="mt-2 text-blue-100 text-sm sm:text-base max-w-2xl">
                    Apply for professional access to manage venues or organize events. Your request will be reviewed by an administrator.
                </p>
            </div>
        </div>

        <div class="p-6 sm:p-10">
            <form asp-action="RequestRoles" method="post" class="space-y-8">
                <div asp-validation-summary="ModelOnly" class="text-red-500 text-sm font-bold bg-red-50 p-4 rounded-lg border border-red-100 hidden"></div>

                <!-- Role Selection Cards -->
                <div>
                    <div class="flex items-center mb-4">
                        <div class="h-8 w-8 rounded-lg bg-indigo-50 border border-indigo-100 flex items-center justify-center mr-3">
                            <svg class="h-4 w-4 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                        </div>
                        <h2 class="text-lg font-bold text-gray-900">Select Requested Role <span class="text-red-500">*</span></h2>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                        
                        <!-- Venue Manager Card -->
                        <label class="relative cursor-pointer group">
                            <input type="radio" asp-for="SelectedRoleRequest" value="Venue" id="role_venue" class="peer sr-only">
                            <div class="h-full px-4 py-5 border-2 border-gray-200 rounded-xl hover:bg-gray-50 peer-checked:border-indigo-600 peer-checked:bg-indigo-50 peer-checked:shadow-sm transition-all text-center">
                                <svg class="mx-auto h-8 w-8 text-gray-400 group-hover:text-indigo-400 peer-checked:text-indigo-600 mb-3 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                                </svg>
                                <span class="block text-sm font-bold text-gray-900">Venue Manager</span>
                                <span class="block text-[11px] text-gray-500 mt-1 leading-tight">Register physical locations and manage floorplans.</span>
                            </div>
                            <!-- Active indicator dot -->
                            <div class="absolute top-3 right-3 h-3 w-3 bg-indigo-600 rounded-full opacity-0 peer-checked:opacity-100 transition-opacity"></div>
                        </label>

                        <!-- Event Organizer Card -->
                        <label class="relative cursor-pointer group">
                            <input type="radio" asp-for="SelectedRoleRequest" value="Event" id="role_event" class="peer sr-only">
                            <div class="h-full px-4 py-5 border-2 border-gray-200 rounded-xl hover:bg-gray-50 peer-checked:border-indigo-600 peer-checked:bg-indigo-50 peer-checked:shadow-sm transition-all text-center">
                                <svg class="mx-auto h-8 w-8 text-gray-400 group-hover:text-indigo-400 peer-checked:text-indigo-600 mb-3 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                </svg>
                                <span class="block text-sm font-bold text-gray-900">Event Organizer</span>
                                <span class="block text-[11px] text-gray-500 mt-1 leading-tight">Create and schedule events at available venues.</span>
                            </div>
                            <div class="absolute top-3 right-3 h-3 w-3 bg-indigo-600 rounded-full opacity-0 peer-checked:opacity-100 transition-opacity"></div>
                        </label>

                        <!-- Super Organizer Card -->
                        <label class="relative cursor-pointer group">
                            <input type="radio" asp-for="SelectedRoleRequest" value="SuperOrganizer" id="role_super" class="peer sr-only">
                            <div class="h-full px-4 py-5 border-2 border-gray-200 rounded-xl hover:bg-gray-50 peer-checked:border-indigo-600 peer-checked:bg-indigo-50 peer-checked:shadow-sm transition-all text-center">
                                <svg class="mx-auto h-8 w-8 text-gray-400 group-hover:text-indigo-400 peer-checked:text-indigo-600 mb-3 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
                                </svg>
                                <span class="block text-sm font-bold text-gray-900">Super Organizer</span>
                                <span class="block text-[11px] text-gray-500 mt-1 leading-tight">Full access to manage both venues and events.</span>
                            </div>
                            <div class="absolute top-3 right-3 h-3 w-3 bg-indigo-600 rounded-full opacity-0 peer-checked:opacity-100 transition-opacity"></div>
                        </label>

                    </div>
                    <span asp-validation-for="SelectedRoleRequest" class="text-sm text-red-500 font-bold mt-2 block"></span>
                </div>

                <!-- Reason Textarea -->
                <div>
                    <div class="flex items-center mb-4">
                        <div class="h-8 w-8 rounded-lg bg-emerald-50 border border-emerald-100 flex items-center justify-center mr-3">
                            <svg class="h-4 w-4 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                        </div>
                        <h2 class="text-lg font-bold text-gray-900">Justification & Plans <span class="text-red-500">*</span></h2>
                    </div>
                    
                    <textarea asp-for="Reason" rows="5"
                        class="w-full px-4 py-3 bg-gray-50 border border-gray-300 rounded-xl focus:bg-white focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all text-sm text-gray-900 leading-relaxed shadow-sm"
                        placeholder="Explain why you are requesting this role. Please include details about the types of venues or events you plan to create to help admins verify your request..."></textarea>
                    <span asp-validation-for="Reason" class="text-sm text-red-500 font-bold mt-2 block"></span>
                </div>

                <!-- Actions -->
                <div class="flex flex-col-reverse sm:flex-row justify-end gap-3 pt-6 border-t border-gray-100">
                    <a asp-action="Index" class="w-full sm:w-auto text-center px-6 py-2.5 bg-white border border-gray-300 text-gray-700 font-bold rounded-xl hover:bg-gray-50 transition-colors text-sm shadow-sm">
                        Cancel
                    </a>
                    <button type="submit" class="w-full sm:w-auto flex justify-center items-center px-8 py-2.5 bg-gradient-to-r from-blue-600 to-indigo-600 text-white font-bold rounded-xl shadow-md hover:from-blue-700 hover:to-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-all transform hover:-translate-y-0.5 text-sm">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                        Submit Request
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        // Make the validation summary visible only if it actually contains errors
        document.addEventListener('DOMContentLoaded', function() {
            const valSummary = document.querySelector('[data-valmsg-summary="true"]');
            if (valSummary && valSummary.textContent.trim().length > 0) {
                valSummary.classList.remove('hidden');
            }
        });
    </script>
}