@model PtixiakiReservations.Models.ViewModels.ProfileViewModel
@{
    ViewData["Title"] = "Your Profile";
}

<!-- Security Token for all POST requests -->
@Html.AntiForgeryToken()

<!-- Primary Profile Layout Container -->
<div class="max-w-5xl mx-auto space-y-6 pb-10">
    
    <!-- Profile Identification Header -->
    <div class="bg-white dark:bg-gray-800 shadow-sm rounded-xl overflow-hidden border border-gray-200 dark:border-gray-700">
        <div class="flex flex-col sm:flex-row items-center justify-between p-6 sm:p-8 bg-gradient-to-r from-gray-50 to-white dark:from-gray-800 dark:to-gray-750">
            <div class="flex flex-col sm:flex-row items-center text-center sm:text-left">
                <!-- Avatar Graphic -->
                <div class="h-24 w-24 rounded-full bg-gradient-to-r from-blue-500 to-indigo-600 flex items-center justify-center text-white text-4xl font-bold shadow-md border-4 border-white dark:border-gray-700">
                    @(Model.User.FirstName?[0].ToString().ToUpper() ?? Model.User.Email[0].ToString().ToUpper())@(Model.User.LastName?[0].ToString().ToUpper() ?? "")
                </div>
                <div class="mt-4 sm:mt-0 sm:ml-6">
                    <h1 class="text-2xl sm:text-3xl font-bold text-gray-800 dark:text-white tracking-tight">
                        @(string.IsNullOrEmpty(Model.User.FirstName) ? Model.User.Email : $"{Model.User.FirstName} {Model.User.LastName}")
                    </h1>
                    <p class="text-sm font-medium text-gray-500 dark:text-gray-400 mt-1">@Model.User.Email</p>
                    <div class="mt-3 flex flex-wrap justify-center sm:justify-start gap-2">
                        @foreach (var role in Model.Roles)
                        {
                            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold tracking-wide bg-indigo-100 text-indigo-800 dark:bg-indigo-900/50 dark:text-indigo-200 border border-indigo-200 dark:border-indigo-800">
                                @role
                            </span>
                        }
                    </div>
                </div>
            </div>

            <!-- Profile Edit Navigation -->
            <a href="@Url.Action("Edit", "Profile")"
               class="mt-6 sm:mt-0 px-5 py-2.5 bg-blue-600 text-white text-sm font-medium rounded-lg shadow-sm hover:bg-blue-700 transition duration-200 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 dark:focus:ring-offset-gray-800 flex items-center gap-2 w-full sm:w-auto justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L6.832 19.82a4.5 4.5 0 01-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 011.13-1.897L16.863 4.487zm0 0L19.5 7.125" />
                </svg>
                Edit Profile
            </a>
        </div>
    </div>

    <!-- Main Content Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        
        <!-- Left Column: Primary User Data (Spans 2 columns on large screens) -->
        <div class="lg:col-span-2 space-y-6">
            
            <!-- Personal Information Card -->
            <div class="bg-white dark:bg-gray-800 shadow-sm rounded-xl border border-gray-200 dark:border-gray-700 p-6">
                <h2 class="text-lg font-bold text-gray-800 dark:text-white border-b border-gray-100 dark:border-gray-700 pb-3 mb-5">Personal Information</h2>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                    <div class="bg-gray-50 dark:bg-gray-700/50 p-3 rounded-lg border border-gray-100 dark:border-gray-700">
                        <p class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider">First Name</p>
                        <p class="mt-1 font-medium text-gray-900 dark:text-white">@(Model.User.FirstName ?? "Not provided")</p>
                    </div>

                    <div class="bg-gray-50 dark:bg-gray-700/50 p-3 rounded-lg border border-gray-100 dark:border-gray-700">
                        <p class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider">Last Name</p>
                        <p class="mt-1 font-medium text-gray-900 dark:text-white">@(Model.User.LastName ?? "Not provided")</p>
                    </div>

                    <!-- Email Address with Inline Edit Button -->
                    <div class="bg-gray-50 dark:bg-gray-700/50 p-3 rounded-lg border border-gray-100 dark:border-gray-700">
                        <p class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider">Email Address</p>
                        <div class="flex items-center justify-between mt-1">
                            <p class="font-medium text-gray-900 dark:text-white truncate pr-2">@Model.User.Email</p>
                            <button onclick="document.getElementById('emailChangeModal').showModal()" class="text-blue-600 hover:text-blue-800 dark:text-blue-400 dark:hover:text-blue-300 transition-colors p-1 rounded-md hover:bg-blue-50 dark:hover:bg-blue-900/30" title="Change Email"> 
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L6.832 19.82a4.5 4.5 0 01-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 011.13-1.897L16.863 4.487zm0 0L19.5 7.125" />
                                </svg>
                            </button>
                        </div>
                    </div>

                    <div class="bg-gray-50 dark:bg-gray-700/50 p-3 rounded-lg border border-gray-100 dark:border-gray-700">
                        <p class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider">Phone Number</p>
                        <p class="mt-1 font-medium text-gray-900 dark:text-white">@(Model.User.PhoneNumber ?? "Not provided")</p>
                    </div>
                </div>
            </div>

            <!-- Location Information Card -->
            <div class="bg-white dark:bg-gray-800 shadow-sm rounded-xl border border-gray-200 dark:border-gray-700 p-6">
                <h2 class="text-lg font-bold text-gray-800 dark:text-white border-b border-gray-100 dark:border-gray-700 pb-3 mb-5">Location Details</h2>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                    <div class="bg-gray-50 dark:bg-gray-700/50 p-3 rounded-lg border border-gray-100 dark:border-gray-700">
                        <p class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider">City</p>
                        <p class="mt-1 font-medium text-gray-900 dark:text-white">@(Model.User.City?.Name ?? "Not provided")</p>
                    </div>

                    <div class="bg-gray-50 dark:bg-gray-700/50 p-3 rounded-lg border border-gray-100 dark:border-gray-700">
                        <p class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider">Postal Code</p>
                        <p class="mt-1 font-medium text-gray-900 dark:text-white">@(Model.User.PostalCode ?? "Not provided")</p>
                    </div>

                    <div class="sm:col-span-2 bg-gray-50 dark:bg-gray-700/50 p-3 rounded-lg border border-gray-100 dark:border-gray-700">
                        <p class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider">Physical Address</p>
                        <p class="mt-1 font-medium text-gray-900 dark:text-white">@(Model.User.Address ?? "Not provided")</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Column: Security & Metadata Controls -->
        <div class="space-y-6">
            
            <!-- Security Hub Card -->
            <div class="bg-white dark:bg-gray-800 shadow-sm rounded-xl border border-gray-200 dark:border-gray-700 p-6">
                <h2 class="text-lg font-bold text-gray-800 dark:text-white border-b border-gray-100 dark:border-gray-700 pb-3 mb-5">Account Security</h2>
                
                <!-- Email Verification Status -->
                <div class="mb-6">
                    <p class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-2">Email Verification</p>
                    @if (Model.IsEmailConfirmed)
                    {
                        <div class="flex items-center p-3 bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800/50 rounded-lg">
                            <svg class="h-5 w-5 text-green-600 dark:text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                            <span class="ml-2 text-sm font-semibold text-green-800 dark:text-green-300">Verified & Active</span>
                        </div>
                    }
                    else
                    {
                        <div class="flex flex-col p-3 bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800/50 rounded-lg">
                            <div class="flex items-center mb-2">
                                <svg class="h-5 w-5 text-red-600 dark:text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
                                <span class="ml-2 text-sm font-semibold text-red-800 dark:text-red-300">Action Required</span>
                            </div>
                            <button class="w-full px-3 py-2 bg-red-600 text-white text-xs font-medium rounded shadow-sm hover:bg-red-700 transition duration-200" onclick="document.getElementById('emailConfirmModal').showModal()">
                                Send Verification Code
                            </button>
                        </div>
                    }
                </div>

                <!-- Two-Factor Authentication Status -->
                @if(Model.IsEmailConfirmed)
                {
                    <div>
                        <p class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-2">Two-Factor Authentication</p>
                        @if (Model.Is2faEnabled)
                        {
                            <div class="p-3 bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800/50 rounded-lg">
                                <div class="flex items-center mb-2 text-blue-800 dark:text-blue-300">
                                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
                                    <span class="text-sm font-semibold">2FA is Enabled</span>
                                </div>
                                <button class="w-full px-3 py-2 bg-white dark:bg-gray-800 text-red-600 border border-red-200 dark:border-red-800/50 text-xs font-medium rounded shadow-sm hover:bg-red-50 dark:hover:bg-red-900/30 transition duration-200" onclick="open2faModal(false)">
                                    Disable 2FA
                                </button>
                            </div>
                        }
                        else
                        {
                            <div class="p-3 bg-gray-50 dark:bg-gray-700/50 border border-gray-200 dark:border-gray-600 rounded-lg">
                                <p class="text-xs text-gray-600 dark:text-gray-300 mb-2">Enhance your account security by requiring an authentication code.</p>
                                <button class="w-full px-3 py-2 bg-indigo-600 text-white text-xs font-medium rounded shadow-sm hover:bg-indigo-700 transition duration-200 flex items-center justify-center gap-2" onclick="open2faModal(true)">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
                                    Enable 2FA
                                </button>
                            </div>
                        }
                    </div>
                }

                <!-- Password Management Section -->
                <div class="mt-6 pt-6 border-t border-gray-100 dark:border-gray-700">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-sm font-semibold text-gray-800 dark:text-white">Password</p>
                            <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Update your password regularly to keep your account secure.</p>
                        </div>
                        <button onclick="document.getElementById('changePasswordModal').showModal()" class="px-4 py-2 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-600 text-sm font-medium rounded-md transition-colors border border-gray-200 dark:border-gray-600 shadow-sm ml-4 whitespace-nowrap">
                            Change
                        </button>
                    </div>
                </div>
            </div>

            <!-- System Roles Request Card (Hidden from current Admins) -->
            @if (!User.IsInRole("Admin"))
            {
                <div class="bg-indigo-50 dark:bg-indigo-900/20 border border-indigo-100 dark:border-indigo-800/50 rounded-xl p-6">
                    <h3 class="text-base font-bold text-indigo-900 dark:text-indigo-200 flex items-center mb-2">
                        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"></path></svg>
                        Request Elevated Roles
                    </h3>
                    <ul class="text-xs text-indigo-700 dark:text-indigo-300 space-y-1 mb-4 list-disc pl-4">
                        <li><strong>Venue Manager:</strong> Create and control venue layouts.</li>
                        <li><strong>Event Manager:</strong> Publish and schedule events.</li>
                    </ul>
                    <a href="@Url.Action("RequestRoles", "Profile")" class="block text-center w-full px-4 py-2 bg-indigo-600 text-white text-sm font-medium rounded-lg hover:bg-indigo-700 transition duration-200">
                        Submit Request
                    </a>
                </div>
            }
        </div>
    </div>

    <!-- Recent Reservations Spanning Table Card -->
    <div class="bg-white dark:bg-gray-800 shadow-sm rounded-xl border border-gray-200 dark:border-gray-700 overflow-hidden">
        <div class="flex justify-between items-center px-6 py-5 border-b border-gray-100 dark:border-gray-700">
            <h2 class="text-lg font-bold text-gray-800 dark:text-white">Recent Reservations</h2>
            <a href="@Url.Action("Reservations", "Profile")" class="text-sm font-medium text-blue-600 hover:text-blue-800 dark:text-blue-400 dark:hover:text-blue-300 transition-colors flex items-center">
                View History
                <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
            </a>
        </div>

        @if (Model.RecentReservations != null && Model.RecentReservations.Any())
        {
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
                    <thead class="bg-gray-50 dark:bg-gray-800">
                        <tr>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider">Event</th>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider">Venue</th>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider">Seat Allocation</th>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider">Date & Time</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white dark:bg-gray-800 divide-y divide-gray-100 dark:divide-gray-700">
                    @foreach (var reservation in Model.RecentReservations)
                    {
                        <tr class="hover:bg-gray-50 dark:hover:bg-gray-750 transition-colors">
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="text-sm font-bold text-gray-900 dark:text-white">@reservation.Event.Name</div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="text-sm text-gray-600 dark:text-gray-300">@reservation.Seat.Layout.Venue.Name</div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="inline-flex items-center px-2.5 py-1 rounded text-xs font-medium bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-200 border border-gray-200 dark:border-gray-600">
                                    @reservation.Seat.Layout.AreaName • @reservation.Seat.Name
                                </div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap flex items-center justify-between">
                                <div class="text-sm font-medium text-gray-700 dark:text-gray-300">
                                    @reservation.Date.ToString("MMM dd, yyyy h:mm tt")
                                </div>
                                <a href="/reservation/@reservation.ID/ics" title="Export to Calendar" class="p-2 ml-4 rounded hover:bg-blue-100 dark:hover:bg-blue-900/50 text-blue-600 dark:text-blue-400 transition-colors">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10m-13 9h16a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v11a2 2 0 002 2z"/>
                                    </svg>
                                </a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <!-- Empty State Configuration -->
            <div class="text-center py-10 px-6">
                <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-gray-100 dark:bg-gray-700 mb-4">
                    <svg class="w-8 h-8 text-gray-400 dark:text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z"></path></svg>
                </div>
                <h3 class="text-base font-bold text-gray-900 dark:text-white mb-1">No Reservations Found</h3>
                <p class="text-sm text-gray-500 dark:text-gray-400 mb-4">You haven't booked any seats yet.</p>
                <a href="@Url.Action("EventsForToday", "Events")" class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
                    Browse Upcoming Events
                </a>
            </div>
        }
    </div>

</div>

<!-- ============================================================== -->
<!-- DIALOG MODALS                                                  -->
<!-- ============================================================== -->

<!-- 1. General Email Confirmation Modal (For initial unverified state) -->
<dialog id="emailConfirmModal" class="rounded-xl shadow-2xl border border-indigo-200 dark:border-gray-600 bg-white dark:bg-gray-800 p-0 w-full max-w-sm backdrop:bg-gray-900/60 transition-all">
    <div class="p-6">
        <div class="flex items-center justify-between mb-4">
            <h3 class="text-lg font-bold text-gray-900 dark:text-white">Verify Account</h3>
            <button type="button" onclick="closeAndResetModal()" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-300">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
        </div>

        <div id="step1">
            <p class="text-sm text-gray-600 dark:text-gray-300 mb-6">Click the button below to generate a 6-digit verification code to secure your account.</p>
            <div class="flex justify-end gap-3">
                <button type="button" onclick="closeAndResetModal()" class="px-4 py-2 rounded-md bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 text-sm font-medium hover:bg-gray-200 dark:hover:bg-gray-600 transition">Cancel</button>
                <button type="button" onclick="sendVerificationCode()" id="sendBtn" class="px-4 py-2 rounded-md bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium transition shadow-sm">Send Code</button>
            </div>
        </div>

        <div id="step2" class="hidden">
            <p class="text-sm text-gray-600 dark:text-gray-300 mb-4">Enter the 6-digit code sent to your email.</p>
            <input type="text" id="emailCodeInput" placeholder="000000" maxlength="6" class="w-full border border-gray-300 dark:border-gray-600 bg-gray-50 dark:bg-gray-700 rounded-lg px-4 py-3 text-gray-900 dark:text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 mb-2 tracking-widest text-center text-xl font-mono" />
            <div id="emailError" class="hidden text-red-500 dark:text-red-400 text-xs mb-4 text-center font-medium">Invalid code. Please try again.</div>
            
            <div class="flex justify-end gap-3">
                <button type="button" onclick="closeAndResetModal()" class="px-4 py-2 rounded-md bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 text-sm font-medium hover:bg-gray-200 dark:hover:bg-gray-600 transition">Cancel</button>
                <button type="button" onclick="verifyTheCode()" class="px-4 py-2 rounded-md bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium transition shadow-sm">Confirm Code</button>
            </div>
        </div>
    </div>
</dialog>

<!-- 2. Email Change Modal (Conditional Workflow - verifies old email before allowing new input) -->
<dialog id="emailChangeModal" class="rounded-xl shadow-2xl border border-indigo-200 dark:border-gray-600 bg-white dark:bg-gray-800 p-0 w-full max-w-sm backdrop:bg-gray-900/60 transition-all">
    <div class="p-6">
        <div class="flex items-center justify-between mb-4">
            <h3 class="text-lg font-bold text-gray-900 dark:text-white">Change Email Address</h3>
            <button type="button" onclick="closeAndResetChangeModal()" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-300">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
        </div>

        @if (Model.IsEmailConfirmed)
        {
            <!-- Phase 1: Identity verification via current verified email -->
            <div id="changeStep1_Old">
                <p class="text-sm text-gray-600 dark:text-gray-300 mb-4">To ensure your security, please verify your current email before changing it.</p>
                <div class="flex justify-end gap-3">
                    <button type="button" onclick="closeAndResetChangeModal()" class="px-4 py-2 rounded-md bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 text-sm font-medium hover:bg-gray-200 dark:hover:bg-gray-600 transition">Cancel</button>
                    <button type="button" onclick="sendOldEmailCode()" id="btnSendOld" class="px-4 py-2 rounded-md bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium transition shadow-sm">Send Code</button>
                </div>
            </div>

            <!-- Phase 2: Token input for current email -->
            <div id="changeStep2_Old" class="hidden">
                <p class="text-sm text-gray-600 dark:text-gray-300 mb-4">Enter the 6-digit code sent to your <strong>current</strong> email address.</p>
                <input type="text" id="oldCodeInput" placeholder="000000" maxlength="6" class="w-full border border-gray-300 dark:border-gray-600 bg-gray-50 dark:bg-gray-700 rounded-lg px-4 py-3 text-gray-900 dark:text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 mb-2 tracking-widest text-center text-xl font-mono" />
                <div id="oldEmailError" class="hidden text-red-500 dark:text-red-400 text-xs mb-4 text-center font-medium">Invalid code. Please try again.</div>
                <div class="flex justify-end gap-3">
                    <button type="button" onclick="closeAndResetChangeModal()" class="px-4 py-2 rounded-md bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 text-sm font-medium hover:bg-gray-200 dark:hover:bg-gray-600 transition">Cancel</button>
                    <button type="button" onclick="verifyOldCode()" class="px-4 py-2 rounded-md bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium transition shadow-sm">Verify</button>
                </div>
            </div>
        }

        <!-- Phase 3: New Email request (Shown immediately if old email was never confirmed) -->
        <div id="changeStep3_New" class="@(Model.IsEmailConfirmed ? "hidden" : "")">
            <p class="text-sm text-gray-600 dark:text-gray-300 mb-4">Enter your new email address. We will send a 6-digit code to verify ownership.</p>
            <input type="email" id="newEmailInput" placeholder="new.email@example.com" class="w-full border border-gray-300 dark:border-gray-600 bg-gray-50 dark:bg-gray-700 rounded-lg px-4 py-2 text-gray-900 dark:text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 mb-6 text-sm" required />
            <div class="flex justify-end gap-3">
                <button type="button" onclick="closeAndResetChangeModal()" class="px-4 py-2 rounded-md bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 text-sm font-medium hover:bg-gray-200 dark:hover:bg-gray-600 transition">Cancel</button>
                <button type="button" onclick="sendNewEmailCode()" id="btnSendNew" class="px-4 py-2 rounded-md bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium transition shadow-sm">Send Code</button>
            </div>
        </div>

        <!-- Phase 4: Verification of newly requested email -->
        <div id="changeStep4_New" class="hidden">
            <p class="text-sm text-gray-600 dark:text-gray-300 mb-4">Enter the 6-digit code sent to <strong id="displayNewEmail" class="text-gray-900 dark:text-white"></strong>.</p>
            <input type="text" id="newCodeInput" placeholder="000000" maxlength="6" class="w-full border border-gray-300 dark:border-gray-600 bg-gray-50 dark:bg-gray-700 rounded-lg px-4 py-3 text-gray-900 dark:text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 mb-2 tracking-widest text-center text-xl font-mono" />
            <div id="newEmailError" class="hidden text-red-500 dark:text-red-400 text-xs mb-4 text-center font-medium">Invalid code. Please try again.</div>
            
            <div class="flex justify-end gap-3">
                <button type="button" onclick="closeAndResetChangeModal()" class="px-4 py-2 rounded-md bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 text-sm font-medium hover:bg-gray-200 dark:hover:bg-gray-600 transition">Cancel</button>
                <button type="button" onclick="verifyNewCode()" class="px-4 py-2 rounded-md bg-green-600 hover:bg-green-700 text-white text-sm font-medium transition shadow-sm">Confirm Change</button>
            </div>
        </div>
    </div>
</dialog>

<!-- 3. 2FA Toggle Modal (Requires password authorization) -->
<dialog id="authDialog" class="rounded-xl shadow-2xl border border-indigo-200 dark:border-gray-600 bg-white dark:bg-gray-800 p-0 w-full max-w-sm backdrop:bg-gray-900/60 transition-all">
    <div class="p-6">
        <div class="flex items-center justify-between mb-4">
            <h3 class="text-lg font-bold text-gray-900 dark:text-white">Authentication Required</h3>
            <button type="button" onclick="document.getElementById('authDialog').close()" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-300">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
        </div>
        
        <p class="text-sm text-gray-600 dark:text-gray-300 mb-4">Please enter your current password to modify your 2FA security settings.</p>
        
        <input type="password" id="confirmPassword" class="w-full border border-gray-300 dark:border-gray-600 bg-gray-50 dark:bg-gray-700 rounded-lg px-4 py-2 text-gray-900 dark:text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 mb-2 text-sm" placeholder="Password" required>
        <div id="passwordError" class="hidden text-red-500 dark:text-red-400 text-xs mb-4 font-medium"></div>
        <input type="hidden" id="actionState">

        <div class="flex justify-end gap-3 mt-4">
            <button type="button" class="px-4 py-2 rounded-md bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 text-sm font-medium hover:bg-gray-200 dark:hover:bg-gray-600 transition" onclick="document.getElementById('authDialog').close()">Cancel</button>
            <button type="button" class="px-4 py-2 rounded-md bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium transition shadow-sm" onclick="submitToggle2Fa()">Confirm</button>
        </div>
    </div>
</dialog>

<!-- 4. Change Password Modal (Discord-style: Current, New, Confirm New) -->
<dialog id="changePasswordModal" class="rounded-xl shadow-2xl border border-indigo-200 dark:border-gray-600 bg-white dark:bg-gray-800 p-0 w-full max-w-sm backdrop:bg-gray-900/60 transition-all">
    <div class="p-6">
        <div class="flex items-center justify-between mb-4">
            <h3 class="text-lg font-bold text-gray-900 dark:text-white">Change Password</h3>
            <button type="button" onclick="closePasswordModal()" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-300">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
        </div>
        
        <form id="changePasswordForm" onsubmit="submitPasswordChange(event)" class="space-y-4">
            <div>
                <label class="block text-xs font-semibold text-gray-700 dark:text-gray-300 uppercase tracking-wider mb-1">Current Password</label>
                <input type="password" id="currentPassword" class="w-full border border-gray-300 dark:border-gray-600 bg-gray-50 dark:bg-gray-700 rounded-lg px-4 py-2 text-gray-900 dark:text-white focus:ring-2 focus:ring-indigo-500 text-sm" required />
            </div>
            
            <div class="pt-2 border-t border-gray-100 dark:border-gray-700">
                <label class="block text-xs font-semibold text-gray-700 dark:text-gray-300 uppercase tracking-wider mb-1">New Password</label>
                <input type="password" id="newPassword" class="w-full border border-gray-300 dark:border-gray-600 bg-gray-50 dark:bg-gray-700 rounded-lg px-4 py-2 text-gray-900 dark:text-white focus:ring-2 focus:ring-indigo-500 text-sm" required />
            </div>
            
            <div>
                <label class="block text-xs font-semibold text-gray-700 dark:text-gray-300 uppercase tracking-wider mb-1">Confirm New Password</label>
                <input type="password" id="confirmNewPassword" class="w-full border border-gray-300 dark:border-gray-600 bg-gray-50 dark:bg-gray-700 rounded-lg px-4 py-2 text-gray-900 dark:text-white focus:ring-2 focus:ring-indigo-500 text-sm" required />
            </div>

            <div id="changePasswordError" class="hidden text-red-500 dark:text-red-400 text-xs font-medium text-center bg-red-50 dark:bg-red-900/20 p-2 rounded"></div>

            <div class="flex justify-end gap-3 pt-4">
                <button type="button" class="px-4 py-2 rounded-md bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 text-sm font-medium hover:bg-gray-200 dark:hover:bg-gray-600 transition" onclick="closePasswordModal()">Cancel</button>
                <button type="submit" id="btnSubmitPassword" class="px-4 py-2 rounded-md bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-medium transition shadow-sm">Update Password</button>
            </div>
        </form>
    </div>
</dialog>

@section Scripts {
<script>
    // Extract CSRF token required for secure ASP.NET Core POST requests
    const __RequestVerificationToken = document.querySelector('input[name="__RequestVerificationToken"]').value;

    /* ==============================================================
     * EMAIL CONFIRMATION LOGIC (For initially unverified accounts)
     * ============================================================== */
    const confirmModal = document.getElementById('emailConfirmModal');
    const step1 = document.getElementById('step1');
    const step2 = document.getElementById('step2');
    const input = document.getElementById('emailCodeInput');
    const error = document.getElementById('emailError');

    /** Requests the server to generate and dispatch an OTP to the current unverified email */
    async function sendVerificationCode() {
        const btn = document.getElementById('sendBtn');
        btn.disabled = true;
        btn.innerHTML = "Sending...";

        const response = await fetch('/ApplicationUser/GenerateEmailConfirmationCode', { 
            method: 'POST',
            headers: { 'RequestVerificationToken': __RequestVerificationToken }
        });

        if (response.ok) {
            step1.classList.add('hidden');
            step2.classList.remove('hidden');
            input.focus();
        } else {
            btn.disabled = false;
            btn.innerHTML = "Send Code";
        }
    }

    /** Submits the user-provided OTP validating account ownership */
    async function verifyTheCode() {
        const codeValue = input.value;
        const response = await fetch(`/ApplicationUser/ConfirmEmailCode?code=${codeValue}`, {
            method: 'POST',
            headers: { 'RequestVerificationToken': __RequestVerificationToken }
        });

        if (response.ok) {
            window.location.reload();
        } else {
            error.classList.remove('hidden');
            input.value = '';
            input.focus();
        }
    }

    /** Purges modal visual state resolving rendering conflicts on subsequent opens */
    function closeAndResetModal() {
        confirmModal.close();
        step1.classList.remove('hidden');
        step2.classList.add('hidden');
        document.getElementById('sendBtn').disabled = false;
        document.getElementById('sendBtn').innerHTML = "Send Code";
        error.classList.add('hidden');
        input.value = '';
    }

    /* ==============================================================
     * CONDITIONAL EMAIL UPDATE LOGIC
     * ============================================================== */
    const isEmailConfirmed = @Model.IsEmailConfirmed.ToString().ToLower();
    
    const changeModal = document.getElementById('emailChangeModal');
    const changeStep1_Old = document.getElementById('changeStep1_Old');
    const changeStep2_Old = document.getElementById('changeStep2_Old');
    const changeStep3_New = document.getElementById('changeStep3_New');
    const changeStep4_New = document.getElementById('changeStep4_New');
    
    const oldCodeInput = document.getElementById('oldCodeInput');
    const oldEmailError = document.getElementById('oldEmailError');
    const newEmailInput = document.getElementById('newEmailInput');
    const newCodeInput = document.getElementById('newCodeInput');
    const newEmailError = document.getElementById('newEmailError');

    /** Phase 1: Dispatches an OTP to the currently verified address to ensure account authority */
    async function sendOldEmailCode() {
        const btn = document.getElementById('btnSendOld');
        btn.disabled = true; btn.innerHTML = "Sending...";

        const response = await fetch('/ApplicationUser/GenerateEmailConfirmationCode', { 
            method: 'POST',
            headers: { 'RequestVerificationToken': __RequestVerificationToken }
        });

        if (response.ok) {
            changeStep1_Old.classList.add('hidden');
            changeStep2_Old.classList.remove('hidden');
            oldCodeInput.focus();
        } else {
            btn.disabled = false; btn.innerHTML = "Send Code";
            alert("Failed to send verification code. Please try again.");
        }
    }

    /** Phase 2: Validates the legacy address OTP before unlocking new address formulation */
    async function verifyOldCode() {
        const codeValue = oldCodeInput.value;
        const response = await fetch(`/ApplicationUser/VerifyCurrentEmailOwnership?code=${codeValue}`, {
            method: 'POST',
            headers: { 'RequestVerificationToken': __RequestVerificationToken }
        });

        if (response.ok) {
            changeStep2_Old.classList.add('hidden');
            changeStep3_New.classList.remove('hidden'); 
            newEmailInput.focus();
        } else {
            oldEmailError.classList.remove('hidden');
            oldCodeInput.value = '';
            oldCodeInput.focus();
        }
    }

    /** Phase 3: Generates the target OTP verifying the new requested identity payload */
    async function sendNewEmailCode() {
        const targetEmail = newEmailInput.value;
        // Uses hex string evaluation \x40 circumventing ASP.NET Razor template engine syntax parsing errors
        if (!targetEmail || !targetEmail.includes('\x40')) return;

        const btn = document.getElementById('btnSendNew');
        btn.disabled = true; btn.innerHTML = "Sending...";

        try {
            const response = await fetch('/ApplicationUser/GenerateEmailChangeCode', {
                method: 'POST',
                headers: { 
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': __RequestVerificationToken 
                },
                body: JSON.stringify({ newEmail: targetEmail })
            });

            if (response.ok) {
                document.getElementById('displayNewEmail').innerText = targetEmail;
                changeStep3_New.classList.add('hidden');
                changeStep4_New.classList.remove('hidden');
                newCodeInput.focus();
            } else {
                throw new Error("Validation Failed");
            }
        } catch (e) {
            btn.disabled = false; btn.innerHTML = "Send Code";
            alert("Failed to send code. Ensure the email is valid and not already in use.");
        }
    }

    /** Phase 4: Submits the final token permanently rebinding the account identity matrix */
    async function verifyNewCode() {
        const codeValue = newCodeInput.value;
        const targetEmail = newEmailInput.value;

        const response = await fetch(`/ApplicationUser/ConfirmEmailChangeCode`, {
            method: 'POST',
            headers: { 
                'Content-Type': 'application/json',
                'RequestVerificationToken': __RequestVerificationToken 
            },
            body: JSON.stringify({ code: codeValue, newEmail: targetEmail })
        });

        if (response.ok) {
            window.location.reload();
        } else {
            newEmailError.classList.remove('hidden');
            newCodeInput.value = '';
            newCodeInput.focus();
        }
    }

    /** Clears email mutation states hiding localized context blocks */
    function closeAndResetChangeModal() {
        changeModal.close();
        
        if(changeStep1_Old) changeStep1_Old.classList.add('hidden');
        if(changeStep2_Old) changeStep2_Old.classList.add('hidden');
        changeStep3_New.classList.add('hidden');
        changeStep4_New.classList.add('hidden');
        
        if (isEmailConfirmed) {
            changeStep1_Old.classList.remove('hidden');
            document.getElementById('btnSendOld').disabled = false;
            document.getElementById('btnSendOld').innerHTML = "Send Code";
            if(oldCodeInput) oldCodeInput.value = '';
            if(oldEmailError) oldEmailError.classList.add('hidden');
        } else {
            changeStep3_New.classList.remove('hidden');
        }

        document.getElementById('btnSendNew').disabled = false;
        document.getElementById('btnSendNew').innerHTML = "Send Code";
        
        newEmailInput.value = '';
        newCodeInput.value = '';
        newEmailError.classList.add('hidden');
    }

    /* ==============================================================
     * TWO-FACTOR AUTHENTICATION TOGGLE LOGIC
     * ============================================================== */

    /**
     * Initializes the verification prompt requiring local password payload.
     * @@param {boolean} enable - Target boolean state configuring 2FA bindings.
     */
    function open2faModal(enable) {
        const dialog = document.getElementById('authDialog');
        document.getElementById('passwordError').style.display = 'none';
        document.getElementById('confirmPassword').value = '';
        document.getElementById('actionState').value = enable;
        dialog.showModal();
    }

    /** Submits identity authorization requesting 2FA security alterations */
    async function submitToggle2Fa() {
        const password = document.getElementById('confirmPassword').value;
        const enable = document.getElementById('actionState').value === 'true';
        const dialog = document.getElementById('authDialog');

        try {
            const response = await fetch('/ApplicationUser/Toggle2Fa', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': __RequestVerificationToken
                },
                body: JSON.stringify({ Password: password, Enable: enable })
            });

            const data = await response.json();

            if (response.ok) {
                dialog.close(); 
                window.location.reload(); 
            } else {
                const errorDiv = document.getElementById('passwordError');
                errorDiv.innerText = data.message || 'Error occurred authenticating password.';
                errorDiv.style.display = 'block';
            }
        } catch (error) {
            console.error('Fetch error:', error);
        }
    }

    /* ==============================================================
     * PASSWORD CHANGE LOGIC
     * ============================================================== */

    /** Clears form data removing residual password payloads from DOM rendering */
    function closePasswordModal() {
        document.getElementById('changePasswordModal').close();
        document.getElementById('changePasswordForm').reset();
        document.getElementById('changePasswordError').classList.add('hidden');
    }

    /** 
     * Transmits the 3-tier password structure utilizing Identity's integrated validation matrix.
     * Incorporates fast local checks preventing unnecessary network transmission latency.
     */
    async function submitPasswordChange(e) {
        e.preventDefault(); 
        
        const currentPassword = document.getElementById('currentPassword').value;
        const newPassword = document.getElementById('newPassword').value;
        const confirmNewPassword = document.getElementById('confirmNewPassword').value;
        const errorDiv = document.getElementById('changePasswordError');
        const btn = document.getElementById('btnSubmitPassword');

        // Execute local verification constraint
        if (newPassword !== confirmNewPassword) {
            errorDiv.innerText = "New passwords do not match!";
            errorDiv.classList.remove('hidden');
            return;
        }

        btn.disabled = true;
        btn.innerHTML = "Updating...";
        errorDiv.classList.add('hidden');

        try {
            const response = await fetch('/ApplicationUser/ChangePassword', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': __RequestVerificationToken
                },
                body: JSON.stringify({ 
                    CurrentPassword: currentPassword, 
                    NewPassword: newPassword, 
                    ConfirmPassword: confirmNewPassword 
                })
            });

            if (response.ok) {
                closePasswordModal();
                alert("Password updated successfully. A confirmation email has been sent.");
                window.location.reload();
            } else {
                const data = await response.json();
                errorDiv.innerText = data.message || "Failed to update password.";
                errorDiv.classList.remove('hidden');
            }
        } catch (error) {
            errorDiv.innerText = "Network error occurred. Please try again.";
            errorDiv.classList.remove('hidden');
        } finally {
            btn.disabled = false;
            btn.innerHTML = "Update Password";
        }
    }
</script>
}