@model IEnumerable<PtixiakiReservations.Models.ApplicationUser>

@{
    ViewData["Title"] = "Role Requests";

    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    string searchQuery = ViewBag.SearchQuery as string;
    int totalItems = ViewBag.TotalItems ?? 0;
}

<div class="max-w-7xl mx-auto py-8 px-4 sm:px-6 lg:px-8">
    
    <div class="flex flex-col md:flex-row md:items-center justify-between mb-8 gap-4">
        <div>
            <h1 class="text-3xl font-bold text-gray-900">Pending Role Requests</h1>
            <p class="text-sm text-gray-500 mt-1">Review and manage elevated permission requests.</p>
        </div>

        <form method="get" class="flex w-full md:w-auto relative">
            <div class="relative w-full md:w-80">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                    <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                    </svg>
                </div>
                <input type="text" name="searchQuery" value="@searchQuery" placeholder="Search applicants..." 
                       class="pl-10 pr-4 py-2 w-full border border-gray-300 rounded-l-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-colors" />
            </div>
            <button type="submit" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white font-medium rounded-r-lg transition-colors border border-indigo-600">
                Search
            </button>
            
            @if (!string.IsNullOrEmpty(searchQuery))
            {
                <a href="?" class="ml-2 px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 font-medium rounded-lg transition-colors border border-gray-300 flex items-center">
                    Clear
                </a>
            }
        </form>
    </div>

    <!-- Required for AJAX POST operations -->
    @Html.AntiForgeryToken()

    <div class="bg-white shadow overflow-hidden sm:rounded-xl mb-8 border border-gray-200">
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Applicant</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Role Requested</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Reason</th>
                        <th scope="col" class="px-6 py-3 text-center text-xs font-semibold text-gray-500 uppercase tracking-wider">Action</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var user in Model)
                        {
                            var pendingRequests = new List<(string RoleName, string BadgeColor, string FormRoleType, string Reason)>();

                            // CRITICAL FIX: The FormRoleType exactly matches the C# switch statement cases
                            if (user.VenueManagerRequestStatus == "Pending")
                                pendingRequests.Add(("Venue Manager", "text-blue-700 bg-blue-100 border-blue-200", "Venue", user.VenueManagerRequestReason));
                            
                            if (user.EventManagerRequestStatus == "Pending")
                                pendingRequests.Add(("Event Organizer", "text-green-700 bg-green-100 border-green-200", "Event", user.EventManagerRequestReason));
                            
                            if (user.SuperOrganizerRequestStatus == "Pending")
                                pendingRequests.Add(("Super Organizer", "text-purple-700 bg-purple-100 border-purple-200", "SuperOrganizer", user.SuperOrganizerRequestReason));

                            foreach (var req in pendingRequests)
                            {
                                string rowId = $"row-{user.Id}-{req.FormRoleType}";
                                string reasonId = $"reason-{user.Id}-{req.FormRoleType}";
                                string safeReason = string.IsNullOrWhiteSpace(req.Reason) ? "No reason provided." : req.Reason;

                                <tr id="@rowId" class="hover:bg-gray-50 transition-colors">
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <div class="text-sm font-bold text-gray-900">@user.FirstName @user.LastName</div>
                                        <div class="text-xs text-gray-500 mt-0.5">@user.Email</div>
                                    </td>
                                    
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <span class="px-3 py-1 inline-flex text-xs leading-5 font-bold rounded-full border @req.BadgeColor">
                                            @req.RoleName
                                        </span>
                                    </td>
                                    
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <button type="button" 
                                                onclick="toggleReasonRow('@reasonId', this)" 
                                                class="text-indigo-600 hover:text-indigo-900 text-sm font-medium underline focus:outline-none transition-colors">
                                            Read Reason
                                        </button>
                                    </td>
                                    
                                    <td class="px-6 py-4 whitespace-nowrap text-center">
                                        <div class="flex items-center justify-center space-x-2">
                                            <!-- Pointing explicitly to the Admin Controller to ensure perfect routing -->
                                            <button type="button" 
                                                    onclick="processRoleAction('@Url.Action("ApproveRoleRequest", "Admin")', '@user.Id', '@req.FormRoleType', '@rowId', '@reasonId', this)" 
                                                    class="text-white bg-green-600 hover:bg-green-700 px-4 py-2 rounded-md shadow-sm font-semibold text-xs transition-colors flex items-center">
                                                <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                                                Approve
                                            </button>
                                            
                                            <button type="button" 
                                                    onclick="processRoleAction('@Url.Action("RejectRoleRequest", "Admin")', '@user.Id', '@req.FormRoleType', '@rowId', '@reasonId', this)" 
                                                    class="text-white bg-red-600 hover:bg-red-700 px-4 py-2 rounded-md shadow-sm font-semibold text-xs transition-colors flex items-center">
                                                <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                                                Reject
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                                
                                <!-- Expandable Context Row -->
                                <tr id="@reasonId" class="hidden bg-indigo-50/30 border-b border-gray-100">
                                    <td colspan="4" class="px-6 py-4">
                                        <div class="text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">Applicant's Stated Reason:</div>
                                        <p class="text-sm text-gray-800 whitespace-pre-wrap leading-relaxed bg-white p-4 rounded-lg border border-gray-200 shadow-sm">@safeReason</p>
                                    </td>
                                </tr>
                            }
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="px-6 py-12 text-center text-gray-500">
                                <svg class="mx-auto h-12 w-12 text-gray-400 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                                <p class="text-lg font-medium text-gray-900">No Pending Requests</p>
                                <p class="text-sm mt-1">There are currently no role authorization requests matching your criteria.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (totalPages > 1)
        {
            <div class="bg-gray-50 px-6 py-4 border-t border-gray-200 flex flex-col sm:flex-row items-center justify-between gap-4">
                
                <div class="text-sm text-gray-700">
                    Showing page <span class="font-medium">@currentPage</span> of <span class="font-medium">@totalPages</span>
                    <span class="text-gray-400 mx-2">|</span>
                    Total Requests: <span class="font-medium">@totalItems</span>
                </div>

                <div class="flex items-center space-x-2">
                    
                    @if (currentPage > 1)
                    {
                        <a href="?pageNumber=@(currentPage - 1)&searchQuery=@searchQuery" 
                           class="px-4 py-2 border border-gray-300 rounded-md text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 transition-colors">
                            Previous
                        </a>
                    }
                    else
                    {
                        <button disabled class="px-4 py-2 border border-gray-200 rounded-md text-sm font-medium text-gray-400 bg-gray-50 cursor-not-allowed">
                            Previous
                        </button>
                    }

                    <div class="hidden md:flex space-x-1">
                        @for (int i = 1; i <= totalPages; i++)
                        {
                            if (i == 1 || i == totalPages || (i >= currentPage - 2 && i <= currentPage + 2))
                            {
                                <a href="?pageNumber=@i&searchQuery=@searchQuery"
                                   class="px-3 py-1.5 rounded-md text-sm font-medium transition-colors @(i == currentPage ? "bg-indigo-600 text-white border border-indigo-600" : "bg-white text-gray-700 border border-gray-300 hover:bg-gray-50")">
                                    @i
                                </a>
                            }
                            else if (i == currentPage - 3 || i == currentPage + 3)
                            {
                                <span class="px-2 py-1 text-gray-500">...</span>
                            }
                        }
                    </div>

                    @if (currentPage < totalPages)
                    {
                        <a href="?pageNumber=@(currentPage + 1)&searchQuery=@searchQuery" 
                           class="px-4 py-2 border border-gray-300 rounded-md text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 transition-colors">
                            Next
                        </a>
                    }
                    else
                    {
                        <button disabled class="px-4 py-2 border border-gray-200 rounded-md text-sm font-medium text-gray-400 bg-gray-50 cursor-not-allowed">
                            Next
                        </button>
                    }
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        /**
         * Toggles the visibility of the embedded rationale row.
         */
        function toggleReasonRow(reasonRowId, btnElement) {
            const row = document.getElementById(reasonRowId);
            if (row.classList.contains('hidden')) {
                row.classList.remove('hidden');
                btnElement.textContent = 'Hide Reason';
            } else {
                row.classList.add('hidden');
                btnElement.textContent = 'Read Reason';
            }
        }

        /**
         * Dispatches asynchronous request evaluation payloads.
         */
        async function processRoleAction(endpointUrl, userId, roleType, mainRowId, reasonRowId, buttonElement) {
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            const originalText = buttonElement.innerHTML;
            
            try {
                buttonElement.innerHTML = '<span class="inline-block animate-spin mr-1">↻</span> Processing...';
                buttonElement.disabled = true;

                const formData = new FormData();
                formData.append('userId', userId);
                formData.append('roleType', roleType);

                const response = await fetch(endpointUrl, {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': token
                    },
                    body: formData
                });

                if (response.ok) {
                    const mainRow = document.getElementById(mainRowId);
                    const reasonRow = document.getElementById(reasonRowId);
                    
                    if(mainRow) mainRow.remove();
                    if(reasonRow) reasonRow.remove();
                    
                    const tbody = document.querySelector('tbody');
                    if (tbody.querySelectorAll('tr').length === 0) {
                        location.reload(); 
                    }
                } else {
                    alert('Failed to process authorization action. Please try again.');
                    buttonElement.innerHTML = originalText;
                    buttonElement.disabled = false;
                }
            } catch (err) {
                console.error('Request mutation error:', err);
                alert('An application error occurred.');
                buttonElement.innerHTML = originalText;
                buttonElement.disabled = false;
            }
        }
    </script>
}