@model PtixiakiReservations.Models.Event

@{
    ViewData["Title"] = "Edit Event";
    var currentVenueName = "";
    
    // Resolves venue nomenclature.
    if (Model?.Venue != null)
    {
        currentVenueName = Model.Venue.Name + (Model.Venue.City != null ? ", " + Model.Venue.City.Name : "");
    }
    else if (ViewBag.VenueList is IEnumerable<SelectListItem> venueList && Model?.VenueId > 0)
    {
        var selectedVenue = venueList.FirstOrDefault(v => v.Value == Model.VenueId.ToString());
        if (selectedVenue != null) currentVenueName = selectedVenue.Text;
    }

    // Resolves inherited media properties.
    var displayImagePath = !string.IsNullOrEmpty(Model?.ImagePath) 
        ? Model.ImagePath 
        : Model?.ParentEvent?.ImagePath;
        
    var displayGallery = (Model?.GalleryImages != null && Model.GalleryImages.Any()) 
        ? Model.GalleryImages 
        : Model?.ParentEvent?.GalleryImages;
}

<div class="min-h-screen bg-gray-50/50 py-8 px-4 sm:px-6 lg:px-8 pb-32 sm:pb-12">
    <div class="max-w-4xl mx-auto">
        
        <!-- Header Configuration -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between mb-8 gap-4">
            <div>
                <nav class="flex text-sm text-gray-500 mb-2" aria-label="Breadcrumb">
                    <ol class="inline-flex items-center space-x-1 md:space-x-3">
                        <li class="inline-flex items-center">
                            <a href="@Url.Action("Index", "Events")" class="hover:text-indigo-600 transition-colors font-medium">Events Index</a>
                        </li>
                        <li>
                            <div class="flex items-center">
                                <svg class="w-4 h-4 text-gray-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" /></svg>
                                <span class="ml-1 text-gray-700 font-bold md:ml-2">Edit</span>
                            </div>
                        </li>
                    </ol>
                </nav>
                <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">Edit Configuration</h1>
                <p class="mt-1 text-gray-500 text-sm">Manage settings, scheduling, and media for <span class="font-bold text-gray-700">@Model?.Name</span></p>
            </div>
            <div class="hidden sm:block">
                <a href="@Url.Action("Index", "Events")" class="inline-flex items-center px-4 py-2 bg-white border border-gray-300 rounded-lg text-sm font-semibold text-gray-700 hover:bg-gray-50 transition-colors shadow-sm">
                    <svg class="h-4 w-4 mr-2 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
                    Back to List
                </a>
            </div>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="mb-8 p-4 bg-green-50 border border-green-200 rounded-xl shadow-sm flex items-center">
                <div class="flex-shrink-0 bg-green-100 p-2 rounded-full">
                    <svg class="h-5 w-5 text-green-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" /></svg>
                </div>
                <p class="ml-3 text-sm font-bold text-green-800">@TempData["SuccessMessage"]</p>
            </div>
        }

        <form method="post" id="editEventForm" enctype="multipart/form-data" class="space-y-8">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            
            <!-- General Information -->
            <div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden">
                <div class="px-6 py-5 border-b border-gray-100 bg-gray-50/30 flex items-center">
                    <div class="h-8 w-8 rounded-lg bg-indigo-50 border border-indigo-100 flex items-center justify-center mr-3">
                        <svg class="h-4 w-4 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    </div>
                    <h3 class="text-lg font-bold text-gray-900">General Information</h3>
                </div>
                
                <div class="p-6 space-y-6">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label asp-for="Name" class="block text-sm font-bold text-gray-700 mb-1.5">Event Name <span class="text-red-500">*</span></label>
                            <input asp-for="Name" class="w-full px-4 py-2.5 bg-gray-50 border border-gray-300 rounded-lg focus:bg-white focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all text-sm font-medium text-gray-900"/>
                            <span asp-validation-for="Name" class="text-red-500 text-xs mt-1.5 block font-medium"></span>
                        </div>

                        <div>
                            <label asp-for="EventTypeId" class="block text-sm font-bold text-gray-700 mb-1.5">Event Category <span class="text-red-500">*</span></label>
                            <select asp-for="EventTypeId" asp-items="ViewBag.EventTypeList" class="w-full px-4 py-2.5 bg-gray-50 border border-gray-300 rounded-lg focus:bg-white focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all text-sm font-medium text-gray-900 appearance-none"></select>
                            <span asp-validation-for="EventTypeId" class="text-red-500 text-xs mt-1.5 block font-medium"></span>
                        </div>
                    </div>

                    @if (Model?.ParentEventId == null)
                    {
                        <div>
                            <label asp-for="Description" class="block text-sm font-bold text-gray-700 mb-1.5">Detailed Description</label>
                            <textarea asp-for="Description" rows="5" class="w-full px-4 py-3 bg-gray-50 border border-gray-300 rounded-lg focus:bg-white focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all text-sm text-gray-900 leading-relaxed"></textarea>
                            <span asp-validation-for="Description" class="text-red-500 text-xs mt-1.5 block font-medium"></span>
                        </div>
                    }

                    <div>
                        <label asp-for="TicketPrice" class="block text-sm font-bold text-gray-700 mb-1.5">Ticket Price</label>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                <span class="text-gray-500 sm:text-sm">€</span>
                            </div>
                            <input asp-for="TicketPrice" type="number" step="0.01" min="0" placeholder="0.00" class="w-full pl-8 px-4 py-2.5 bg-gray-50 border border-gray-300 rounded-lg focus:bg-white focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all text-sm font-medium text-gray-900" />
                        </div>
                        <p class="text-xs text-gray-500 mt-1.5 font-bold uppercase tracking-wider">Leave blank or set to 0 for free admission.</p>
                        <span asp-validation-for="TicketPrice" class="text-red-500 text-xs mt-1.5 block font-medium"></span>
                    </div>
                </div>
            </div>

            <!-- Location Parameters -->
            <div class="bg-white rounded-2xl shadow-sm border border-gray-200">
                <div class="px-6 py-5 border-b border-gray-100 bg-gray-50/30 flex items-center">
                    <div class="h-8 w-8 rounded-lg bg-emerald-50 border border-emerald-100 flex items-center justify-center mr-3">
                        <svg class="h-4 w-4 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                    </div>
                    <h3 class="text-lg font-bold text-gray-900">Location Details</h3>
                </div>
                
                <div class="p-6 grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label class="block text-sm font-bold text-gray-700 mb-1.5">Assigned Venue <span class="text-red-500">*</span></label>
                        <div class="relative">
                            <input type="hidden" asp-for="VenueId" id="VenueId" />
                            <div class="flex gap-2 w-full">
                                <input type="text" id="venueSearch" 
                                    class="w-full px-4 py-2.5 bg-gray-50 border border-gray-300 rounded-lg disabled:opacity-60 focus:bg-white focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition-all text-sm font-medium" 
                                    placeholder="Search venue database..." autocomplete="off" value="@currentVenueName" />
                                <button class="px-4 py-2 bg-gray-100 hover:bg-gray-200 border border-gray-200 rounded-lg text-sm font-bold text-gray-600 hidden transition-colors" type="button" id="clearVenueSelection">Clear</button>
                            </div>
                            <ul id="venueSearchResults" class="absolute w-full bg-white border border-gray-200 rounded-xl shadow-2xl z-[100] hidden max-h-60 overflow-y-auto mt-2 divide-y divide-gray-50"></ul>
                        </div>
                        <span asp-validation-for="VenueId" class="text-red-500 text-xs mt-1.5 block font-medium"></span>
                    </div>

                    <div>
                        <label asp-for="LayoutId" class="block text-sm font-bold text-gray-700 mb-1.5">Active Floorplan <span class="text-red-500">*</span></label>
                        <select asp-for="LayoutId" asp-items="ViewBag.LayoutList" id="LayoutId"
                                class="w-full px-4 py-2.5 bg-gray-50 border border-gray-300 rounded-lg focus:bg-white focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition-all text-sm font-medium disabled:opacity-60 appearance-none">
                            <option value="">Select a Layout</option>
                        </select>
                        <span asp-validation-for="LayoutId" class="text-red-500 text-xs mt-1.5 block font-medium"></span>
                    </div>
                </div>
            </div>

            <!-- Media Configuration -->
            <div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden">
                <div class="px-6 py-5 border-b border-gray-100 bg-gray-50/30 flex items-center justify-center text-center">
                    <div class="h-8 w-8 rounded-lg bg-pink-50 border border-pink-100 flex items-center justify-center mr-3">
                        <svg class="h-4 w-4 text-pink-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                    </div>
                    <h3 class="text-lg font-bold text-gray-900">Media Assets</h3>
                </div>
                
                <div class="p-6 space-y-10 max-w-2xl mx-auto">
                    <div class="flex flex-col items-center text-center">
                        <label class="block text-sm font-bold text-gray-700 mb-3 border-b border-gray-100 pb-2 w-full">Main Event Banner</label>
                        
                        @if (!string.IsNullOrEmpty(displayImagePath))
                        {
                            <div class="mb-4">
                                <p class="text-[10px] font-bold text-gray-400 uppercase tracking-wider mb-2">Current Poster</p>
                                <img src="@(displayImagePath.EndsWith(".webp") ? displayImagePath : $"/Events/GetCompressedImage?path={displayImagePath}&width=400")" 
                                     class="w-full max-w-xs h-48 object-cover rounded-lg shadow-sm border border-gray-200 mx-auto" alt="Current Poster" />
                            </div>
                        }

                        <div class="w-full max-w-md flex justify-center px-6 py-6 border-2 border-gray-300 border-dashed rounded-xl bg-gray-50 hover:bg-gray-100 transition-colors mx-auto">
                            <div class="text-center">
                                <label for="imageFile" class="cursor-pointer font-bold text-indigo-600 hover:text-indigo-500">
                                    <span>Select new image</span>
                                    <input id="imageFile" name="imageFile" type="file" class="sr-only" accept="image/*" onchange="previewImage(this)">
                                </label>
                                <p id="childImageNote" class="text-gray-400 text-[11px] mt-1 uppercase tracking-wider">Leave empty to keep existing</p>
                            </div>
                        </div>
                        <div id="imagePreviewContainer" class="hidden mt-4 w-full max-w-md mx-auto">
                            <p class="text-[10px] font-bold text-pink-500 uppercase tracking-wider mb-2">New Upload Preview</p>
                            <img id="imagePreview" src="#" class="w-full h-48 object-cover rounded-lg shadow-sm border border-gray-200 mx-auto">
                        </div>
                    </div>

                    <div class="flex flex-col items-center text-center">
                        <label class="block text-sm font-bold text-gray-700 mb-3 border-b border-gray-100 pb-2 w-full">Gallery Icons / Collection</label>
                        
                        @if (displayGallery != null && displayGallery.Any())
                        {
                            <div class="mb-4 w-full">
                                <p class="text-[10px] font-bold text-gray-400 uppercase tracking-wider mb-2">Current Gallery Collection</p>
                                <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 justify-center">
                                    @foreach(var img in displayGallery)
                                    {
                                        <img src="@(img.ImagePath.EndsWith(".webp") ? img.ImagePath : $"/Events/GetCompressedImage?path={img.ImagePath}&width=300")" 
                                             class="w-full h-24 object-cover rounded shadow-sm border border-gray-200" alt="Gallery Image" />
                                    }
                                </div>
                            </div>
                        }

                        <div class="w-full max-w-md flex justify-center px-6 py-6 border-2 border-gray-300 border-dashed rounded-xl bg-gray-50 hover:bg-gray-100 transition-colors mx-auto">
                            <div class="text-center">
                                <label for="galleryFiles" class="cursor-pointer font-bold text-indigo-600 hover:text-indigo-500">
                                    <span>Select multiple files</span>
                                    <input id="galleryFiles" name="galleryFiles" type="file" multiple class="sr-only" accept="image/*" onchange="previewGallery(this)">
                                </label>
                                <p class="text-gray-400 text-[11px] mt-1 uppercase tracking-wider">Uploading adds to existing collection</p>
                            </div>
                        </div>
                        <div id="galleryPreviewContainer" class="hidden mt-4 w-full grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3 justify-center"></div>
                    </div>
                </div>
            </div>

            <!-- Scheduling Parameters -->
            <div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden">
                <div class="px-6 py-5 border-b border-gray-100 bg-gray-50/30 flex items-center">
                    <div class="h-8 w-8 rounded-lg bg-orange-50 border border-orange-100 flex items-center justify-center mr-3">
                        <svg class="h-4 w-4 text-orange-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                    </div>
                    <h3 class="text-lg font-bold text-gray-900">Scheduling</h3>
                </div>
                
                <div class="p-6 grid grid-cols-1 sm:grid-cols-2 gap-6">
                    <div>
                        <label asp-for="StartDateTime" class="block text-sm font-bold text-gray-700 mb-1.5">Start Date & Time</label>
                        <input asp-for="StartDateTime" type="datetime-local" class="w-full px-4 py-2.5 bg-gray-50 border border-gray-300 rounded-lg focus:bg-white focus:ring-2 focus:ring-orange-500 focus:border-orange-500 transition-all text-sm font-bold text-gray-900" value="@(Model?.StartDateTime.ToString("yyyy-MM-ddTHH:mm"))"/>
                        <span asp-validation-for="StartDateTime" class="text-red-500 text-xs mt-1.5 block font-medium"></span>
                    </div>

                    <div>
                        <label asp-for="EndTime" class="block text-sm font-bold text-gray-700 mb-1.5">End Date & Time</label>
                        <input asp-for="EndTime" type="datetime-local" class="w-full px-4 py-2.5 bg-gray-50 border border-gray-300 rounded-lg focus:bg-white focus:ring-2 focus:ring-orange-500 focus:border-orange-500 transition-all text-sm font-bold text-gray-900" value="@(Model?.EndTime.ToString("yyyy-MM-ddTHH:mm"))"/>
                        <span asp-validation-for="EndTime" class="text-red-500 text-xs mt-1.5 block font-medium"></span>
                    </div>
                </div>
            </div>

            <!-- Form Actions -->
            <div class="fixed bottom-0 left-0 w-full bg-white border-t border-gray-200 p-4 shadow-[0_-4px_6px_-1px_rgba(0,0,0,0.05)] z-50 sm:static sm:bg-transparent sm:border-0 sm:p-0 sm:shadow-none sm:col-span-12 sm:flex sm:justify-end sm:gap-3 sm:mt-4">
                <a href="@Url.Action("Index", "Events")"
                   class="hidden sm:inline-flex justify-center px-6 py-2.5 bg-white border border-gray-300 rounded-xl text-sm font-bold text-gray-700 hover:bg-gray-50 shadow-sm transition-colors">
                    Cancel
                </a>
                <button type="submit" class="w-full sm:w-auto flex justify-center items-center px-8 py-3 sm:py-2.5 bg-indigo-600 text-white text-sm sm:text-base font-bold rounded-xl shadow-md hover:bg-indigo-700 focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-all">
                    <svg class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4"/></svg>
                    Save Changes
                </button>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const venueHiddenInput = document.getElementById('VenueId');
            const venueSearch = document.getElementById('venueSearch');
            const venueResultsList = document.getElementById('venueSearchResults');
            const clearVenueBtn = document.getElementById('clearVenueSelection');
            const layoutSelect = document.getElementById('LayoutId');
            
            venueSearch.addEventListener('input', function(e) {
                if (e.target.value.length < 2) { 
                    venueResultsList.classList.add('hidden'); 
                    return; 
                }
                
                fetch(`/Events/SearchVenues?query=${encodeURIComponent(e.target.value)}`)
                    .then(res => res.json())
                    .then(data => {
                        venueResultsList.innerHTML = '';
                        data.forEach(v => {
                            const li = document.createElement('li');
                            li.className = 'px-5 py-3 hover:bg-indigo-50 cursor-pointer text-sm transition-colors border-b border-gray-50 last:border-0';
                            li.innerHTML = `<span class="font-bold text-gray-900 block">${v.name}</span><span class="text-xs text-gray-500 block mt-0.5">${v.city || ''}</span>`;
                            li.onclick = () => {
                                venueHiddenInput.value = v.id;
                                venueSearch.value = v.name + (v.city ? ', ' + v.city : '');
                                venueSearch.disabled = true;
                                clearVenueBtn.classList.remove('hidden');
                                venueResultsList.classList.add('hidden');
                                fetchLayouts(v.id);
                            };
                            venueResultsList.appendChild(li);
                        });
                        venueResultsList.classList.remove('hidden');
                    })
                    .catch(error => console.error('Error searching venues:', error));
            });

            document.addEventListener('click', function(e) {
                if (!venueSearch.contains(e.target) && !venueResultsList.contains(e.target)) {
                    venueResultsList.classList.add('hidden');
                }
            });

            clearVenueBtn.onclick = () => {
                venueHiddenInput.value = '';
                venueSearch.value = '';
                venueSearch.disabled = false;
                clearVenueBtn.classList.add('hidden');
                layoutSelect.innerHTML = '<option value="">Select a Layout</option>';
                venueSearch.focus();
            };

            function fetchLayouts(venueId, preselectId = null) {
                if (!venueId) {
                    layoutSelect.innerHTML = '<option value="">Select a Layout</option>';
                    return;
                }
                
                layoutSelect.disabled = true;
                layoutSelect.innerHTML = '<option value="">Loading Layouts...</option>';
                
                fetch(`/Events/GetLayouts?venueId=${venueId}`)
                    .then(response => response.json())
                    .then(data => {
                        layoutSelect.innerHTML = '<option value="">Select a Layout</option>';
                        data.forEach(layout => {
                            const option = document.createElement('option');
                            option.value = layout.id;
                            option.textContent = layout.areaName;
                            
                            if (preselectId && layout.id.toString() === preselectId.toString()) {
                                option.selected = true;
                            }
                            
                            layoutSelect.appendChild(option);
                        });
                        layoutSelect.disabled = false;
                    })
                    .catch(error => {
                        console.error('Error fetching layouts:', error);
                        layoutSelect.innerHTML = '<option value="">Error loading Layouts</option>';
                        layoutSelect.disabled = false;
                    });
            }
            
            if (venueHiddenInput.value) {
                venueSearch.disabled = true;
                clearVenueBtn.classList.remove('hidden');
                const currentLayoutId = '@(Model?.LayoutId)';
                fetchLayouts(venueHiddenInput.value, currentLayoutId);
            }
            
            venueSearch.addEventListener('keypress', function(e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                }
            });
        });

        function previewImage(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = e => { 
                    document.getElementById('imagePreview').src = e.target.result;
                    document.getElementById('imagePreviewContainer').classList.remove('hidden');
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        function previewGallery(input) {
            const container = document.getElementById('galleryPreviewContainer');
            container.innerHTML = ''; 

            if (input.files && input.files.length > 0) {
                container.classList.remove('hidden');
                Array.from(input.files).forEach(file => {
                    const reader = new FileReader();
                    reader.onload = e => {
                        const img = document.createElement('img');
                        img.src = e.target.result;
                        img.className = 'h-24 w-full object-cover rounded shadow-sm border border-gray-200';
                        container.appendChild(img);
                    };
                    reader.readAsDataURL(file);
                });
            } else {
                container.classList.add('hidden');
            }
        }
    </script>
}