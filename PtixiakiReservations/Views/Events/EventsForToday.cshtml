@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@model IEnumerable<PtixiakiReservations.Models.Event>

@{
    ViewData["Title"] = "Events";
    var currentUser = SignInManager.IsSignedIn(User) ? await UserManager.GetUserAsync(User) : null;
    var userRoles = currentUser != null ? await UserManager.GetRolesAsync(currentUser) : new List<string>();
    
    /** 
     * Authorization parameters establishing boolean visibility states 
     * for administrative and organizational DOM elements.
     */
    var isAdmin = userRoles.Contains("Admin");
    var isSuper = userRoles.Contains("SuperOrganizer");
    var isEventManager = userRoles.Contains("Event");
}

<!-- 
  =======================================================================
  STYLESHEET: V3 Color Space Mapping & Functional Component Rules
  =======================================================================
-->
<style>
    :root {
        /* Preserves explicit hexadecimal color definitions matching established UI guidelines */
        --color-blue-50: #eff6ff;
        --color-blue-100: #dbeafe;
        --color-blue-300: #93c5fd; 
        --color-blue-400: #60a5fa; 
        --color-blue-500: #3b82f6;
        --color-blue-600: #2563eb;
        --color-blue-700: #1d4ed8;
        --color-indigo-600: #4f46e5;
        --color-indigo-700: #4338ca;
        --color-gray-50: #f9fafb;
        --color-gray-100: #f3f4f6;
        --color-gray-200: #e5e7eb;
        --color-gray-300: #d1d5db;
        --color-gray-400: #9ca3af;
        --color-gray-500: #6b7280;
        --color-gray-600: #4b5563;
        --color-gray-700: #374151;
        --color-gray-800: #1f2937;
        --color-gray-900: #111827;
    }

    /** 
     * Tooltip Interface
     * Generates a floating z-indexed container for aggregated string metadata.
     */
    .tooltip-container { position: relative; display: inline-block; cursor: help; }
    .tooltip-text {
        visibility: hidden; opacity: 0; background-color: #1f2937; color: #fff;
        text-align: center; padding: 8px 12px; border-radius: 6px; font-weight: normal;
        width: max-content; max-width: 200px; position: absolute; z-index: 50;
        bottom: 130%; left: 50%; transform: translateX(-50%);
        transition: opacity 0.2s ease, visibility 0.2s ease; font-size: 0.75rem;
    }
    .tooltip-text::after {
        content: ""; position: absolute; top: 100%; left: 50%; margin-left: -6px;
        border-width: 6px; border-style: solid; border-color: #1f2937 transparent transparent transparent;
    }
    .tooltip-container:hover .tooltip-text,
    .tooltip-container2:hover .tooltip-text { visibility: visible; opacity: 1; }

    /** 
     * Event Card Structural Grid
     * Enforces responsive flex-column behavior with an established visual boundary thickness.
     */
    .event-card {
        position: relative;
        display: flex;
        flex-direction: column; 
        height: 100%;          
        transition: all 0.3s ease;
        z-index: 1;
        min-height: 300px; 
        background-color: white;
        border-radius: 0.75rem;
        border-top: 6px solid var(--color-blue-400); 
    }
    
    .event-card:hover {
        transform: scale(1.02) translate(0px, -5px); 
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
        z-index: 10;
    }
    
    .event-content { flex-grow: 1; display: flex; flex-direction: column; }
    .event-footer { margin-top: auto; }
    
    /** Temporal specific overlay states */
    .event-today:hover { box-shadow: 0 10px 15px -3px rgba(16, 185, 129, 0.15), 0 4px 6px -2px rgba(16, 185, 129, 0.05); }
    .event-upcoming:hover { box-shadow: 0 10px 15px -3px rgba(96, 165, 250, 0.15), 0 4px 6px -2px rgba(96, 165, 250, 0.05); }
    .event-past { background-color: #f8fafc; opacity: 0.85; border-top-color: var(--color-gray-400); }
    .event-past:hover { box-shadow: 0 10px 15px -3px rgba(148, 163, 184, 0.15), 0 4px 6px -2px rgba(148, 163, 184, 0.05); }

    /** 
     * Autocomplete Dropdown
     * Maintains absolute z-index prioritization over adjacent inputs.
     */
    #autocomplete-dropdown { box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1); border-radius: 0.75rem; border: 1px solid #e5e7eb; }
    .autocomplete-item { padding: 0.75rem 1.25rem; cursor: pointer; transition: background-color 0.2s ease; }
    .autocomplete-item:hover, .autocomplete-item.active { background-color: #f3f4f6; }
    .highlight { font-weight: 700; color: #3b82f6; }

    /** 
     * Wishlist Action Badge
     * Restricts visual load on desktop viewports by binding visibility to parent hover execution.
     */
    .wishlist-badge { visibility: visible; opacity: 1; transition: all 0.2s ease; }
    @@media (min-width: 1024px) {
        .wishlist-badge { visibility: hidden; opacity: 0; }
        .event-card:hover .wishlist-badge { visibility: visible; opacity: 1; }
    }
</style>

<!-- 
  =======================================================================
  MAIN LAYOUT DOM ARCHITECTURE
  =======================================================================
-->
<div class="w-full bg-gray-50 min-h-screen pb-12">
    @Html.AntiForgeryToken()
    
    <!-- Application Global Navigation Header -->
    <div class="w-full bg-gradient-to-r from-blue-700 to-indigo-800 shadow-md">
        <div class="max-w-7xl mx-auto px-4 py-6 sm:px-6 lg:px-8">
            <h1 class="text-3xl font-extrabold text-white tracking-tight">Discover Events</h1>
            <p class="text-blue-100 mt-1">Find experiences tailored just for you.</p>
        </div>
    </div>
    
    <!-- Hero Section: Featured dual-slide carousel -->
    <div class="hidden sm:block w-full pb-2 mt-5">
        <div class="relative w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="relative w-full overflow-hidden rounded-2xl shadow-lg" style="height: 20rem;">
                <div id="dual-hero-track" class="flex h-full gap-6 transition-transform duration-1000 ease-in-out" style="transform: translateX(0);">
                    <!-- Dynamic slides injected via asynchronous event fetching -->
                </div>
            </div>
        </div>
    </div>

    <!-- Advanced Search & Filtering Interface -->
    <div class="relative z-40 w-full max-w-5xl mx-auto px-4 mt-6 sm:-mt-12 mb-12">
        <div class="bg-white rounded-2xl shadow-[0_8px_30px_rgb(0,0,0,0.06)] w-full border border-gray-200">
            
            <div class="bg-gray-50 border-b border-gray-200 px-6 py-4 flex flex-row items-center justify-between rounded-t-2xl">
                <h3 class="text-lg font-bold text-gray-800 tracking-tight flex items-center gap-2">
                    <svg class="w-5 h-5 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
                    Search Criteria
                </h3>
                <button id="panel-button" class="text-gray-400 hover:text-gray-700 focus:outline-none transition-colors">
                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
                </button>
            </div>

            <div id="panel-body" class="p-6">
                <div class="flex flex-col md:flex-row gap-5 mb-5">
                    
                    <div class="w-full md:w-1/2 relative">
                        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none">
                            <svg class="h-5 w-5 text-gray-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
                        </div>
                        <input type="text" id="search-term" placeholder="Event name, venue, or city..." class="block w-full pl-11 pr-4 py-3 bg-white border border-gray-300 rounded-xl shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors text-sm font-medium" autocomplete="off">
                        <div id="autocomplete-dropdown" class="absolute left-0 top-full mt-2 z-50 bg-white shadow-2xl rounded-xl border border-gray-100 hidden max-h-60 overflow-y-auto w-full"></div>
                    </div>

                    <div class="w-full md:w-1/4 relative">
                        <select id="event-type" class="w-full appearance-none bg-white border border-gray-300 rounded-xl shadow-sm py-3 px-4 pr-10 text-sm font-medium focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors cursor-pointer">
                            <option value="">All Categories</option>
                        </select>
                        <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-4 text-gray-400">
                            <svg class="fill-current h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20"><path d="M9.293 12.95l.707.707L15.657 8l-1.414-1.414L10 10.828 5.757 6.586 4.343 8z" /></svg>
                        </div>
                    </div>

                    <div class="w-full md:w-1/4 relative">
                        <input type="text" id="date-range" placeholder="Select Dates" class="w-full bg-white border border-gray-300 rounded-xl shadow-sm py-3 px-4 text-sm font-medium focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors cursor-pointer">
                        <button id="reset-date" type="button" class="absolute right-3 top-1/2 transform -translate-y-1/2 text-gray-400 hover:text-gray-600 transition-colors bg-white pl-2">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" /></svg>
                        </button>
                    </div>
                </div>

                <div class="flex flex-col sm:flex-row justify-between items-center pt-2 border-t border-gray-100 mt-4">
                    <div class="flex items-center gap-2 mb-4 sm:mb-0">
                        <input type="checkbox" id="archived-filter" class="w-4 h-4 text-blue-600 bg-white border-gray-300 rounded focus:ring-blue-500 cursor-pointer" />
                        <label for="archived-filter" class="text-sm font-medium text-gray-600 cursor-pointer select-none">Include Archived Events</label>
                    </div>
                    
                    <div class="flex items-center gap-4 w-full sm:w-auto">
                        <p id="search-validation-message" class="text-red-500 text-xs font-medium hidden">Please fill at least one field</p>
                        <button id="search-button" class="w-full sm:w-auto px-8 py-3 bg-blue-600 text-white font-bold rounded-xl shadow-md hover:bg-blue-700 hover:shadow-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 transition-all">
                            <span class="flex items-center justify-center">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
                                Search Now
                            </span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 
      =======================================================================
      DYNAMIC EVENT RESULTS GRID
      =======================================================================
    -->
    <div class="w-full px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">

        <!-- Result Evaluation Headers and Configuration Limiters -->
        <div id="events-count" class="flex flex-col sm:flex-row items-start sm:items-center justify-between mb-8 gap-4">
            <h2 class="text-2xl font-extrabold text-gray-900 tracking-tight">
                Results <span class="text-blue-600 font-bold ml-2 bg-blue-50 px-3 py-1 rounded-full text-lg" id="filtered-count">0</span>
            </h2>
            <div class="flex items-center gap-3 w-full sm:w-auto">
                <div class="relative w-full sm:w-auto"> 
                    <select id="variable-view" class="appearance-none bg-white border border-gray-300 rounded-xl py-2.5 px-4 pr-10 text-sm font-medium focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors w-full sm:w-48 shadow-sm cursor-pointer">
                        <option value="asc" selected>Sort by Date: Asc</option>
                        <option value="desc">Sort by Date: Desc</option>
                    </select>
                    <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-3 text-gray-400">
                        <svg class="fill-current h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20"><path d="M9.293 12.95l.707.707L15.657 8l-1.414-1.414L10 10.828 5.757 6.586 4.343 8z" /></svg>
                    </div>
                </div>
                <div class="relative w-full sm:w-auto"> 
                    <select id="variable-pagination" class="appearance-none bg-white border border-gray-300 rounded-xl py-2.5 px-4 pr-10 text-sm font-medium focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors w-full sm:w-36 shadow-sm cursor-pointer">
                        <option value="12" selected>12 per page</option>
                        <option value="24">24 per page</option>
                        <option value="48">48 per page</option>
                    </select>
                    <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-3 text-gray-400">
                        <svg class="fill-current h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20"><path d="M9.293 12.95l.707.707L15.657 8l-1.414-1.414L10 10.828 5.757 6.586 4.343 8z" /></svg>
                    </div>
                </div>
            </div>
        </div>

        <!-- Render Target for Generated DOM Iterations -->
        <div id="events-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 py-4"></div>

        <!-- System Latency Loading Visualization -->
        <div id="loading-indicator" class="text-center py-20 hidden">
            <div class="inline-block h-12 w-12 rounded-full border-4 border-gray-200 border-t-blue-600 animate-spin"></div>
            <p class="mt-4 text-lg font-medium text-gray-500">Discovering events...</p>
        </div>

        <!-- Empty Query Handling View -->
        <div id="no-results" class="hidden text-center py-20 bg-white rounded-3xl shadow-sm border border-gray-100">
            <div class="max-w-md mx-auto">
                <div class="bg-gray-50 w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-4">
                    <svg class="h-10 w-10 text-gray-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
                <h3 class="text-xl font-bold text-gray-900">No events found</h3>
                <p class="mt-2 text-gray-500 font-medium">Try adjusting your filters or search criteria.</p>
                <button id="reset-search" class="mt-6 px-6 py-2.5 bg-gray-900 text-white rounded-xl font-semibold hover:bg-gray-800 transition-colors shadow-md">
                    Clear Filters
                </button>
            </div>
        </div>

        <!-- Component Iteration Pagination Link Structures -->
        <div class="mt-12 flex justify-center pb-12">
            <nav id="pagination" class="relative z-0 inline-flex rounded-md shadow-sm -space-x-px @(ViewBag.TotalPages > 1 ? "" : "hidden")" aria-label="Pagination">
                <button id="prev-page" class="pagination-prev relative inline-flex items-center px-4 py-2 rounded-l-md border border-gray-300 bg-white text-sm font-medium text-gray-700 hover:bg-gray-50 transition-colors disabled:opacity-50 disabled:cursor-not-allowed">
                    <svg class="h-5 w-5 mr-1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                        <path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd" />
                    </svg>
                    Previous
                </button>

                <div id="page-numbers" class="flex flex-wrap justify-center"></div>

                <button id="next-page" class="pagination-next relative inline-flex items-center px-4 py-2 rounded-r-md border border-gray-300 bg-white text-sm font-medium text-gray-700 hover:bg-gray-50 transition-colors disabled:opacity-50 disabled:cursor-not-allowed">
                    Next
                    <svg class="h-5 w-5 ml-1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                        <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
                    </svg>
                </button>
            </nav>
        </div>
    </div>
</div>

@section Scripts {
    <!-- 
      =======================================================================
      JAVASCRIPT: Logic Controllers & Async Evaluation Cycles
      =======================================================================
    -->
    <script>
        $(document).ready(function () {
            /** Maintains operational scope references globally scoped to user initialization */
            const currentUserId = '@UserManager.GetUserId(User)';
            let currentPage = 1;
            let pageSize = 12;
            let sortOrder = 'asc';
            
            let totalRecords = @(ViewBag.TotalMasterEvents ?? 0);
            let totalPages = Math.max(1, Math.ceil(totalRecords / pageSize));
            
            let searchParams = {};
            let dateRangePicker;
            let autocompleteTimeout;
            let autocompleteResults = [];
            let currentAutocompleteIndex = -1;
            let maxAutocompleteResults = 8;

            /**
             * Initializes the Flatpickr framework binding it to specific internal DOM elements.
             */
            dateRangePicker = flatpickr("#date-range", {
                mode: "range",
                dateFormat: "Y-m-d",
                altInput: true,
                altFormat: "d/m/Y",
                conjunction: " to ",
                minDate: "today",
                onChange: function(selectedDates) {
                    validateSearch();
                }
            });

            $('#filtered-count').text(totalRecords);
            updatePagination(totalPages > 1);

            $('#reset-date').click(function() {
                dateRangePicker.clear();
                validateSearch();
            });

            $('#reset-search').click(function() {
                $('#event-type').val('');
                dateRangePicker.clear();
                $('#search-term').val('');
                validateSearch();
                window.location.href = '@Url.Action("EventsForToday", "Events")';
            });

            // Hydrates select inputs with JSON records upon DOM initialization
            loadEventTypes();

            $('#events-container').addClass('hidden');
            $('#loading-indicator').removeClass('hidden');
            performSearch();

            /**
             * Implements debounce limiters terminating consecutive duplicate search requests
             */
            $('#search-term').on('input', function() {
                const query = $(this).val().trim();
                if (autocompleteTimeout) clearTimeout(autocompleteTimeout);

                if (query.length < 1) {
                    $('#autocomplete-dropdown').addClass('hidden').empty();
                    return;
                }

                autocompleteTimeout = setTimeout(function() {
                    fetchAutocompleteResults(query);
                }, 300);

                validateSearch();
            });

            $('#variable-view').on('change', function() {
                sortOrder = $(this).val();
                currentPage = 1;
                $('#events-container').addClass('hidden');
                $('#loading-indicator').removeClass('hidden');
                performSearch();
            });

            /**
             * Manages logical overrides for keyboard execution paths targeting specific DOM index locations.
             */
            $('#search-term').on('keydown', function(e) {
                const dropdown = $('#autocomplete-dropdown');
                const isVisible = !dropdown.hasClass('hidden');

                if (!isVisible) return;

                if (e.keyCode === 40) { 
                    e.preventDefault();
                    navigateAutocomplete(1);
                } else if (e.keyCode === 38) { 
                    e.preventDefault();
                    navigateAutocomplete(-1);
                } else if (e.keyCode === 13 && currentAutocompleteIndex >= 0) { 
                    e.preventDefault();
                    selectAutocompleteItem(currentAutocompleteIndex);
                } else if (e.keyCode === 27) { 
                    dropdown.addClass('hidden');
                    currentAutocompleteIndex = -1;
                }
            });

            $(document).on('click', function(e) {
                if (!$(e.target).closest('#search-term, #autocomplete-dropdown').length) {
                    $('#autocomplete-dropdown').addClass('hidden');
                }
            });

            function loadEventTypes() {
                $.getJSON('/Events/GetEventTypes')
                    .done(function(data) {
                        const dropdown = $('#event-type');
                        $.each(data, function(i, item) {
                            dropdown.append($('<option>', {
                                value: item.id,
                                text: item.name
                            }));
                        });
                    })
                    .fail(function(error) {
                        console.error('Failed to load event types:', error);
                    });
            }

            /**
             * Processes Ajax callbacks parsing backend object values for local DOM hydration.
             * Utilizes functional mockup generations mitigating runtime faults.
             */
            function fetchAutocompleteResults(query) {
                $.ajax({
                    url: '/Events/GetAutocompleteResults',
                    data: { query: query },
                    success: function(data) {
                        displayAutocompleteResults(data, query);
                    },
                    error: function() {
                        const mockResults = getMockAutocompleteResults(query);
                        displayAutocompleteResults(mockResults, query);
                    }
                });
            }

            function displayAutocompleteResults(results, query) {
                const dropdown = $('#autocomplete-dropdown');
                dropdown.empty();

                if (!results || results.length === 0) {
                    dropdown.addClass('hidden');
                    return;
                }

                autocompleteResults = results.slice(0, maxAutocompleteResults);
                currentAutocompleteIndex = -1;

                autocompleteResults.forEach(function(result, index) {
                    const highlightedText = highlightMatch(result.text, query);
                    const item = $('<div class="autocomplete-item flex items-center">')
                        .html(`
                            <div class="mr-3 text-blue-500">
                                ${result.type === 'event' ?
                                    '<svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>' :
                                    '<svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>'
                                }
                            </div>
                            <div>
                                <div class="text-sm text-gray-900">${highlightedText}</div>
                                <div class="text-xs text-gray-500 font-medium">${result.subtext || ''}</div>
                            </div>
                        `)
                        .data('index', index)
                        .on('click', function() {
                            selectAutocompleteItem(index);
                        });

                    dropdown.append(item);
                });

                dropdown.removeClass('hidden');
            }

            function navigateAutocomplete(direction) {
                const items = $('.autocomplete-item');
                if (items.length === 0) return;

                items.removeClass('active');
                currentAutocompleteIndex += direction;

                if (currentAutocompleteIndex >= items.length) {
                    currentAutocompleteIndex = 0;
                } else if (currentAutocompleteIndex < 0) {
                    currentAutocompleteIndex = items.length - 1;
                }

                items.eq(currentAutocompleteIndex).addClass('active');
            }

            function selectAutocompleteItem(index) {
                const result = autocompleteResults[index];
                if (!result) return;

                $('#search-term').val(result.text);
                $('#autocomplete-dropdown').addClass('hidden');

                if (validateSearch()) {
                    $('#search-button').click();
                }
            }

            /**
             * Implements logical text string mapping highlighting sub-parameters against input requests.
             */
            function highlightMatch(text, query) {
                if (!query) return text;
                const regex = new RegExp('(' + query.replace(/[-\/\\^$*+?.()|[\]{}]/g, '\\$&') + ')', 'gi');
                return text.replace(regex, '<span class="highlight">$1</span>');
            }

            function getMockAutocompleteResults(query) {
                query = query.toLowerCase();
                const cities = ['Athens', 'Thessaloniki', 'Patras', 'Heraklion'];
                const events = ['Music Concert Series', 'Comedy Night', 'Art Exhibition'];
                let results = [];

                cities.filter(c => c.toLowerCase().includes(query)).forEach(c => { results.push({ text: c, type: 'location', subtext: 'City' }); });
                events.filter(e => e.toLowerCase().includes(query)).forEach(e => { results.push({ text: e, type: 'event', subtext: 'Event' }); });
                
                return results;
            }

            /**
             * Parses explicit input form values checking execution readiness flags.
             * Restricts requests mitigating blank payload generations.
             */
            function validateSearch() {
                const eventType = $('#event-type').val();
                const dateRange = $('#date-range').val();
                const searchTerm = $('#search-term').val();

                let filledFields = 0;
                if (eventType) filledFields++;
                if (dateRange) filledFields++;
                if (searchTerm && searchTerm.length >= 2) filledFields++;

                const isValid = filledFields >= 1;
                $('#search-validation-message').toggleClass('hidden', isValid);

                return isValid;
            }

            $('#event-type, #date-range, #search-term').on('change input', validateSearch);

            $('#variable-pagination').on('change', function() {
                pageSize = parseInt($(this).val()) || 12;
                currentPage = 1;
                $('#events-container').addClass('hidden');
                $('#loading-indicator').removeClass('hidden');
                performSearch();
            });

            $('#search-button').click(function() {
                if (!validateSearch()) return;

                currentPage = 1;
                $('#events-container').addClass('hidden');
                $('#loading-indicator').removeClass('hidden');
                $('#no-results').addClass('hidden');

                setTimeout(function() { performSearch(); }, 500);
            });

            // Evaluation block tracking state-bound page changes
            $('#prev-page').click(function() {
                if (currentPage > 1) {
                    currentPage--;
                    $('#events-container').addClass('hidden');
                    $('#loading-indicator').removeClass('hidden');
                    setTimeout(performSearch, 300);
                }
            });

            $('#next-page').click(function() {
                if (currentPage < totalPages) {
                    currentPage++;
                    $('#events-container').addClass('hidden');
                    $('#loading-indicator').removeClass('hidden');
                    setTimeout(performSearch, 300);
                }
            });

            $('#page-numbers').on('click', '.page-button', function(e) {
                e.preventDefault();
                currentPage = parseInt($(this).data('page'));
                $('#events-container').addClass('hidden');
                $('#loading-indicator').removeClass('hidden');
                setTimeout(performSearch, 300);
            });

            /**
             * Central JSON processing loop evaluating form conditions, querying endpoint arrays,
             * establishing conditional DOM boundaries, and injecting rendering templates.
             */
            function performSearch() {
                let startDate = null;
                let endDate = null;

                if (dateRangePicker && dateRangePicker.selectedDates.length > 0) {
                    startDate = dateRangePicker.selectedDates[0].toISOString().split('T')[0];
                    endDate = dateRangePicker.selectedDates.length > 1
                        ? dateRangePicker.selectedDates[1].toISOString().split('T')[0]
                        : startDate;
                }

                const eventTypeId = $('#event-type').val();
                const searchTerm = $('#search-term').val().trim();
                
                // Evaluates boolean constraint logic checking parameter overrides
                const isSearchActive = (eventTypeId !== '' || startDate !== null || searchTerm !== '');

                searchParams = {
                    eventTypeId: eventTypeId,
                    startDate: startDate,
                    endDate: endDate,
                    searchTerm: searchTerm,
                    sort: sortOrder,
                    page: currentPage,
                    pageSize: pageSize,
                    archived: $('#archived-filter').is(':checked'),
                    onlyMasterEvents: !isSearchActive 
                };

                $.getJSON('/Events/SearchEvents', searchParams)
                    .done(function(data) {
                        totalPages = data.totalPages;
                        currentPage = data.currentPage;

                        const container = $('#events-container');
                        container.empty();
                        $('#loading-indicator').addClass('hidden');
                        $('#no-results').addClass('hidden');
                        $('#filtered-count').text(data.totalCount || 0);

                        if (!data.events || data.events.length === 0) {
                            $('#no-results').removeClass('hidden');
                            $('#pagination').addClass('hidden');
                            return;
                        }

                        data.events.forEach(function(event) {
                            const isMasterEvent = event.parentEventId == null && event.ParentEventId == null;
                            if (!isSearchActive && !isMasterEvent) return; 

                            const timeClass = getEventTimeClass(new Date(event.startDateTime), new Date(event.endTime));
                            const cardHtml = buildEventCard(event, timeClass);
                            container.append(cardHtml);
                        });

                        /**
                         * Evaluates target variables interpreting individual record states into 
                         * formatted HTML node strings, preventing nested anchor corruption on UI roles.
                         */
                        function buildEventCard(event, timeClass) {
                            const startDate = new Date(event.startDateTime || event.StartDateTime);
                            const endDate = new Date(event.endTime || event.EndTime);
                            const isMultiDay = startDate.toDateString() !== endDate.toDateString();
                            let dateDisplayHtml = "";

                            if (isMultiDay) {
                                const startStr = startDate.toLocaleDateString('en-US', {month: 'short', day: 'numeric', year: 'numeric' });
                                const endStr = endDate.toLocaleDateString('en-US', {month: 'short', day: 'numeric', year: 'numeric' });
                                dateDisplayHtml = `<p class="text-sm text-gray-800 font-bold">${startStr} - ${endStr}</p>`;
                            } else {
                                const dateStr = startDate.toLocaleDateString('en-US', {month: 'long', day: 'numeric', year: 'numeric' });
                                const timeStr = `${startDate.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' })} - ${endDate.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' })}`;
                                dateDisplayHtml = `<p class="text-sm text-gray-800 font-bold">${dateStr}</p><p class="text-sm text-gray-500 font-medium">${timeStr}</p>`;
                            }

                            const imgPath = event.displayImagePath || event.imagePath || '';
                            const hasImage = imgPath.trim() !== "";
                            const eventName = event.name || event.Name || 'Unnamed Event';
                            const eventId = event.id || event.Id;

                            // Security state evaluation restricting administrative footer generation
                            const isMasterEvent = event.parentEventId == null && event.ParentEventId == null;
                            const canViewSubEvents = @((isSuper || isAdmin || isEventManager).ToString().ToLower());
                            const showSubEventsLink = isMasterEvent && canViewSubEvents;
                            const childCount = event.childCount || event.ChildCount || 0;

                            // Pre-compiles absolute target layer avoiding async collision on replacement
                            let wishlistBadge = `
                            <div class="wishlist-badge cursor-help absolute top-7 left-7 bg-white/90 backdrop-blur-sm border border-gray-100 text-indigo-800 p-2 z-20 rounded-full shadow-sm hover:bg-white transition-colors wishlist-id-${eventId}">
                                <button type="button" onclick="window.wishlistAction(event, ${eventId})" class="border-none bg-transparent p-0 cursor-pointer flex items-center justify-center">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#eab308" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                                    </svg>
                                </button>
                            </div>`;

                            if (currentUserId !== '') {
                                let wParams = { eventId: eventId, userId: currentUserId };
                                $.getJSON('/Wishlist/returnItem', wParams)
                                    .done(function(isWishlisted) {
                                        if (isWishlisted === true) {
                                            $(`.wishlist-id-${eventId}`).html(`
                                                <button type="button" onclick="window.wishlistAction(event, ${eventId})" class="border-none bg-transparent p-0 cursor-pointer flex items-center justify-center">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="#eab308" stroke="#eab308" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                                                    </svg>
                                                </button>
                                            `);
                                        }
                                    });
                            }

                            // Dynamic Chronological Status Badges
                            let statusBadgeHtml = "";
                            if (timeClass === "event-today") {
                                statusBadgeHtml = `<div class="bg-green-500/95 backdrop-blur-sm text-white text-[10px] font-extrabold px-3 py-1.5 rounded-full shadow-sm tracking-wide uppercase border border-green-400">TODAY</div>`;
                            } else if (timeClass === "event-upcoming") {
                                statusBadgeHtml = `<div class="bg-blue-400/95 backdrop-blur-sm text-white text-[10px] font-extrabold px-3 py-1.5 rounded-full shadow-sm tracking-wide uppercase border border-blue-300">UPCOMING</div>`;
                            } else {
                                statusBadgeHtml = `<div class="bg-gray-600/95 backdrop-blur-sm text-white text-[10px] font-extrabold px-3 py-1.5 rounded-full shadow-sm tracking-wide uppercase border border-gray-500">ENDED</div>`;
                            }

                            const hasMultipleCities = event.hasMultipleCities || event.HasMultipleCities || false;
                            const distinctCities = event.distinctCities || event.DistinctCities || 0;
                            let cityName = event.cityNames || event.cityNames[0];
                            if (event.distinctCities === 0) cityName = event.cityName;

                            const cityNamesList = event.cityNames ? event.cityNames.join(', ') : '';
                            
                            // Displays contextual metadata indicating multi-property values
                            let cityBadgeHtml = hasMultipleCities 
                                ? `<p>${distinctCities} Cities</p><span class="tooltip-text" role="tooltip">${cityNamesList}</span>` 
                                : `<p>${cityName}</p>`;

                            const hasMultipleVenues = event.hasMultipleVenues || event.HasMultipleVenues || false;
                            const venueName = event.venueName || event.VenueName || (event.venue ? event.venue.name : 'No Venue');
                            let venueDisplayHtml = hasMultipleVenues 
                                ? `<p class="text-sm font-medium text-gray-600">Multiple Locations</p>` 
                                : `<p class="text-sm font-medium text-gray-600">${venueName}</p>`;

                            // Primary Card Element returned resolving structural HTML blocks
                            return `
                            <div class="event-card ${timeClass} border border-gray-200 shadow-md transition-all">
                                <a href="/Events/Details/${eventId}" class="block !no-underline text-current flex-grow relative p-5 pb-0">
                                    
                                    <!-- Image Bounds Enforcing Aspect Ratios While Retaining Absolute Floating Capabilities -->
                                    <div class="relative h-40 w-full shrink-0 mb-4 z-10">
                                        
                                        <div class="absolute inset-0 overflow-hidden rounded-xl bg-gray-100">
                                            ${hasImage ? 
                                                `<img src="${imgPath}" alt="${eventName}" class="w-full h-full object-cover transform hover:scale-105 transition-transform duration-300" />` : 
                                                `<div class="flex items-center justify-center h-full text-gray-400"><svg class="h-12 w-12" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg></div>`
                                            }
                                        </div>
                                        
                                        <!-- Vertical Badge Hierarchy explicitly positioned above image bounds -->
                                        <div class="absolute top-2 right-2 z-50 flex flex-col items-end gap-2">
                                            ${statusBadgeHtml}
                                            <div class="tooltip-container2 cursor-help bg-white/95 backdrop-blur-sm border border-gray-100 text-indigo-800 text-[10px] font-extrabold px-3 py-1.5 rounded-full shadow-sm uppercase tracking-wide">
                                                ${cityBadgeHtml}
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <div class="event-content">
                                        <div class="flex items-center justify-between mb-3">
                                            <h3 class="text-lg font-bold text-gray-900 mb-2 line-clamp-2">${eventName}</h3>
                                            ${isMasterEvent ? 
                                            `<div class="tooltip-container flex items-center cursor-help shrink-0">
                                                <svg class="h-5 w-5 text-indigo-600" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                                    <path d="M12 11V5" /><path d="M12 11L6 18" /><path d="M12 11L18 18" />
                                                    <circle cx="12" cy="4" r="2.5" fill="currentColor" stroke="none" />
                                                    <circle cx="6" cy="19" r="2.5" fill="currentColor" stroke="none" />
                                                    <circle cx="18" cy="19" r="2.5" fill="currentColor" stroke="none" />
                                                </svg>
                                                <span class="tooltip-text" role="tooltip">Master event</span>
                                            </div>` : ''}
                                        </div>
                                        <div class="flex items-start mb-3">
                                            <svg class="h-5 w-5 text-gray-500 mr-2 mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                                            <div>${dateDisplayHtml}</div>
                                        </div>
                                        <div class="flex items-start mb-4">
                                            <svg class="h-5 w-5 text-gray-500 mr-2 mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /></svg>
                                            <div>${venueDisplayHtml}</div>
                                        </div>
                                    </div>
                                </a>

                                ${wishlistBadge}
                                
                                <!-- Segregated Admin Link Container guarding against nested anchor rendering failures -->
                                ${showSubEventsLink ? `
                                <div class="px-5 pb-5 mt-auto">
                                    <div class="event-footer flex justify-between items-center pt-4 border-t border-gray-100">
                                        <a href="/Events/ChildEvents/${eventId}" class="text-sm font-bold text-blue-600 hover:text-blue-800 transition-colors bg-blue-50 px-3 py-1.5 rounded-lg hover:bg-blue-100 !no-underline cursor-pointer">Manage Sub-Events (${childCount})</a>
                                        <a href="/Events/Edit/${eventId}" class="text-sm font-bold text-gray-500 hover:text-gray-800 transition-colors !no-underline cursor-pointer">Edit →</a>
                                    </div>
                                </div>
                                ` : '<div class="pb-5"></div>'}
                            </div>`;
                        }

                        container.removeClass('hidden');
                        updatePagination(data.totalPages > 1);
                    })
                    .fail(function() {
                        console.error('Search query operation encountered a server-side exception or routing failure.');
                        $('#loading-indicator').addClass('hidden');
                    });
            }

            /**
             * Handles asynchronous addition and removal mutations updating backend models and UI toggles globally.
             */
            window.wishlistAction = function(e, eventId) {
                e.preventDefault();
                e.stopPropagation();

                if (!currentUserId || currentUserId === '') {
                    alert("You must be logged in to use this feature.");
                    return;
                }

                let token = $('input[name="__RequestVerificationToken"]').val();
                let wParams = { eventId: eventId, userId: currentUserId };

                $.getJSON('/Wishlist/returnItem', wParams).done(function(isWishlisted) {
                    if (!isWishlisted) {
                        $.ajax({
                            url: '/Wishlist/addWishlistEvent',
                            type: 'POST',
                            data: wParams,
                            headers: { "RequestVerificationToken": token },
                            success: function(success) {
                                if (success === true) {
                                    $(`.wishlist-id-${eventId}`).html(`
                                    <button type="button" onclick="window.wishlistAction(event, ${eventId})" class="border-none bg-transparent p-0 cursor-pointer flex items-center justify-center">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="#eab308" stroke="#eab308" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                                        </svg>
                                    </button>`);
                                }
                            }
                        });
                    } else {
                        $.ajax({
                            url: '/Wishlist/deleteWishlistEvent',
                            type: 'DELETE',
                            data: wParams,
                            headers: { "RequestVerificationToken": token },
                            success: function(success) {
                                if (success === true) {
                                    $(`.wishlist-id-${eventId}`).html(`
                                    <button type="button" onclick="window.wishlistAction(event, ${eventId})" class="border-none bg-transparent p-0 cursor-pointer flex items-center justify-center">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#eab308" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                                        </svg>
                                    </button>`);
                                }
                            }
                        });
                    }
                });
            }

            /**
             * Generates string-based timeline classifications comparing dynamic metadata blocks.
             */
            function getEventTimeClass(startDate, endDate) {
                const today = new Date();
                today.setHours(0, 0, 0, 0);
                const startDay = new Date(startDate);
                startDay.setHours(0, 0, 0, 0);
                const endDay = new Date(endDate);
                endDay.setHours(0, 0, 0, 0);

                if (startDay.getTime() <= today.getTime() && endDay.getTime() >= today.getTime()) {
                    return 'event-today';
                } else if (endDay.getTime() > today.getTime()) {
                    return 'event-upcoming';
                } else {
                    return 'event-past';
                }
            }

            /** 
             * Structures UI nodes dynamically generating scalable pagination logic configurations
             * @@param {boolean} show - Dictates absolute container layout visibility limits
             */
            function updatePagination(show = true) {
                const paginationContainer = $('#pagination');
                const pageNumbersContainer = $('#page-numbers');

                if (!show || totalPages <= 1) {
                    paginationContainer.addClass('hidden');
                    return;
                }

                paginationContainer.removeClass('hidden');
                pageNumbersContainer.empty();

                $('#prev-page').prop('disabled', currentPage === 1);
                $('#next-page').prop('disabled', currentPage === totalPages);

                let startPage = Math.max(1, currentPage - 2);
                let endPage = Math.min(totalPages, startPage + 4);

                if (endPage - startPage < 4) {
                    startPage = Math.max(1, endPage - 4);
                }

                if (startPage > 1) {
                    pageNumbersContainer.append(createPageButton(1));
                    if (startPage > 2) {
                        pageNumbersContainer.append('<span class="relative inline-flex items-center px-4 py-2 border border-gray-300 bg-white text-sm font-medium text-gray-700">...</span>');
                    }
                }

                for (let i = startPage; i <= endPage; i++) {
                    pageNumbersContainer.append(createPageButton(i));
                }

                if (endPage < totalPages) {
                    if (endPage < totalPages - 1) {
                        pageNumbersContainer.append('<span class="relative inline-flex items-center px-4 py-2 border border-gray-300 bg-white text-sm font-medium text-gray-700">...</span>');
                    }
                    pageNumbersContainer.append(createPageButton(totalPages));
                }
            }

            function createPageButton(pageNumber) {
                const isActive = pageNumber === currentPage;
                return $('<button>', {
                    class: `page-number pagination-link page-button relative inline-flex items-center px-4 py-2 border text-sm font-medium ${
                        isActive 
                        ? 'active current-page z-10 bg-indigo-50 border-indigo-500 text-indigo-600' 
                        : 'bg-white border-gray-300 text-gray-500 hover:bg-gray-50'
                    }`,
                    'data-page': pageNumber,
                    text: pageNumber
                });
            }
        
        });
    </script>
    
    <script>
        // Implements structural CSS mutations managing dynamic UI panel states
        document.getElementById("panel-button").addEventListener("click", function () {
            const panel = document.getElementById("panel-body");
            panel.classList.toggle("hidden");
        });
    </script>

    <script>
        /** 
         * Dual-slide side-by-side hero carousel execution engine internally tracking dynamic event loads
         */
        document.addEventListener("DOMContentLoaded", function () {
            async function populateDualCarousel() {
                try {
                    const response = await fetch('/Events/getNewestEvents');
                    const events = await response.json();
                    const track = document.getElementById('dual-hero-track');

                    if (!track) return;

                    if (events.length === 0) {
                        track.innerHTML = '<div class="w-full h-full flex items-center justify-center text-gray-500 bg-white rounded-2xl border border-gray-200 shadow-sm">No events found</div>';
                        return;
                    }

                    track.innerHTML = ''; 

                    events.forEach((event) => {
                        const formattedStartDate = new Date(event.startDateTime).toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
                        const hasMultipleCities = event.hasMultipleCities || false;
                        const distinctCities = event.distinctCities || 0;
                        const cityName = event.distinctCities === 0 ? event.cityName : (event.cityNames ? event.cityNames[0] : 'Unknown');
                        let locationText = hasMultipleCities ? `${distinctCities} Cities` : cityName;
                        
                        const imgBg = event.imagePath ? `url('${event.imagePath}')` : 'none';
                        const fallbackBg = event.imagePath ? '' : 'bg-gradient-to-br from-gray-700 to-gray-900';

                        const slideHtml = `
                            <a href="/Events/Details/${event.id}" 
                               class="flex-shrink-0 h-full rounded-2xl overflow-hidden relative group block shadow-xl hover:shadow-2xl transition-all border border-gray-100" 
                               style="width: calc(50% - 12px);">
                               <div class="absolute inset-0 bg-cover bg-center transition-transform duration-1000 group-hover:scale-105 ${fallbackBg}" style="background-image: ${imgBg};"></div>
                               <div class="absolute inset-0 bg-gradient-to-t from-black via-black/40 to-transparent opacity-90"></div>
                               <div class="absolute inset-0 p-8 flex flex-col justify-start text-white">
                                   <span class="bg-blue-600 text-white text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-full w-max mb-4 shadow-md">
                                       ${event.eventType || 'Event'}
                                   </span>
                                   <h3 class="text-3xl font-extrabold mb-3 line-clamp-2 leading-tight drop-shadow-md">${event.name}</h3>
                                   <div class="flex items-center gap-6 text-sm text-gray-200 font-medium drop-shadow-sm">
                                       <span class="flex items-center">
                                           <svg class="h-5 w-5 mr-2 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /></svg>
                                           ${locationText}
                                       </span>
                                       <span class="flex items-center">
                                           <svg class="h-5 w-5 mr-2 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                                           ${formattedStartDate}
                                       </span>
                                   </div>
                               </div>
                            </a>
                        `;
                        track.insertAdjacentHTML('beforeend', slideHtml);
                    });

                    startDualCarouselLogic(events.length);
                } catch (err) {
                    console.error("Dual Carousel fetch error:", err);
                }
            }

            function startDualCarouselLogic(totalSlides) {
                const track = document.getElementById('dual-hero-track');
                if (totalSlides <= 2) return; 

                let currentIndex = 0;
                setInterval(() => {
                    const maxIndex = totalSlides - 2; 
                    currentIndex++;
                    if (currentIndex > maxIndex) currentIndex = 0; 
                    track.style.transform = `translateX(calc(-${currentIndex} * (50% + 12px)))`;
                }, 4000);
            }

            populateDualCarousel();
        });
    </script>
}