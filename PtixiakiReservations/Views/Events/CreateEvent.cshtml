@model PtixiakiReservations.Models.Event

@{
    ViewData["Title"] = "Create New Event";
}

<div class="min-h-screen bg-gray-50/50 py-6 sm:py-10 px-4 sm:px-6 lg:px-8 pb-32 sm:pb-12">
    <div class="max-w-4xl mx-auto">
        
        <!-- Header Configuration -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between mb-6 gap-4">
            <div>
                <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">Create New Event</h1>
                <p class="mt-1 text-gray-500 text-sm">Schedule new standalone events, master containers, or individual sub-events.</p>
            </div>
            <div class="hidden sm:block">
                <a href="@Url.Action("Index", "Events")" class="inline-flex items-center px-4 py-2 bg-white border border-gray-300 rounded-lg text-sm font-semibold text-gray-700 hover:bg-gray-50 transition-colors shadow-sm">
                    <svg class="h-4 w-4 mr-2 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
                    Back to List
                </a>
            </div>
        </div>

        <!-- Information Panel -->
        <div class="bg-indigo-50 border border-indigo-100 rounded-2xl p-5 sm:p-6 mb-8 shadow-sm relative overflow-hidden">
            <div class="absolute -right-4 -top-4 w-24 h-24 bg-indigo-200 rounded-full opacity-40 blur-2xl pointer-events-none"></div>
            <div class="flex items-start relative z-10">
                <div class="flex-shrink-0 mt-0.5">
                    <svg class="h-6 w-6 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
                <div class="ml-3 sm:ml-4 w-full">
                    <h3 class="text-sm font-extrabold text-indigo-900 uppercase tracking-wider mb-3">How Event Creation Works</h3>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
                        <div class="bg-white/60 p-4 rounded-xl border border-indigo-50">
                            <strong class="text-indigo-900 block mb-1.5 flex items-center">
                                <svg class="w-4 h-4 mr-1 text-indigo-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-11a1 1 0 10-2 0v2H7a1 1 0 100 2h2v2a1 1 0 102 0v-2h2a1 1 0 100-2h-2V7z" clip-rule="evenodd" /></svg>
                                Master Events
                            </strong>
                            <ul class="list-disc pl-5 space-y-1 text-indigo-800/80">
                                <li>Act as standalone events OR parent containers.</li>
                                <li>Hold the primary Description, Category, and Media.</li>
                                <li>If it's just a container with no physical location yet, uncheck <span class="font-bold text-indigo-600">Standalone Event</span>.</li>
                            </ul>
                        </div>
                        <div class="bg-white/60 p-4 rounded-xl border border-indigo-50">
                            <strong class="text-indigo-900 block mb-1.5 flex items-center">
                                <svg class="w-4 h-4 mr-1 text-indigo-500" fill="currentColor" viewBox="0 0 20 20"><path d="M7 3a1 1 0 000 2h6a1 1 0 100-2H7zM4 7a1 1 0 011-1h10a1 1 0 110 2H5a1 1 0 01-1-1zM2 11a2 2 0 012-2h12a2 2 0 012 2v4a2 2 0 01-2 2H4a2 2 0 01-2-2v-4z" /></svg>
                                Sub-Events (Children)
                            </strong>
                            <ul class="list-disc pl-5 space-y-1 text-indigo-800/80">
                                <li>Automatically inherit the Master's Category, Description, and Images.</li>
                                <li><span class="font-bold underline">Must</span> be scheduled strictly within the Master's timeframe.</li>
                                <li><span class="font-bold underline">Must</span> have a specific Venue and Floorplan selected.</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <form asp-action="CreateEvent" asp-controller="Events" method="post" id="createEventForm" enctype="multipart/form-data" class="space-y-8">
            @Html.AntiForgeryToken()
            
            <!-- Event Mode Selection -->
            <div class="bg-white rounded-2xl shadow-sm border border-gray-200 relative z-[80]">
                <div class="px-6 py-5 border-b border-gray-100 bg-gray-50/30 flex items-center rounded-t-2xl">
                    <div class="h-8 w-8 rounded-lg bg-blue-50 border border-blue-100 flex items-center justify-center mr-3">
                        <svg class="h-4 w-4 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/></svg>
                    </div>
                    <h3 class="text-lg font-bold text-gray-900">Creation Mode</h3>
                </div>
                
                <div class="p-6">
                    <div class="bg-indigo-600 rounded-xl p-1 mb-2 flex shadow-inner">
                        <label class="flex-1 text-center py-2.5 cursor-pointer transition-all rounded-lg bg-white shadow-sm font-bold text-indigo-700" id="labelFather">
                            <input type="radio" id="radioFather" name="eventMode" value="father" class="sr-only" checked onchange="toggleEventMode('father', true)">
                            <span>Master Event</span>
                        </label>
                        <label class="flex-1 text-center py-2.5 cursor-pointer transition-all rounded-lg" id="labelChild">
                            <input type="radio" id="radioChild" name="eventMode" value="child" class="sr-only" onchange="toggleEventMode('child', true)">
                            <span class="text-white font-medium flex items-center justify-center">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                                </svg>
                                Sub-Event (Child)
                            </span>
                        </label>
                    </div>
                </div>
            </div>

            <!-- Parent Event Association -->
            <div id="parentEventSection" class="hidden bg-white rounded-2xl shadow-sm border border-gray-200 ring-2 ring-indigo-500 border-transparent relative z-[70]">
                <div class="px-6 py-5 border-b border-gray-100 bg-indigo-50/50 flex items-center rounded-t-2xl">
                    <div class="h-8 w-8 rounded-lg bg-indigo-100 border border-indigo-200 flex items-center justify-center mr-3">
                        <svg class="h-4 w-4 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg>
                    </div>
                    <h3 class="text-lg font-bold text-gray-900">Link to Master Event</h3>
                </div>
                <div class="p-6">
                    <input type="hidden" asp-for="ParentEventId" id="ParentEventId" name="ParentEventId" />
                    <label class="block text-sm font-bold text-gray-700 mb-1.5">Search Existing Master Event <span class="text-red-500">*</span></label>
                    <div class="search-container relative">
                        <div class="flex gap-2">
                            <input type="text" id="parentEventSearch" class="w-full px-4 py-2.5 bg-gray-50 border border-gray-300 rounded-lg disabled:opacity-60 focus:bg-white focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all text-sm font-medium relative z-10" placeholder="Start typing parent event name..." autocomplete="off" />
                            <button class="px-4 py-2 bg-gray-100 hover:bg-gray-200 border border-gray-200 rounded-lg text-sm font-bold text-gray-600 hidden transition-colors" type="button" id="clearParentSelection">Clear</button>
                        </div>
                        <ul id="searchResults" class="absolute w-full bg-white border border-gray-200 rounded-b-xl shadow-2xl z-[100] hidden max-h-60 overflow-y-auto mt-2 divide-y divide-gray-50"></ul>
                    </div>
                    <p id="parentRequiredError" class="text-red-500 text-xs mt-2 hidden font-bold">You must strictly select a Master Event to proceed in Child Mode.</p>
                </div>
            </div>

            <!-- Sub-Events Collection -->
            <div id="subEventsListContainer" class="hidden bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden relative z-[65]">
                <div class="bg-gray-50 px-6 py-4 border-b border-gray-200 flex flex-col sm:flex-row justify-between sm:items-center gap-4 rounded-t-2xl">
                    <div>
                        <h3 class="text-gray-900 font-bold text-sm">Generated Sub-Events (<span id="subEventCountDisplay">0</span>)</h3>
                        <p class="text-[11px] text-gray-500 uppercase tracking-wider font-bold mt-1">Instances tied to the selected Master Event</p>
                        
                        <div class="flex items-center mt-3 gap-2">
                            <input type="checkbox" id="MultiRenameCheckbox" onchange="showRenameCheckboxes()" class="h-4 w-4 cursor-pointer rounded border-gray-300 text-indigo-600 focus:ring-indigo-500"/>
                            <label for="MultiRenameCheckbox" class="text-xs font-bold text-indigo-700 cursor-pointer">Enable Multi-Rename</label>
                            <button type="button" onclick="showRenameModal()" id="ConfirmMultiRenameBtn" class="hidden ml-2 bg-green-600 hover:bg-green-700 text-white px-3 py-1 rounded text-xs transition-colors shadow-sm font-bold">Apply Bulk Rename</button>
                        </div>
                    </div>
                    <div class="flex flex-wrap items-center gap-2 mt-3 sm:mt-0">
                        <button type="button" onclick="resetToCleanMasterMode()" class="px-4 py-2.5 bg-emerald-50 text-emerald-700 border border-emerald-200 rounded-lg hover:bg-emerald-100 transition-colors text-sm font-bold shadow-sm">Create New Master</button>
                        <a href="@Url.Action("EventsForToday", "Events")" class="px-4 py-2.5 bg-white border border-gray-300 rounded-lg text-sm font-bold text-gray-700 hover:bg-gray-50 shadow-sm transition-colors">Exit</a>
                        <button type="button" onclick="showChildEventForm()" class="inline-flex items-center px-4 py-2.5 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition-colors text-sm font-bold shadow-sm">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1.5" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v6h4a1 1 0 110 2h-4v6a1 1 0 11-2 0v-6H4a1 1 0 110-2h4V4a1 1 0 011-1z" clip-rule="evenodd" />
                            </svg>
                            Draft New Sub-Event
                        </button>
                    </div>
                </div>
                <div class="max-h-60 overflow-y-auto">
                    <table class="min-w-full divide-y divide-gray-200">
                        <thead class="bg-white text-[10px] uppercase font-extrabold text-gray-400 sticky top-0 shadow-sm z-10">
                            <tr>
                                <th class="px-6 py-3 text-left">Identifier Name</th>
                                <th class="px-6 py-3 text-left">Time Boundaries</th>
                                <th class="px-6 py-3 text-left">Floorplan</th>
                                <th class="px-6 py-3 text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="subEventsTableBody" class="divide-y divide-gray-100 text-sm bg-white"></tbody>
                    </table>
                </div>
            </div>

            <!-- Event Data Form -->
            <div id="eventDetailsWrapper" class="space-y-8">
                
                <!-- General Information -->
                <div class="bg-white rounded-2xl shadow-sm border border-gray-200 relative z-[60]">
                    <div class="px-6 py-5 border-b border-gray-100 bg-gray-50/30 flex items-center rounded-t-2xl">
                        <div class="h-8 w-8 rounded-lg bg-indigo-50 border border-indigo-100 flex items-center justify-center mr-3">
                            <svg class="h-4 w-4 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                        </div>
                        <h3 class="text-lg font-bold text-gray-900">General Information</h3>
                    </div>
                    
                    <div class="p-6 space-y-6">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div>
                                <label asp-for="Name" class="block text-sm font-bold text-gray-700 mb-1.5">Event Name <span class="text-red-500">*</span></label>
                                <input asp-for="Name" placeholder="Enter event name" class="w-full px-4 py-2.5 bg-gray-50 border border-gray-300 rounded-lg focus:bg-white focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all text-sm font-medium text-gray-900"/>
                                <span asp-validation-for="Name" class="text-red-500 text-xs mt-1.5 block font-medium"></span>
                            </div>

                            <div>
                                <label asp-for="EventTypeId" class="block text-sm font-bold text-gray-700 mb-1.5">Event Category <span class="text-red-500">*</span></label>
                                <select asp-for="EventTypeId" asp-items="ViewBag.EventTypeList" class="w-full px-4 py-2.5 bg-gray-50 border border-gray-300 rounded-lg focus:bg-white focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all text-sm font-medium text-gray-900 appearance-none disabled:opacity-60"></select>
                            </div>
                        </div>
                        
                        <div id="descriptionContainer">
                            <label asp-for="Description" class="block text-sm font-bold text-gray-700 mb-1.5">Detailed Description</label>
                            <textarea asp-for="Description" rows="4" placeholder="Enter event description..." class="w-full px-4 py-3 bg-gray-50 border border-gray-300 rounded-lg focus:bg-white focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all text-sm text-gray-900 leading-relaxed"></textarea>
                        </div>

                        <div id="childDescriptionNote" class="hidden">
                            <label class="block text-sm font-bold text-gray-700 mb-1.5">Description Status</label>
                            <div class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-lg">
                                <p class="text-sm font-bold text-indigo-700 flex items-center">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2 text-indigo-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                                    Description & Category are inherited strictly from the Master Event.
                                </p>
                            </div>
                        </div>

                        <div id="ticketPriceContainer">
                            <label asp-for="TicketPrice" class="block text-sm font-bold text-gray-700 mb-1.5">Ticket Price</label>
                            <div class="relative">
                                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                    <span class="text-gray-500 sm:text-sm">€</span>
                                </div>
                                <input asp-for="TicketPrice" type="number" step="0.01" min="0" placeholder="0.00" class="w-full pl-8 px-4 py-2.5 bg-gray-50 border border-gray-300 rounded-lg focus:bg-white focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all text-sm font-medium text-gray-900" />
                            </div>
                            <p class="text-xs text-gray-500 mt-1.5 font-bold uppercase tracking-wider">Leave blank or set to 0 for free admission.</p>
                        </div>
                    </div>
                </div>

                <!-- Location Parameters -->
                <div id="location-section" class="bg-white rounded-2xl shadow-sm border border-gray-200 relative z-[50]">
                    <div class="px-6 py-5 border-b border-gray-100 bg-gray-50/30 flex items-center rounded-t-2xl">
                        <div class="h-8 w-8 rounded-lg bg-emerald-50 border border-emerald-100 flex items-center justify-center mr-3">
                            <svg class="h-4 w-4 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                        </div>
                        <h3 class="text-lg font-bold text-gray-900">Location Settings</h3>
                    </div>
                    
                    <div class="p-6">
                        <div id="single-checkbox-container" class="mb-6 p-4 bg-gray-50 border border-gray-200 rounded-xl flex items-center gap-3">
                            <input type="checkbox" id="single-checkbox" name="IsStandalone" value="true" class="h-5 w-5 text-indigo-600 border-gray-300 rounded focus:ring-indigo-500 cursor-pointer" checked onchange="handleLayoutAndVenueState()" />
                            <label for="single-checkbox" class="block text-sm font-bold text-gray-700 cursor-pointer">Standalone Event <span class="font-normal text-gray-500">(Uncheck if this will act as a Master Container with no physical location yet)</span></label>
                        </div>
                        
                        <div id="venue-layout-fields" class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div>
                                <label class="block text-sm font-bold text-gray-700 mb-1.5">Assigned Venue <span class="text-red-500">*</span></label>
                                <div class="relative">
                                    <input type="hidden" asp-for="VenueId" id="VenueId" />
                                    <div class="flex gap-2 w-full">
                                        <input type="text" id="venueSearch" class="w-full px-4 py-2.5 bg-gray-50 border border-gray-300 rounded-lg disabled:opacity-60 focus:bg-white focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition-all text-sm font-medium relative z-10" placeholder="Search for a venue..." autocomplete="off" />
                                        <button class="px-4 py-2 bg-gray-100 hover:bg-gray-200 border border-gray-200 rounded-lg text-sm font-bold text-gray-600 hidden transition-colors" type="button" id="clearVenueSelection">Clear</button>
                                    </div>
                                    <ul id="venueSearchResults" class="absolute w-full bg-white border border-gray-200 rounded-b-xl shadow-2xl z-[100] hidden max-h-60 overflow-y-auto mt-2 divide-y divide-gray-50"></ul>
                                </div>
                            </div>
                            <div>
                                <label asp-for="LayoutId" class="block text-sm font-bold text-gray-700 mb-1.5">Active Floorplan <span class="text-red-500">*</span></label>
                                <select asp-for="LayoutId" id="layoutSelect" class="w-full px-4 py-2.5 bg-gray-50 border border-gray-300 rounded-lg disabled:opacity-60 focus:bg-white focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition-all text-sm font-medium appearance-none">
                                    <option value="">Select a Layout</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Media Uploads -->
                <div class="bg-white rounded-2xl shadow-sm border border-gray-200 relative z-[40]">
                    <div class="px-6 py-5 border-b border-gray-100 bg-gray-50/30 flex items-center justify-center text-center rounded-t-2xl">
                        <div class="h-8 w-8 rounded-lg bg-pink-50 border border-pink-100 flex items-center justify-center mr-3">
                            <svg class="h-4 w-4 text-pink-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                        </div>
                        <h3 class="text-lg font-bold text-gray-900">Media Assets</h3>
                    </div>
                    
                    <div class="p-6 space-y-10 max-w-2xl mx-auto">
                        <div class="flex flex-col items-center text-center">
                            <label class="block text-sm font-bold text-gray-700 mb-3 border-b border-gray-100 pb-2 w-full">Main Event Banner</label>
                            
                            <div class="w-full max-w-md flex justify-center px-6 py-6 border-2 border-gray-300 border-dashed rounded-xl bg-gray-50 hover:bg-gray-100 transition-colors mx-auto">
                                <div class="text-center">
                                    <label for="imageFile" class="cursor-pointer font-bold text-indigo-600 hover:text-indigo-500">
                                        <span>Upload Poster Image</span>
                                        <input id="imageFile" name="imageFile" type="file" class="sr-only" accept="image/*" onchange="previewImage(this)">
                                    </label>
                                    <p id="childImageNote" class="hidden text-gray-500 text-[11px] mt-1 font-bold uppercase tracking-wider">Inherits Master's image if left empty</p>
                                </div>
                            </div>
                            <div id="imagePreviewContainer" class="hidden mt-4 w-full max-w-md mx-auto">
                                <p class="text-[10px] font-bold text-pink-500 uppercase tracking-wider mb-2">Upload Preview</p>
                                <img id="imagePreview" src="#" class="w-full h-48 object-cover rounded-lg shadow-sm border border-gray-200 mx-auto">
                            </div>
                        </div>

                        <div class="flex flex-col items-center text-center">
                            <label class="block text-sm font-bold text-gray-700 mb-3 border-b border-gray-100 pb-2 w-full">Gallery Additions</label>
                            <div class="w-full max-w-md flex justify-center px-6 py-6 border-2 border-gray-300 border-dashed rounded-xl bg-gray-50 hover:bg-gray-100 transition-colors mx-auto">
                                <div class="text-center">
                                    <label for="galleryFiles" class="cursor-pointer font-bold text-indigo-600 hover:text-indigo-500">
                                        <span>Upload Gallery Collection</span>
                                        <input id="galleryFiles" name="galleryFiles" type="file" class="sr-only" accept="image/*" multiple onchange="previewGalleryImages(this)">
                                    </label>
                                    <p class="text-gray-400 text-[11px] mt-1 uppercase tracking-wider">Hold Ctrl/Shift for multiple</p>
                                </div>
                            </div>
                            <div id="galleryPreviewContainer" class="hidden mt-4 w-full grid grid-cols-3 md:grid-cols-4 gap-2"></div>
                        </div>
                    </div>
                </div>

                <!-- Scheduling Parameters -->
                <div class="bg-white rounded-2xl shadow-sm border border-gray-200 relative z-[30]">
                    <div class="px-6 py-5 border-b border-gray-100 bg-gray-50/30 flex items-center rounded-t-2xl">
                        <div class="h-8 w-8 rounded-lg bg-orange-50 border border-orange-100 flex items-center justify-center mr-3">
                            <svg class="h-4 w-4 text-orange-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                        </div>
                        <h3 class="text-lg font-bold text-gray-900">Scheduling</h3>
                    </div>
                    
                    <div class="p-6">
                        <div id="multiDayToggleContainer" class="flex items-center mb-6 p-4 bg-gray-50 border border-gray-200 rounded-xl">
                            <input type="checkbox" id="isMultiDay" name="IsMultiDay" class="h-5 w-5 text-indigo-600 border-gray-300 rounded focus:ring-indigo-500 cursor-pointer" onchange="handleLayoutAndVenueState()">
                            <label for="isMultiDay" class="ml-3 font-bold text-gray-700 cursor-pointer">Deploy events across multiple days automatically</label>
                        </div>

                        <div id="singleDayContainer" class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div>
                                <label asp-for="StartDateTime" class="block text-sm font-bold text-gray-700 mb-1.5">Start Date & Time</label>
                                <input asp-for="StartDateTime" type="datetime-local" class="w-full px-4 py-2.5 bg-gray-50 border border-gray-300 rounded-lg focus:bg-white focus:ring-2 focus:ring-orange-500 disabled:opacity-60 transition-all text-sm font-bold text-gray-900" />
                            </div>
                            <div>
                                <label asp-for="EndTime" class="block text-sm font-bold text-gray-700 mb-1.5">End Date & Time</label>
                                <input asp-for="EndTime" type="datetime-local" class="w-full px-4 py-2.5 bg-gray-50 border border-gray-300 rounded-lg focus:bg-white focus:ring-2 focus:ring-orange-500 disabled:opacity-60 transition-all text-sm font-bold text-gray-900" />
                            </div>
                        </div>

                        <div id="multiDayContainer" class="hidden space-y-6">
                            <input asp-for="StartDateTime" type="hidden" id="multiStartDateTime" />
                            <input asp-for="EndTime" type="hidden" id="multiEndDateTime" />
                            
                            <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                                <div>
                                    <label class="block text-[11px] uppercase tracking-wider font-bold text-gray-500 mb-1">Start Date</label>
                                    <input id="StartDate" name="StartDate" type="date" class="w-full px-4 py-2 bg-gray-50 border border-gray-300 rounded-lg focus:bg-white focus:ring-2 focus:ring-orange-500 text-sm font-bold disabled:opacity-60" />
                                </div>
                                <div>
                                    <label class="block text-[11px] uppercase tracking-wider font-bold text-gray-500 mb-1">End Date</label>
                                    <input id="EndDate" name="EndDate" type="date" class="w-full px-4 py-2 bg-gray-50 border border-gray-300 rounded-lg focus:bg-white focus:ring-2 focus:ring-orange-500 text-sm font-bold disabled:opacity-60" />
                                </div>
                                <div>
                                    <label class="block text-[11px] uppercase tracking-wider font-bold text-gray-500 mb-1">Daily Start</label>
                                    <input id="StartTime" name="StartTime" type="time" class="w-full px-4 py-2 bg-gray-50 border border-gray-300 rounded-lg focus:bg-white focus:ring-2 focus:ring-orange-500 text-sm font-bold disabled:opacity-60" />
                                </div>
                                <div>
                                    <label class="block text-[11px] uppercase tracking-wider font-bold text-gray-500 mb-1">Daily End</label>
                                    <input id="DailyEndTime" name="MultiEndTime" type="time" class="w-full px-4 py-2 bg-gray-50 border border-gray-300 rounded-lg focus:bg-white focus:ring-2 focus:ring-orange-500 text-sm font-bold disabled:opacity-60" />
                                </div>
                            </div>
                            
                            <div id="datePreviewContainer" class="bg-white border border-gray-200 rounded-xl hidden overflow-hidden shadow-sm">
                                <div class="bg-gray-50 px-4 py-3 border-b border-gray-200 flex justify-between items-center">
                                    <span class="text-sm font-bold text-gray-700">Deployment Preview</span>
                                    <span class="text-xs font-bold bg-indigo-100 text-indigo-700 px-2 py-1 rounded-full"><span id="eventCount">0</span> Events</span>
                                </div>
                                <div class="max-h-48 overflow-y-auto p-2">
                                    <table class="min-w-full">
                                        <tbody id="eventPreviewList" class="divide-y divide-gray-100 text-sm font-medium"></tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Form Actions -->
            <div id="bottomActionBar" class="fixed bottom-0 left-0 w-full bg-white border-t border-gray-200 p-4 shadow-[0_-4px_6px_-1px_rgba(0,0,0,0.05)] z-50 sm:static sm:bg-transparent sm:border-0 sm:p-0 sm:shadow-none sm:flex sm:justify-end sm:gap-3 sm:mt-4">
                <div class="flex w-full sm:w-auto gap-3 mt-3 sm:mt-0">
                    <button type="button" id="cancelChildBtn" onclick="hideChildEventForm()" class="hidden w-full sm:w-auto justify-center items-center px-6 py-2.5 bg-white border border-gray-300 rounded-xl text-sm font-bold text-gray-700 hover:bg-gray-50 shadow-sm transition-colors">Cancel Draft</button>
                    <button type="submit" id="btnSubmitForm" class="w-full sm:w-auto flex justify-center items-center px-8 py-3 sm:py-2.5 bg-indigo-600 text-white text-sm font-bold rounded-xl shadow-md hover:bg-indigo-700 focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-all">
                        Create Event
                    </button>
                </div>
            </div>

        </form>
    </div>
</div>

<!-- Interactive Elements -->
<div id="renameModal" tabindex="-1" class="hidden fixed inset-0 z-[110] flex items-center justify-center bg-gray-900 bg-opacity-60 backdrop-blur-sm transition-opacity">
    <div class="bg-white rounded-2xl shadow-2xl p-6 w-full max-w-md relative transform transition-all border border-gray-100">
        <h3 class="text-xl font-extrabold text-gray-900 mb-2">Bulk Rename Elements</h3>
        <p class="text-sm text-gray-500 mb-4">Provide a new baseline name for selected events.</p>
        <input type="text" id="ModalField" placeholder="New Baseline Name..." class="w-full px-4 py-3 bg-gray-50 border border-gray-300 rounded-lg focus:bg-white focus:ring-2 focus:ring-indigo-500 mb-5 outline-none font-bold text-gray-900" />
        <div class="flex justify-end gap-3">
            <button type="button" onclick="closeRenameModal()" class="px-5 py-2.5 bg-white border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 transition-colors font-bold text-sm">Cancel</button>
            <button type="button" onclick="RenameMultiple(document.getElementById('ModalField').value)" class="px-5 py-2.5 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 shadow-sm transition-colors font-bold text-sm">Apply Rename</button>
        </div>
    </div>
</div>
    
<div id="successMessage" class="hidden mb-6 bg-emerald-50 border border-emerald-200 p-4 rounded-xl shadow-lg fixed top-6 right-6 z-[120] animate-fade-in-up">
    <div class="flex items-center">
        <div class="flex-shrink-0 bg-emerald-100 p-2 rounded-full">
            <svg class="h-5 w-5 text-emerald-600" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
        </div>
        <div class="ml-3">
            <p class="text-sm text-emerald-800 font-bold">Event provisioned successfully!</p>
        </div>
    </div>
</div>

<style>
    .highlight { font-weight: 800; color: #4f46e5; }
    @@keyframes fadeInUp {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .animate-fade-in-up {
        animation: fadeInUp 0.4s ease-out forwards;
    }
</style>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            
            const form = document.getElementById('createEventForm');
            const eventDetailsWrapper = document.getElementById('eventDetailsWrapper');
            const bottomActionBar = document.getElementById('bottomActionBar');
            const cancelChildBtn = document.getElementById('cancelChildBtn');
            const subEventsListContainer = document.getElementById('subEventsListContainer');
            
            const radioMaster = document.getElementById('radioFather');
            const radioChild = document.getElementById('radioChild');
            const isMultiDay = document.getElementById('isMultiDay');
            const singleCheckbox = document.getElementById('single-checkbox');
            const singleCheckboxContainer = document.getElementById('single-checkbox-container');
            const multiDayToggleContainer = document.getElementById('multiDayToggleContainer');
            
            const descriptionContainer = document.getElementById('descriptionContainer');
            const childDescriptionNote = document.getElementById('childDescriptionNote');
            const childImageNote = document.getElementById('childImageNote');
            const eventTypeSelect = document.getElementById('EventTypeId');
            const ticketPriceContainer = document.getElementById('ticketPriceContainer');
            const ticketPriceInput = document.getElementById('TicketPrice');

            const locationSection = document.getElementById('location-section');
            const venueLayoutFields = document.getElementById('venue-layout-fields');
            const venueSearch = document.getElementById('venueSearch');
            const venueResultsList = document.getElementById('venueSearchResults');
            const venueHiddenInput = document.getElementById('VenueId');
            const clearVenueBtn = document.getElementById('clearVenueSelection');
            const layoutSelect = document.getElementById('layoutSelect');

            const parentEventSection = document.getElementById('parentEventSection');
            const parentError = document.getElementById('parentRequiredError'); 
            const searchInput = document.getElementById('parentEventSearch');
            const resultsList = document.getElementById('searchResults');
            const hiddenIdInput = document.getElementById('ParentEventId');
            const clearBtn = document.getElementById('clearParentSelection');

            const startInput = document.querySelector('input[name="StartDateTime"]:not([type="hidden"])');
            const endInput = document.querySelector('input[name="EndTime"]:not([type="hidden"])');
            const multiStartDate = document.getElementById('StartDate');
            const multiEndDate = document.getElementById('EndDate');
            const multiStartTime = document.getElementById('StartTime');
            const multiDailyEndTime = document.getElementById('DailyEndTime');
            const singleDayContainer = document.getElementById('singleDayContainer');
            const multiDayContainer = document.getElementById('multiDayContainer');
            const eventPreviewList = document.getElementById('eventPreviewList');
            const cont = document.getElementById('datePreviewContainer');
            
            const allScheduleInputs = [startInput, endInput, multiStartDate, multiEndDate, multiStartTime, multiDailyEndTime];
            let namingIds = [];
            let previewDates = [];

            // Validation Reset
            function resetValidationColors() {
                venueSearch.classList.remove('border-red-500', 'bg-red-50');
                layoutSelect.classList.remove('border-red-500', 'bg-red-50');
            }

            venueSearch.addEventListener('input', function() {
                this.classList.remove('border-red-500', 'bg-red-50');
            });
            layoutSelect.addEventListener('change', function() {
                this.classList.remove('border-red-500', 'bg-red-50');
            });

            // UI State Management
            window.handleLayoutAndVenueState = function() {
                const isMasterMode = radioMaster.checked;
                const isStandalone = singleCheckbox.checked || isMultiDay.checked;
                
                if (isMasterMode) {
                    if (isStandalone) {
                        venueLayoutFields.classList.remove('hidden');
                        ticketPriceContainer.classList.remove('hidden');
                        venueSearch.disabled = false;
                        layoutSelect.disabled = false;
                    } else {
                        venueLayoutFields.classList.add('hidden');
                        ticketPriceContainer.classList.add('hidden');
                        venueSearch.disabled = true;
                        layoutSelect.disabled = true;
                        venueHiddenInput.value = '';
                        venueSearch.value = '';
                        layoutSelect.value = '';
                        if(ticketPriceInput) ticketPriceInput.value = '';
                        clearVenueBtn.classList.add('hidden');
                        resetValidationColors();
                    }
                }
            };

            window.toggleEventMode = function(mode, isManualClick = false) {
                const isMaster = (mode === 'father');

                if (isManualClick) {
                    form.reset();
                    radioMaster.checked = isMaster;
                    radioChild.checked = !isMaster;
                    resetValidationColors();
                    
                    document.getElementById('imagePreviewContainer').classList.add('hidden');
                    document.getElementById('galleryPreviewContainer').classList.add('hidden');
                    venueHiddenInput.value = '';
                    layoutSelect.innerHTML = '<option value="">Select a Layout</option>';
                    hiddenIdInput.value = '';
                    searchInput.value = '';
                    resultsList.classList.add('hidden');
                }

                multiDayToggleContainer.classList.toggle('hidden', isMaster);
                if(childImageNote) childImageNote.classList.toggle('hidden', isMaster);
                if(descriptionContainer) descriptionContainer.classList.toggle('hidden', !isMaster);
                if(childDescriptionNote) childDescriptionNote.classList.toggle('hidden', isMaster);
                
                if (isMaster) {
                    eventDetailsWrapper.classList.remove('hidden'); 
                    bottomActionBar.classList.remove('hidden');
                    cancelChildBtn.classList.add('hidden'); 
                    subEventsListContainer.classList.add('hidden');
                    parentEventSection.classList.add('hidden');
                    
                    locationSection.classList.remove('hidden');
                    singleCheckboxContainer.classList.remove('hidden');
                    
                    handleLayoutAndVenueState(); 
                    
                    allScheduleInputs.forEach(i => { if (i) i.disabled = false; });
                    isMultiDay.checked = false;
                    singleDayContainer.classList.remove('hidden');
                    multiDayContainer.classList.add('hidden');
                    if(parentError) parentError.classList.add('hidden');
                    eventTypeSelect.disabled = false;
                    
                    resetDateConstraints();
                    isMultiDay.disabled = false;
                    document.querySelector('label[for="isMultiDay"]').classList.remove('text-gray-400');
                } else {
                    eventDetailsWrapper.classList.add('hidden'); 
                    bottomActionBar.classList.add('hidden');
                    parentEventSection.classList.remove('hidden');
                    
                    if (hiddenIdInput.value) {
                        subEventsListContainer.classList.remove('hidden');
                    }
                    
                    locationSection.classList.remove('hidden');
                    singleCheckboxContainer.classList.add('hidden');
                    venueLayoutFields.classList.remove('hidden'); 
                    if(ticketPriceContainer) ticketPriceContainer.classList.remove('hidden');
                    
                    venueSearch.disabled = false;
                    layoutSelect.disabled = true; 
                    eventTypeSelect.disabled = true;
                    allScheduleInputs.forEach(i => { if(i) i.disabled = true; });
                }
                
                updateRadioStyles();
            };

            function updateRadioStyles() {
                const labelF = document.getElementById('labelFather');
                const labelC = document.getElementById('labelChild');

                labelF.className = "flex-1 text-center py-2.5 transition-all rounded-lg";
                labelC.className = "flex-1 text-center py-2.5 transition-all rounded-lg";

                if (radioMaster.checked) {
                    labelF.classList.add('cursor-pointer', 'bg-white', 'shadow-sm');
                    labelF.querySelector('span').className = "text-indigo-700 font-bold";
                    labelC.classList.add('cursor-pointer');
                    labelC.querySelector('span').className = "text-white font-medium flex items-center justify-center";
                } else {
                    labelC.classList.add('cursor-pointer', 'bg-white', 'shadow-sm');
                    labelC.querySelector('span').className = "text-indigo-700 font-bold flex items-center justify-center";
                    labelF.classList.add('cursor-pointer');
                    labelF.querySelector('span').className = "text-white font-medium";
                }
            }

            window.resetToCleanMasterMode = function() {
                toggleEventMode('father', true);
                window.scrollTo({top: 0, behavior: 'smooth'});
            };

            window.showChildEventForm = function() {
                eventDetailsWrapper.classList.remove('hidden');
                bottomActionBar.classList.remove('hidden');
                cancelChildBtn.classList.remove('hidden'); 
                document.getElementById('Name').focus();
                window.scrollTo({top: eventDetailsWrapper.offsetTop - 50, behavior: 'smooth'});
            };

            window.hideChildEventForm = function() {
                eventDetailsWrapper.classList.add('hidden');
                bottomActionBar.classList.add('hidden');
                
                document.getElementById('Name').value = '';
                document.getElementById('Description').value = '';
                if(ticketPriceInput) ticketPriceInput.value = '';
                document.getElementById('imagePreviewContainer').classList.add('hidden');
                document.getElementById('galleryPreviewContainer').classList.add('hidden');
                document.getElementById('galleryPreviewContainer').innerHTML = '';
                resetDateConstraints();
                resetValidationColors();
            };

            // Constraint Validation

            async function applyParentTimingConstraints(parentId) {
                if (!parentId) return;
                try {
                    const response = await fetch(`/Events/GetEventTiming?id=${parentId}`);
                    if (!response.ok) throw new Error("Failed to fetch parent timing.");
                    const timing = await response.json();

                    const minISO = timing.start.substring(0, 16);
                    const maxISO = timing.end.substring(0, 16);
                    const minD = minISO.split('T')[0];
                    const maxD = maxISO.split('T')[0];

                    startInput.min = endInput.min = minISO; 
                    startInput.max = endInput.max = maxISO;
                    multiStartDate.min = multiEndDate.min = minD; 
                    multiStartDate.max = multiEndDate.max = maxD;
                    
                    multiStartTime.value = minISO.split('T')[1].substring(0, 5);
                    multiDailyEndTime.value = maxISO.split('T')[1].substring(0, 5);

                    if (minD === maxD) {
                        isMultiDay.checked = false;
                        isMultiDay.disabled = true;
                        document.querySelector('label[for="isMultiDay"]').classList.add('text-gray-400');
                        singleDayContainer.classList.remove('hidden');
                        multiDayContainer.classList.add('hidden');
                    } else {
                        isMultiDay.disabled = false;
                        document.querySelector('label[for="isMultiDay"]').classList.remove('text-gray-400');
                    }
                    if (isMultiDay.checked) updatePreview();
                } catch (err) { console.error("Error applying constraints:", err); }
            }

            function enforceParentConstraints() {
                if (!radioChild.checked || !hiddenIdInput.value) return false;

                const minISO = startInput.getAttribute('min');
                const maxISO = startInput.getAttribute('max');

                if (!minISO || !maxISO) return false;

                let alerted = false;

                if (!isMultiDay.checked) {
                    if (startInput.value && startInput.value < minISO) {
                        alert(`Sub-events cannot start before the Master Event (${minISO.replace('T', ' ')})`);
                        startInput.value = minISO;
                        alerted = true;
                    } else if (startInput.value && startInput.value > maxISO) {
                        alert(`Sub-events cannot start after the Master Event (${maxISO.replace('T', ' ')})`);
                        startInput.value = maxISO;
                        alerted = true;
                    }

                    if (endInput.value && endInput.value < minISO) {
                        alert(`Sub-events cannot end before the Master Event (${minISO.replace('T', ' ')})`);
                        endInput.value = minISO;
                        alerted = true;
                    } else if (endInput.value && endInput.value > maxISO) {
                        alert(`Sub-events cannot end after the Master Event (${maxISO.replace('T', ' ')})`);
                        endInput.value = maxISO;
                        alerted = true;
                    }
                } 
                else {
                    const pDateMin = minISO.split('T')[0];
                    const pTimeMin = minISO.split('T')[1].substring(0, 5);
                    const pDateMax = maxISO.split('T')[0];
                    const pTimeMax = maxISO.split('T')[1].substring(0, 5);

                    if (multiStartDate.value && multiStartDate.value < pDateMin) {
                        alert(`Start Date cannot be earlier than Master Event (${pDateMin})`);
                        multiStartDate.value = pDateMin;
                        alerted = true;
                    } else if (multiStartDate.value && multiStartDate.value > pDateMax) {
                        alert(`Start Date cannot be later than Master Event (${pDateMax})`);
                        multiStartDate.value = pDateMax;
                        alerted = true;
                    }

                    if (multiEndDate.value && multiEndDate.value < pDateMin) {
                        alert(`End Date cannot be earlier than Master Event (${pDateMin})`);
                        multiEndDate.value = pDateMin;
                        alerted = true;
                    } else if (multiEndDate.value && multiEndDate.value > pDateMax) {
                        alert(`End Date cannot be later than Master Event (${pDateMax})`);
                        multiEndDate.value = pDateMax;
                        alerted = true;
                    }

                    if (multiStartDate.value === pDateMin && multiStartTime.value && multiStartTime.value < pTimeMin) {
                        alert(`Time on the first day cannot be earlier than Master Event (${pTimeMin})`);
                        multiStartTime.value = pTimeMin;
                        alerted = true;
                    }
                    if (multiEndDate.value === pDateMax && multiDailyEndTime.value && multiDailyEndTime.value > pTimeMax) {
                        alert(`Time on the last day cannot be later than Master Event (${pTimeMax})`);
                        multiDailyEndTime.value = pTimeMax;
                        alerted = true;
                    }
                }
                
                return alerted;
            }

            [startInput, endInput].forEach(input => {
                if(input) {
                    input.addEventListener('change', enforceParentConstraints);
                }
            });

            [multiStartDate, multiEndDate, multiStartTime, multiDailyEndTime].forEach(input => {
                if(input) {
                    input.addEventListener('change', function() {
                        const blocked = enforceParentConstraints();
                        if (!blocked) updatePreview();
                    });
                }
            });

            async function selectParent(ev) {
                hiddenIdInput.value = ev.id;
                searchInput.value = ev.name;
                searchInput.disabled = true;
                clearBtn.classList.remove('hidden');
                resultsList.classList.add('hidden');
                if(parentError) parentError.classList.add('hidden');

                subEventsListContainer.classList.remove('hidden');
                hideChildEventForm(); 
                updateSubEventsList(ev.id);

                eventTypeSelect.value = ev.eventTypeId;
                eventTypeSelect.disabled = true;
                
                venueHiddenInput.value = '';
                venueSearch.value = '';
                venueSearch.disabled = false;
                venueSearch.classList.remove('border-red-500', 'bg-red-50');
                
                clearVenueBtn.classList.add('hidden');
                layoutSelect.innerHTML = '<option value="">Select a Layout</option>';
                layoutSelect.disabled = true;
                layoutSelect.classList.remove('border-red-500', 'bg-red-50');

                allScheduleInputs.forEach(i => { if (i) i.disabled = false; });
                resetDateConstraints();
                await applyParentTimingConstraints(ev.id);
            }

            searchInput.addEventListener('input', function(e) {
                if (e.target.value.length < 2) { resultsList.classList.add('hidden'); return; }
                fetch(`/Events/SearchParentEvents?query=${encodeURIComponent(e.target.value)}`)
                    .then(res => res.json())
                    .then(data => {
                        resultsList.innerHTML = '';
                        data.forEach(ev => {
                            const li = document.createElement('li');
                            li.className = 'px-5 py-3 hover:bg-indigo-50 cursor-pointer border-b border-gray-50 text-sm transition-colors';
                            li.innerHTML = `<span class="font-bold text-gray-900 block">${ev.name}</span><span class="text-xs text-gray-500 block mt-0.5">${ev.venue} | ${ev.date}</span>`;
                            li.onclick = () => selectParent(ev);
                            resultsList.appendChild(li);
                        });
                        resultsList.classList.remove('hidden');
                    });
            });

            clearBtn.onclick = () => {
                hiddenIdInput.value = ''; searchInput.value = ''; searchInput.disabled = false;
                clearBtn.classList.add('hidden'); 
                if(radioChild.checked) {
                    venueHiddenInput.value = "";
                    venueSearch.value = "";
                    clearVenueBtn.classList.add('hidden');
                    layoutSelect.disabled = true;
                    layoutSelect.innerHTML = '<option value="">Select a layout</option>';
                    allScheduleInputs.forEach(i => { if(i) i.disabled = true; });
                    subEventsListContainer.classList.add('hidden');
                    hideChildEventForm();
                }
                isMultiDay.disabled = false;
                document.querySelector('label[for="isMultiDay"]').classList.remove('text-gray-400');
                resetDateConstraints();
            };

            venueSearch.addEventListener('input', function(e) {
                if (e.target.value.length < 1) { venueResultsList.classList.add('hidden'); return; }
                fetch(`/Events/SearchVenues?query=${encodeURIComponent(e.target.value)}`)
                    .then(res => res.json())
                    .then(data => {
                        const query = e.target.value;
                        venueResultsList.innerHTML = '';
                        data.forEach(v => {
                            const li = document.createElement('li');
                            li.className = 'px-5 py-3 hover:bg-indigo-50 cursor-pointer border-b border-gray-50 text-sm transition-colors';
                            li.innerHTML = `<span class="font-bold text-gray-900 block">${highlightMatch(v.name, query)}</span><span class="text-xs text-gray-500 block mt-0.5">${highlightMatch(v.city || '', query)}</span>`;
                            li.onclick = () => {
                                venueHiddenInput.value = v.id;
                                venueSearch.value = v.name + (v.city ? ', ' + v.city : '');
                                venueSearch.disabled = false;
                                clearVenueBtn.classList.remove('hidden');
                                venueResultsList.classList.add('hidden');
                                fetchLayouts(v.id);
                                layoutSelect.disabled = false;
                                resetValidationColors();
                            };
                            venueResultsList.appendChild(li);
                        });
                        venueResultsList.classList.remove('hidden');
                    });
            });

            function highlightMatch(text, query) {
                if (!query) return text;
                const regex = new RegExp('(' + query.replace(/[-\/\\^$*+?.()|[\]{}]/g, '\\$&') + ')', 'gi');
                return text.replace(regex, '<span class="highlight">$1</span>');
            }

            clearVenueBtn.onclick = () => {
                venueHiddenInput.value = '';
                venueSearch.value = '';
                venueSearch.disabled = false;
                clearVenueBtn.classList.add('hidden');
                layoutSelect.innerHTML = '<option value="">Select a Layout</option>';
                layoutSelect.disabled = true;
            };

            function fetchLayouts(vId) {
                if(!vId) return;
                fetch(`/Events/GetLayouts?venueId=${vId}`)
                    .then(res => res.json())
                    .then(data => {
                        layoutSelect.innerHTML = '<option value="">Select a Layout</option>';
                        data.forEach(s => {
                            const opt = document.createElement('option');
                            opt.value = s.id; opt.textContent = s.areaName;
                            layoutSelect.appendChild(opt);
                        });
                    });
            }

            function resetDateConstraints() {
                allScheduleInputs.forEach(i => { if(i) { i.removeAttribute('min'); i.removeAttribute('max'); }});
                const now = new Date();
                const tzOffset = now.getTimezoneOffset() * 60000;
                const localISOTime = (new Date(now - tzOffset)).toISOString().slice(0, 16);
                const localISOLater = (new Date(now.getTime() + (2 * 3600000) - tzOffset)).toISOString().slice(0, 16);

                if(startInput) startInput.value = localISOTime;
                if(endInput) endInput.value = localISOLater;
                
                const todayDate = localISOTime.split('T')[0];
                if(multiStartDate) multiStartDate.value = todayDate;
                if(multiEndDate) multiEndDate.value = todayDate;
            }

            if(isMultiDay) {
                isMultiDay.onchange = function() {
                    singleDayContainer.classList.toggle('hidden', this.checked);
                    multiDayContainer.classList.toggle('hidden', !this.checked);
                    if(this.checked) updatePreview();
                    handleLayoutAndVenueState();
                };
            }

            function updatePreview() {
                enforceParentConstraints();
                const s = new Date(multiStartDate.value + 'T00:00:00');
                const e = new Date(multiEndDate.value + 'T00:00:00');

                previewDates = [];
                for (let d = new Date(s); d <= e; d.setDate(d.getDate() + 1)) {
                    previewDates.push(new Date(d));
                }
                renderPreviewTable();
            }

            function renderPreviewTable() {
                eventPreviewList.innerHTML = '';
                previewDates.forEach((date, index) => {
                    const row = document.createElement('tr');
                    row.setAttribute('data-date', date.toLocaleDateString('en-CA'));
                    row.innerHTML = `
                        <td class="px-4 py-2">${date.toLocaleDateString(undefined, { weekday: 'short', month: 'short', day: 'numeric' })}</td>
                        <td class="px-4 py-2 text-right">
                            <button type="button" onclick="removeDate(${index})" class="text-red-500 hover:text-red-700 font-bold">Delete</button>
                        </td>`;
                    eventPreviewList.appendChild(row);
                });
                document.getElementById('eventCount').textContent = previewDates.length;
                cont.classList.remove('hidden');
            }

            window.removeDate = function(index) {
                previewDates.splice(index, 1); 
                renderPreviewTable();
            };

            // Form Submission
            form.addEventListener('submit', async function(e) {
                
                e.preventDefault();
                
                if (typeof $(form).valid === "function" && !$(form).valid()) {
                    return; 
                }

                const blocked = enforceParentConstraints();
                if (blocked) return;

                const eventNameInput = document.getElementById('Name');
                if (!eventNameInput.value.trim()) {
                    alert("Please enter an Event Name.");
                    eventNameInput.focus();
                    return;
                }

                const isChild = radioChild.checked;
                const isMaster = radioMaster.checked;
                const isStandalone = singleCheckbox.checked || isMultiDay.checked;
                
                if (isChild && !hiddenIdInput.value) {
                    if(parentError) parentError.classList.remove('hidden');
                    return;
                }

                if (isChild || (isMaster && isStandalone)) {
                    let locationError = false;

                    if (!venueHiddenInput.value || venueHiddenInput.value === '0') {
                        venueSearch.classList.add('border-red-500', 'bg-red-50');
                        locationError = true;
                    }

                    if (!layoutSelect.value || layoutSelect.value === '0') {
                        layoutSelect.classList.add('border-red-500', 'bg-red-50');
                        locationError = true;
                    }

                    if (locationError) {
                        alert("ERROR: Sub-Events and Standalone events strictly require both a Venue and a Layout.");
                        document.getElementById('location-section').scrollIntoView({ behavior: 'smooth', block: 'center' });
                        return;
                    }
                } else {
                    venueHiddenInput.value = '';
                    layoutSelect.innerHTML = '<option value="">Select a Layout</option>';
                    layoutSelect.value = '';
                }

                if (isMultiDay.checked) {
                    const s = new Date(multiStartDate.value);
                    const e = new Date(multiEndDate.value);
                    if (isNaN(s) || isNaN(e) || s > e) { alert("Please select a valid date range."); return; }
                } else {
                    const s = new Date(startInput.value);
                    const e = new Date(endInput.value);
                    if (isNaN(s) || isNaN(e) || s >= e) { alert("Event must end after it starts."); return; }
                }

                allScheduleInputs.forEach(i => { if(i) i.disabled = false; });
                if (eventTypeSelect) eventTypeSelect.disabled = false;
                if (layoutSelect) layoutSelect.disabled = false;

                const formData = new FormData(form);

                if (isMultiDay.checked) {
                    const dateRows = document.querySelectorAll('#eventPreviewList tr');
                    const finalDates = Array.from(dateRows).map(row => row.getAttribute('data-date'));
                    formData.append("SpecificDatesJson", JSON.stringify(finalDates));
                    resetDateConstraints();
                    eventPreviewList.innerHTML='';
                    cont.classList.add('hidden');
                }

                const submitBtn = form.querySelector('button[type="submit"]');
                const originalBtnText = submitBtn.innerHTML;

                try {
                    submitBtn.innerHTML = 'Creating...';
                    submitBtn.disabled = true;

                    const response = await fetch(form.action, { method: 'POST', body: formData });

                    if (!response.ok) {
                        const errorData = await response.json().catch(() => ({ message: "A server error occurred (500)." }));
                        throw new Error(errorData.message || "Failed to create event.");
                    }

                    const data = await response.json(); 
                    const successAlert = document.getElementById('successMessage');
                    const alertText = successAlert.querySelector('p'); 
                    successAlert.classList.remove('hidden');
                    
                    const currentParentId = isMaster ? data.eventId : hiddenIdInput.value;
                    const currentParentName = isMaster ? data.eventName : searchInput.value;
                    const currentEventTypeId = isMaster ? data.eventTypeId : eventTypeSelect.value;
                    
                    if (isMaster) {
                        if (isStandalone) {
                            alertText.textContent = "Standalone Event created successfully!";
                            resetToCleanMasterMode(); 
                        } else {
                            alertText.textContent = "Master Event created! You can now quickly add Sub-Events for it.";
                            
                            radioMaster.checked = false;
                            radioChild.checked = true;
                            toggleEventMode('child');
                            
                            hiddenIdInput.value = data.eventId;
                            searchInput.value = data.eventName;
                            searchInput.disabled = true;          
                            clearBtn.classList.remove('hidden');   
                            resultsList.classList.add('hidden');   
                            
                            venueHiddenInput.value = '';
                            venueSearch.value = '';
                            venueSearch.disabled = false;
                            clearVenueBtn.classList.add('hidden');
                            layoutSelect.innerHTML = '<option value="">Select a Layout</option>';
                            layoutSelect.disabled = true;

                            if (eventTypeSelect) {
                                eventTypeSelect.value = data.eventTypeId;
                                eventTypeSelect.disabled = true;
                            }

                            allScheduleInputs.forEach(i => { if(i) i.disabled = false; });
                            resetDateConstraints();
                            await applyParentTimingConstraints(data.eventId);
                            updateSubEventsList(currentParentId);
                            
                            hideChildEventForm();
                        }
                    } else {
                        alertText.textContent = "Sub-Event created successfully!";
                        
                        form.reset(); 
                        
                        radioMaster.checked = false;
                        radioChild.checked = true;

                        document.getElementById('imagePreviewContainer').classList.add('hidden');
                        document.getElementById('galleryPreviewContainer').classList.add('hidden');
                        document.getElementById('galleryPreviewContainer').innerHTML = '';

                        hiddenIdInput.value = currentParentId;
                        searchInput.value = currentParentName;
                        searchInput.disabled = true;
                        clearBtn.classList.remove('hidden');
                        
                        venueHiddenInput.value = '';
                        venueSearch.value = '';
                        venueSearch.disabled = false;
                        clearVenueBtn.classList.add('hidden');
                        layoutSelect.innerHTML = '<option value="">Select a Layout</option>';
                        layoutSelect.disabled = true;
                        
                        if (eventTypeSelect) {
                            eventTypeSelect.value = currentEventTypeId;
                            eventTypeSelect.disabled = true;
                        }
                        
                        updateSubEventsList(currentParentId);
                        resetDateConstraints();
                        multiDayContainer.classList.add("hidden");
                        singleDayContainer.classList.remove("hidden");
                        
                        hideChildEventForm();
                    }
                    
                    setTimeout(() => successAlert.classList.add('hidden'), 5000);

                } catch (error) {
                    console.error("Submission failed:", error);
                    alert(error.message || "A network error occurred.");
                } finally {
                    submitBtn.innerHTML = originalBtnText;
                    submitBtn.disabled = false;
                    
                    if (isChild && !hiddenIdInput.value) {
                        allScheduleInputs.forEach(i => { if(i) i.disabled = true; });
                    }
                }
            });

            toggleEventMode('father'); 
        });

        // Sub-Event Management
        async function updateSubEventsList(parentId) {
            if (!parentId) return;
            try {
                const res = await fetch(`/Events/GetSubEvents?parentId=${parentId}`);
                const data = await res.json();
                
                const tbody = document.getElementById('subEventsTableBody');
                document.getElementById('subEventCountDisplay').textContent = data.length;
                document.getElementById('subEventsListContainer').classList.remove('hidden'); 
                
                if (data.length === 0) {
                    tbody.innerHTML = `<tr><td colspan="4" class="px-6 py-6 text-center text-sm font-bold text-gray-500 italic">No sub-events created yet.</td></tr>`;
                    return;
                }

                tbody.innerHTML = '';
                data.forEach(ev => {
                    const row = document.createElement('tr');
                    row.className = 'hover:bg-indigo-50/30 transition-colors';
                    row.innerHTML = `
                        <td class="namingData px-6 py-4 whitespace-nowrap flex items-center space-x-2">
                            <label class="hidden SubIdLabels">${ev.id}</label>
                            <input type="checkbox" class="h-4 w-4 hidden renameCheckboxes rounded border-gray-300 text-indigo-600"/>
                            <input type="text" id="edit-input-${ev.id}" value="${ev.name}" data-original-value="${ev.name}" onkeydown="if(event.key === 'Enter') { event.preventDefault(); saveEditName(${ev.id}); }" onfocus="showEditButtons(${ev.id})" class="renameField font-bold text-gray-900 border border-transparent hover:border-gray-300 rounded px-2 py-1 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 w-full max-w-[200px] transition-colors">
                            <button type="button" id="save-btn-${ev.id}" onclick="saveEditName(${ev.id})" class="hidden bg-emerald-500 hover:bg-emerald-600 text-white px-2 py-1 rounded text-xs transition-colors font-bold shadow-sm">Save</button>
                            <button type="button" id="cancel-btn-${ev.id}" onclick="cancelEditName(${ev.id})" class="hidden text-gray-500 hover:text-gray-700 px-2 py-1 text-xs transition-colors font-bold">Cancel</button>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap">
                            <div class="font-bold text-gray-700">${ev.date}</div>
                            <div class="text-[11px] text-indigo-600 font-bold uppercase tracking-wider mt-0.5">${ev.time}</div>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap"><div class="font-bold text-gray-900">${ev.layout}</div></td>
                        <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium flex justify-end items-center gap-2">
                            <button type="button" onclick="DuplicateSubEvent(${ev.id})" class="text-indigo-600 hover:text-white hover:bg-indigo-600 p-1.5 rounded-lg border border-indigo-100 bg-indigo-50 transition-colors" title="Duplicate"><svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 3a1 1 0 011 1v6h4a1 1 0 110 2h-4v6a1 1 0 11-2 0v-6H4a1 1 0 110-2h4V4a1 1 0 011-1z" clip-rule="evenodd" /></svg></button>
                            <button type="button" onclick="deleteSubEvent(${ev.id})" class="text-red-500 hover:text-white hover:bg-red-500 p-1.5 rounded-lg border border-red-100 bg-red-50 transition-colors" title="Delete"><svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd" /></svg></button>
                        </td>`;
                    tbody.appendChild(row);
                });
            } catch (e) { console.error("Error updating list", e); }
        }

        window.showRenameCheckboxes = function(){
            const checked = document.getElementById('MultiRenameCheckbox').checked;
            document.getElementById('ConfirmMultiRenameBtn').classList.toggle('hidden', !checked);
            document.querySelectorAll('.renameCheckboxes').forEach(cb => cb.classList.toggle('hidden', !checked));
            document.querySelectorAll('.renameField').forEach(f => f.disabled = checked);
            if (checked) { document.querySelectorAll('.SubIdLabels').forEach(lbl => cancelEditName(lbl.textContent)); }
        };

        window.showRenameModal = function() {
            document.getElementById("renameModal").classList.remove('hidden');
            document.body.classList.add('overflow-hidden');
        };

        window.closeRenameModal = function() {
            namingIds = [];
            document.getElementById("renameModal").classList.add('hidden');
            document.body.classList.remove('overflow-hidden');
        };

        window.RenameMultiple = async function(NewName){
            const Name = NewName.trim();
            if (!Name) { alert("Name cannot be empty."); return; }
            closeRenameModal();

            document.querySelectorAll('.namingData').forEach(data => {
                if (data.children[1].checked) namingIds.push(data.children[0].textContent);
            });
            if (namingIds.length === 0) { alert("Select at least one event to rename."); return; }

            const formData = new FormData();
            formData.append("NewName", Name);
            namingIds.forEach(id => formData.append("ids", id));

            try {
                const res = await fetch('/Events/MultiSubRename', { method: 'POST', body: formData });
                if (res.ok) {
                    updateSubEventsList(document.getElementById('ParentEventId').value);
                    document.getElementById('MultiRenameCheckbox').checked = false;
                    showRenameCheckboxes(); 
                    document.getElementById('ModalField').value = '';
                } else alert("Failed to rename events.");
            } catch (e) { console.error("Error bulk rename", e); }
        };

        window.showEditButtons = function(id) {
            document.getElementById(`save-btn-${id}`).classList.remove('hidden');
            document.getElementById(`cancel-btn-${id}`).classList.remove('hidden');
        };

        window.saveEditName = async function(id) {
            const inputField = document.getElementById(`edit-input-${id}`);
            const newName = inputField.value.trim();
            if (!newName) { alert("Name cannot be empty."); return; }
            if (!confirm("Rename this specific sub-event?")) { cancelEditName(id); return; }

            try {
                const res = await fetch(`/Events/EditSubSelectedName?id=${id}&NewName=${encodeURIComponent(newName)}`, { method: 'POST' });
                if (res.ok) {
                    inputField.setAttribute('data-original-value', newName);
                    document.getElementById(`save-btn-${id}`).classList.add('hidden');
                    document.getElementById(`cancel-btn-${id}`).classList.add('hidden');
                    inputField.blur();
                } else alert("Failed to rename the event.");
            } catch (e) { console.error("Error renaming", e); }
        };

        window.cancelEditName = function(id) {
            const inputField = document.getElementById(`edit-input-${id}`);
            if(inputField) {
                inputField.value = inputField.getAttribute('data-original-value');
                document.getElementById(`save-btn-${id}`).classList.add('hidden');
                document.getElementById(`cancel-btn-${id}`).classList.add('hidden');
                inputField.blur();
            }
        };

        window.deleteSubEvent = async function(id) {
            if (!confirm("Are you sure you want to delete this specific sub-event?")) return;
            try {
                const res = await fetch(`/Events/Delete?id=${id}&dAll=false`);
                if (res.ok) updateSubEventsList(document.getElementById('ParentEventId').value);
            } catch (e) { console.error("Error deleting", e); }
        };

        window.DuplicateSubEvent = async function(id) {
            if (!confirm("Are you sure you want to duplicate this specific sub-event?")) return;
            try {
                const res = await fetch(`/Events/DuplicateSubEvent?id=${id}`, { method: 'POST' });
                if (res.ok) updateSubEventsList(document.getElementById('ParentEventId').value);
            } catch (e) { console.error("Error duplicating", e); }
        };

        // Media Preview Handlers
        window.previewImage = function(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = e => { 
                    document.getElementById('imagePreview').src = e.target.result;
                    document.getElementById('imagePreviewContainer').classList.remove('hidden');
                };
                reader.readAsDataURL(input.files[0]);
            }
        };

        window.previewGalleryImages = function(input) {
            const container = document.getElementById('galleryPreviewContainer');
            container.innerHTML = ''; 
            if (input.files && input.files.length > 0) {
                container.classList.remove('hidden');
                Array.from(input.files).forEach(file => {
                    const reader = new FileReader();
                    reader.onload = e => {
                        const div = document.createElement('div');
                        div.className = 'relative aspect-square rounded-lg overflow-hidden border border-gray-200 shadow-sm bg-white';
                        div.innerHTML = `<img src="${e.target.result}" class="w-full h-full object-cover">`;
                        container.appendChild(div);
                    };
                    reader.readAsDataURL(file);
                });
            } else {
                container.classList.add('hidden');
            }
        };
    </script>
}