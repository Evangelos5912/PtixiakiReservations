@model IEnumerable<PtixiakiReservations.Models.Event>
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
    ViewData["Title"] = "Welcome";
    var currentUser = SignInManager.IsSignedIn(User) ? await UserManager.GetUserAsync(User) : null;
    var userRoles = currentUser != null ? await UserManager.GetRolesAsync(currentUser) : new List<string>();
}
<div class="w-full">

    <div class="bg-white dark:bg-gray-900 shadow-sm mb-10 w-full border-b border-gray-200 dark:border-gray-800 transition-colors">
        
        <!-- Header Banner -->
        <div class="w-full bg-gradient-to-r from-blue-600 to-indigo-700">
            <div class="max-w-7xl mx-auto px-4 py-4 sm:px-6 lg:px-8">
                <h3 class="text-xl font-bold text-white tracking-wide">Explore Events</h3>
            </div>
        </div>

        <!-- Search and Hero Panel -->
        <div id="panel-body" class="w-full">
            <div class="max-w-7xl mx-auto px-4 py-8 sm:px-6 lg:px-8">

                <div class="grid grid-cols-1 md:grid-cols-2 gap-10 items-center w-full">
                    
                    <!-- Search Input Column -->
                    <div class="flex flex-col w-full">
                        <div class="flex flex-col w-full lg:col-span-5 xl:col-span-6 z-20">
                            <div class="inline-flex items-center px-3 py-1 rounded-full bg-blue-50 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 text-xs font-bold tracking-wide uppercase mb-4 w-max border border-blue-100 dark:border-blue-800 transition-colors">
                                <span class="flex h-2 w-2 rounded-full bg-blue-600 mr-2 animate-pulse"></span>
                                Discover Experiences
                            </div>
                            
                            <h1 class="text-4xl lg:text-5xl font-extrabold text-gray-900 dark:text-white leading-tight mb-6 transition-colors">
                                Find your next <br />
                                <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-indigo-600">unforgettable</span> event.
                            </h1>
                            
                            <div class="bg-white dark:bg-gray-800 p-2 rounded-2xl shadow-lg border border-gray-100 dark:border-gray-700 mt-2 relative transition-colors">
                                <label for="search-term" class="sr-only">Search Events</label>
                                <div class="relative w-full flex items-center">
                                    <div class="absolute left-4 text-gray-400">
                                        <svg class="h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
                                    </div>
                                    
                                    <input type="text" id="search-term" placeholder="Search by event name, venue, or city..." class="block w-full pl-12 pr-4 py-4 text-gray-900 dark:text-white bg-transparent border-none focus:ring-0 text-base sm:text-lg font-medium placeholder-gray-400 outline-none" autocomplete="off">
                                        
                                    <button id="search-button" class="hidden sm:flex shrink-0 px-6 py-3 bg-blue-600 text-white font-bold rounded-xl hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all transform hover:scale-105 shadow-md border-none !no-underline">
                                        Search
                                    </button>
                                </div>
                                
                                <div id="autocomplete-dropdown" class="absolute left-0 right-0 top-[calc(100%+10px)] z-30 bg-white dark:bg-gray-800 shadow-2xl rounded-2xl border border-gray-100 dark:border-gray-700 hidden max-h-72 overflow-y-auto w-full transition-colors"></div>
                            </div>
                            
                            <button id="search-button-mobile" class="sm:hidden mt-4 w-full px-6 py-4 bg-blue-600 text-white font-bold rounded-xl hover:bg-blue-700 shadow-md border-none !no-underline">Search Events</button>
                            <p id="search-validation-message" class="text-red-500 text-sm font-medium mt-2 hidden ml-2">* Please type something to search.</p>
                        </div>
                    </div>
                    
                    <!-- Alpine.js Hero Carousel -->
                    <div class="hidden md:block w-full">
                        <div x-data="heroCarousel()" 
                             x-init="fetchEvents()"
                             x-on:mouseenter="pauseAutoplay()" 
                             x-on:mouseleave="resumeAutoplay()"
                             class="relative w-full h-[400px] overflow-hidden rounded-3xl shadow-2xl bg-gray-900 border border-gray-100 dark:border-gray-800">
                            
                            <div x-show="loading" class="absolute inset-0 flex items-center justify-center bg-gray-800 animate-pulse z-30">
                                <svg class="w-10 h-10 text-gray-400 animate-spin" fill="none" viewBox="0 0 24 24">
                                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                                </svg>
                            </div>

                            <template x-for="(event, index) in events" :key="event.id">
                                <div x-show="currentIndex === index"
                                     x-transition:enter="transition ease-out duration-700"
                                     x-transition:enter-start="opacity-0 scale-105"
                                     x-transition:enter-end="opacity-100 scale-100"
                                     x-transition:leave="transition ease-in duration-500"
                                     x-transition:leave-start="opacity-100"
                                     x-transition:leave-end="opacity-0"
                                     class="absolute inset-0 w-full h-full">
                                    
                                    <img :src="event.imagePath ? event.imagePath : '/images/default-event-placeholder.jpg'" 
                                         :alt="event.name"
                                         class="absolute inset-0 w-full h-full object-cover" />
                                    
                                    <div class="absolute inset-0 bg-gradient-to-t from-gray-950 via-gray-900/40 to-transparent"></div>

                                    <div class="absolute bottom-0 left-0 w-full p-8 text-white z-10">
                                        <div class="flex items-center gap-2 mb-2">
                                            <span class="px-3 py-1 text-xs font-bold uppercase tracking-wider bg-blue-600/90 backdrop-blur-sm rounded-full shadow-sm" x-show="event.eventType" x-text="event.eventType"></span>
                                            <span class="px-3 py-1 text-xs font-bold uppercase tracking-wider bg-emerald-500/90 backdrop-blur-sm rounded-full shadow-sm" 
                                                  x-text="getPriceDisplay(event)">
                                            </span>
                                        </div>
                                        <h2 class="text-3xl font-extrabold mt-1 drop-shadow-md line-clamp-2" x-text="event.name"></h2>
                                        <div class="flex items-center gap-3 text-gray-200 text-sm mt-2 font-medium">
                                            <span x-text="formatDate(event.startDateTime)"></span>
                                            <span class="text-gray-400">&bull;</span>
                                            
                                            <!-- Tooltip container for AlpineJS location display -->
                                            <div class="tooltip-container relative inline-block" x-show="getLocationTooltip(event) !== ''">
                                                <span class="cursor-help border-b border-dashed border-gray-400" x-text="getLocationText(event)"></span>
                                                <span class="tooltip-text" x-text="getLocationTooltip(event)"></span>
                                            </div>
                                            <span x-show="getLocationTooltip(event) === ''" x-text="getLocationText(event)"></span>
                                            
                                        </div>
                                    </div>
                                    <a :href="'/Events/Details/' + event.id" class="absolute inset-0 z-20"></a>
                                </div>
                            </template>

                            <button x-on:click="prev()" class="absolute left-4 top-1/2 -translate-y-1/2 p-3 bg-black/30 hover:bg-black/60 text-white rounded-full backdrop-blur-md transition-all hidden md:block z-30 cursor-pointer border-none">
                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
                            </button>
                            <button x-on:click="next()" class="absolute right-4 top-1/2 -translate-y-1/2 p-3 bg-black/30 hover:bg-black/60 text-white rounded-full backdrop-blur-md transition-all hidden md:block z-30 cursor-pointer border-none">
                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                            </button>

                            <div class="absolute bottom-4 left-1/2 -translate-x-1/2 flex gap-2 z-30">
                                <template x-for="(event, index) in events" :key="'dot-'+index">
                                    <button x-on:click="goTo(index)" 
                                            class="h-2 rounded-full transition-all duration-300 border-none cursor-pointer"
                                            :class="currentIndex === index ? 'w-8 bg-blue-500' : 'w-2 bg-white/50 hover:bg-white/80'"></button>
                                </template>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>

    <div class="container mx-auto px-4 py-8 max-w-7xl">
        @Html.AntiForgeryToken()
        
        @if (!SignInManager.IsSignedIn(User))
        {
            <div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg mb-10 overflow-hidden transition-colors">
                <div class="grid grid-cols-1 bg-gradient-to-r from-blue-600 to-indigo-700 px-6 py-4 flex flex-row items-center justify-between p-5">
                    <h3 class="text-2xl font-bold text-white mb-5">Create an Account or Log in</h3>
                    <p class="text-lg font-bold text-white mb-5">Make sure to Create or Log in with an account to get access to the features of the app and your personal profile where you can request higher role privileges.</p>
                    <div class="mb-5">
                        <a class="mr-5 px-6 py-3 bg-white text-blue-600 font-bold rounded-lg shadow-md hover:bg-gray-100 transition-colors inline-block !no-underline" asp-area="Identity" asp-page="/Account/Login">
                            Log in
                        </a>
                        <a class="px-6 py-3 bg-white text-blue-600 font-bold rounded-lg shadow-md hover:bg-gray-100 transition-colors inline-block !no-underline" asp-area="Identity" asp-page="/Account/Register">
                            Register
                        </a>
                    </div>
                </div>        
            </div>
        }

        <!-- Recent Events -->
        <div class="mb-10 overflow-hidden">
            <div class="flex w-full max-w-7xl justify-between rounded-xl p-5 bg-gradient-to-r from-blue-600 to-indigo-700 rounded">
                <div>
                    <h3 class="text-2xl font-bold text-white mb-2">Recent Events</h3>
                    <p class="text-lg text-white">Don't miss out on the most recent events.</p>
                </div>
                <div class="flex items-center">
                    <a class="text-blue-600 bg-white rounded-3xl font-bold px-4 py-2 hover:bg-gray-100 shadow-md !no-underline" href="@Url.Action("EventsForToday", "Events")">View all Events</a>
                </div>
            </div>
            <div class="relative w-full max-w-6xl mx-auto px-12 py-5">
                <div class="overflow-hidden rounded-3xl py-4"> 
                    <div id="recent-events-track" class="flex transition-transform duration-500 ease-out" style="transform: translateX(0%);"></div>
                </div>
                <button id="recent-prev-btn" class="absolute left-0 top-1/2 -translate-y-1/2 bg-white dark:bg-gray-800 text-gray-800 dark:text-white p-3 rounded-full shadow-md hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors z-10 disabled:opacity-50 border-none cursor-pointer">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
                </button>
                <button id="recent-next-btn" class="absolute right-0 top-1/2 -translate-y-1/2 bg-white dark:bg-gray-800 text-gray-800 dark:text-white p-3 rounded-full shadow-md hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors z-10 disabled:opacity-50 border-none cursor-pointer">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
                </button>
            </div>
        </div>

        <!-- Event Categories -->
        <div class="mb-10 overflow-hidden">
            <div class="relative w-full max-w-6xl px-5">
                <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-2 transition-colors">Event Categories</h3>
                <p class="text-lg text-gray-700 dark:text-gray-300 transition-colors">Choose one of our many Categories, we must have something you like.</p>
            </div>
            <div class="relative w-full max-w-6xl mx-auto px-12 py-5">
                <div class="overflow-hidden rounded-xl">
                    <div id="category-track" class="flex transition-transform duration-500 ease-out" style="transform: translateX(0%);"></div>
                </div>
                <button id="prev-btn" class="absolute left-0 top-1/2 -translate-y-1/2 bg-white dark:bg-gray-800 text-gray-800 dark:text-white p-3 rounded-full shadow-md hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors z-10 disabled:opacity-50 border-none cursor-pointer">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
                </button>
                <button id="next-btn" class="absolute right-0 top-1/2 -translate-y-1/2 bg-white dark:bg-gray-800 text-gray-800 dark:text-white p-3 rounded-full shadow-md hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors z-10 disabled:opacity-50 border-none cursor-pointer">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
                </button>
            </div>
        </div>

        <!-- New Arrivals -->
        <div class="mb-10 overflow-hidden">
            <div class="flex w-full max-w-7xl justify-between rounded-xl p-5 bg-gradient-to-r from-blue-600 to-indigo-700 rounded">
                <div>
                    <h3 class="text-2xl font-bold text-white mb-2">New Arrivals</h3>
                    <p class="text-lg text-white">View some of our newest Events.</p>
                </div>
                <div class="flex items-center">
                    <a class="text-blue-600 bg-white rounded-3xl px-4 py-2 font-bold hover:bg-gray-100 shadow-md !no-underline" href="@Url.Action("EventsForToday", "Events")">View all Events</a>
                </div>
            </div>
            <div class="relative w-full max-w-6xl mx-auto px-12 py-5">
                <div class="overflow-hidden rounded-xl py-4"> 
                    <div id="new-events-track" class="flex transition-transform duration-500 ease-out" style="transform: translateX(0%);"></div>
                </div>
                <button id="new-prev-btn" class="absolute left-0 top-1/2 -translate-y-1/2 bg-white dark:bg-gray-800 text-gray-800 dark:text-white p-3 rounded-full shadow-md hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors z-10 disabled:opacity-50 border-none cursor-pointer">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
                </button>
                <button id="new-next-btn" class="absolute right-0 top-1/2 -translate-y-1/2 bg-white dark:bg-gray-800 text-gray-800 dark:text-white p-3 rounded-full shadow-md hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors z-10 disabled:opacity-50 border-none cursor-pointer">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    .tooltip-container { position: relative; display: inline-block; cursor: help; overflow: visible; }
    .tooltip-text {
        visibility: hidden; opacity: 0; background-color: #333; color: #fff; text-align: center;
        padding: 8px 12px; border-radius: 6px; width: max-content; max-width: 200px;
        position: absolute; z-index: 10; bottom: 130%; left: 50%; transform: translateX(-50%);
        transition: opacity 0.3s ease, visibility 0.3s ease;
    }
    .tooltip-text::after {
        content: ""; position: absolute; top: 100%; left: 50%; margin-left: -6px;
        border-width: 6px; border-style: solid; border-color: #333 transparent transparent transparent;
    }
    .tooltip-container:hover .tooltip-text { visibility: visible; opacity: 1; }

    .wishlist-hover-badge { opacity: 1; visibility: visible; }
    @@media (min-width: 1024px) {
        .wishlist-hover-badge { opacity: 0; visibility: hidden; transition: all 0.2s ease-in-out; }
        .event-card-link:hover .wishlist-hover-badge { opacity: 1; visibility: visible; }
    }
</style>

<script>
    const currentUserId = '@UserManager.GetUserId(User)';

    window.wishlistAction = function(e, eventId) {
        e.preventDefault(); e.stopPropagation();
        if (!currentUserId || currentUserId === '') { alert("You must be logged in to use this feature."); return; }
        const token = $('input[name="__RequestVerificationToken"]').val();
        const wParams = { eventId: eventId, userId: currentUserId };

        $.getJSON('/Wishlist/returnItem', wParams).done(function(isWishlisted) {
            const url = !isWishlisted ? '/Wishlist/addWishlistEvent' : '/Wishlist/deleteWishlistEvent';
            const method = !isWishlisted ? 'POST' : 'DELETE';
            
            $.ajax({
                url: url, type: method, data: wParams, headers: { "RequestVerificationToken": token },
                success: function(success) {
                    if (success) {
                        const fill = !isWishlisted ? '#eab308' : 'none';
                        $(`.wishlist-id-${eventId}`).html(`
                            <button type="button" onclick="window.wishlistAction(event, ${eventId})" class="border-none bg-transparent cursor-pointer">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="${fill}" stroke="#eab308" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                                </svg>
                            </button>`);
                    }
                }
            });
        });
    }

    // Helper formatting functions
    function formatCityLocation(event) {
        const childCount = event.childCount || event.ChildCount || 0;
        const distinctCities = event.distinctCities || event.DistinctCities || 0;
        const cityNames = event.cityNames || event.CityNames || [];
        const baseCity = event.cityName || event.CityName || 'Unknown';

        let locationText = baseCity;
        let tooltipHtml = '';

        if (childCount > 0) {
            if (distinctCities > 1) {
                locationText = distinctCities + ' Cities';
                tooltipHtml = `<span class="tooltip-text" role="tooltip">${cityNames.join(', ')}</span>`;
            } else if (distinctCities === 1 && cityNames.length > 0) {
                locationText = cityNames[0];
            }
        }

        return tooltipHtml !== '' 
            ? `<div class="tooltip-container relative inline-block"><span class="cursor-help border-b border-dashed border-gray-400">${locationText}</span>${tooltipHtml}</div>` 
            : `<span>${locationText}</span>`;
    }

    function formatPrice(event) {
        const childCount = event.childCount || event.ChildCount || 0;
        if (childCount > 0) {
            const minP = event.minPrice !== undefined ? event.minPrice : event.MinPrice;
            const maxP = event.maxPrice !== undefined ? event.maxPrice : event.MaxPrice;
            if (minP != null && maxP != null) {
                return minP === maxP ? (minP > 0 ? `€${minP}` : "Free") : `€${minP} - €${maxP}`;
            }
        }
        const tPrice = event.ticketPrice !== undefined ? event.ticketPrice : event.TicketPrice;
        return (tPrice != null && tPrice > 0) ? `€${tPrice}` : "Free";
    }

    function generateCardHTML(event) {
        const startDate = new Date(event.startDateTime).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
        const endDate = new Date(event.endTime).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
        const priceHtml = formatPrice(event);
        const cityHtml = formatCityLocation(event);
        
        const imageHtml = event.imagePath 
            ? `<img src="${event.imagePath}" alt="${event.name}" class="w-full h-40 object-cover rounded-t-xl" />`
            : `<div class="w-full h-40 bg-gradient-to-br from-gray-700 to-gray-900 flex items-center justify-center text-gray-400 rounded-t-xl">
                <svg class="h-10 w-10" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
               </div>`;

        const categoryHtml = event.eventType ? `<span class="text-xs font-bold text-blue-700 dark:text-blue-300 uppercase tracking-wider bg-blue-50 dark:bg-blue-900/30 px-2 py-1 rounded-md border border-blue-100 dark:border-blue-800">${event.eventType}</span>` : '';

        return `
            <div class="w-full sm:w-1/2 lg:w-1/3 flex-shrink-0 px-3">
                <a href="/Events/Details/${event.id}" class="event-card-link block bg-white dark:bg-gray-800 rounded-xl shadow-md hover:shadow-xl hover:-translate-y-1 transition-all cursor-pointer h-full border border-gray-100 dark:border-gray-700 relative !no-underline">
                    ${imageHtml}
                    <div class="wishlist-hover-badge cursor-help absolute top-3 left-6 mt-3 mr-3 bg-white text-indigo-800 text-xs font-bold px-2 py-1 z-30 rounded-full shadow-sm wishlist-id-${event.id}">
                        <button type="button" onclick="window.wishlistAction(event, ${event.id})" class="border-none bg-transparent cursor-pointer">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#eab308" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                        </button>
                    </div>
                    <div class="p-5">
                        <div class="flex flex-wrap items-center gap-2 mb-2">
                            ${categoryHtml}
                            <span class="text-xs font-bold text-emerald-700 dark:text-emerald-300 uppercase tracking-wider bg-emerald-50 dark:bg-emerald-900/30 px-2 py-1 rounded-md border border-emerald-100 dark:border-emerald-800">${priceHtml}</span>
                        </div>
                        <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-2 line-clamp-2">${event.name}</h3>
                        <div class="flex items-center text-sm text-gray-500 dark:text-gray-400 mb-1">
                            <svg class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                            ${startDate} - ${endDate}
                        </div>
                        <div class="mt-3 text-sm font-bold text-gray-600 dark:text-gray-300">
                            ${cityHtml}
                        </div>
                    </div>
                </a>
            </div>
        `;
    }

    // Initialize Category Slider
    document.addEventListener('DOMContentLoaded', async function() {
        const track = document.getElementById('category-track');
        const gradients = ['from-purple-500 to-indigo-600', 'from-blue-400 to-blue-600', 'from-green-400 to-teal-500', 'from-yellow-400 to-orange-500', 'from-pink-400 to-rose-500'];

        try {
            const response = await fetch('/EventType/GetCategories'); 
            const categories = await response.json();

            categories.forEach((category, index) => {
                const colorClass = gradients[index % gradients.length];
                const content = category.imagePath 
                    ? `<img src="${category.imagePath}" alt="${category.name}" class="w-full h-full object-cover rounded-2xl" /><div class="absolute inset-0 bg-gradient-to-t from-gray-900 via-transparent to-transparent rounded-2xl"></div>` 
                    : `<div class="absolute inset-0 bg-gradient-to-br ${colorClass} rounded-2xl"></div>`;

                track.insertAdjacentHTML('beforeend', `
                    <div class="w-full sm:w-1/2 lg:w-1/3 flex-shrink-0 px-3">
                        <a href="/Events/EventsForToday?eventTypeId=${category.id}" class="relative block rounded-2xl p-8 h-64 flex flex-col justify-end text-white shadow-lg hover:shadow-xl hover:-translate-y-1 transition-all cursor-pointer !no-underline">
                            ${content}
                            <h3 class="absolute bottom-8 left-8 text-2xl font-bold z-10">${category.name}</h3>
                        </a>
                    </div>
                `);
            });
            initializeSlider(track, document.getElementById('prev-btn'), document.getElementById('next-btn'));
        } catch (e) { track.innerHTML = '<p class="text-red-500 px-3">Failed to load categories.</p>'; }
    });

    // Load Sliders
    document.addEventListener('DOMContentLoaded', async function() {
        ['newest', 'recent'].forEach(async type => {
            const track = document.getElementById(type === 'newest' ? 'new-events-track' : 'recent-events-track');
            try {
                const url = type === 'newest' ? '/Events/getNewestEvents' : '/Events/getRecentEvents';
                const response = await fetch(url);
                const events = await response.json();
                
                if (events.length === 0) { track.innerHTML = '<p class="text-gray-500 px-3">No events found.</p>'; return; }
                events.forEach(event => track.insertAdjacentHTML('beforeend', generateCardHTML(event)));
                initializeSlider(track, document.getElementById(`${type === 'newest' ? 'new' : 'recent'}-prev-btn`), document.getElementById(`${type === 'newest' ? 'new' : 'recent'}-next-btn`));
            } catch (e) { track.innerHTML = '<p class="text-red-500 px-3">Failed to load events.</p>'; }
        });
    });

    function initializeSlider(trackElement, prevButton, nextButton) {
        const cards = trackElement.children;
        if (cards.length === 0) return;
        let currentIndex = 0;
        function updateSlider() {
            let visibleCards = window.innerWidth >= 1024 ? 3 : (window.innerWidth >= 640 ? 2 : 1);
            const maxIndex = Math.max(0, cards.length - visibleCards);
            currentIndex = Math.max(0, Math.min(currentIndex, maxIndex));
            trackElement.style.transform = `translateX(-${currentIndex * cards[0].offsetWidth}px)`;
            prevButton.disabled = currentIndex === 0;
            nextButton.disabled = currentIndex >= maxIndex;
        }
        nextButton.addEventListener('click', () => { currentIndex++; updateSlider(); });
        prevButton.addEventListener('click', () => { currentIndex--; updateSlider(); });
        window.addEventListener('resize', updateSlider);
        updateSlider(); 
    }
</script>

<script>
    function heroCarousel() {
        return {
            events: [], currentIndex: 0, loading: true, autoplayInterval: null,
            async fetchEvents() {
                try {
                    const response = await fetch('/Events/getNewestEvents');
                    const data = await response.json();
                    if (data && data.length > 0) { this.events = data; this.loading = false; this.resumeAutoplay(); }
                    else { this.loading = false; }
                } catch (e) { this.loading = false; }
            },
            next() { if (this.events.length) this.currentIndex = (this.currentIndex + 1) % this.events.length; },
            prev() { if (this.events.length) this.currentIndex = (this.currentIndex - 1 + this.events.length) % this.events.length; },
            goTo(index) { this.currentIndex = index; },
            resumeAutoplay() { clearInterval(this.autoplayInterval); this.autoplayInterval = setInterval(() => this.next(), 5000); },
            pauseAutoplay() { clearInterval(this.autoplayInterval); },
            formatDate(d) { return d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : ''; },
            getPriceDisplay(event) { return formatPrice(event); },
            getLocationText(event) {
                const childCount = event.childCount || 0;
                const distCities = event.distinctCities || 0;
                if (childCount > 0) {
                    if (distCities > 1) return distCities + ' Cities';
                    if (distCities === 1 && event.cityNames && event.cityNames.length) return event.cityNames[0];
                }
                return event.cityName || 'Unknown';
            },
            getLocationTooltip(event) {
                return (event.childCount > 0 && event.distinctCities > 1) ? (event.cityNames || []).join(', ') : '';
            }
        }
    }
</script>

<script>
    $(document).ready(function () {
        let autocompleteTimeout;
        let autocompleteResults = [];
        let currentAutocompleteIndex = -1;

        $('#search-button, #search-button-mobile').click(function() {
            const searchTerm = $('#search-term').val().trim();
            if (searchTerm.length > 0) window.location.href = '/Events/EventsForToday?searchTerm=' + encodeURIComponent(searchTerm);
            else $('#search-validation-message').removeClass('hidden');
        });

        $('#search-term').on('input', function() {
            $('#search-validation-message').addClass('hidden'); 
            const query = $(this).val().trim();
            if (autocompleteTimeout) clearTimeout(autocompleteTimeout);
            if (query.length < 1) { $('#autocomplete-dropdown').addClass('hidden').empty(); return; }
            autocompleteTimeout = setTimeout(() => {
                $.getJSON('/Events/GetAutocompleteResults', { query: query }, function(data) {
                    const dropdown = $('#autocomplete-dropdown').empty();
                    if (!data || data.length === 0) { dropdown.addClass('hidden'); return; }
                    autocompleteResults = data.slice(0, 8);
                    currentAutocompleteIndex = -1;
                    autocompleteResults.forEach((result, i) => {
                        const hlText = result.text.replace(new RegExp('(' + query.replace(/[-\/\\^$*+?.()|[\]{}]/g, '\\$&') + ')', 'gi'), '<span class="font-bold text-blue-600">$1</span>');
                        const icon = result.type === 'event' ? '<path d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />' : '<path d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />';
                        dropdown.append($('<div class="autocomplete-item flex items-center p-3 hover:bg-gray-100 dark:hover:bg-gray-700 cursor-pointer">')
                            .html(`<div class="mr-2 text-gray-400"><svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">${icon}</svg></div><div><div class="text-sm dark:text-white">${hlText}</div><div class="text-xs text-gray-500">${result.subtext||''}</div></div>`)
                            .on('click', () => { $('#search-term').val(autocompleteResults[i].text); $('#autocomplete-dropdown').addClass('hidden'); $('#search-button').click(); })
                        );
                    });
                    dropdown.removeClass('hidden');
                });
            }, 300);
        });

        $('#search-term').on('keydown', function(e) {
            const dropdown = $('#autocomplete-dropdown');
            if (!dropdown.hasClass('hidden')) {
                const items = $('.autocomplete-item');
                if (e.keyCode === 13) { e.preventDefault(); if (currentAutocompleteIndex >= 0) items.eq(currentAutocompleteIndex).click(); else $('#search-button').click(); return; }
                if (e.keyCode === 40 || e.keyCode === 38) {
                    e.preventDefault(); items.removeClass('bg-gray-100 dark:bg-gray-700');
                    currentAutocompleteIndex += e.keyCode === 40 ? 1 : -1;
                    if (currentAutocompleteIndex >= items.length) currentAutocompleteIndex = 0;
                    else if (currentAutocompleteIndex < 0) currentAutocompleteIndex = items.length - 1;
                    items.eq(currentAutocompleteIndex).addClass('bg-gray-100 dark:bg-gray-700');
                }
                if (e.keyCode === 27) { dropdown.addClass('hidden'); currentAutocompleteIndex = -1; }
            } else if (e.keyCode === 13) { e.preventDefault(); $('#search-button').click(); }
        });

        $(document).on('click', e => { if (!$(e.target).closest('#search-term, #autocomplete-dropdown').length) $('#autocomplete-dropdown').addClass('hidden'); });
    });
</script>