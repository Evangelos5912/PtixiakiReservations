                <div>
                    <h3 class="text-2xl font-bold text-black mb-2">Recent Events</h3>
                    <p class="text-lg text-black">Don't miss out on the most recent events.</p>
                </div>
                <div>
                    <a class="text-blue-600 font-bold hover:underline" href="@Url.Action("EventsForToday", "Events")">View all Events</a>
                </div>
            </div>
            <div class="relative w-full max-w-6xl mx-auto px-12 py-5">
                <div class="overflow-hidden rounded-xl py-4"> 
                    <div id="recent-events-track" class="flex transition-transform duration-500 ease-out" style="transform: translateX(0%);"></div>
                </div>
                <button id="recent-prev-btn" class="absolute left-0 top-1/2 -translate-y-1/2 bg-white text-gray-800 p-3 rounded-full shadow-md hover:bg-gray-50 focus:outline-none transition-colors z-10 disabled:opacity-50 disabled:cursor-not-allowed">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                    </svg>
                </button>
                <button id="recent-next-btn" class="absolute right-0 top-1/2 -translate-y-1/2 bg-white text-gray-800 p-3 rounded-full shadow-md hover:bg-gray-50 focus:outline-none transition-colors z-10 disabled:opacity-50 disabled:cursor-not-allowed">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                </button>
            </div>
        </div>

        <!-- Category Slider -->
        <div class="mb-10 overflow-hidden">
            <div class="relative w-full max-w-6xl px-5">
                <h3 class="text-2xl font-bold text-black mb-2">Event Categories</h3>
                <p class="text-lg text-black">Choose one of our many Categories, we must have something you like.</p>
            </div>
            <div class="relative w-full max-w-6xl mx-auto px-12 py-5">
                <div class="overflow-hidden rounded-xl">
                    <div id="category-track" class="flex transition-transform duration-500 ease-out" style="transform: translateX(0%);"></div>
                </div>
                <button id="prev-btn" class="absolute left-0 top-1/2 -translate-y-1/2 bg-white text-gray-800 p-3 rounded-full shadow-md hover:bg-gray-50 focus:outline-none transition-colors z-10 disabled:opacity-50 disabled:cursor-not-allowed">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                    </svg>
                </button>
                <button id="next-btn" class="absolute right-0 top-1/2 -translate-y-1/2 bg-white text-gray-800 p-3 rounded-full shadow-md hover:bg-gray-50 focus:outline-none transition-colors z-10 disabled:opacity-50 disabled:cursor-not-allowed">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                </button>
            </div>
        </div>

        <!-- New Events Slider -->
        <div class="mb-10 overflow-hidden">
            <div class="flex w-full max-w-6xl justify-between rounded-xl p-5">
                <div>
                    <h3 class="text-2xl font-bold text-black mb-2">New Arrivals</h3>
                    <p class="text-lg text-black">View some of our newest Events.</p>
                </div>
                <div>
                    <a class="text-blue-600 font-bold hover:underline" href="@Url.Action("EventsForToday", "Events")">View all Events</a>
                </div>
            </div>
            <div class="relative w-full max-w-6xl mx-auto px-12 py-5">
                <div class="overflow-hidden rounded-xl py-4"> 
                    <div id="new-events-track" class="flex transition-transform duration-500 ease-out" style="transform: translateX(0%);"></div>
                </div>
                <button id="new-prev-btn" class="absolute left-0 top-1/2 -translate-y-1/2 bg-white text-gray-800 p-3 rounded-full shadow-md hover:bg-gray-50 focus:outline-none transition-colors z-10 disabled:opacity-50 disabled:cursor-not-allowed">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                    </svg>
                </button>
                <button id="new-next-btn" class="absolute right-0 top-1/2 -translate-y-1/2 bg-white text-gray-800 p-3 rounded-full shadow-md hover:bg-gray-50 focus:outline-none transition-colors z-10 disabled:opacity-50 disabled:cursor-not-allowed">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    /* Tooltip State */
    .tooltip-container {
        position: relative;      
        display: inline-block;   
        cursor: help;            
    }

    .tooltip-text {
        visibility: hidden;     
        opacity: 0;              
        background-color: #333;  
        color: #fff;             
        text-align: center;
        padding: 8px 12px;
        border-radius: 6px;
        width: max-content;     
        max-width: 200px;     
        position: absolute;
        z-index: 10;             
        bottom: 130%;            
        left: 50%;            
        transform: translateX(-50%); 
        transition: opacity 0.3s ease, visibility 0.3s ease;
        overflow: visible;
    }

    .tooltip-text::after {
        content: "";
        position: absolute;
        top: 100%;              
        left: 50%;
        margin-left: -6px;       
        border-width: 6px;
        border-style: solid;
        border-color: #333 transparent transparent transparent; 
    }

    .tooltip-container:hover .tooltip-text {
        visibility: visible;
        opacity: 1;
    }

    /* Wishlist Hover Selectors */
    .wishlist-hover-badge {
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.2s ease-in-out, visibility 0.2s ease-in-out;
    }
    
    .event-card-link:hover .wishlist-hover-badge {
        opacity: 1;
        visibility: visible;
    }
</style>

<!-- Context Variables -->
<script>
    const currentUserId = '@UserManager.GetUserId(User)';
</script>

<!-- Global Event Handlers -->
<script>
    /** Wishlist Interaction Delegate */
    window.wishlistAction = function(e, eventId) {
        e.preventDefault();
        e.stopPropagation();

        if (!currentUserId || currentUserId === '') {
            alert("You must be logged in to use this feature.");
            return;
        }

        const token = $('input[name="__RequestVerificationToken"]').val();
        const wParams = { eventId: eventId, userId: currentUserId };

        $.getJSON('/Wishlist/returnItem', wParams).done(function(isWishlisted) {
            if (!isWishlisted) {
                // Execute Add Payload
                $.ajax({
                    url: '/Wishlist/addWishlistEvent',
                    type: 'POST',
                    data: wParams,
                    headers: { "RequestVerificationToken": token },
                    success: function(success) {
                        if (success) {
                            $(`.wishlist-id-${eventId}`).html(`
                                <button type="button" onclick="window.wishlistAction(event, ${eventId})">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="#eab308" stroke="#eab308" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                                    </svg>
                                </button>`);
                        }
                    }
                });
            } else {
                // Execute Remove Payload
                $.ajax({
                    url: '/Wishlist/deleteWishlistEvent',
                    type: 'DELETE',
                    data: wParams,
                    headers: { "RequestVerificationToken": token },
                    success: function(success) {
                        if (success) {
                            $(`.wishlist-id-${eventId}`).html(`
                                <button type="button" onclick="window.wishlistAction(event, ${eventId})">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#eab308" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                                    </svg>
                                </button>`);
                        }
                    }
                });
            }
        });
    }
</script>

<!-- Category Component -->
<script>
    document.addEventListener('DOMContentLoaded', async function() {
        const track = document.getElementById('category-track');
        const prevBtn = document.getElementById('prev-btn');
        const nextBtn = document.getElementById('next-btn');
        
        const gradients = [
            'from-purple-500 to-indigo-600',
            'from-blue-400 to-blue-600',
            'from-green-400 to-teal-500',
            'from-yellow-400 to-white-500',
            'from-pink-400 to-rose-500'
        ];

        try {
            const response = await fetch('/EventType/GetCategories'); 
            const categories = await response.json();

            categories.forEach((category, index) => {
                let cardHtml = '';

                if (!category.imagePath) {
                    const colorClass = gradients[index % gradients.length];
                    cardHtml = `
                        <div class="w-full sm:w-1/2 lg:w-1/3 flex-shrink-0 px-3">
                            <a href="/Events/EventsForToday?category=${category.id}" class="relative block bg-gradient-to-br ${colorClass} rounded-2xl p-8 h-64 flex flex-col justify-end text-white shadow-lg hover:shadow-xl hover:-translate-y-1 transition-all cursor-pointer">
                                <h3 class="absolute bottom-8 left-8 text-2xl font-bold">${category.name}</h3>
                            </a>
                        </div>
                    `;
                } else {
                    cardHtml = `
                        <div class="w-full sm:w-1/2 lg:w-1/3 flex-shrink-0 px-3">
                            <a href="/Events/EventsForToday?category=${category.id}" class="relative block rounded-2xl h-64 flex flex-col justify-end text-white shadow-lg hover:shadow-xl hover:-translate-y-1 transition-all cursor-pointer">
                                <img src="${category.imagePath}" alt="${category.name}" class="w-full h-full object-cover rounded-2xl" />
                                <h3 class="absolute bottom-8 left-8 text-2xl font-bold">${category.name}</h3>
                            </a>
                        </div>
                    `;
                }
                track.insertAdjacentHTML('beforeend', cardHtml);
            });

            initializeSlider(track, prevBtn, nextBtn);
        } catch (error) {
            console.error("Failed to load categories:", error);
            track.innerHTML = '<p class="text-red-500 px-3">Failed to load categories.</p>';
        }
    });

    /** Slider Dimension Binding */
    function initializeSlider(trackElement, prevButton, nextButton) {
        const cards = trackElement.children;
        if (cards.length === 0) return;

        let currentIndex = 0;

        function updateSlider() {
            let visibleCards = 1;
            if (window.innerWidth >= 1024) visibleCards = 3; 
            else if (window.innerWidth >= 640) visibleCards = 2; 

            const maxIndex = Math.max(0, cards.length - visibleCards);
            
            if (currentIndex < 0) currentIndex = 0;
            if (currentIndex > maxIndex) currentIndex = maxIndex;

            const cardWidth = cards[0].offsetWidth;
            trackElement.style.transform = `translateX(-${currentIndex * cardWidth}px)`;

            prevButton.disabled = currentIndex === 0;
            nextButton.disabled = currentIndex >= maxIndex || maxIndex === 0;
        }

        nextButton.addEventListener('click', () => { currentIndex++; updateSlider(); });
        prevButton.addEventListener('click', () => { currentIndex--; updateSlider(); });
        window.addEventListener('resize', updateSlider);
        
        updateSlider(); 
    }
</script>

<!-- Carousel Initialization -->
<script>
    document.addEventListener("DOMContentLoaded", function () {
        async function populateCarousel() {
            try {
                const response = await fetch('/Events/getNewestEvents');
                const events = await response.json();
                const container = document.getElementById('carousel-container');

                if (events.length === 0) {
                    container.innerHTML = '<div class="absolute inset-0 flex items-center justify-center text-gray-500">No events found</div>';
                    return;
                }

                container.innerHTML = ''; 

                events.forEach((event, index) => {
                    const visibilityClass = index === 0 ? 'opacity-100' : 'opacity-0 pointer-events-none';

                    const formattedStartDate = new Date(event.startDateTime).toLocaleDateString();
                    const formattedEndDate = new Date(event.endTime).toLocaleDateString();

                    const slide = document.createElement('a');
                    slide.href = `/Events/Details/${event.id}`;
                    slide.className = `carousel-slide absolute inset-0 transition-opacity duration-1000 ease-in-out ${visibilityClass} bg-cover bg-center flex flex-col justify-end p-6 cursor-pointer`;
                    
                    if (event.imagePath) {
                        slide.style.backgroundImage = `url('${event.imagePath}')`;
                    } else {
                        slide.classList.add('bg-gray-800'); 
                    }

                    const hasMultipleCities = event.hasMultipleCities || false;
                    const distinctCities = event.distinctCities || 0;
                    const cityName = event.distinctCities === 0 ? event.cityName : (event.cityNames ? event.cityNames[0] : 'Unknown');

                    let cityBadgeHtml = hasMultipleCities ? `<p>${distinctCities} Cities</p>` : `<p>${cityName}</p>`;
                    
                    slide.innerHTML = `
                        <div class="absolute inset-0 bg-black bg-opacity-40"></div>
                        <div class="relative z-10 text-white">
                            <h3 class="text-3xl font-bold">${event.name}</h3>
                            <div class="flex gap-4 text-sm mt-2 opacity-90">
                                <span>${cityBadgeHtml}</span>
                                <span>${formattedStartDate} - ${formattedEndDate}</span>
                                <span>${event.eventType || 'Unknown Type'}</span>
                            </div>
                        </div>
                    `;
                    
                    container.appendChild(slide);
                });

                startCarouselLogic();
            } catch (err) {
                console.error("Carousel fetch error:", err);
            }
        }

        function startCarouselLogic() {
            const slides = document.querySelectorAll('.carousel-slide');
            if (slides.length <= 1) return; 

            let currentIndex = 0;
            setInterval(() => {
                slides[currentIndex].classList.remove('opacity-100');
                slides[currentIndex].classList.add('opacity-0', 'pointer-events-none');

                currentIndex = (currentIndex + 1) % slides.length;

                slides[currentIndex].classList.remove('opacity-0', 'pointer-events-none');
                slides[currentIndex].classList.add('opacity-100');
            }, 4000);
        }

        populateCarousel();
    });
</script>

<!-- Autocomplete Interface -->
<script>
    $(document).ready(function () {
        let autocompleteTimeout;
        let autocompleteResults = [];
        let currentAutocompleteIndex = -1;
        const maxAutocompleteResults = 8;

        // Base search routing
        $('#search-button').click(function() {
            const searchTerm = $('#search-term').val().trim();
            
            if (searchTerm.length > 0) {
                window.location.href = '/Events/EventsForToday?searchTerm=' + encodeURIComponent(searchTerm);
            } else {
                $('#search-validation-message').removeClass('hidden');
            }
        });

        $('#search-term').on('input', function() {
            $('#search-validation-message').addClass('hidden'); 
            const query = $(this).val().trim();

            if (autocompleteTimeout) clearTimeout(autocompleteTimeout);

            if (query.length < 1) {
                $('#autocomplete-dropdown').addClass('hidden').empty();
                return;
            }

            // State debounce
            autocompleteTimeout = setTimeout(() => { fetchAutocompleteResults(query); }, 300);
        });

        // Key bindings
        $('#search-term').on('keydown', function(e) {
            const dropdown = $('#autocomplete-dropdown');
            const isVisible = !dropdown.hasClass('hidden');

            if (e.keyCode === 13) {
                e.preventDefault();
                if (currentAutocompleteIndex >= 0 && isVisible) {
                    selectAutocompleteItem(currentAutocompleteIndex);
                } else {
                    $('#search-button').click();
                }
                return;
            }

            if (!isVisible) return;

            if (e.keyCode === 40) { e.preventDefault(); navigateAutocomplete(1); } // Down
            else if (e.keyCode === 38) { e.preventDefault(); navigateAutocomplete(-1); } // Up
            else if (e.keyCode === 27) { dropdown.addClass('hidden'); currentAutocompleteIndex = -1; } // Esc
        });

        $(document).on('click', function(e) {
            if (!$(e.target).closest('#search-term, #autocomplete-dropdown').length) {
                $('#autocomplete-dropdown').addClass('hidden');
            }
        });

        function fetchAutocompleteResults(query) {
            $.ajax({
                url: '/Events/GetAutocompleteResults', 
                data: { query: query },
                success: function(data) { displayAutocompleteResults(data, query); },
                error: function() {
                    const mockResults = getMockAutocompleteResults(query);
                    displayAutocompleteResults(mockResults, query);
                }
            });
        }

        function displayAutocompleteResults(results, query) {
            const dropdown = $('#autocomplete-dropdown');
            dropdown.empty();

            if (!results || results.length === 0) {
                dropdown.addClass('hidden');
                return;
            }

            autocompleteResults = results.slice(0, maxAutocompleteResults);
            currentAutocompleteIndex = -1;

            autocompleteResults.forEach(function(result, index) {
                const highlightedText = highlightMatch(result.text, query);
                const item = $('<div class="autocomplete-item flex items-center p-3 hover:bg-gray-100 cursor-pointer transition-colors">')
                    .html(`
                        <div class="mr-2 text-gray-400">
                            ${result.type === 'event' ?
                                '<svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>' :
                                '<svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>'
                            }
                        </div>
                        <div>
                            <div class="text-sm">${highlightedText}</div>
                            <div class="text-xs text-gray-500">${result.subtext || ''}</div>
                        </div>
                    `)
                    .data('index', index)
                    .on('click', function() { selectAutocompleteItem(index); });

                dropdown.append(item);
            });

            dropdown.removeClass('hidden');
        }

        function navigateAutocomplete(direction) {
            const items = $('.autocomplete-item');
            if (items.length === 0) return;

            items.removeClass('bg-gray-100');
            currentAutocompleteIndex += direction;

            if (currentAutocompleteIndex >= items.length) currentAutocompleteIndex = 0;
            else if (currentAutocompleteIndex < 0) currentAutocompleteIndex = items.length - 1;

            items.eq(currentAutocompleteIndex).addClass('bg-gray-100');
        }

        function selectAutocompleteItem(index) {
            const result = autocompleteResults[index];
            if (!result) return;

            $('#search-term').val(result.text);
            $('#autocomplete-dropdown').addClass('hidden');
            $('#search-button').click();
        }

        function highlightMatch(text, query) {
            if (!query) return text;
            const regex = new RegExp('(' + query.replace(/[-\/\\^$*+?.()|[\]{}]/g, '\\$&') + ')', 'gi');
            return text.replace(regex, '<span class="font-bold text-blue-600">$1</span>');
        }

        function getMockAutocompleteResults(query) {
            query = query.toLowerCase();
            const cities = ['Athens', 'Thessaloniki', 'Patras', 'Heraklion'];
            const events = ['Music Concert Series', 'Comedy Night', 'Art Exhibition'];
            let results = [];

            cities.filter(c => c.toLowerCase().includes(query)).forEach(c => { results.push({ text: c, type: 'location', subtext: 'City' }); });
            events.filter(e => e.toLowerCase().includes(query)).forEach(e => { results.push({ text: e, type: 'event', subtext: 'Event' }); });
            
            return results;
        }
    });
</script>

