                            Log in
                        </a>
                        <a class="px-6 py-3 bg-white text-blue-600 font-medium rounded-lg shadow-md hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-colors inline-block" asp-area="Identity" asp-page="/Account/Register">
                            Register
