@model IEnumerable<PtixiakiReservations.Models.Event>
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
    ViewData["Title"] = "Welcome";
    var currentUser = SignInManager.IsSignedIn(User) ? await UserManager.GetUserAsync(User) : null;
    var userRoles = currentUser != null ? await UserManager.GetRolesAsync(currentUser) : new List<string>();
}
<div class="w-full">

    <div class="bg-white shadow-sm mb-10 w-full border-b border-gray-200">
        
        <div class="w-full bg-gradient-to-r from-blue-600 to-indigo-700">
            <div class="max-w-7xl mx-auto px-4 py-4 sm:px-6 lg:px-8">
                <h3 class="text-xl font-bold text-white tracking-wide">Explore Events</h3>
            </div>
        </div>

        <div id="panel-body" class="w-full">
            <div class="max-w-7xl mx-auto px-4 py-8 sm:px-6 lg:px-8">

                <div class="grid grid-cols-1 md:grid-cols-2 gap-10 items-center w-full">
                    
                    <div class="flex flex-col w-full">
                        <h1 class="text-3xl lg:text-4xl font-extrabold text-blue-700 mb-6">Get Started with your next Experiences</h1>
                        
                        <div class="mb-6 w-full">
                            <label for="search-term" class="block text-sm font-bold text-gray-700 mb-2 uppercase tracking-wide">Event Name, Venue, or Location</label>
                            
                            <div class="relative w-full">
                                <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                                    <svg class="h-5 w-5 text-gray-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                                    </svg>
                                </div>
                                
                                <input type="text" id="search-term" 
                                    placeholder="Enter event name, venue, or city..."
                                    class="block w-full pl-12 pr-4 py-4 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-shadow shadow-sm"
                                    autocomplete="off">
                                    
                                <div id="autocomplete-dropdown" class="absolute left-0 top-full mt-2 z-50 bg-white shadow-xl rounded-xl border border-gray-100 hidden max-h-60 overflow-y-auto w-full"></div>
                            </div>
                        </div>
                        
                        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center w-full gap-4">
                            <button id="search-button"
                                    class="w-full sm:w-auto px-8 py-4 bg-blue-600 text-white font-bold rounded-xl shadow-md hover:bg-blue-700 hover:shadow-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 transition-all transform hover:-translate-y-0.5">
                                <span class="flex items-center justify-center">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                                    </svg>
                                    Search For Results
                                </span>
                            </button>
                            <p id="search-validation-message" class="text-red-500 text-sm font-medium hidden">*Please type to search</p>
                        </div>
                    </div>
                    
                    <div class="hidden sm:block w-full">
                        <!-- Changed h-[320px] to h-80 to ensure standard Tailwind compilation -->
                        <div id="carousel-container" class="relative w-full h-80 overflow-hidden rounded-2xl shadow-xl bg-gray-800 border border-gray-100">
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>

    <div class="container mx-auto px-4 py-8 max-w-7xl">
        <!-- Anti-forgery Token -->
        @Html.AntiForgeryToken()
        
        <!-- Authentication Block -->
        @if (!SignInManager.IsSignedIn(User))
        {
            <div class="bg-white rounded-xl shadow-lg mb-10 overflow-hidden">
                <div class="grid grid-cols-1 bg-gradient-to-r from-blue-600 to-indigo-700 px-6 py-4 flex flex-row items-center justify-between p-5">
                    <h3 class="text-2xl font-bold text-white mb-5">Create an Account or Log in</h3>
                    <p class="text-lg font-bold text-white mb-5">Make sure to Create or Log in with an account to get access to the features of the app and your personal profile where you can request higher role privileges.</p>
                    <div class="mb-5">
