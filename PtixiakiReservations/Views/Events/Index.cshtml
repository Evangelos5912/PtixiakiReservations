@model IEnumerable<PtixiakiReservations.Models.Event>
@using Microsoft.AspNetCore.Identity
@using PtixiakiReservations.Models
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager

@{
    ViewBag.Title = "My Events";
    var currentUser = await UserManager.GetUserAsync(User);
    var userRoles = await UserManager.GetRolesAsync(currentUser);
    bool isAdmin = User.IsInRole("Admin");
    bool isSuper = User.IsInRole("SuperOrganizer");
    bool isEventManager = User.IsInRole("Event");

    // Pagination constants
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int pageSize = ViewBag.PageSize ?? 12;
}

<!-- ============================================================== -->
<!-- MAIN WORKSPACE CONTAINER                                       -->
<!-- ============================================================== -->
<div class="bg-gradient-to-br from-gray-50 to-blue-50/50 min-h-screen py-8 px-4 sm:px-6 lg:px-8 font-sans">
    <div class="max-w-7xl mx-auto space-y-6">
        
        <!-- Contextual Page Header & Call to Action -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden">
            <div class="bg-gradient-to-r from-blue-600 to-indigo-700 px-6 sm:px-8 py-8">
                <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
                    <div>
                        <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">Event Management</h1>
                        <p class="mt-2 text-blue-100 text-sm sm:text-base max-w-2xl">
                            Oversee your organized events, review schedules, and manage venue assignments.
                        </p>
                    </div>
                    <div class="shrink-0">
                        <a href="@Url.Action("CreateEvent", "Events")"
                           class="inline-flex items-center px-5 py-2.5 bg-white text-indigo-700 font-bold rounded-lg shadow-sm hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-all transform hover:-translate-y-0.5 justify-center w-full md:w-auto">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
                            </svg>
                            Create New Event
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- ============================================================== -->
        <!-- SEARCH & FILTER TOOLBAR                                        -->
        <!-- ============================================================== -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-4 sm:p-5">
            <div class="flex flex-col lg:flex-row gap-4">
                
                <!-- Search Input -->
                <div class="flex-grow relative">
                    <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                        <svg class="h-5 w-5 text-gray-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd" />
                        </svg>
                    </div>
                    <input type="text" id="event-search"
                           class="w-full pl-11 pr-4 py-2.5 border border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-colors text-sm font-medium placeholder-gray-400"
                           placeholder="Search events by name, type, or venue...">
                </div>
                
                <!-- Dropdown Filters -->
                <div class="flex flex-col sm:flex-row gap-3 lg:shrink-0">
                    <select id="ownership-filter" class="w-full sm:w-48 px-4 py-2.5 border border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-colors text-sm font-semibold text-gray-700 bg-gray-50 cursor-pointer">
                        <option value="mine">My Events</option>
                        <option value="all">All Events</option>
                    </select>
                    
                    <select id="date-filter" class="w-full sm:w-48 px-4 py-2.5 border border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-colors text-sm font-semibold text-gray-700 bg-gray-50 cursor-pointer">
                        <option value="all">All Dates</option>
                        <option value="upcoming">Upcoming</option>
                        <option value="today">Today</option>
                        <option value="past">Past</option>
                    </select>
                </div>
            </div>
        </div>

        <!-- ============================================================== -->
        <!-- DYNAMIC DATA TABLE PRESENTATION                                -->
        <!-- ============================================================== -->
        <div id="events-container" class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden relative min-h-[300px]">
            
            <!-- Loading State -->
            <div id="loading-indicator" class="absolute inset-0 z-10 bg-white/80 backdrop-blur-sm flex flex-col items-center justify-center">
                <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-indigo-600 mb-3"></div>
                <p class="text-sm font-bold text-gray-500 animate-pulse">Loading Events...</p>
            </div>

            <!-- Table Structure -->
            <div class="overflow-x-auto hidden" id="events-table-wrapper">
                <table id="events-table" class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>
                            <th scope="col" class="px-6 py-4 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">Event Name</th>
                            <th scope="col" class="px-6 py-4 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">Category</th>
                            <th scope="col" class="px-6 py-4 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">Schedule</th>
                            <th scope="col" class="px-6 py-4 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">Location</th>
                            <th scope="col" class="px-6 py-4 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">Status</th>
                            <th scope="col" class="px-6 py-4 text-right text-xs font-bold text-gray-500 uppercase tracking-wider">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="events-list" class="bg-white divide-y divide-gray-100">
                        <!-- Content Injected via JavaScript -->
                    </tbody>
                </table>
            </div>

            <!-- Empty State Fallback -->
            <div id="no-events-message" class="hidden py-16 px-6 text-center">
                <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-gray-100 mb-4">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                </div>
                <h3 class="text-lg font-bold text-gray-900 mb-1">No events found</h3>
                <p class="text-sm text-gray-500 max-w-sm mx-auto">We couldn't find any events matching your current search or filter criteria.</p>
                <button onclick="clearFilters()" class="mt-4 px-4 py-2 bg-indigo-50 text-indigo-700 font-semibold rounded-lg hover:bg-indigo-100 transition-colors text-sm">
                    Clear Filters
                </button>
            </div>
            
            <!-- Pagination Controls Wrapper -->
            <div id="js-pagination-container" class="bg-gray-50 px-6 py-4 border-t border-gray-200 flex flex-col sm:flex-row items-center justify-between gap-4 hidden"></div>
        </div>
    </div>
</div>

<!-- ============================================================== -->
<!-- EVENT DETAILS MODAL DIALOG                                     -->
<!-- ============================================================== -->
<div id="event-details-modal" class="fixed inset-0 z-[100] hidden bg-gray-900/60 backdrop-blur-sm flex items-center justify-center transition-opacity" aria-modal="true" role="dialog">
    <div class="bg-white rounded-2xl shadow-2xl w-full max-w-2xl mx-4 overflow-hidden transform transition-all border border-gray-200">
        <div class="bg-gradient-to-r from-blue-600 to-indigo-700 px-6 py-4 flex justify-between items-center">
            <h4 class="text-lg font-extrabold text-white truncate pr-4" id="modal-event-title">Event Details</h4>
            <button type="button" class="text-indigo-100 hover:text-white transition-colors focus:outline-none" onclick="closeModal()">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
            </button>
        </div>
        
        <div class="p-6" id="modal-event-details">
            <!-- Event details injected via JS -->
        </div>
        
        <div class="bg-gray-50 border-t border-gray-100 px-6 py-4 flex justify-end items-center gap-3">
            <div id="modal-action-buttons" class="flex items-center gap-3 w-full sm:w-auto">
                <button onclick="closeModal()" type="button" class="flex-1 sm:flex-none px-5 py-2.5 bg-white border border-gray-300 text-gray-700 font-bold rounded-lg hover:bg-gray-50 transition-colors text-sm shadow-sm">
                    Close
                </button>
                <button id="modal-delete-btn" type="button" class="hidden flex-1 sm:flex-none px-5 py-2.5 bg-red-600 text-white font-bold rounded-lg shadow-sm hover:bg-red-700 transition-colors text-sm">
                    Delete Event
                </button>
                <a id="modal-edit-btn" class="hidden flex-1 sm:flex-none cursor-pointer px-5 py-2.5 bg-indigo-600 text-white font-bold rounded-lg shadow-sm hover:bg-indigo-700 transition-colors text-sm text-center">
                    Edit Configuration
                </a>
            </div>
        </div>
    </div>
</div>

<!-- ============================================================== -->
<!-- JAVASCRIPT LOGIC ENGINE                                        -->
<!-- ============================================================== -->
@section Scripts {
    <script>
        /** State Memory & Configuration */
        const currentUserId = '@UserManager.GetUserId(User)';
        const userIsAdmin = @User.IsInRole("Admin").ToString().ToLower();
        const userIsSuper = @User.IsInRole("SuperOrganizer").ToString().ToLower();
        const userIsEventManager = @User.IsInRole("Event").ToString().ToLower();
        
        let allEvents = [];
        let filteredEvents = [];
        let jsCurrentPage = 1;
        const jsPageSize = 12;

        /** DOM Initialization */
        $(document).ready(function() {
            loadEvents();
            
            // Bind Filter Listeners
            $("#event-search").on("input", () => { jsCurrentPage = 1; filterEvents(); });
            $("#ownership-filter").on("change", () => { jsCurrentPage = 1; filterEvents(); });
            $("#date-filter").on("change", () => { jsCurrentPage = 1; filterEvents(); });
            
            // Allow clicking outside the modal to close it
            $('#event-details-modal').on('click', function(e) {
                if (e.target === this) closeModal();
            });
            
            // Escape key closes modal
            $(document).on('keydown', function(e) {
                if (e.key === "Escape" && !$('#event-details-modal').hasClass('hidden')) closeModal();
            });
        });

        /** Utility to reset all search parameters */
        window.clearFilters = function() {
            $("#event-search").val('');
            $("#ownership-filter").val('mine');
            $("#date-filter").val('all');
            filterEvents();
        };

        /** Fetches raw event JSON payload from server memory */
        function loadEvents() {
            $.ajax({
                url: '/Events/GetUserEvents',
                type: 'GET',
                success: function(data) {
                    allEvents = data.events;
                    filterEvents();
                    $("#loading-indicator").addClass("hidden");
                },
                error: function(xhr) {
                    console.error("Error loading events:", xhr);
                    $("#loading-indicator").addClass("hidden");
                    $("#events-table-wrapper").addClass("hidden");
                    $("#js-pagination-container").addClass("hidden");
                    $("#no-events-message").removeClass("hidden");
                }
            });
        }

        /** 
         * Master Filtering Engine
         */
        function filterEvents() {
            const searchTerm = $("#event-search").val().toLowerCase();
            const ownershipFilter = $("#ownership-filter").val(); 
            const dateFilter = $("#date-filter").val(); 

            const now = new Date();
            const todayStart = new Date(now.getFullYear(), now.getMonth(), now.getDate()).getTime();

            filteredEvents = allEvents.filter(function(event) {
                
                let matchesSearch = true;
                if (searchTerm) {
                    matchesSearch = (
                        (event.name && event.name.toLowerCase().includes(searchTerm)) ||
                        (event.eventType && event.eventType.name.toLowerCase().includes(searchTerm)) ||
                        (event.venue && event.venue.name.toLowerCase().includes(searchTerm))
                    );
                }

                let matchesOwnership = true;
                if (ownershipFilter === 'mine') {
                    matchesOwnership = (event.organizerId === currentUserId);
                }

                let matchesDate = true;
                if (dateFilter !== 'all') {
                    const eventStartRaw = new Date(event.startDateTime);
                    const eventStartDay = new Date(eventStartRaw.getFullYear(), eventStartRaw.getMonth(), eventStartRaw.getDate()).getTime();

                    if (dateFilter === 'upcoming') {
                        matchesDate = eventStartDay > todayStart;
                    } else if (dateFilter === 'past') {
                        matchesDate = eventStartDay < todayStart;
                    } else if (dateFilter === 'today') {
                        matchesDate = eventStartDay === todayStart;
                    }
                }

                return matchesSearch && matchesOwnership && matchesDate;
            });

            renderPage();
        }

        function renderPage() {
            const startIndex = (jsCurrentPage - 1) * jsPageSize;
            const endIndex = startIndex + jsPageSize;
            const pageEvents = filteredEvents.slice(startIndex, endIndex);
            
            renderTable(pageEvents);
            renderPaginationControls();
        }

        function renderTable(events) {
            const eventsList = $("#events-list");
            eventsList.empty();

            if (events.length === 0) {
                $("#events-table-wrapper").addClass("hidden");
                $("#js-pagination-container").addClass("hidden");
                $("#no-events-message").removeClass("hidden");
                return;
            }

            $("#no-events-message").addClass("hidden");
            $("#events-table-wrapper").removeClass("hidden");
            $("#js-pagination-container").removeClass("hidden");

            const now = new Date();
            const todayStart = new Date(now.getFullYear(), now.getMonth(), now.getDate()).getTime();

            events.forEach(function(event) {
                const startDate = new Date(event.startDateTime);
                const eventStartDay = new Date(startDate.getFullYear(), startDate.getMonth(), startDate.getDate()).getTime();

                let statusClass, statusText;
                if (eventStartDay < todayStart) {
                    statusClass = "bg-gray-100 text-gray-700 border-gray-200";
                    statusText = "Past";
                } else if (eventStartDay === todayStart) {
                    statusClass = "bg-green-100 text-green-800 border-green-200";
                    statusText = "Today";
                } else {
                    statusClass = "bg-blue-100 text-blue-800 border-blue-200";
                    statusText = "Upcoming";
                }

                const formattedDate = startDate.toLocaleDateString(undefined, { weekday: 'short', year: 'numeric', month: 'short', day: 'numeric' });
                const formattedTime = startDate.toLocaleTimeString(undefined, { hour: '2-digit', minute: '2-digit' });

                const rowHtml = `
                    <tr class="hover:bg-indigo-50/30 transition-colors group">
                        <td class="px-6 py-4">
                            <div class="text-sm font-bold text-gray-900 group-hover:text-indigo-700 transition-colors">${event.name}</div>
                        </td>
                        <td class="px-6 py-4">
                            <div class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-semibold bg-gray-100 text-gray-600 border border-gray-200">
                                ${event.eventType ? event.eventType.name : 'Uncategorized'}
                            </div>
                        </td>
                        <td class="px-6 py-4">
                            <div class="text-sm font-medium text-gray-900">${formattedDate}</div>
                            <div class="text-xs font-bold text-gray-500 uppercase tracking-wider mt-0.5">${formattedTime}</div>
                        </td>
                        <td class="px-6 py-4">
                            <div class="text-sm font-medium text-gray-700 flex items-center">
                                <svg class="w-4 h-4 mr-1 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                                ${event.venue ? event.venue.name : 'TBA'}
                            </div>
                        </td>
                        <td class="px-6 py-4">
                            <span class="px-3 py-1 inline-flex text-xs font-bold rounded-full border ${statusClass}">
                                ${statusText}
                            </span>
                        </td>
                        <td class="px-6 py-4 text-right">
                            <div class="flex items-center justify-end space-x-2">
                                <button onclick="showEventDetails(${event.id})" class="inline-flex items-center px-3 py-1.5 bg-white border border-gray-300 rounded-lg text-xs font-bold text-gray-700 hover:bg-gray-50 shadow-sm transition-colors">
                                    Quick View
                                </button>
                                <a href="/Events/Details/${event.id}" class="inline-flex items-center px-3 py-1.5 bg-indigo-50 border border-indigo-200 rounded-lg text-xs font-bold text-indigo-700 hover:bg-indigo-100 shadow-sm transition-colors">
                                    Full Page
                                </a>
                            </div>
                        </td>
                    </tr>
                `;
                eventsList.append(rowHtml);
            });
        }

        function renderPaginationControls() {
            const totalPages = Math.ceil(filteredEvents.length / jsPageSize);
            const navContainer = $("#js-pagination-container");
            navContainer.empty();

            if (totalPages <= 1) return;

            let html = `
                <div class="text-sm text-gray-700 w-full sm:w-auto text-center sm:text-left mb-4 sm:mb-0">
                    Showing page <span class="font-bold text-gray-900">${jsCurrentPage}</span> of <span class="font-bold text-gray-900">${totalPages}</span>
                    <span class="text-gray-300 mx-2">|</span>
                    Total matches: <span class="font-bold text-gray-900">${filteredEvents.length}</span>
                </div>
                <div class="flex items-center justify-center space-x-2">
            `;

            if (jsCurrentPage > 1) {
                html += `<button type="button" onclick="changePage(${jsCurrentPage - 1})" class="px-3 py-1.5 border border-gray-300 rounded-md text-sm font-bold text-gray-700 bg-white hover:bg-gray-50 transition-colors shadow-sm">Prev</button>`;
            } else {
                html += `<button disabled class="px-3 py-1.5 border border-gray-200 rounded-md text-sm font-bold text-gray-400 bg-gray-50 cursor-not-allowed">Prev</button>`;
            }

            html += `<div class="hidden sm:flex space-x-1">`;
            let startPage = Math.max(1, jsCurrentPage - 2);
            let endPage = Math.min(totalPages, startPage + 4);
            if (endPage - startPage < 4) startPage = Math.max(1, endPage - 4);

            if (startPage > 1) {
                html += `<button type="button" onclick="changePage(1)" class="px-3 py-1.5 rounded-md text-sm font-bold transition-colors shadow-sm bg-white text-gray-700 border border-gray-300 hover:bg-gray-50">1</button>`;
                if (startPage > 2) html += `<span class="px-2 py-1.5 text-gray-400 font-bold">...</span>`;
            }

            for (let i = startPage; i <= endPage; i++) {
                const activeClass = i === jsCurrentPage 
                    ? "bg-indigo-600 text-white border border-indigo-600" 
                    : "bg-white text-gray-700 border border-gray-300 hover:bg-gray-50";
                
                html += `<button type="button" onclick="changePage(${i})" class="${activeClass} px-3 py-1.5 rounded-md text-sm font-bold transition-colors shadow-sm">${i}</button>`;
            }

            if (endPage < totalPages) {
                if (endPage < totalPages - 1) html += `<span class="px-2 py-1.5 text-gray-400 font-bold">...</span>`;
                html += `<button type="button" onclick="changePage(${totalPages})" class="px-3 py-1.5 rounded-md text-sm font-bold transition-colors shadow-sm bg-white text-gray-700 border border-gray-300 hover:bg-gray-50">${totalPages}</button>`;
            }
            html += `</div>`;

            if (jsCurrentPage < totalPages) {
                html += `<button type="button" onclick="changePage(${jsCurrentPage + 1})" class="px-3 py-1.5 border border-gray-300 rounded-md text-sm font-bold text-gray-700 bg-white hover:bg-gray-50 transition-colors shadow-sm">Next</button>`;
            } else {
                html += `<button disabled class="px-3 py-1.5 border border-gray-200 rounded-md text-sm font-bold text-gray-400 bg-gray-50 cursor-not-allowed">Next</button>`;
            }

            html += `</div>`;
            navContainer.html(html);
        }

        window.changePage = function(pageNumber) {
            jsCurrentPage = pageNumber;
            renderPage();
            document.getElementById('events-container').scrollIntoView({ behavior: 'smooth', block: 'start' });
        };

        /** Action: Opens specific event context in modal UI */
        window.showEventDetails = function(eventId) {
            const event = allEvents.find(e => e.id === eventId);
            if (!event) return;

            const startDate = new Date(event.startDateTime);
            const endDate = new Date(event.endTime);

            const dateOptions = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
            const timeOptions = { hour: '2-digit', minute: '2-digit' };
            
            $("#modal-event-title").text(event.name);

            const editBtn = document.getElementById("modal-edit-btn");
            const deleteBtn = document.getElementById("modal-delete-btn");
            const isOwner = event.organizerId === currentUserId || event.organizerId === undefined; 
            const canEdit = userIsAdmin || ((userIsEventManager || userIsSuper) && isOwner);

            if (canEdit) {
                editBtn.classList.remove("hidden");
                editBtn.onclick = (e) => { e.preventDefault(); window.location.assign("/Events/Edit/" + event.id); };
                
                deleteBtn.classList.remove("hidden");
                deleteBtn.onclick = () => { triggerEventDeletion(event.id); };
            } else {
                editBtn.classList.add("hidden");
                deleteBtn.classList.add("hidden");
            }

            const detailsHtml = `
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 bg-gray-50 p-5 rounded-xl border border-gray-100">
                    <div class="flex flex-col">
                        <span class="text-xs font-bold text-gray-500 uppercase tracking-wider mb-1">Category</span>
                        <div class="inline-flex items-center px-3 py-1.5 rounded-lg bg-white border border-gray-200 text-sm font-bold text-gray-800 w-max shadow-sm">
                            ${event.eventType ? event.eventType.name : 'Uncategorized'}
                        </div>
                    </div>
                    
                    <div class="flex flex-col">
                        <span class="text-xs font-bold text-gray-500 uppercase tracking-wider mb-1">Location</span>
                        <div class="flex items-center text-sm font-bold text-gray-900">
                            <svg class="w-4 h-4 mr-1.5 text-indigo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                            ${event.venue ? event.venue.name : 'Venue TBA'}
                        </div>
                    </div>
                    
                    <div class="md:col-span-2 border-t border-gray-200 pt-4 grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div class="bg-white p-3 rounded-lg border border-gray-200 shadow-sm">
                            <h3 class="text-xs font-bold text-green-600 uppercase tracking-wider mb-1 flex items-center">
                                <svg class="w-3 h-3 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M12 4v16m8-8H4"/></svg> Start
                            </h3>
                            <p class="text-sm font-bold text-gray-900">${startDate.toLocaleDateString(undefined, dateOptions)}</p>
                            <p class="text-xs font-bold text-gray-500 mt-0.5">${startDate.toLocaleTimeString(undefined, timeOptions)}</p>
                        </div>
                        
                        <div class="bg-white p-3 rounded-lg border border-gray-200 shadow-sm">
                            <h3 class="text-xs font-bold text-red-500 uppercase tracking-wider mb-1 flex items-center">
                                <svg class="w-3 h-3 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M20 12H4"/></svg> End
                            </h3>
                            <p class="text-sm font-bold text-gray-900">${endDate.toLocaleDateString(undefined, dateOptions)}</p>
                            <p class="text-xs font-bold text-gray-500 mt-0.5">${endDate.toLocaleTimeString(undefined, timeOptions)}</p>
                        </div>
                    </div>
                </div>
            `;

            $("#modal-event-details").html(detailsHtml);
            
            $("body").css("overflow", "hidden");
            $("#event-details-modal").removeClass("hidden");
        };

        /** Prompts user and immediately hits the Delete controller */
        window.triggerEventDeletion = function(eventId) {
            const warningMessage = "Are you absolutely sure you want to delete this event?\n\nWARNING: If this is a Master Event, ALL of its Sub-Events will be permanently deleted alongside it. This cannot be undone.";
            
            if (confirm(warningMessage)) {
                
                const deleteBtn = document.getElementById("modal-delete-btn");
                const originalText = deleteBtn.innerHTML;
                deleteBtn.innerHTML = "Deleting...";
                deleteBtn.disabled = true;

                $.ajax({
                    url: '/Events/Delete?id=' + eventId,
                    type: 'DELETE',
                    success: function() {
                        // Reset button state immediately upon success for future modal opens
                        deleteBtn.innerHTML = "Delete Event";
                        deleteBtn.disabled = false;

                        allEvents = allEvents.filter(e => e.id !== eventId && e.parentEventId !== eventId);
                        
                        closeModal();
                        filterEvents(); 
                    },
                    error: function(xhr) {
                        console.error("Deletion failed:", xhr);
                        alert("An error occurred while attempting to delete the event. Check server logs.");
                        
                        deleteBtn.innerHTML = originalText;
                        deleteBtn.disabled = false;
                    }
                });
            }
        };

        window.closeModal = function() {
            $("#event-details-modal").addClass("hidden");
            $("body").css("overflow", "auto");
        };
    </script>
}