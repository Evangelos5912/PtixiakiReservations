@model IEnumerable<PtixiakiReservations.Models.Layout>

@{
    ViewData["Title"] = "Venue Layouts";
    var venue = ViewBag.Venue as PtixiakiReservations.Models.Venue;
    var venueName = venue?.Name ?? "Venue";
    var cityName = venue?.City?.Name ?? "";
}

<!-- Renders the venue's active floorplans or provides feedback if empty -->
<div class="min-h-screen bg-gray-50/50 py-6 sm:py-10 px-4 sm:px-6 lg:px-8 pb-32">
    <div class="max-w-6xl mx-auto">
        
        <div class="flex flex-col sm:flex-row sm:items-center justify-between mb-8 gap-4">
            <div>
                <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">Venue Blueprints</h1>
                <p class="mt-1 text-gray-500 text-sm">Interactive floorplans for <span class="font-bold text-gray-700">@venueName @(!string.IsNullOrEmpty(cityName) ? $"({cityName})" : "")</span></p>
            </div>
            <div>
                <a href="javascript:history.back()" class="inline-flex items-center px-4 py-2 bg-white border border-gray-300 rounded-xl font-bold text-sm text-gray-700 hover:bg-gray-50 shadow-sm transition-colors">
                    <svg class="w-4 h-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
                    Back
                </a>
            </div>
        </div>

        @if (Model == null || !Model.Any())
        {
            <div class="bg-yellow-50 border border-yellow-200 rounded-xl p-6 flex items-start shadow-sm">
                <div class="flex-shrink-0 bg-yellow-100 p-2 rounded-full mr-4">
                    <svg class="h-6 w-6 text-yellow-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.082 16.5c-.77.833.192 2.5 1.732 2.5z" /></svg>
                </div>
                <div>
                    <h3 class="text-lg font-bold text-yellow-800">No Layouts Configured</h3>
                    <p class="text-yellow-700 text-sm mt-1">There are no spatial blueprints available for this venue yet.</p>
                </div>
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                @foreach (var layout in Model)
                {
                    <div onclick="openLayoutModal(@layout.Id, '@Html.Raw(layout.AreaName?.Replace("'", "\\'"))')" class="bg-white rounded-2xl shadow-sm hover:shadow-md border border-gray-200 p-6 cursor-pointer transition-all hover:border-indigo-300 flex flex-col justify-between group">
                        <div>
                            <div class="w-12 h-12 rounded-xl bg-indigo-50 border border-indigo-100 flex items-center justify-center text-indigo-600 mb-4 group-hover:bg-indigo-600 group-hover:text-white transition-colors">
                                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z"/></svg>
                            </div>
                            <h3 class="text-lg font-bold text-gray-900 group-hover:text-indigo-600 transition-colors">@layout.AreaName</h3>
                            <p class="text-sm text-gray-500 mt-1 line-clamp-2">@(string.IsNullOrEmpty(layout.Desc) ? "Click to inspect spatial seating layout." : layout.Desc)</p>
                        </div>
                        <div class="mt-6 pt-4 border-t border-gray-100 flex items-center justify-between text-xs font-bold text-indigo-600">
                            <span>View Schema</span>
                            <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

<!-- Modal container for the interactive 2D layout canvas -->
<div id="layoutModal" class="fixed inset-0 z-50 hidden bg-black/60 backdrop-blur-sm flex items-center justify-center p-4 sm:p-6">
    <div class="bg-white rounded-2xl shadow-2xl border border-gray-200 w-full max-w-5xl overflow-hidden flex flex-col max-h-[90vh] animate-fade-in-up">
        
        <div class="bg-slate-900 px-6 py-4 flex items-center justify-between">
            <div>
                <h3 id="modalLayoutTitle" class="text-lg font-bold text-white">Floorplan Preview</h3>
                <p class="text-xs text-slate-400">Read-Only Seat & Table Blueprint</p>
            </div>
            <button onclick="closeLayoutModal()" class="text-slate-400 hover:text-white p-1 rounded-lg transition-colors">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
        </div>

        <div class="p-4 sm:p-6 bg-gray-50 flex-1 relative overflow-hidden flex flex-col">
            <div id="modal-canvas-wrapper" class="bg-white rounded-xl border border-gray-200 overflow-hidden relative shadow-inner w-full flex-1" style="min-height: 55vh;">
                
                <div class="absolute bottom-4 right-4 z-50 flex items-center gap-1 bg-white/90 backdrop-blur-sm p-1.5 rounded-lg shadow-md border border-gray-200">
                    <button type="button" onclick="ZoomOut()" class="p-1.5 hover:bg-gray-100 rounded text-gray-700 transition-colors" title="Zoom Out">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM13 10H7"/></svg>
                    </button>
                    <span id="zoom-level" class="w-12 text-center text-sm font-extrabold text-gray-800 select-none">100%</span>
                    <button type="button" onclick="ZoomIn()" class="p-1.5 hover:bg-gray-100 rounded text-gray-700 transition-colors" title="Zoom In">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"/></svg>
                    </button>
                    <div class="w-px h-5 bg-gray-300 mx-1"></div>
                    <button type="button" onclick="ResetZoom()" class="p-1.5 hover:bg-gray-100 rounded text-gray-700 transition-colors" title="Reset View">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                    </button>
                </div>

                <canvas id="seatCanvas"></canvas>
            </div>
        </div>

        <div class="bg-white border-t border-gray-200 px-6 py-3 flex justify-end">
            <button onclick="closeLayoutModal()" class="px-5 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 font-bold rounded-xl transition-colors text-sm">Close Preview</button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/fabric.js/5.3.0/fabric.min.js"></script>
    <script>
        let fabricCanvas;
        let currentSeatsCache = [];
        let currentShapesCache = [];
        let currentGroupsCache = [];

        // Instantiates the FabricJS canvas and triggers data fetching
        function openLayoutModal(layoutId, layoutName) {
            $('#modalLayoutTitle').text(layoutName);
            $('#layoutModal').removeClass('hidden');

            setTimeout(() => {
                if (!fabricCanvas) {
                    const container = document.getElementById('modal-canvas-wrapper');
                    fabricCanvas = new fabric.Canvas('seatCanvas', {
                        width: container.clientWidth,
                        height: container.clientHeight,
                        selection: false
                    });
                    
                    fabricCanvas.on('mouse:down', function (opt) {
                        if (!opt.target) {
                            this.isDragging = true;
                            this.lastPosX = opt.e.clientX;
                            this.lastPosY = opt.e.clientY;
                        }
                    });
                    fabricCanvas.on('mouse:move', function (opt) {
                        if (this.isDragging) {
                            const vpt = this.viewportTransform.slice();
                            vpt[4] += opt.e.clientX - this.lastPosX;
                            vpt[5] += opt.e.clientY - this.lastPosY;
                            this.setViewportTransform(vpt);
                            this.lastPosX = opt.e.clientX;
                            this.lastPosY = opt.e.clientY;
                        }
                    });
                    fabricCanvas.on('mouse:up', function () { this.isDragging = false; });
                    fabricCanvas.on('mouse:wheel', function(opt) {
                        let zoom = fabricCanvas.getZoom() * (0.999 ** opt.e.deltaY);
                        if (zoom > 5) zoom = 5;
                        if (zoom < 0.1) zoom = 0.1;
                        fabricCanvas.zoomToPoint({ x: opt.e.offsetX, y: opt.e.offsetY }, zoom);
                        opt.e.preventDefault();
                        opt.e.stopPropagation();
                        updateZoomText();
                    });
                } else {
                    const container = document.getElementById('modal-canvas-wrapper');
                    fabricCanvas.setWidth(container.clientWidth);
                    fabricCanvas.setHeight(container.clientHeight);
                }

                loadModalSeatMap(layoutId);
            }, 150);
        }

        // Tears down the canvas data and closes the modal
        function closeLayoutModal() {
            $('#layoutModal').addClass('hidden');
            if (fabricCanvas) fabricCanvas.clear();
        }

        function updateZoomText() {
            const zoomText = document.getElementById('zoom-level');
            if (zoomText && fabricCanvas) zoomText.textContent = `${Math.round(fabricCanvas.getZoom() * 100)}%`;
        }

        function ZoomIn() {
            if (!fabricCanvas) return;
            let zoom = Math.min(5, fabricCanvas.getZoom() * 1.1);
            fabricCanvas.zoomToPoint({ x: fabricCanvas.width / 2, y: fabricCanvas.height / 2 }, zoom);
            updateZoomText();
        }

        function ZoomOut() {
            if (!fabricCanvas) return;
            let zoom = Math.max(0.1, fabricCanvas.getZoom() / 1.1);
            fabricCanvas.zoomToPoint({ x: fabricCanvas.width / 2, y: fabricCanvas.height / 2 }, zoom);
            updateZoomText();
        }

        function ResetZoom() { fitLayoutToViewport(); }

        // Recalculates canvas boundaries and centers the viewport around all mapped objects
        function fitLayoutToViewport() {
            if (!fabricCanvas) return;

            const objects = fabricCanvas.getObjects().filter(obj => !obj.isBoundingGuide);
            if (objects.length === 0) return;

            const boundGroup = new fabric.Group(objects);
            const bbox = boundGroup.getBoundingRect();
            boundGroup.destroy();

            const container = document.getElementById('modal-canvas-wrapper');
            const vw = container.clientWidth;
            const vh = container.clientHeight;

            fabricCanvas.setWidth(vw);
            fabricCanvas.setHeight(vh);

            const padding = 100;
            const contentWidth = bbox.width || 100;
            const contentHeight = bbox.height || 100;

            const scaleX = vw / (contentWidth + padding);
            const scaleY = vh / (contentHeight + padding);
            const optScale = Math.max(0.05, Math.min(scaleX, scaleY, 2.0));

            const centerX = bbox.left + (bbox.width / 2);
            const centerY = bbox.top + (bbox.height / 2);

            const vpt = fabricCanvas.viewportTransform.slice();
            vpt[0] = optScale; 
            vpt[3] = optScale; 
            vpt[4] = (vw / 2) - (centerX * optScale); 
            vpt[5] = (vh / 2) - (centerY * optScale); 
            
            fabricCanvas.setViewportTransform(vpt);
            fabricCanvas.calcOffset();
            updateZoomText();
        }

        // Fetches JSON configuration mapping and passes it to the rendering engine
        async function loadModalSeatMap(layoutId) {
            try {
                const res = await fetch(`/Seat/GetCompleteLayout?layoutId=${layoutId}`);
                const data = res.ok ? await res.json() : { seats: [], shapes: [], groups: [] };
                currentSeatsCache = data.seats || [];
                currentShapesCache = data.shapes || [];
                currentGroupsCache = data.groups || [];

                fabricCanvas.clear();
                renderMap(fabricCanvas, currentSeatsCache, currentShapesCache, currentGroupsCache);
                
                setTimeout(() => {
                    fitLayoutToViewport();
                }, 50);
            } catch (e) {
                console.error("Failed to load layout schema:", e);
            }
        }

        // Translates layout JSON into native FabricJS objects
        function renderMap(canvas, seats, shapes, groups) {
            canvas.clear();

            if (shapes) {
                shapes.forEach(shape => renderShape(canvas, shape));
            }

            if (seats) {
                seats.forEach(seat => renderSeat(canvas, seat));
            }

            if (groups) {
                groups.forEach(group => {
                    const gLeft = parseFloat(group.left || group.Left) || 0;
                    const gTop = parseFloat(group.top || group.Top) || 0;

                    const childBounds = [];
                    if (group.selectableUnits) {
                        group.selectableUnits.forEach(u => childBounds.push({ x: gLeft + (u.x||u.X), y: gTop + (u.y||u.Y), w: u.width||60, h: u.height||60 }));
                    }
                    if (group.nonSelectableUnits) {
                        group.nonSelectableUnits.forEach(u => childBounds.push({ x: gLeft + (u.x||u.X), y: gTop + (u.y||u.Y), w: u.width||100, h: u.height||100 }));
                    }

                    if (childBounds.length > 0) {
                        const minX = Math.min(...childBounds.map(c => c.x));
                        const minY = Math.min(...childBounds.map(c => c.y));
                        const maxX = Math.max(...childBounds.map(c => c.x + c.w));
                        const maxY = Math.max(...childBounds.map(c => c.y + c.h));

                        const guideRect = new fabric.Rect({
                            left: minX - 12, top: minY - 12,
                            width: (maxX - minX) + 24, height: (maxY - minY) + 24,
                            fill: 'rgba(99, 102, 241, 0.03)', stroke: '#6366f1', strokeWidth: 1.5,
                            strokeDashArray: [4, 4], rx: 8, ry: 8, selectable: false, evented: false
                        });
                        guideRect.isBoundingGuide = true;
                        canvas.add(guideRect);
                    }

                    if (group.nonSelectableUnits) {
                        group.nonSelectableUnits.forEach(shape => renderShape(canvas, shape, gLeft, gTop));
                    }

                    if (group.selectableUnits) {
                        group.selectableUnits.forEach(seat => renderSeat(canvas, seat, gLeft, gTop));
                    }
                });
            }

            canvas.renderAll();
        }

        function renderSeat(canvas, seat, offsetX = 0, offsetY = 0) {
            const x = offsetX + (parseFloat(seat.x || seat.X) || 0);
            const y = offsetY + (parseFloat(seat.y || seat.Y) || 0);
            
            const rect = new fabric.Rect({ width: 60, height: 60, fill: '#10b981', stroke: '#059669', strokeWidth: 1, rx: 6, ry: 6, originX: 'left', originY: 'top' });
            const text = new fabric.Text(seat.name || '', { originX: 'center', originY: 'center', left: 30, top: 30, fill: 'white', fontSize: 12, fontWeight: 'bold' });
            
            canvas.add(new fabric.Group([rect, text], { left: x, top: y, selectable: false, evented: false }));
        }

        function renderShape(canvas, shape, offsetX = 0, offsetY = 0) {
            let fShape;
            const fill = shape.backgroundColor || '#E5E7EB';
            const w = shape.width || shape.Width || 100;
            const h = shape.height || shape.Height || 100;
            const x = offsetX + (parseFloat(shape.x || shape.X) || 0);
            const y = offsetY + (parseFloat(shape.y || shape.Y) || 0);

            if (shape.shapeType === 'ellipse') {
                fShape = new fabric.Ellipse({ rx: w/2, ry: h/2, fill, opacity: 0.85, stroke: '#9CA3AF', strokeWidth: 1, originX: 'left', originY: 'top' });
            } else if (shape.shapeType === 'triangle') {
                fShape = new fabric.Triangle({ width: w, height: h, fill, opacity: 0.85, originX: 'left', originY: 'top' });
            } else {
                fShape = new fabric.Rect({ width: w, height: h, fill, opacity: 0.85, stroke: '#9CA3AF', strokeWidth: 1, originX: 'left', originY: 'top' });
            }
            const text = new fabric.Text(shape.name || '', { originX: 'center', originY: 'center', left: w/2, top: h/2, fill: '#374151', fontSize: 13, fontWeight: 'bold' });
            canvas.add(new fabric.Group([fShape, text], { left: x, top: y, selectable: false, evented: false }));
        }
    </script>
}