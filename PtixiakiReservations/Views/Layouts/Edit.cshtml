                        </div>
                        <div class="flex flex-col w-full sm:w-20">
                            <label class="text-[10px] sm:text-xs font-bold text-gray-600 uppercase mb-1">Y Pos</label>
                            <input id="opt-y" type="number" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm font-mono focus:ring-indigo-500" />
                        </div>
                        ${type === 'shape' ? `
                            <div class="flex flex-col w-full sm:w-20">
                                <label class="text-[10px] sm:text-xs font-bold text-gray-600 uppercase mb-1">Width</label>
                                <input id="opt-w" type="number" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm font-mono focus:ring-indigo-500" />
                            </div>
                            <div class="flex flex-col w-full sm:w-20">
                                <label class="text-[10px] sm:text-xs font-bold text-gray-600 uppercase mb-1">Height</label>
                                <input id="opt-h" type="number" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm font-mono focus:ring-indigo-500" />
                            </div>
                        ` : ''}
                    </div>

                    ${type === 'shape' ? `
                        <div class="w-full mt-1 pt-3 sm:pt-4 border-t border-gray-100 grid grid-cols-2 sm:flex sm:flex-wrap items-end gap-3">
                            <h4 class="col-span-2 sm:w-full text-xs font-bold text-indigo-500 uppercase tracking-wider">Generators</h4>
                            ${isStageNode ? `
                                <div class="flex flex-col col-span-2 sm:col-span-1 sm:w-auto">
                                    <label class="text-[10px] sm:text-xs font-semibold text-gray-600 mb-1">Template</label>
                                    <select id="opt-stage-template" class="w-full sm:w-28 border border-gray-300 rounded-lg px-2 py-2 text-sm focus:ring-indigo-500 bg-white">
                                        <option value="stadium">Stadium</option><option value="concert">Concert</option>
                                    </select>
                                </div>
                                <div class="flex flex-col w-full sm:w-16"><label class="text-[10px] sm:text-xs font-semibold text-gray-600 mb-1">Seats</label><input id="opt-stage-seats" type="number" value="30" class="w-full border border-gray-300 rounded-lg px-2 py-2 text-sm" /></div>
                                <div class="flex flex-col w-full sm:w-16"><label class="text-[10px] sm:text-xs font-semibold text-gray-600 mb-1">Rows</label><input id="opt-stage-rows" type="number" value="3" class="w-full border border-gray-300 rounded-lg px-2 py-2 text-sm" /></div>
                                <div class="flex flex-col w-full sm:w-16"><label class="text-[10px] sm:text-xs font-semibold text-gray-600 mb-1">Prefix</label><input id="opt-stage-prefix" type="text" value="C" class="w-full border border-gray-300 rounded-lg px-2 py-2 text-sm" /></div>
                                <button type="button" id="opt-stage-btn" class="col-span-2 sm:w-auto px-4 py-2.5 sm:py-2 bg-indigo-100 text-indigo-700 hover:bg-indigo-200 font-bold rounded-lg transition-colors text-sm">Generate Array</button>
                            ` : `
                                <div class="flex flex-col w-full sm:w-20"><label class="text-[10px] sm:text-xs font-semibold text-gray-600 mb-1">Seats</label><input id="opt-gen-count" type="number" value="4" class="w-full border border-gray-300 rounded-lg px-2 py-2 text-sm" /></div>
                                <div class="flex flex-col w-full sm:w-20"><label class="text-[10px] sm:text-xs font-semibold text-gray-600 mb-1">Prefix</label><input id="opt-gen-prefix" type="text" value="T" class="w-full border border-gray-300 rounded-lg px-2 py-2 text-sm" /></div>
                                <button type="button" id="opt-gen-btn" class="col-span-2 sm:w-auto px-4 py-2.5 sm:py-2 bg-indigo-100 text-indigo-700 hover:bg-indigo-200 font-bold rounded-lg transition-colors text-sm">Generate Ring</button>
                            `}
                        </div>
                    ` : ''}
                    
                    <div class="w-full mt-2 border-t border-gray-100 pt-3">
                        <button type="button" id="opt-confirm" class="w-full sm:w-auto sm:float-right px-6 py-3 sm:py-2.5 bg-blue-600 text-white font-bold rounded-lg shadow hover:bg-blue-700 transition-colors text-sm">
                            Apply Changes
                        </button>
                    </div>
                </div>
            `;

            document.getElementById('opt-display-id').textContent = `ID: ${displayId}`;
            document.getElementById('opt-name').value = data.name;
            document.getElementById('opt-x').value = data.x;
            document.getElementById('opt-y').value = data.y;
            if (type === 'shape') {
                document.getElementById('opt-w').value = data.width;
                document.getElementById('opt-h').value = data.height;
                if (isStageNode) document.getElementById('opt-stage-btn').addEventListener('click', () => generateStageSeats(data, parseInt(document.getElementById('opt-stage-seats').value), parseInt(document.getElementById('opt-stage-rows').value), document.getElementById('opt-stage-template').value, document.getElementById('opt-stage-prefix').value));
                else document.getElementById('opt-gen-btn').addEventListener('click', () => generateSeatsAroundTable(data, parseInt(document.getElementById('opt-gen-count').value), document.getElementById('opt-gen-prefix').value));
            }

            document.getElementById('opt-confirm').addEventListener('click', async () => {
                const oldName = data.name;
                data.name = document.getElementById('opt-name').value;
                
                data.x = Math.max(0, Math.min(parseInt(document.getElementById('opt-x').value) || 0, baseW - (data.width || 60)));
                data.y = Math.max(0, Math.min(parseInt(document.getElementById('opt-y').value) || 0, baseH - (data.height || 60)));
                
                if (type === 'shape') {
                    data.width = Math.max(40, parseInt(document.getElementById('opt-w').value) || 100);
                    data.height = Math.max(40, parseInt(document.getElementById('opt-h').value) || 100);
                }

                if (oldName !== data.name && selectedItems.has(oldName)) {
                    selectedItems.delete(oldName); selectedItems.add(data.name);
                }
                renderAll(); 

                if (!isTemp) {
                    try {
                        await fetch(type === 'seat' ? '/Seat/UpdateSeat' : '/NonSelectable/UpdateElement', { method: 'POST', headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value }, body: JSON.stringify(data) });
                        updateStatus(`${type} updated!`, "success");
                    } catch (err) { updateStatus(`Failed DB sync.`, "error"); }
                } else updateStatus(`Unsaved ${type} updated.`, "success");
            });
        };

        window.groupSelectedItems = function() {
            if (selectedItems.size < 2) return updateStatus("Select at least 2 items to group.", "warning");

            const explicitItems = currentSeats.concat(currentShapes).filter(s => selectedItems.has(s.name));
            const existingGroupIds = new Set(explicitItems.map(s => s.groupId).filter(id => id));

            let allItemsToGroup = new Set([...explicitItems]);
            if (existingGroupIds.size > 0) {
                currentSeats.concat(currentShapes).forEach(s => { if (s.groupId && existingGroupIds.has(s.groupId)) allItemsToGroup.add(s); });
            }

            const itemsArray = Array.from(allItemsToGroup);

            const newGroupId = `group-temp-${Date.now()}`;
            const minX = Math.min(...itemsArray.map(s => s.x));
            const minY = Math.min(...itemsArray.map(s => s.y));

            currentGroups = currentGroups.filter(g => !existingGroupIds.has(g.id));

            currentGroups.push({ id: newGroupId, name: `Group ${currentGroups.length + 1}`, x: minX, y: minY });

            selectedItems.clear();
            itemsArray.forEach(s => { s.groupId = newGroupId; selectedItems.add(s.name); });

            updateStatus(existingGroupIds.size > 0 ? "Multiple groups merged successfully." : "Items grouped successfully.", "success");
            renderAll(); showOptions({ id: newGroupId }, 'group');
        };

        window.ungroupSelectedItems = function() {
            const itemsToUngroup = currentSeats.concat(currentShapes).filter(s => selectedItems.has(s.name) && s.groupId);
            if (itemsToUngroup.length === 0) return updateStatus("No grouped items selected.", "warning");

            const groupIdsToRemove = new Set(itemsToUngroup.map(s => s.groupId));
            currentGroups = currentGroups.filter(g => !groupIdsToRemove.has(g.id));
            currentSeats.concat(currentShapes).forEach(s => { if (groupIdsToRemove.has(s.groupId)) delete s.groupId; });

            updateStatus("Items ungrouped.", "success");
            renderAll();
        };

        document.querySelectorAll('[draggable="true"]').forEach(btn => {
            btn.addEventListener('dragstart', (e) => {
                e.dataTransfer.setData('itemType', btn.id.replace('add-table-', '').replace('add-scene-', '').replace('add-seat-', ''));
                e.dataTransfer.effectAllowed = 'copy';
            });
        });

        seatMap.addEventListener('dragover', (e) => { e.preventDefault(); e.dataTransfer.dropEffect = 'copy'; });
        seatMap.addEventListener('drop', (e) => {
            e.preventDefault();
            const itemType = e.dataTransfer.getData('itemType');
            const rect = zoomContainer.getBoundingClientRect();
            let dropX = Math.round(((e.clientX - rect.left) / currentScale) / 10) * 10;
            let dropY = Math.round(((e.clientY - rect.top) / currentScale) / 10) * 10;

            let itemW = 60, itemH = 60;
            if (itemType === 'stage') { itemW = 300; itemH = 150; }
            else if (['square', 'circle', 'triangle'].includes(itemType)) { itemW = 100; itemH = 100; }

            dropX = Math.max(0, Math.min(dropX, baseW - itemW));
            dropY = Math.max(0, Math.min(dropY, baseH - itemH));

            if (itemType === 'single') {
                const u = getUniqueItemName('S', 1);
                currentSeats.push({ id: `temp-${Date.now()}`, name: u.name, x: dropX, y: dropY, available: true });
            } else if (['square', 'circle', 'triangle', 'stage'].includes(itemType)) {
                let shapeType = 'rectangle'; let pfx = "Table"; let bg = '#D1D5DB';
                if (itemType === 'circle') shapeType = 'ellipse';
                if (itemType === 'triangle') shapeType = 'triangle';
                if (itemType === 'stage') { pfx = "Stage"; bg = '#4B5563'; }
                
                const u = getUniqueItemName(pfx + ' ', 1);
                currentShapes.push({ id: `temp-${Date.now()}`, name: u.name, x: dropX, y: dropY, width: itemW, height: itemH, shapeType: shapeType, backgroundColor: bg });
            }
            renderAll();
        });

        function renderAll() {
            zoomContainer.querySelectorAll('div[data-id]').forEach(el => el.remove());

            currentGroups.forEach(group => {
                const children = currentSeats.concat(currentShapes).filter(s => s.groupId === group.id);
                if (children.length === 0) return;

                let minX = Math.min(...children.map(s => s.x)); let minY = Math.min(...children.map(s => s.y));
                let maxX = Math.max(...children.map(s => s.x + (s.width || 60))); let maxY = Math.max(...children.map(s => s.y + (s.height || 60)));
                group.x = minX; group.y = minY;

                const el = document.createElement('div');
                el.dataset.id = group.id; el.dataset.type = 'group';
                
                const isSelected = Array.from(selectedItems).some(name => children.find(c => c.name === name));
                el.className = `absolute border-2 border-dashed rounded-lg z-0 transition-colors cursor-move ${isSelected ? 'border-indigo-500 bg-indigo-500/10' : 'border-gray-400 bg-gray-400/10'}`;
                el.style.left = `${minX - 10}px`; el.style.top = `${minY - 10}px`; el.style.width = `${(maxX - minX) + 20}px`; el.style.height = `${(maxY - minY) + 20}px`;

                setupDragAndSelect(el, group, 'group');
                zoomContainer.appendChild(el);
            });

            currentSeats.forEach(seat => {
                const el = document.createElement('div');
                el.dataset.id = seat.id; el.dataset.name = seat.name; el.title = seat.name; 
                el.className = `absolute text-white rounded-lg flex flex-col items-center justify-center cursor-move shadow transition-colors select-none ${selectedItems.has(seat.name) ? 'bg-red-500 ring-2 ring-red-200' : 'bg-blue-500 hover:bg-blue-600'}`;
                el.style.width = '60px'; el.style.height = '60px'; el.style.left = `${seat.x}px`; el.style.top = `${seat.y}px`;
                
                const nameDiv = document.createElement('div');
                nameDiv.textContent = seat.name; nameDiv.className = 'w-full text-center truncate font-bold text-sm px-1 pointer-events-none';
                el.appendChild(nameDiv);

                setupDragAndSelect(el, seat, 'seat'); zoomContainer.appendChild(el);
            });

            currentShapes.forEach(shape => {
                const el = document.createElement('div');
                el.dataset.type = "shape"; el.dataset.id = shape.id; el.dataset.name = shape.name; el.title = shape.name; 
                el.className = 'absolute flex flex-col items-center justify-center text-sm font-medium group z-[10] hover:z-[20] select-none';
                el.style.left = `${shape.x}px`; el.style.top = `${shape.y}px`; el.style.width = `${shape.width}px`; el.style.height = `${shape.height}px`;

                const visualBg = document.createElement('div');
                visualBg.className = `visual-bg absolute inset-0 shadow-md pointer-events-none opacity-80 group-hover:opacity-100 transition-opacity border border-gray-300 ${selectedItems.has(shape.name) ? 'ring-4 ring-indigo-500' : ''}`;
                visualBg.style.backgroundColor = shape.backgroundColor || '#D1D5DB';
                if (shape.shapeType === 'ellipse') visualBg.style.borderRadius = '50%';
                if (shape.shapeType === 'triangle') { visualBg.style.clipPath = 'polygon(50% 0%, 0% 100%, 100% 100%)'; visualBg.style.border = 'none'; }
                el.appendChild(visualBg);

                if (shape.name) {
                    const label = document.createElement('span');
                    label.className = `z-10 text-center pointer-events-none font-bold ${shape.backgroundColor === '#4B5563' ? 'text-white bg-gray-900/50' : 'text-gray-800 bg-white/50'} px-2 py-0.5 rounded shadow-sm text-[10px] sm:text-xs`;
                    label.textContent = shape.name;
                    if (shape.shapeType === 'triangle') label.style.marginTop = '25%';
                    el.appendChild(label);
                }

                const resizeHandle = document.createElement('div');
                resizeHandle.className = 'absolute bottom-0 right-0 w-6 h-6 cursor-nwse-resize flex items-end justify-end p-1 z-20 opacity-0 group-hover:opacity-100 transition-opacity bg-white/80 rounded-tl-lg backdrop-blur-sm shadow border-t border-l border-gray-300';
                resizeHandle.innerHTML = `<svg viewBox="0 0 24 24" width="14" height="14" class="text-gray-700"><path fill="currentColor" d="M22,22H20V20H22V22M22,18H20V16H22V18M18,22H16V20H18V22M18,18H16V16H18V18M14,22H12V20H14V22M22,14H20V12H22V14Z" /></svg>`;
                el.appendChild(resizeHandle);

                setupShapeResize(resizeHandle, el, shape); setupDragAndSelect(el, shape, 'shape'); zoomContainer.appendChild(el);
            });
        }

        function setupDragAndSelect(element, dataObj, type) {
            let isDragging = false; let startX, startY;

            element.addEventListener('mousedown', function(e) {
                if (e.target.closest('.cursor-nwse-resize')) return; 
                // IGNORE CTRL CLICKS SO PANNING CAN TAKE OVER
                if (e.ctrlKey || e.metaKey) return; 

                e.preventDefault(); e.stopPropagation();

                const isGroup = (type === 'group');
                const groupId = isGroup ? dataObj.id : dataObj.groupId;

                if (!e.shiftKey && (!isGroup && (!selectedItems.has(dataObj.name) || !groupId))) selectedItems.clear();

                if (groupId) currentSeats.concat(currentShapes).forEach(s => { if (s.groupId === groupId) selectedItems.add(s.name); });
                else selectedItems.add(dataObj.name);

                const activeGroupIds = new Set();
                currentSeats.concat(currentShapes).forEach(s => { if (selectedItems.has(s.name) && s.groupId) activeGroupIds.add(s.groupId); });
                currentSeats.concat(currentShapes).forEach(s => { if (s.groupId && activeGroupIds.has(s.groupId)) selectedItems.add(s.name); });

                updateSelectionVisuals(); showOptions(dataObj, isGroup ? 'group' : type);

                startX = e.clientX; startY = e.clientY;
                const startingPositions = new Map();
                currentSeats.concat(currentShapes).forEach(s => {
                    if (selectedItems.has(s.name)) {
                        startingPositions.set(s.name, { x: s.x, y: s.y });
                        const childEl = document.querySelector(`[data-name="${s.name}"]`);
                        if(childEl) childEl.classList.add('opacity-70', 'z-[100]');
                    }
                });
                if (isGroup) element.classList.add('opacity-70', 'z-[100]');

                const onMouseMove = function(moveEvent) {
                    const dx = (moveEvent.clientX - startX) / currentScale; const dy = (moveEvent.clientY - startY) / currentScale;
                    if (!isDragging && (Math.abs(dx) > 3 || Math.abs(dy) > 3)) isDragging = true;

                    if (isDragging) {
                        currentSeats.concat(currentShapes).forEach(s => {
                            if (selectedItems.has(s.name)) {
                                const startPos = startingPositions.get(s.name);
                                if(startPos) {
                                    const itemW = s.width || 60; const itemH = s.height || 60;
                                    s.x = Math.max(0, Math.min(startPos.x + dx, baseW - itemW)); 
                                    s.y = Math.max(0, Math.min(startPos.y + dy, baseH - itemH));
                                    const childEl = document.querySelector(`[data-name="${s.name}"]`);
                                    if (childEl) { childEl.style.left = `${s.x}px`; childEl.style.top = `${s.y}px`; }
                                }
                            }
                        });

                        currentGroups.forEach(g => {
                            const children = currentSeats.concat(currentShapes).filter(s => s.groupId === g.id);
                            if (children.length > 0 && selectedItems.has(children[0].name)) {
                                const groupEl = document.querySelector(`div[data-id="${g.id}"]`);
                                if (groupEl) {
                                    groupEl.style.left = `${Math.min(...children.map(s => s.x)) - 10}px`;
                                    groupEl.style.top = `${Math.min(...children.map(s => s.y)) - 10}px`;
                                }
                            }
                        });
                    }
                };

                const onMouseUp = function(eUp) {
                    document.removeEventListener('mousemove', onMouseMove); document.removeEventListener('mouseup', onMouseUp);

                    currentSeats.concat(currentShapes).forEach(s => {
                        if (selectedItems.has(s.name)) {
                            const childEl = document.querySelector(`[data-name="${s.name}"]`);
                            if(childEl) childEl.classList.remove('opacity-70', 'z-[100]');
                        }
                    });
                    if (isGroup) element.classList.remove('opacity-70', 'z-[100]');

                    if (isDragging) {
                        currentSeats.concat(currentShapes).forEach(s => {
                            if (selectedItems.has(s.name)) {
                                s.x = Math.round(s.x / 10) * 10; s.y = Math.round(s.y / 10) * 10;
                                const childEl = document.querySelector(`[data-name="${s.name}"]`);
                                if(childEl) { childEl.style.left = `${s.x}px`; childEl.style.top = `${s.y}px`; }
                            }
                        });
                        showOptions(dataObj, isGroup ? 'group' : type); renderAll();
                    } else if (!eUp.shiftKey && !isGroup) {
                        if (dataObj.groupId) {
                            selectedItems.clear();
                            currentSeats.concat(currentShapes).forEach(s => { if (s.groupId === dataObj.groupId) selectedItems.add(s.name); });
                            updateSelectionVisuals(); showOptions(dataObj, type);
                        } else {
                            selectedItems.clear(); selectedItems.add(dataObj.name);
                            updateSelectionVisuals(); showOptions(dataObj, type);
                        }
                    }
                };
                document.addEventListener('mousemove', onMouseMove); document.addEventListener('mouseup', onMouseUp);
            });
        }

        function setupShapeResize(handleElement, parentElement, shapeData) {
            let isResizing = false; let startW, startH, startX, startY;

            handleElement.addEventListener('mousedown', function(e) {
                if (e.ctrlKey || e.metaKey) return; 

                e.preventDefault(); e.stopPropagation();
                isResizing = true; startX = e.clientX; startY = e.clientY; startW = shapeData.width; startH = shapeData.height;

                const onMouseMove = function(moveEvent) {
                    if (!isResizing) return;
                    const dx = (moveEvent.clientX - startX) / currentScale; const dy = (moveEvent.clientY - startY) / currentScale;
                    
                    shapeData.width = Math.max(40, Math.min(Math.round((startW + dx) / 10) * 10, baseW - shapeData.x));
                    shapeData.height = Math.max(40, Math.min(Math.round((startH + dy) / 10) * 10, baseH - shapeData.y));
                    parentElement.style.width = `${shapeData.width}px`; parentElement.style.height = `${shapeData.height}px`;

                    if (shapeData.groupId) {
                        const children = currentSeats.concat(currentShapes).filter(s => s.groupId === shapeData.groupId);
                        if (children.length > 0) {
                            const groupEl = document.querySelector(`div[data-id="${shapeData.groupId}"]`);
                            if (groupEl) {
                                groupEl.style.width = `${(Math.max(...children.map(s => s.x + (s.width || 60))) - Math.min(...children.map(s => s.x))) + 20}px`;
                                groupEl.style.height = `${(Math.max(...children.map(s => s.y + (s.height || 60))) - Math.min(...children.map(s => s.y))) + 20}px`;
                            }
                        }
                    }
                };

                const onMouseUp = function() {
                    isResizing = false; document.removeEventListener('mousemove', onMouseMove); document.removeEventListener('mouseup', onMouseUp);
                    selectedItems.clear();
                    if (shapeData.groupId) {
                        currentSeats.concat(currentShapes).forEach(s => { if (s.groupId === shapeData.groupId) selectedItems.add(s.name); });
                        updateSelectionVisuals(); showOptions(shapeData, 'shape'); 
                    } else {
                        selectedItems.add(shapeData.name); updateSelectionVisuals(); showOptions(shapeData, 'shape');
                    }
                    renderAll(); 
                };
                document.addEventListener('mousemove', onMouseMove); document.addEventListener('mouseup', onMouseUp);
            });
        }

        const selectionBox = document.getElementById('selection-box');
        let isBoxSelecting = false; let startBoxX, startBoxY;

        // ==========================================
        // PAN AND BOX-SELECT EVENT LISTENER
        // ==========================================
        seatMap.addEventListener('mousedown', function(e) {
            if (isClickToAddMode) return;

            // PANNING LOGIC (Ctrl + Click & Drag)
            if (e.ctrlKey || e.metaKey) {
                e.preventDefault();
                let isPanning = true;
                let panStartX = e.clientX;
                let panStartY = e.clientY;
                let scrollStartX = seatMap.scrollLeft;
                let scrollStartY = seatMap.scrollTop;
                
                seatMap.style.cursor = 'grabbing';

                const onPanMove = function(ePanMove) {
                    if (!isPanning) return;
                    ePanMove.preventDefault();
                    const dx = ePanMove.clientX - panStartX;
                    const dy = ePanMove.clientY - panStartY;
                    seatMap.scrollLeft = scrollStartX - dx;
                    seatMap.scrollTop = scrollStartY - dy;
                };

                const onPanUp = function() {
                    isPanning = false;
                    seatMap.style.cursor = ''; 
                    document.removeEventListener('mousemove', onPanMove);
                    document.removeEventListener('mouseup', onPanUp);
                };

                document.addEventListener('mousemove', onPanMove);
                document.addEventListener('mouseup', onPanUp);
                return; // Stop here so it doesn't trigger box selection
            }

            // BOX SELECTION LOGIC
            if (e.target !== seatMap && e.target !== zoomContainer && e.target.id !== 'layout-boundary') return; 

            hideAllOptions(); isBoxSelecting = true;
            const rect = zoomContainer.getBoundingClientRect();
            startBoxX = (e.clientX - rect.left) / currentScale; startBoxY = (e.clientY - rect.top) / currentScale;
            selectionBox.style.left = `${startBoxX}px`; selectionBox.style.top = `${startBoxY}px`;
            selectionBox.style.width = '0px'; selectionBox.style.height = '0px'; selectionBox.style.display = 'block';

            const onMouseMove = function(eMove) {
                if (!isBoxSelecting) return; eMove.preventDefault();
                const currentX = (eMove.clientX - rect.left) / currentScale; const currentY = (eMove.clientY - rect.top) / currentScale;
                const left = Math.min(startBoxX, currentX); const top = Math.min(startBoxY, currentY);
                const width = Math.abs(currentX - startBoxX); const height = Math.abs(currentY - startBoxY);

                selectionBox.style.left = `${left}px`; selectionBox.style.top = `${top}px`;
                selectionBox.style.width = `${width}px`; selectionBox.style.height = `${height}px`;

                if (!eMove.shiftKey) selectedItems.clear();

                const activeGroups = new Set();
                currentSeats.forEach(seat => {
                    if (seat.x + 30 >= left && seat.x + 30 <= left + width && seat.y + 30 >= top && seat.y + 30 <= top + height) {
                        selectedItems.add(seat.name); if (seat.groupId) activeGroups.add(seat.groupId);
                    } else if (!eMove.shiftKey && !seat.groupId) selectedItems.delete(seat.name);
                });
                
                currentShapes.forEach(shape => {
                    if (shape.x + (shape.width/2) >= left && shape.x + (shape.width/2) <= left + width && shape.y + (shape.height/2) >= top && shape.y + (shape.height/2) <= top + height) {
                        selectedItems.add(shape.name); if (shape.groupId) activeGroups.add(shape.groupId);
                    } else if (!eMove.shiftKey && !shape.groupId) selectedItems.delete(shape.name);
                });

                currentSeats.concat(currentShapes).forEach(s => {
                    if (s.groupId) {
                        if (activeGroups.has(s.groupId)) selectedItems.add(s.name);
                        else if (!eMove.shiftKey) selectedItems.delete(s.name);
                    }
                });
                updateSelectionVisuals(); 
            };

            const onMouseUp = function() {
                if (!isBoxSelecting) return;
                isBoxSelecting = false; selectionBox.style.display = 'none';
                
                if (selectedItems.size === 1) {
                    const selectedName = Array.from(selectedItems)[0];
                    const obj = currentSeats.find(s => s.name === selectedName) || currentShapes.find(s => s.name === selectedName);
                    if (obj) showOptions(obj, currentSeats.includes(obj) ? 'seat' : 'shape');
                }
                document.removeEventListener('mousemove', onMouseMove); document.removeEventListener('mouseup', onMouseUp);
            };
            document.addEventListener('mousemove', onMouseMove); document.addEventListener('mouseup', onMouseUp);
        });

        document.getElementById('save-seats').addEventListener('click', async () => {
            updateStatus("Saving layout configuration...", "loading");

            const layoutPayload = {
                seats: currentSeats.filter(s => !s.groupId).map(s => ({ name: s.name, X: s.x, Y: s.y, available: true, layoutId: parseInt(layoutId), width: 60, height: 60 })),
                shapes: currentShapes.filter(s => !s.groupId).map(s => ({ name: s.name, X: s.x, Y: s.y, layoutId: parseInt(layoutId), shapeType: s.shapeType, width: s.width, height: s.height, backgroundColor: s.backgroundColor })),
                groups: currentGroups.map(g => {
                    const groupChildren = currentSeats.concat(currentShapes).filter(s => s.groupId === g.id);
                    return {
                        name: g.name, top: g.y, left: g.x, layoutId: parseInt(layoutId),
                        selectableUnits: groupChildren.filter(c => currentSeats.includes(c)).map(c => ({ name: c.name, X: c.x - g.x, Y: c.y - g.y, available: true, width: 60, height: 60 })),
                        nonSelectableUnits: groupChildren.filter(c => currentShapes.includes(c)).map(c => ({ name: c.name, X: c.x - g.x, Y: c.y - g.y, shapeType: c.shapeType, width: c.width, height: c.height, backgroundColor: c.backgroundColor }))
                    };
                })
            };

            try {
                const response = await fetch(`/Seat/SaveCompleteLayout?layoutId=${layoutId}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value },
                    body: JSON.stringify(layoutPayload)
                });
                if (response.ok) { updateStatus("Layout mapped and saved securely.", "success"); loadSeats(layoutId); }
                else throw new Error("Synchronization failure.");
            } catch (error) { updateStatus("Error processing save transaction.", "error"); }
        });
        
        async function loadSeats(id) {
            updateStatus("Retrieving layout coordinates...", "loading");
            try {
                const response = await fetch(`/Seat/GetCompleteLayout?layoutId=${id}`);
                if (!response.ok) throw new Error("Failed to retrieve coordinate array.");
                
                const data = await response.json();
                currentSeats = []; currentShapes = []; currentGroups = [];

                if (data.seats) data.seats.forEach(s => currentSeats.push({...s, x: s.x ?? s.X ?? 0, y: s.y ?? s.Y ?? 0}));
                if (data.shapes) data.shapes.forEach(s => currentShapes.push({...s, x: s.x ?? s.X ?? 0, y: s.y ?? s.Y ?? 0}));
                if (data.groups) {
                    data.groups.forEach(g => {
                        const groupId = `group-${g.id}`;
                        currentGroups.push({ id: groupId, name: g.name, x: g.left, y: g.top });
                        if (g.selectableUnits) g.selectableUnits.forEach(c => {
                            currentSeats = currentSeats.filter(s => s.id !== c.id);
                            currentSeats.push({ ...c, x: (c.x ?? c.X ?? 0) + g.left, y: (c.y ?? c.Y ?? 0) + g.top, groupId: groupId });
                        });
                        if (g.nonSelectableUnits) g.nonSelectableUnits.forEach(c => {
                            currentShapes = currentShapes.filter(s => s.id !== c.id);
                            currentShapes.push({ ...c, x: (c.x ?? c.X ?? 0) + g.left, y: (c.y ?? c.Y ?? 0) + g.top, groupId: groupId });
                        });
                    });
                }
                
                selectedItems.clear(); renderAll(); hideAllOptions(); 
                setTimeout(fitLayoutToViewport, 150);
                updateStatus(`Retrieved ${currentSeats.length} active seats.`, "success");
            } catch (error) { updateStatus("Error parsing retrieved layout constraints.", "error"); }
        }

        document.getElementById('tab-details').addEventListener('click', function() {
            this.classList.add('border-indigo-500', 'text-indigo-600'); this.classList.remove('border-transparent', 'text-gray-500');
            document.getElementById('tab-seats').className = 'tab-button shrink-0 flex items-center border-transparent text-gray-500 hover:text-gray-800 hover:border-gray-300 py-4 px-4 sm:px-6 border-b-2 font-semibold text-sm transition-colors ml-2';
            document.getElementById('details-content').style.display = 'block'; document.getElementById('seats-content').style.display = 'none';
            turnOffClickToAdd(); 
        });

        document.getElementById('tab-seats').addEventListener('click', function() {
            this.classList.add('border-indigo-500', 'text-indigo-600'); this.classList.remove('border-transparent', 'text-gray-500');
            document.getElementById('tab-details').className = 'tab-button shrink-0 flex items-center border-transparent text-gray-500 hover:text-gray-800 hover:border-gray-300 py-4 px-4 sm:px-6 border-b-2 font-semibold text-sm transition-colors';
            document.getElementById('details-content').style.display = 'none'; document.getElementById('seats-content').style.display = 'block';
            
            if (!window.seatsInitialized) { window.seatsInitialized = true; loadSeats(layoutId); } 
            else setTimeout(fitLayoutToViewport, 50); 
        });

        if (window.location.hash === '#seats') document.getElementById('tab-seats').click();
    });
</script>