            zoomContainer.querySelectorAll('div[data-type="shape"]').forEach(el => {
                const visualBg = el.querySelector('.visual-bg');
                if (visualBg) {
                    if (selectedItems.has(el.dataset.name)) visualBg.classList.add('ring-4', 'ring-red-500');
                    else visualBg.classList.remove('ring-4', 'ring-red-500');
                }
