        /**
         * Orchestrates circular parametric coordinate plotting surrounding standard table objects.
         * Enforces strict padding calculating structural offsets resolving overlap issues.
         * @@param {Object} shapeData - Baseline entity model properties
         * @@param {number} seatCount - Defined generation limit constraint
         * @@param {string} prefix - Lexical naming prefix requirement
         */
        function generateSeatsAroundTable(shapeData, seatCount, prefix) {
            if (seatCount <= 0 || seatCount > 50) {
                updateStatus("Please enter a valid number of seats (1-50).", "warning");
                return;
            }

            const margin = 30; 
            const seatW = 60, seatH = 60;

            const cx = shapeData.x + (shapeData.width / 2);
            const cy = shapeData.y + (shapeData.height / 2);

            let rx = (shapeData.width / 2) + margin + (seatW / 2);
            let ry = (shapeData.height / 2) + margin + (seatH / 2);

            const arcPerSeat = 75; 
            const requiredMinRadius = (seatCount * arcPerSeat) / (2 * Math.PI);
            
            if (rx < requiredMinRadius) rx = requiredMinRadius;
            if (ry < requiredMinRadius) ry = requiredMinRadius;

            const newSeats = [];
            for (let i = 0; i < seatCount; i++) {
                const angle = (i * 2 * Math.PI) / seatCount;
                const seatX = cx + (rx * Math.cos(angle)) - (seatW / 2);
                const seatY = cy + (ry * Math.sin(angle)) - (seatH / 2);

                newSeats.push({
                    id: `temp-${Date.now()}-${i}`,
                    name: `${prefix}${i + 1}`,
                    x: Math.round(seatX / 10) * 10,
                    y: Math.round(seatY / 10) * 10,
                    available: true
                });
            }

            currentSeats.push(...newSeats);

            let targetGroupId = shapeData.groupId;
            
            if (!targetGroupId) {
                targetGroupId = `group-temp-${Date.now()}`;
                const allGroupItems = [shapeData, ...newSeats];
                const minX = Math.min(...allGroupItems.map(s => s.x));
                const minY = Math.min(...allGroupItems.map(s => s.y));

                currentGroups.push({
                    id: targetGroupId,
                    name: `Table Group ${currentGroups.length + 1}`,
                    x: minX,
                    y: minY
                });
                
                shapeData.groupId = targetGroupId;
            }

            newSeats.forEach(s => s.groupId = targetGroupId);
            updateStatus(`Generated ${seatCount} seats around ${shapeData.name}.`, "success");
            
            selectedItems.clear();
            const groupChildren = currentSeats.concat(currentShapes).filter(s => s.groupId === targetGroupId);
            groupChildren.forEach(s => selectedItems.add(s.name));
            
            renderAll();
            showOptions(shapeData, 'shape');
        }

        /**
         * Calculates extensive coordinate matrices modeling amphitheater style or stadium ring seating.
         * Appends explicit boundary thresholds enforcing linear scaling prevention patterns.
         * @@param {Object} shapeData - Baseline entity stage constraints
         * @@param {number} totalSeats - Absolute volume configuration total
         * @@param {number} rowCount - Concentric level limits
         * @@param {string} template - Delineated algorithmic mapping schema selector
         * @@param {string} prefix - Structural lexical identification string
         */
        function generateStageSeats(shapeData, totalSeats, rowCount, template, prefix) {
            if (totalSeats <= 0 || totalSeats > 300) return updateStatus("Please enter a valid number of seats (1-300).", "warning");
            if (rowCount <= 0 || rowCount > 20) return updateStatus("Please enter a valid number of rows (1-20).", "warning");

            const seatW = 60, seatH = 60;
            const margin = 40; 
            const rowSpacing = 80; 

            const cx = shapeData.x + (shapeData.width / 2);
            const cy = shapeData.y + (shapeData.height / 2);

            let baseRx = (shapeData.width / 2) + margin + (seatW / 2);
            let baseRy = (shapeData.height / 2) + margin + (seatH / 2);

            let seatsPerRow = new Array(rowCount).fill(Math.floor(totalSeats / rowCount));
            let remainder = totalSeats % rowCount;
            for(let i = rowCount - 1; i >= rowCount - remainder; i--) {
                if(i >= 0) seatsPerRow[i]++;
            }
            
            const maxSeatsInARow = Math.max(...seatsPerRow);
            const arcPerSeat = 75; 
            const requiredArcLength = maxSeatsInARow * arcPerSeat;

            let requiredMinRadius = 0;
            if (template === 'stadium') {
                requiredMinRadius = requiredArcLength / (2 * Math.PI);
            } else if (template === 'concert') {
                requiredMinRadius = requiredArcLength / (0.8 * Math.PI);
            }

            if (baseRx < requiredMinRadius) baseRx = requiredMinRadius;
            if (baseRy < requiredMinRadius) baseRy = requiredMinRadius;

            const newSeats = [];
            let seatCounter = 0;

            for (let r = 0; r < rowCount; r++) {
                const currentRx = baseRx + (r * rowSpacing);
                const currentRy = baseRy + (r * rowSpacing);
                const seatsInThisRow = seatsPerRow[r];

                if (seatsInThisRow <= 0) continue;

                for (let i = 0; i < seatsInThisRow; i++) {
                    let angle;
                    
                    if (template === 'stadium') {
                        angle = (i * 2 * Math.PI) / seatsInThisRow;
                    } else if (template === 'concert') {
                        if (seatsInThisRow === 1) {
                            angle = Math.PI / 2; 
                        } else {
                            const startAngle = 0.1 * Math.PI;
                            const endAngle = 0.9 * Math.PI;
                            angle = startAngle + (i * (endAngle - startAngle) / (seatsInThisRow - 1));
                        }
                    }

                    const seatX = cx + (currentRx * Math.cos(angle)) - (seatW / 2);
                    const seatY = cy + (currentRy * Math.sin(angle)) - (seatH / 2);

                    newSeats.push({
                        id: `temp-${Date.now()}-${seatCounter}`,
                        name: `${prefix}${seatCounter + 1}`,
                        x: Math.round(seatX / 10) * 10,
                        y: Math.round(seatY / 10) * 10,
                        available: true
                    });
                    seatCounter++;
                }
            }

            currentSeats.push(...newSeats);

            let targetGroupId = shapeData.groupId;
            
            if (!targetGroupId) {
                targetGroupId = `group-temp-${Date.now()}`;
                const allGroupItems = [shapeData, ...newSeats];
                const minX = Math.min(...allGroupItems.map(s => s.x));
                const minY = Math.min(...allGroupItems.map(s => s.y));

                currentGroups.push({
                    id: targetGroupId,
                    name: `Stage Group ${currentGroups.length + 1}`,
                    x: minX,
                    y: minY
                });
                
                shapeData.groupId = targetGroupId;
            }

            newSeats.forEach(s => s.groupId = targetGroupId);
            updateStatus(`Generated ${totalSeats} seats around ${shapeData.name}.`, "success");
            
            selectedItems.clear();
            const groupChildren = currentSeats.concat(currentShapes).filter(s => s.groupId === targetGroupId);
            groupChildren.forEach(s => selectedItems.add(s.name));
            
            renderAll();
            showOptions(shapeData, 'shape');
        }

        /** Dispatches transactional remote delete endpoints synchronizing memory layout states. */
        window.removeSelectedItems = async function() {
            if (selectedItems.size === 0) return updateStatus("No items selected.", "warning");

            if (confirm(`Remove ${selectedItems.size} selected item(s)?`)) {
                const itemsToDelete = Array.from(selectedItems);
                const dbItemsToDelete = itemsToDelete.filter(name => !name.startsWith('temp-'));

                currentSeats = currentSeats.filter(s => !selectedItems.has(s.name));
                currentShapes = currentShapes.filter(s => !selectedItems.has(s.name));

                if (dbItemsToDelete.length > 0) {
                    try {
                        await fetch('/Seat/DeleteMultipleSeats', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                            },
                            body: JSON.stringify({ seatNames: dbItemsToDelete, layoutId: layoutId })
                        });
                        
                        await fetch('/NonSelectable/DeleteElements', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ names: dbItemsToDelete, layoutId: layoutId })
                        });

                        updateStatus("Items removed successfully from database.", "success");
                    } catch (err) {
                        updateStatus("Items removed from view, but database sync failed.", "warning");
                    }
                } else {
                    updateStatus("Unsaved items removed.", "success");
                }

                selectedItems.clear();
                renderAll();
                hideAllOptions();
            }
        };

