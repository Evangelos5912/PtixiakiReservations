@using System.Linq
@model PtixiakiReservations.Models.Layout

@{
    ViewData["Title"] = "Edit Layout";
}

<div class="container mx-auto bg-gradient-to-br from-gray-50 to-blue-50/50 min-h-screen py-4 sm:py-8 px-2 sm:px-6 lg:px-8">
    <div class="w-full max-w-screen-2xl mx-auto">
        
        <div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden mb-4 sm:mb-8">
            <div class="bg-gradient-to-r from-blue-600 to-indigo-700 px-4 sm:px-8 py-6 sm:py-8">
                <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
                    <div>
                        <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">Edit Layout</h1>
                        <p class="mt-1 sm:mt-2 text-blue-100 text-sm sm:text-base">
                            Configure floor plan and assign seating mapping for <span class="font-bold text-white">@Model.AreaName</span>
                        </p>
                    </div>
                    <div class="shrink-0">
                        <a href="@Url.Action("VenueLayouts", new { venueId = Model.VenueId })"
                           class="inline-flex items-center px-4 py-2 bg-white/10 hover:bg-white/20 text-white border border-white/20 rounded-lg shadow-sm text-sm font-semibold transition-all w-full justify-center sm:w-auto backdrop-blur-sm">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                            </svg>
                            Back to Venue
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-2xl shadow-lg border border-gray-200 overflow-hidden">
            
            <div class="border-b border-gray-200 bg-gray-50/50 overflow-x-auto">
                <nav class="flex px-2 sm:px-4" aria-label="Tabs">
                    <button id="tab-details" class="tab-button flex items-center border-indigo-500 text-indigo-600 py-4 px-4 sm:px-6 border-b-2 font-bold text-sm transition-colors" aria-current="page">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                        Basic Details
                    </button>
                    <button id="tab-seats" class="tab-button flex items-center border-transparent text-gray-500 hover:text-gray-800 hover:border-gray-300 py-4 px-4 sm:px-6 border-b-2 font-semibold text-sm transition-colors ml-2">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z" /></svg>
                        Seat Map Editor
                    </button>
                </nav>
            </div>

            <div class="p-4 sm:p-8">
                
                <div id="details-content" class="tab-content">
                    <form asp-action="Edit" id="editLayoutForm" class="space-y-6 max-w-2xl mx-auto">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-red-500 text-sm bg-red-50 p-3 rounded-lg border border-red-200"></div>
                        <input type="hidden" asp-for="Id"/>
                        <input type="hidden" asp-for="VenueId"/>

                        <div class="bg-gray-50 p-6 rounded-xl border border-gray-100 space-y-6">
                            <div>
                                <label asp-for="AreaName" class="block text-sm font-bold text-gray-700 mb-1.5">Layout Name</label>
                                <input asp-for="AreaName" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-shadow shadow-sm text-sm" placeholder="e.g. Main Hall" />
                                <span asp-validation-for="AreaName" class="text-red-500 text-xs mt-1.5 block"></span>
                            </div>

                            <div>
                                <label asp-for="Desc" class="block text-sm font-bold text-gray-700 mb-1.5">Description</label>
                                <textarea asp-for="Desc" rows="3" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-shadow shadow-sm text-sm" placeholder="General info about this area..."></textarea>
                                <span asp-validation-for="Desc" class="text-red-500 text-xs mt-1.5 block"></span>
                            </div>

                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                                <div>
                                    <label asp-for="Width" class="block text-sm font-bold text-gray-700 mb-1.5">Map Boundary Width</label>
                                    <input asp-for="Width" type="number" min="0" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 shadow-sm text-sm" />
                                    <span asp-validation-for="Width" class="text-red-500 text-xs mt-1.5 block"></span>
                                </div>
                                <div>
                                    <label asp-for="Height" class="block text-sm font-bold text-gray-700 mb-1.5">Map Boundary Height</label>
                                    <input asp-for="Height" type="number" min="0" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 shadow-sm text-sm" />
                                    <span asp-validation-for="Height" class="text-red-500 text-xs mt-1.5 block"></span>
                                </div>
                            </div>
                        </div>

                        <div class="flex flex-col sm:flex-row items-center gap-3 pt-4">
                            <button type="submit" class="w-full sm:w-auto px-6 py-2.5 bg-indigo-600 text-white font-bold rounded-lg shadow hover:bg-indigo-700 focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-all text-sm">
                                Save Details
                            </button>
                        </div>
                    </form>
                </div>

                <div id="seats-content" class="tab-content hidden">
                    <div id="seat-status" class="hidden mb-4 font-bold text-sm transition-all duration-300 shadow-sm"></div>

                    <div class="bg-white rounded-t-xl border border-gray-200 p-4 shadow-sm relative z-20">
                        
                        <div class="flex flex-col xl:flex-row gap-4 w-full items-start xl:items-center justify-between">
                            
                            <div class="order-1 xl:order-2 flex flex-wrap gap-2 w-full xl:w-auto justify-start xl:justify-end">
                                <button type="button" onclick="groupSelectedItems()" class="flex items-center px-4 py-2 bg-indigo-50 hover:bg-indigo-100 text-indigo-700 border border-indigo-200 rounded-lg shadow-sm text-sm font-bold transition-all flex-1 sm:flex-none justify-center">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" /></svg>
                                    Group
                                </button>
                                <button type="button" onclick="ungroupSelectedItems()" class="flex items-center px-4 py-2 bg-white hover:bg-gray-50 text-gray-700 border border-gray-300 rounded-lg shadow-sm text-sm font-bold transition-all flex-1 sm:flex-none justify-center">
                                    Ungroup
                                </button>
                                <button type="button" id="deleteSeatBtn" onclick="removeSelectedItems()" class="flex items-center px-4 py-2 bg-red-50 hover:bg-red-100 text-red-700 border border-red-200 rounded-lg shadow-sm text-sm font-bold transition-all flex-1 sm:flex-none justify-center">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                                    Delete
                                </button>
                                <button type="button" id="save-seats" class="flex items-center px-6 py-2 bg-green-600 hover:bg-green-700 text-white rounded-lg shadow text-sm font-bold transition-all flex-1 sm:flex-none justify-center w-full sm:w-auto mt-2 sm:mt-0">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4"/></svg>
                                    Save Map
                                </button>
                            </div>

                            <div class="order-2 xl:order-1 flex flex-wrap gap-2 w-full xl:w-auto justify-start border-t xl:border-t-0 border-gray-100 pt-4 xl:pt-0">
                                <span class="w-full xl:hidden text-xs font-bold text-gray-400 uppercase tracking-wider mb-1">Add Elements:</span>
                                <button type="button" id="show-seat" class="px-4 py-2 text-sm font-bold text-blue-700 bg-blue-50 border border-blue-200 hover:bg-blue-600 hover:text-white rounded-lg shadow-sm transition-all flex-1 sm:flex-none">Seats</button>
                                <button type="button" id="show-table" class="px-4 py-2 text-sm font-bold text-blue-700 bg-blue-50 border border-blue-200 hover:bg-blue-600 hover:text-white rounded-lg shadow-sm transition-all flex-1 sm:flex-none">Tables</button>
                                <button type="button" id="show-scene" class="px-4 py-2 text-sm font-bold text-blue-700 bg-blue-50 border border-blue-200 hover:bg-blue-600 hover:text-white rounded-lg shadow-sm transition-all flex-1 sm:flex-none">Stages</button>
                            </div>
                        </div>

                        <div class="order-3 w-full mt-4 bg-gray-50 rounded-lg p-3 border border-gray-200 shadow-inner min-h-[60px]">
                            <div id="toolbar-instruction" class="text-sm text-gray-500 italic flex items-center justify-center h-full w-full">
                                Select a category above to view component configurations.
                            </div>
                            
                            <div class="AddContainer w-full hidden flex flex-wrap items-center gap-2 justify-start" id="seatContainer">
                                
                                <div class="flex items-center bg-white border border-gray-300 rounded-md shadow-sm overflow-hidden h-9">
                                    <button type="button" id="toggle-click-add" class="px-3 h-full text-sm font-bold text-gray-700 hover:bg-gray-50 transition-colors flex items-center gap-1.5 border-r border-gray-300 outline-none focus:bg-gray-50">
                                        <svg class="w-4 h-4 text-indigo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5M7.188 2.239l.777 2.897M5.136 7.965l-2.898-.777M13.95 4.05l-2.122 2.122m-5.657 5.656l-2.12 2.122"></path></svg>
                                        Click-to-Add: <span id="click-add-status" class="text-red-500 font-extrabold ml-1">OFF</span>
                                    </button>
                                    <input type="text" id="click-add-prefix" value="S" placeholder="Prefix" class="w-16 h-full text-sm px-2 outline-none focus:bg-indigo-50 font-bold text-gray-700" title="Seat Prefix">
                                    <div class="w-px h-5 bg-gray-300"></div>
                                    <input type="number" id="click-add-start" value="1" min="1" class="w-16 h-full text-sm px-2 outline-none focus:bg-indigo-50 font-bold text-gray-700" title="Start Number">
                                </div>
                                <div class="w-px h-6 bg-gray-300 mx-1"></div>

                                <button type="button" id="add-seat-single" draggable="true" class="px-4 py-1.5 text-sm font-bold text-gray-700 bg-white border border-gray-300 hover:border-blue-400 hover:text-blue-600 rounded-md shadow-sm cursor-grab active:cursor-grabbing">Single</button>
                                <button type="button" id="add-seat-hline" class="px-4 py-1.5 text-sm font-bold text-gray-700 bg-white border border-gray-300 hover:border-blue-400 hover:bg-blue-50 hover:text-blue-600 rounded-md shadow-sm transition-colors cursor-pointer">Horizontal Row</button>
                                <button type="button" id="add-seat-vline" class="px-4 py-1.5 text-sm font-bold text-gray-700 bg-white border border-gray-300 hover:border-blue-400 hover:bg-blue-50 hover:text-blue-600 rounded-md shadow-sm transition-colors cursor-pointer">Vertical Row</button>
                                <button type="button" id="add-seat-grid" class="px-4 py-1.5 text-sm font-bold text-gray-700 bg-white border border-gray-300 hover:border-blue-400 hover:bg-blue-50 hover:text-blue-600 rounded-md shadow-sm transition-colors cursor-pointer">Grid</button>
                            </div>
                            
                            <div class="AddContainer w-full hidden flex flex-wrap gap-2 justify-start" id="tableContainer">
                                <button type="button" id="add-table-square" draggable="true" class="px-4 py-1.5 text-sm font-bold text-gray-700 bg-white border border-gray-300 hover:border-blue-400 hover:text-blue-600 rounded-md shadow-sm cursor-grab active:cursor-grabbing">Square Table</button>
                                <button type="button" id="add-table-circle" draggable="true" class="px-4 py-1.5 text-sm font-bold text-gray-700 bg-white border border-gray-300 hover:border-blue-400 hover:text-blue-600 rounded-md shadow-sm cursor-grab active:cursor-grabbing">Circular Table</button>
                                <button type="button" id="add-table-triangle" draggable="true" class="px-4 py-1.5 text-sm font-bold text-gray-700 bg-white border border-gray-300 hover:border-blue-400 hover:text-blue-600 rounded-md shadow-sm cursor-grab active:cursor-grabbing">Triangular Table</button>
                            </div>
                            
                            <div class="AddContainer w-full hidden flex flex-wrap gap-2 justify-start" id="sceneContainer">
                                <button type="button" id="add-scene-stage" draggable="true" class="px-4 py-1.5 text-sm font-bold text-gray-700 bg-white border border-gray-300 hover:border-blue-400 hover:text-blue-600 rounded-md shadow-sm cursor-grab active:cursor-grabbing">Performance Stage</button>
                            </div>
                        </div>
                    </div>

                    <div class="relative mt-[-1px] z-10">
                        <div class="bg-gray-100 rounded-b-xl border border-gray-200 p-0 w-full overflow-hidden relative shadow-inner" style="height: 65vh; min-height: 500px; max-height: 900px;">
                            
                            <div class="absolute bottom-4 right-4 z-[110] flex items-center gap-1 bg-white/90 backdrop-blur p-1.5 rounded-lg shadow-md border border-gray-200">
                                <button type="button" id="zoom-out" class="p-1.5 hover:bg-gray-100 rounded text-gray-700 transition-colors" title="Zoom Out">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM13 10H7"/></svg>
                                </button>
                                <span id="zoom-level" class="w-12 text-center text-sm font-extrabold text-gray-800 select-none">100%</span>
                                <button type="button" id="zoom-in" class="p-1.5 hover:bg-gray-100 rounded text-gray-700 transition-colors" title="Zoom In">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"/></svg>
                                </button>
                                <div class="w-px h-5 bg-gray-300 mx-1"></div>
                                <button type="button" id="zoom-reset" class="p-1.5 hover:bg-gray-100 rounded text-gray-700 transition-colors" title="Reset Zoom">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                                </button>
                            </div>

                            <div id="seat-map" class="relative w-full h-full overflow-auto select-none touch-pan-x touch-pan-y shadow-inner z-[90]">
                                <div id="zoom-container" class="absolute top-0 left-0 origin-top-left transition-transform duration-75 bg-[radial-gradient(#cbd5e1_1px,transparent_1px)] [background-size:20px_20px]" style="width: 2500px; height: 2500px; z-index: 10;">
                                    <div id="selection-box" class="selection-box"></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mt-4 w-full relative z-30">
                        <div class="hidden flex flex-col bg-white shadow-xl border-t-4 border-indigo-500 rounded-xl p-4 sm:p-6 w-full gap-4 transition-all duration-300 animate-fade-in-up" id="optionsPanel"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .selection-box {
        position: absolute;
        border: 2px dashed #4f46e5; 
        background-color: rgba(79, 70, 229, 0.15); 
        pointer-events: none;
        z-index: 100;
        display: none;
    }
    
    @@keyframes fadeInUp {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .animate-fade-in-up {
        animation: fadeInUp 0.3s ease-out forwards;
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        let currentSeats = [];
        let currentShapes = [];
        let currentGroups = [];
        let selectedItems = new Set();
        window.seatsInitialized = false;

        const layoutId = document.querySelector('input[name="Id"]').value;
        const seatMap = document.getElementById('seat-map');
        const zoomContainer = document.getElementById('zoom-container');
        const optionsPanel = document.getElementById("optionsPanel");
        const instructionBar = document.getElementById("toolbar-instruction");

        let currentScale = 1;
        const zoomLevelText = document.getElementById('zoom-level');

        let isClickToAddMode = false;
        const toggleClickAddBtn = document.getElementById('toggle-click-add');
        const clickAddStatus = document.getElementById('click-add-status');
        const prefixInput = document.getElementById('click-add-prefix');
        const startInput = document.getElementById('click-add-start');

        function getUniqueItemName(prefix, startNum) {
            let num = startNum;
            let nameStr = `${prefix}${num}`;
            while (currentSeats.some(s => s.name === nameStr) || currentShapes.some(s => s.name === nameStr)) {
                num++;
                nameStr = `${prefix}${num}`;
            }
            return { name: nameStr, nextNum: num + 1 };
        }

        toggleClickAddBtn.addEventListener('click', () => {
            isClickToAddMode = !isClickToAddMode;
            if(isClickToAddMode) {
                clickAddStatus.textContent = "ON";
                clickAddStatus.classList.replace('text-red-500', 'text-green-600');
                toggleClickAddBtn.classList.add('ring-2', 'ring-green-400', 'border-green-400');
                seatMap.style.cursor = 'crosshair'; 
            } else {
                turnOffClickToAdd();
            }
        });

        function turnOffClickToAdd() {
            isClickToAddMode = false;
            if(clickAddStatus) {
                clickAddStatus.textContent = "OFF";
                clickAddStatus.classList.replace('text-green-600', 'text-red-500');
                toggleClickAddBtn.classList.remove('ring-2', 'ring-green-400', 'border-green-400');
                seatMap.style.cursor = 'default';
            }
        }

        zoomContainer.addEventListener('click', function(e) {
            if (!isClickToAddMode) return;
            
            if (e.target === zoomContainer || e.target === seatMap) {
                e.preventDefault();
                e.stopPropagation();

                const prefix = prefixInput.value.trim();
                let currentNum = parseInt(startInput.value) || 1;
                
                const u = getUniqueItemName(prefix, currentNum);
                const seatName = u.name;

                const rect = zoomContainer.getBoundingClientRect();
                const dropX = Math.round(((e.clientX - rect.left) / currentScale) / 10) * 10;
                const dropY = Math.round(((e.clientY - rect.top) / currentScale) / 10) * 10;

                currentSeats.push({
                    id: `temp-${Date.now()}`,
                    name: seatName,
                    x: dropX,
                    y: dropY,
                    available: true
                });

                startInput.value = u.nextNum;
                renderAll();
            }
        });

        function findFreeSpace(reqWidth, reqHeight) {
            const gap = 40;
            const stepX = 50;
            const stepY = 50;

            const allItems = currentSeats.map(s => ({x: s.x, y: s.y, w: 60, h: 60}))
                .concat(currentShapes.map(s => ({x: s.x, y: s.y, w: s.width || 60, h: s.height || 60})));

            if (allItems.length === 0) return { x: 50, y: 50 };

            let maxX = 50, maxY = 50;
            allItems.forEach(i => {
                if (i.x + i.w > maxX) maxX = i.x + i.w;
                if (i.y + i.h > maxY) maxY = i.y + i.h;
            });

            for (let y = 50; y <= maxY + reqHeight + gap; y += stepY) {
                for (let x = 50; x <= maxX + reqWidth + gap; x += stepX) {
                    let isFree = true;
                    for (let i = 0; i < allItems.length; i++) {
                        const item = allItems[i];
                        if (x < item.x + item.w + gap &&
                            x + reqWidth + gap > item.x &&
                            y < item.y + item.h + gap &&
                            y + reqHeight + gap > item.y) {
                            isFree = false;
                            break;
                        }
                    }
                    if (isFree) return { x, y };
                }
            }
            return { x: 50, y: maxY + gap };
        }

        document.getElementById('add-seat-hline').addEventListener('click', () => {
            const countStr = prompt("How many seats in this horizontal row?", "5");
            if (!countStr) return;
            const count = parseInt(countStr);
            if (!count || count <= 0) return;
            const prefix = prompt("Seat Prefix:", "R1-");
            if (prefix === null) return;

            const reqWidth = count * 70;
            const freePos = findFreeSpace(reqWidth, 60);
            
            const newSeats = [];
            let currentNum = 1;
            for (let i = 0; i < count; i++) {
                const u = getUniqueItemName(prefix, currentNum);
                newSeats.push({ id: `temp-${Date.now()}-${i}`, name: u.name, x: freePos.x + (i * 70), y: freePos.y, available: true });
                currentNum = u.nextNum;
            }
            createAndInjectGroup(newSeats, 'Horizontal Row');
        });

        document.getElementById('add-seat-vline').addEventListener('click', () => {
            const countStr = prompt("How many seats in this vertical row?", "5");
            if (!countStr) return;
            const count = parseInt(countStr);
            if (!count || count <= 0) return;
            const prefix = prompt("Seat Prefix:", "C1-");
            if (prefix === null) return;

            const reqHeight = count * 70;
            const freePos = findFreeSpace(60, reqHeight);
            
            const newSeats = [];
            let currentNum = 1;
            for (let i = 0; i < count; i++) {
                const u = getUniqueItemName(prefix, currentNum);
                newSeats.push({ id: `temp-${Date.now()}-${i}`, name: u.name, x: freePos.x, y: freePos.y + (i * 70), available: true });
                currentNum = u.nextNum;
            }
            createAndInjectGroup(newSeats, 'Vertical Row');
        });

        document.getElementById('add-seat-grid').addEventListener('click', () => {
            const input = prompt("Enter grid dimensions (Rows x Columns), e.g. 4x5", "4x5");
            if (!input) return;
            const parts = input.toLowerCase().split('x');
            if (parts.length !== 2) return alert("Invalid format. Please use RowsxColumns (e.g. 4x5).");
            const rows = parseInt(parts[0].trim());
            const cols = parseInt(parts[1].trim());
            if (!rows || !cols || rows <= 0 || cols <= 0) return alert("Invalid dimensions provided.");
            
            const prefix = prompt("Seat Prefix:", "G-");
            if (prefix === null) return;

            const reqWidth = cols * 70;
            const reqHeight = rows * 70;
            const freePos = findFreeSpace(reqWidth, reqHeight);
            
            const newSeats = [];
            let currentNum = 1;
            for (let r = 0; r < rows; r++) {
                for (let c = 0; c < cols; c++) {
                    const u = getUniqueItemName(prefix, currentNum);
                    newSeats.push({ id: `temp-${Date.now()}-${r}-${c}`, name: u.name, x: freePos.x + (c * 70), y: freePos.y + (r * 70), available: true });
                    currentNum = u.nextNum;
                }
            }
            createAndInjectGroup(newSeats, 'Grid');
        });

        function createAndInjectGroup(newSeatsArray, groupTitlePrefix) {
            currentSeats.push(...newSeatsArray);
            const targetGroupId = `group-temp-${Date.now()}`;
            currentGroups.push({
                id: targetGroupId,
                name: `${groupTitlePrefix} ${currentGroups.length + 1}`,
                x: Math.min(...newSeatsArray.map(s => s.x)),
                y: Math.min(...newSeatsArray.map(s => s.y))
            });

            newSeatsArray.forEach(s => s.groupId = targetGroupId);
            updateStatus(`Generated ${newSeatsArray.length} items.`, "success");
            
            selectedItems.clear();
            currentSeats.filter(s => s.groupId === targetGroupId).forEach(s => selectedItems.add(s.name));
            
            renderAll();
            showOptions({ id: targetGroupId }, 'group');
        }

        function setZoom(scale) {
            currentScale = Math.max(0.1, Math.min(scale, 2.5)); 
            zoomContainer.style.transform = `scale(${currentScale})`;
            zoomLevelText.textContent = `${Math.round(currentScale * 100)}%`;
        }

        function fitLayoutToViewport() {
            const allItems = currentSeats.concat(currentShapes).concat(currentGroups);
            if (allItems.length === 0) {
                setZoom(1);
                return;
            }

            const xs = allItems.map(s => parseFloat(s.x) || 0);
            const ys = allItems.map(s => parseFloat(s.y) || 0);
            const maxXs = allItems.map(s => (parseFloat(s.x) || 0) + (parseFloat(s.width) || 60)); 
            const maxYs = allItems.map(s => (parseFloat(s.y) || 0) + (parseFloat(s.height) || 60));

            const minX = Math.min(...xs);
            const minY = Math.min(...ys);
            const maxX = Math.max(...maxXs);
            const maxY = Math.max(...maxYs);

            const padding = 120; 
            const requiredWidth = Math.max(2500, maxX + padding);
            const requiredHeight = Math.max(2500, maxY + padding);
            
            zoomContainer.style.width = requiredWidth + 'px';
            zoomContainer.style.height = requiredHeight + 'px';

            const contentWidth = (maxX - minX) + (padding * 2);
            const contentHeight = (maxY - minY) + (padding * 2);
            const viewportWidth = seatMap.clientWidth || window.innerWidth * 0.7;
            const viewportHeight = seatMap.clientHeight || 600;

            const scaleX = viewportWidth / contentWidth;
            const scaleY = viewportHeight / contentHeight;
            const optimalScale = Math.max(0.2, Math.min(scaleX, scaleY, 1.1));
            setZoom(optimalScale);

            const centerX = (minX + maxX) / 2;
            const centerY = (minY + maxY) / 2;

            setTimeout(() => {
                seatMap.scrollLeft = Math.max(0, (centerX * optimalScale) - (viewportWidth / 2));
                seatMap.scrollTop = Math.max(0, (centerY * optimalScale) - (viewportHeight / 2));
            }, 100);
        }

        document.getElementById('zoom-in').addEventListener('click', () => setZoom(currentScale + 0.1));
        document.getElementById('zoom-out').addEventListener('click', () => setZoom(currentScale - 0.1));
        document.getElementById('zoom-reset').addEventListener('click', () => setZoom(1));
        
        seatMap.addEventListener('wheel', (e) => {
            if (e.ctrlKey || e.metaKey) {
                e.preventDefault();
                setZoom(currentScale + (e.deltaY > 0 ? -0.1 : 0.1));
            }
        }, { passive: false });

        window.hideAllOptions = function() {
            optionsPanel.classList.add("hidden");
            optionsPanel.innerHTML = "";
