                }
            }

            document.getElementById('opt-confirm').addEventListener('click', async () => {
                const oldName = data.name;
                const newName = document.getElementById('opt-name').value;
                
                data.name = newName;
                data.x = parseInt(document.getElementById('opt-x').value) || 0;
                data.y = parseInt(document.getElementById('opt-y').value) || 0;

                if (type === 'shape') {
                    data.width = Math.max(40, parseInt(document.getElementById('opt-w').value) || 100);
                    data.height = Math.max(40, parseInt(document.getElementById('opt-h').value) || 100);
                }

                if (oldName !== newName && selectedItems.has(oldName)) {
                    selectedItems.delete(oldName);
                    selectedItems.add(newName);
                }

                renderAll(); 

                if (!isTemp) {
                    const endpoint = type === 'seat' ? '/Seat/UpdateSeat' : '/NonSelectable/UpdateElement';
                    try {
                        await fetch(endpoint, {
                            method: 'POST',
                            headers: { 
                                'Content-Type': 'application/json',
                                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                            },
                            body: JSON.stringify(data)
                        });
                        updateStatus(`${type} updated successfully!`, "success");
                    } catch (err) {
                        updateStatus(`Failed to sync ${type} to database.`, "error");
                    }
                } else {
                    updateStatus(`Unsaved ${type} updated locally.`, "success");
                }
            });
        };

        /** Aggregates loose elements attaching associative group metadata identifiers. */
        window.groupSelectedItems = function() {
            if (selectedItems.size < 2) {
                return updateStatus("Select at least 2 items to group.", "warning");
            }

            const itemsToGroup = currentSeats.concat(currentShapes).filter(s => selectedItems.has(s.name));
            if (itemsToGroup.some(s => s.groupId)) {
                return updateStatus("Some items are already grouped.", "error");
            }

            const groupId = `group-temp-${Date.now()}`;
            const minX = Math.min(...itemsToGroup.map(s => s.x));
            const minY = Math.min(...itemsToGroup.map(s => s.y));

            currentGroups.push({
                id: groupId,
                name: `Group ${currentGroups.length + 1}`,
                x: minX,
                y: minY
            });

            itemsToGroup.forEach(s => s.groupId = groupId);
            updateStatus("Items grouped successfully.", "success");
            renderAll();
        };

        /** Dismantles active grouping matrices freeing components to individual manipulation paths. */
        window.ungroupSelectedItems = function() {
            const itemsToUngroup = currentSeats.concat(currentShapes).filter(s => selectedItems.has(s.name) && s.groupId);
            if (itemsToUngroup.length === 0) return updateStatus("No grouped items selected.", "warning");

            const groupIdsToRemove = new Set(itemsToUngroup.map(s => s.groupId));
            currentGroups = currentGroups.filter(g => !groupIdsToRemove.has(g.id));
            currentSeats.concat(currentShapes).forEach(s => {
                if (groupIdsToRemove.has(s.groupId)) delete s.groupId;
            });

            updateStatus("Items ungrouped.", "success");
            renderAll();
        };

        // --- DRAG & DROP TOOLBAR BINDING ---
        document.querySelectorAll('[draggable="true"]').forEach(btn => {
            btn.addEventListener('dragstart', (e) => {
                let type = btn.id.replace('add-table-', '').replace('add-scene-', '').replace('add-seat-', '');
                e.dataTransfer.setData('itemType', type);
                e.dataTransfer.effectAllowed = 'copy';
            });
        });

        seatMap.addEventListener('dragover', (e) => { e.preventDefault(); e.dataTransfer.dropEffect = 'copy'; });
        
        seatMap.addEventListener('drop', (e) => {
            e.preventDefault();
            const itemType = e.dataTransfer.getData('itemType');
            const rect = zoomContainer.getBoundingClientRect();
            
            const dropX = Math.round(((e.clientX - rect.left) / currentScale) / 10) * 10;
            const dropY = Math.round(((e.clientY - rect.top) / currentScale) / 10) * 10;

            if (itemType === 'single') {
                currentSeats.push({
                    id: `temp-${Date.now()}`,
                    name: `S${currentSeats.length + 1}`,
                    x: dropX, y: dropY, available: true
                });
                updateStatus('Dropped new seat', 'success');
            } else if (['square', 'circle', 'triangle', 'stage'].includes(itemType)) {
                let shapeType = 'rectangle';
                let width = 100; let height = 100; let namePrefix = "Table"; let bgColor = '#D1D5DB';

                if (itemType === 'circle') shapeType = 'ellipse';
                if (itemType === 'triangle') shapeType = 'triangle';
                if (itemType === 'stage') {
                    shapeType = 'rectangle';
                    width = 300; height = 150; namePrefix = "Stage"; bgColor = '#4B5563';
                }
                
                currentShapes.push({
                    id: `temp-${Date.now()}`,
                    name: `${namePrefix} ${currentShapes.length + 1}`,
                    x: dropX, y: dropY, width: width, height: height,
                    shapeType: shapeType, backgroundColor: bgColor
                });
                updateStatus(`Dropped new ${itemType}`, 'success');
            }
            renderAll();
        });

        // --- RENDERING PIPELINE ---
        
        /** Evaluates element caches regenerating coordinate DOM injections structurally. */
        function renderAll() {
            zoomContainer.querySelectorAll('div[data-id]').forEach(el => el.remove());

            // Compile relational group boundary visualization
            currentGroups.forEach(group => {
                const children = currentSeats.concat(currentShapes).filter(s => s.groupId === group.id);
                if (children.length === 0) return;

                let minX = Math.min(...children.map(s => s.x));
                let minY = Math.min(...children.map(s => s.y));
                let maxX = Math.max(...children.map(s => s.x + (s.width || 60)));
                let maxY = Math.max(...children.map(s => s.y + (s.height || 60)));

                group.x = minX;
                group.y = minY;

                const el = document.createElement('div');
                el.dataset.id = group.id;
                el.dataset.type = 'group';
                
                const isSelected = Array.from(selectedItems).some(name => children.find(c => c.name === name));
                el.className = `absolute border-2 border-dashed rounded z-0 transition-colors cursor-move ${isSelected ? 'border-indigo-500 bg-indigo-500/10' : 'border-gray-400 bg-gray-400/10'}`;
                
                el.style.left = `${minX - 10}px`;
                el.style.top = `${minY - 10}px`;
                el.style.width = `${(maxX - minX) + 20}px`;
                el.style.height = `${(maxY - minY) + 20}px`;

                setupDragAndSelect(el, group, 'group');
                zoomContainer.appendChild(el);
            });

            // Compile primary seat entity layers
            currentSeats.forEach(seat => {
                const el = document.createElement('div');
                el.dataset.id = seat.id;
                el.dataset.name = seat.name;
                el.title = seat.name; 
                el.className = `absolute text-white rounded-md flex flex-col items-center justify-center cursor-move shadow-md select-none ${selectedItems.has(seat.name) ? 'bg-red-500 hover:bg-red-600' : 'bg-blue-500 hover:bg-blue-600'}`;
                el.style.width = '60px'; el.style.height = '60px';
                el.style.left = `${seat.x}px`; el.style.top = `${seat.y}px`;
                
                const nameDiv = document.createElement('div');
                nameDiv.textContent = seat.name;
                nameDiv.className = 'w-full text-center truncate text-xs sm:text-sm px-1 pointer-events-none select-none';
                el.appendChild(nameDiv);

                setupDragAndSelect(el, seat, 'seat');
                zoomContainer.appendChild(el);
            });

            // Compile secondary scenery constraints
            currentShapes.forEach(shape => {
                const el = document.createElement('div');
                el.dataset.type = "shape";
                el.dataset.id = shape.id;
                el.dataset.name = shape.name;
                el.title = shape.name; 
                el.className = 'absolute flex flex-col items-center justify-center text-sm font-medium group z-10 hover:z-20 select-none';
                el.style.left = `${shape.x}px`; el.style.top = `${shape.y}px`;
                el.style.width = `${shape.width}px`; el.style.height = `${shape.height}px`;

                const visualBg = document.createElement('div');
                visualBg.className = `visual-bg absolute inset-0 shadow-md pointer-events-none opacity-80 group-hover:opacity-100 transition-opacity border border-gray-300 ${selectedItems.has(shape.name) ? 'ring-4 ring-red-500' : ''}`;
                visualBg.style.backgroundColor = shape.backgroundColor || '#D1D5DB';
                if (shape.backgroundColor === '#4B5563') visualBg.classList.add('text-white'); 

                if (shape.shapeType === 'ellipse') visualBg.style.borderRadius = '50%';
                if (shape.shapeType === 'triangle') {
                    visualBg.style.clipPath = 'polygon(50% 0%, 0% 100%, 100% 100%)';
                    visualBg.style.border = 'none';
                }
                el.appendChild(visualBg);

                if (shape.name) {
                    const label = document.createElement('span');
                    label.className = `z-10 text-center pointer-events-none font-bold ${shape.backgroundColor === '#4B5563' ? 'text-white bg-gray-800/60' : 'text-gray-800 bg-white/60'} px-2 py-0.5 rounded backdrop-blur-sm shadow-sm select-none text-xs sm:text-sm`;
                    label.textContent = shape.name;
                    if (shape.shapeType === 'triangle') label.style.marginTop = '25%';
                    el.appendChild(label);
                }

                const resizeHandle = document.createElement('div');
                resizeHandle.className = 'absolute bottom-0 right-0 w-6 h-6 cursor-nwse-resize flex items-end justify-end p-1 z-20 opacity-0 group-hover:opacity-100 transition-opacity bg-white/70 rounded-tl-lg backdrop-blur-sm shadow-sm border-t border-l border-gray-200';
                resizeHandle.innerHTML = `<svg viewBox="0 0 24 24" width="14" height="14" class="text-gray-700"><path fill="currentColor" d="M22,22H20V20H22V22M22,18H20V16H22V18M18,22H16V20H18V22M18,18H16V16H18V18M14,22H12V20H14V22M22,14H20V12H22V14Z" /></svg>`;
                el.appendChild(resizeHandle);

                setupShapeResize(resizeHandle, el, shape);
                setupDragAndSelect(el, shape, 'shape');
                zoomContainer.appendChild(el);
            });
        }

        // --- INTERACTION LOGIC (DRAG & SELECT) ---
        
        /** 
         * Constructs relative coordinate binding capturing native mouse pan directives.
         * @@param {HTMLElement} element - Active component root targeting interaction matrix
         * @@param {Object} dataObj - Internal memory state configuration node
         * @@param {string} type - Lexical entity classification constraint
         */
        function setupDragAndSelect(element, dataObj, type) {
            let isDragging = false;
            let startX, startY;

            element.addEventListener('mousedown', function(e) {
                if (e.target.closest('.cursor-nwse-resize')) return; 
                e.preventDefault(); e.stopPropagation();

                const isGroup = (type === 'group');
                const groupId = isGroup ? dataObj.id : dataObj.groupId;

                if (!e.shiftKey) {
                    if (isGroup) {
                        selectedItems.clear();
                    } else if (!selectedItems.has(dataObj.name) || !groupId) {
                        selectedItems.clear();
                    }
                }

                if (groupId) {
                    currentSeats.concat(currentShapes).forEach(s => {
                        if (s.groupId === groupId) selectedItems.add(s.name);
                    });
                } else {
                    selectedItems.add(dataObj.name);
                }

                updateSelectionVisuals();

                if (isGroup) {
                    showOptions(dataObj, 'group');
                } else {
                    showOptions(dataObj, type);
                }

                startX = e.clientX; startY = e.clientY;
                
                const startingPositions = new Map();
                currentSeats.concat(currentShapes).forEach(s => {
                    if (selectedItems.has(s.name)) {
                        startingPositions.set(s.name, { x: s.x, y: s.y });
                        const childEl = document.querySelector(`[data-name="${s.name}"]`);
                        if(childEl) childEl.classList.add('opacity-70', 'z-50');
                    }
                });
                
                if (isGroup) element.classList.add('opacity-70', 'z-50');

                const onMouseMove = function(moveEvent) {
                    const dx = (moveEvent.clientX - startX) / currentScale;
                    const dy = (moveEvent.clientY - startY) / currentScale;
                    
                    if (!isDragging && (Math.abs(dx) > 3 || Math.abs(dy) > 3)) isDragging = true;

                    if (isDragging) {
                        currentSeats.concat(currentShapes).forEach(s => {
                            if (selectedItems.has(s.name)) {
                                const startPos = startingPositions.get(s.name);
                                if(startPos) {
                                    s.x = Math.max(0, startPos.x + dx);
                                    s.y = Math.max(0, startPos.y + dy);
                                    const childEl = document.querySelector(`[data-name="${s.name}"]`);
                                    if (childEl) {
                                        childEl.style.left = `${s.x}px`;
                                        childEl.style.top = `${s.y}px`;
                                    }
                                }
                            }
                        });

                        currentGroups.forEach(g => {
                            const children = currentSeats.concat(currentShapes).filter(s => s.groupId === g.id);
                            if (children.length > 0 && selectedItems.has(children[0].name)) {
                                let minX = Math.min(...children.map(s => s.x));
                                let minY = Math.min(...children.map(s => s.y));
                                const groupEl = document.querySelector(`div[data-id="${g.id}"]`);
                                if (groupEl) {
                                    groupEl.style.left = `${minX - 10}px`;
                                    groupEl.style.top = `${minY - 10}px`;
                                }
                            }
                        });
                    }
                };

                const onMouseUp = function(eUp) {
                    document.removeEventListener('mousemove', onMouseMove);
                    document.removeEventListener('mouseup', onMouseUp);

                    currentSeats.concat(currentShapes).forEach(s => {
                        if (selectedItems.has(s.name)) {
                            const childEl = document.querySelector(`[data-name="${s.name}"]`);
                            if(childEl) childEl.classList.remove('opacity-70', 'z-50');
                        }
                    });
                    if (isGroup) element.classList.remove('opacity-70', 'z-50');

                    if (isDragging) {
                        currentSeats.concat(currentShapes).forEach(s => {
                            if (selectedItems.has(s.name)) {
                                s.x = Math.round(s.x / 10) * 10;
                                s.y = Math.round(s.y / 10) * 10;
                                const childEl = document.querySelector(`[data-name="${s.name}"]`);
                                if(childEl) {
                                    childEl.style.left = `${s.x}px`;
                                    childEl.style.top = `${s.y}px`;
                                }
                            }
                        });

                        if (isGroup) {
                            showOptions(dataObj, 'group'); 
                        } else {
                            showOptions(dataObj, type); 
                        }
                        renderAll();
                    } else if (!eUp.shiftKey && !isGroup) {
                        selectedItems.clear();
                        selectedItems.add(dataObj.name);
                        updateSelectionVisuals();
                        showOptions(dataObj, type);
                    }
                };

                document.addEventListener('mousemove', onMouseMove);
                document.addEventListener('mouseup', onMouseUp);
            });
        }

        /** 
         * Binds proportional logic computing differential width matrices upon bounding box corner expansion.
         * @@param {HTMLElement} handleElement - Corner resize target DOM node
         * @@param {HTMLElement} parentElement - Wrapper scaling target DOM node
         * @@param {Object} shapeData - Internal configuration parameters updating relative bounds
         */
        function setupShapeResize(handleElement, parentElement, shapeData) {
            let isResizing = false;
            let startW, startH, startX, startY;

            handleElement.addEventListener('mousedown', function(e) {
                e.preventDefault(); e.stopPropagation();
                isResizing = true;
                startX = e.clientX; startY = e.clientY;
                startW = shapeData.width; startH = shapeData.height;

                const onMouseMove = function(moveEvent) {
                    if (!isResizing) return;
                    
                    const dx = (moveEvent.clientX - startX) / currentScale;
                    const dy = (moveEvent.clientY - startY) / currentScale;

                    shapeData.width = Math.max(40, Math.round((startW + dx) / 10) * 10);
                    shapeData.height = Math.max(40, Math.round((startH + dy) / 10) * 10);

                    parentElement.style.width = `${shapeData.width}px`;
                    parentElement.style.height = `${shapeData.height}px`;

                    if (shapeData.groupId) {
                        const gId = shapeData.groupId;
                        const children = currentSeats.concat(currentShapes).filter(s => s.groupId === gId);
                        if (children.length > 0) {
                            let minX = Math.min(...children.map(s => s.x));
                            let minY = Math.min(...children.map(s => s.y));
                            let maxX = Math.max(...children.map(s => s.x + (s.width || 60)));
                            let maxY = Math.max(...children.map(s => s.y + (s.height || 60)));
                            
                            const groupEl = document.querySelector(`div[data-id="${gId}"]`);
                            if (groupEl) {
                                groupEl.style.left = `${minX - 10}px`;
                                groupEl.style.top = `${minY - 10}px`;
                                groupEl.style.width = `${(maxX - minX) + 20}px`;
                                groupEl.style.height = `${(maxY - minY) + 20}px`;
                            }
                        }
                    }
                };

                const onMouseUp = function() {
                    isResizing = false;
                    document.removeEventListener('mousemove', onMouseMove);
                    document.removeEventListener('mouseup', onMouseUp);
                    
                    selectedItems.clear();
                    if (shapeData.groupId) {
                        const group = currentGroups.find(g => g.id === shapeData.groupId);
                        currentSeats.concat(currentShapes).forEach(s => {
                            if (s.groupId === shapeData.groupId) selectedItems.add(s.name);
                        });
                        updateSelectionVisuals();
                        showOptions(shapeData, 'shape'); 
                    } else {
                        selectedItems.add(shapeData.name);
                        updateSelectionVisuals();
                        showOptions(shapeData, 'shape');
                    }
                    renderAll(); 
                };

                document.addEventListener('mousemove', onMouseMove);
                document.addEventListener('mouseup', onMouseUp);
            });
        }

        // --- MARQUEE BOX SELECTION ---
        const selectionBox = document.getElementById('selection-box');
        let isBoxSelecting = false;
        let startBoxX, startBoxY;

        seatMap.addEventListener('mousedown', function(e) {
            if (e.target !== seatMap && e.target !== zoomContainer) return; 

            if (!e.shiftKey) {
                selectedItems.clear();
                updateSelectionVisuals();
            }

            hideAllOptions();
            isBoxSelecting = true;
            
            const rect = zoomContainer.getBoundingClientRect();
            startBoxX = (e.clientX - rect.left) / currentScale;
            startBoxY = (e.clientY - rect.top) / currentScale;

            selectionBox.style.left = `${startBoxX}px`; 
            selectionBox.style.top = `${startBoxY}px`;
            selectionBox.style.width = '0px'; 
            selectionBox.style.height = '0px';
            selectionBox.style.display = 'block';

            const onMouseMove = function(eMove) {
                if (!isBoxSelecting) return;
                eMove.preventDefault();

                const currentX = (eMove.clientX - rect.left) / currentScale;
                const currentY = (eMove.clientY - rect.top) / currentScale;

                const left = Math.min(startBoxX, currentX);
                const top = Math.min(startBoxY, currentY);
                const width = Math.abs(currentX - startBoxX);
                const height = Math.abs(currentY - startBoxY);

                selectionBox.style.left = `${left}px`; 
                selectionBox.style.top = `${top}px`;
                selectionBox.style.width = `${width}px`; 
                selectionBox.style.height = `${height}px`;

                currentSeats.forEach(seat => {
                    const cX = seat.x + 30; const cY = seat.y + 30;
                    if (cX >= left && cX <= left + width && cY >= top && cY <= top + height) {
                        selectedItems.add(seat.name);
                    } else if (!eMove.shiftKey) {
                        selectedItems.delete(seat.name);
                    }
                });

                currentShapes.forEach(shape => {
                    const cX = shape.x + (shape.width / 2); const cY = shape.y + (shape.height / 2);
                    if (cX >= left && cX <= left + width && cY >= top && cY <= top + height) {
                        selectedItems.add(shape.name);
                    } else if (!eMove.shiftKey) {
                        selectedItems.delete(shape.name);
                    }
                });
                
                updateSelectionVisuals(); 
            };

            const onMouseUp = function() {
                if (!isBoxSelecting) return;
                isBoxSelecting = false;
                selectionBox.style.display = 'none';
                
                if (selectedItems.size === 1) {
                    const selectedName = Array.from(selectedItems)[0];
                    const obj = currentSeats.find(s => s.name === selectedName) || currentShapes.find(s => s.name === selectedName);
                    if (obj) {
                        const type = currentSeats.includes(obj) ? 'seat' : 'shape';
                        showOptions(obj, type);
                    }
                }
                
                document.removeEventListener('mousemove', onMouseMove);
                document.removeEventListener('mouseup', onMouseUp);
            };

            document.addEventListener('mousemove', onMouseMove);
            document.addEventListener('mouseup', onMouseUp);
        });

        // --- SAVE LAYOUT ROUTINE ---
        
        /** Prepares layout matrices transmitting structural metadata arrays towards database endpoints. */
        document.getElementById('save-seats').addEventListener('click', async () => {
            updateStatus("Saving layout...", "loading");

            const standaloneSeats = currentSeats.filter(s => !s.groupId).map(seat => ({
                name: seat.name, X: seat.x, Y: seat.y, available: true, layoutId: parseInt(layoutId), width: 60, height: 60
            }));

            const standaloneShapes = currentShapes.filter(s => !s.groupId).map(shape => ({
                name: shape.name, X: shape.x, Y: shape.y, layoutId: parseInt(layoutId), shapeType: shape.shapeType, width: shape.width, height: shape.height, backgroundColor: shape.backgroundColor
            }));

            const unitGroupsData = currentGroups.map(g => {
                const groupChildren = currentSeats.concat(currentShapes).filter(s => s.groupId === g.id);
                return {
                    name: g.name,
                    top: g.y,
                    left: g.x,
                    layoutId: parseInt(layoutId),
                    selectableUnits: groupChildren.filter(c => currentSeats.includes(c)).map(c => ({
                        name: c.name, X: c.x - g.x, Y: c.y - g.y, available: true, width: 60, height: 60
                    })),
                    nonSelectableUnits: groupChildren.filter(c => currentShapes.includes(c)).map(c => ({
                        name: c.name, X: c.x - g.x, Y: c.y - g.y, shapeType: c.shapeType, width: c.width, height: c.height, backgroundColor: c.backgroundColor
                    }))
                };
            });

            const layoutPayload = {
                seats: standaloneSeats,
                shapes: standaloneShapes,
                groups: unitGroupsData
            };

            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                const response = await fetch(`/Seat/SaveCompleteLayout?layoutId=${layoutId}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                    body: JSON.stringify(layoutPayload)
                });

                if (response.ok) {
                    updateStatus("Layout saved successfully!", "success");
                    loadSeats(layoutId); 
                } else {
                    throw new Error("Save failed");
                }
            } catch (error) {
                updateStatus("Error saving layout", "error");
            }
        });
        
        // --- DATA FETCHING & INITIALIZATION ---
        
        /** 
         * Requests seat, shape, and grouping information from server formatting internal arrays. 
         * @@param {number} id - Identification integer matching external database parameter constraints.
         */
        async function loadSeats(id) {
            updateStatus("Loading layout...", "loading");
            try {
                const response = await fetch(`/Seat/GetCompleteLayout?layoutId=${id}`);
                if (!response.ok) throw new Error("Failed to fetch layout");
                
                const data = await response.json();
                
                currentSeats = [];
                currentShapes = [];
                currentGroups = [];

                if (data.seats) {
                    data.seats.forEach(s => currentSeats.push({...s, x: s.x ?? s.X ?? 0, y: s.y ?? s.Y ?? 0}));
                }
                if (data.shapes) {
                    data.shapes.forEach(s => currentShapes.push({...s, x: s.x ?? s.X ?? 0, y: s.y ?? s.Y ?? 0}));
                }

                if (data.groups) {
                    data.groups.forEach(g => {
                        const groupId = `group-${g.id}`;
                        currentGroups.push({
                            id: groupId,
                            name: g.name,
                            x: g.left,
                            y: g.top
                        });

                        if (g.selectableUnits) {
                            g.selectableUnits.forEach(c => {
                                currentSeats = currentSeats.filter(s => s.id !== c.id);
                                currentSeats.push({
                                    ...c,
                                    x: (c.x ?? c.X ?? 0) + g.left,
                                    y: (c.y ?? c.Y ?? 0) + g.top,
                                    groupId: groupId
                                });
                            });
                        }

                        if (g.nonSelectableUnits) {
                            g.nonSelectableUnits.forEach(c => {
                                currentShapes = currentShapes.filter(s => s.id !== c.id);
                                currentShapes.push({
                                    ...c,
                                    x: (c.x ?? c.X ?? 0) + g.left,
                                    y: (c.y ?? c.Y ?? 0) + g.top,
                                    groupId: groupId
                                });
                            });
                        }
                    });
                }
                
                selectedItems.clear();
                renderAll();
                hideAllOptions(); 

                setTimeout(fitLayoutToViewport, 150);

                updateStatus(`Loaded ${currentSeats.length} seats, ${currentShapes.length} shapes, and ${currentGroups.length} groups.`, "success");
            } catch (error) {
                console.error(error);
                updateStatus("Error loading layout", "error");
            }
        }

        // --- TAB STATE MANAGEMENT ---
        document.getElementById('tab-details').addEventListener('click', function() {
            this.classList.add('border-indigo-500', 'text-indigo-600');
            this.classList.remove('border-transparent', 'text-gray-500');
            document.getElementById('tab-seats').className = 'tab-button border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 whitespace-nowrap py-4 px-4 sm:px-6 border-b-2 font-medium text-sm transition-colors ml-2 sm:ml-8';
            document.getElementById('details-content').style.display = 'block';
            document.getElementById('seats-content').style.display = 'none';
        });

        document.getElementById('tab-seats').addEventListener('click', function() {
            this.classList.add('border-indigo-500', 'text-indigo-600');
            this.classList.remove('border-transparent', 'text-gray-500');
            document.getElementById('tab-details').className = 'tab-button border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 whitespace-nowrap py-4 px-4 sm:px-6 border-b-2 font-medium text-sm transition-colors';
            document.getElementById('details-content').style.display = 'none';
            document.getElementById('seats-content').style.display = 'block';
            
            if (!window.seatsInitialized) {
                window.seatsInitialized = true;
                loadSeats(layoutId);
            } else {
                setTimeout(fitLayoutToViewport, 50); 
            }
        });

        if (window.location.hash === '#seats') document.getElementById('tab-seats').click();
    });
</script>