        function generateSeatsAroundTable(shapeData, seatCount, prefix) {
            if (seatCount <= 0 || seatCount > 50) return updateStatus("Please enter a valid number (1-50).", "warning");

            const margin = 30; const seatW = 60; const seatH = 60;
            const cx = shapeData.x + (shapeData.width / 2);
            const cy = shapeData.y + (shapeData.height / 2);
            let rx = (shapeData.width / 2) + margin + (seatW / 2);
            let ry = (shapeData.height / 2) + margin + (seatH / 2);

            const arcPerSeat = 75; 
            const requiredMinRadius = (seatCount * arcPerSeat) / (2 * Math.PI);
            if (rx < requiredMinRadius) rx = requiredMinRadius;
            if (ry < requiredMinRadius) ry = requiredMinRadius;

            const newSeats = [];
            let currentNum = 1;
            for (let i = 0; i < seatCount; i++) {
                const angle = (i * 2 * Math.PI) / seatCount;
                const u = getUniqueItemName(prefix, currentNum);
                newSeats.push({
                    id: `temp-${Date.now()}-${i}`,
                    name: u.name,
                    x: Math.round((cx + (rx * Math.cos(angle)) - (seatW / 2)) / 10) * 10,
                    y: Math.round((cy + (ry * Math.sin(angle)) - (seatH / 2)) / 10) * 10,
                    available: true
                });
                currentNum = u.nextNum;
            }
            
            injectGeneratedSetAndGroup(shapeData, newSeats, 'Table Group');
        }

        function generateStageSeats(shapeData, totalSeats, rowCount, template, prefix) {
            if (totalSeats <= 0 || totalSeats > 300) return updateStatus("Valid seats: 1-300.", "warning");
            if (rowCount <= 0 || rowCount > 20) return updateStatus("Valid rows: 1-20.", "warning");

            const seatW = 60; const seatH = 60; const margin = 40; const rowSpacing = 80; 
            const cx = shapeData.x + (shapeData.width / 2);
            const cy = shapeData.y + (shapeData.height / 2);
            let baseRx = (shapeData.width / 2) + margin + (seatW / 2);
            let baseRy = (shapeData.height / 2) + margin + (seatH / 2);

            let seatsPerRow = new Array(rowCount).fill(Math.floor(totalSeats / rowCount));
            for(let i = rowCount - 1; i >= rowCount - (totalSeats % rowCount); i--) if(i >= 0) seatsPerRow[i]++;
            
            const reqRadius = (Math.max(...seatsPerRow) * 75) / (template === 'stadium' ? (2 * Math.PI) : (0.8 * Math.PI));
            if (baseRx < reqRadius) baseRx = reqRadius;
            if (baseRy < reqRadius) baseRy = reqRadius;

            const newSeats = []; let counter = 0; let currentNum = 1;
            for (let r = 0; r < rowCount; r++) {
                if (seatsPerRow[r] <= 0) continue;
                for (let i = 0; i < seatsPerRow[r]; i++) {
                    let angle = (template === 'stadium') 
                        ? (i * 2 * Math.PI) / seatsPerRow[r] 
                        : (seatsPerRow[r] === 1 ? Math.PI / 2 : 0.1 * Math.PI + (i * (0.8 * Math.PI) / (seatsPerRow[r] - 1)));
                        
                    const u = getUniqueItemName(prefix, currentNum);    
                    newSeats.push({
                        id: `temp-${Date.now()}-${counter}`,
                        name: u.name,
                        x: Math.round((cx + ((baseRx + (r * rowSpacing)) * Math.cos(angle)) - (seatW / 2)) / 10) * 10,
                        y: Math.round((cy + ((baseRy + (r * rowSpacing)) * Math.sin(angle)) - (seatH / 2)) / 10) * 10,
                        available: true
                    });
                    currentNum = u.nextNum;
                    counter++;
                }
            }
            injectGeneratedSetAndGroup(shapeData, newSeats, 'Stage Group');
        }

        function injectGeneratedSetAndGroup(parentShape, newSeatsArray, groupTitlePrefix) {
            currentSeats.push(...newSeatsArray);
            let targetGroupId = parentShape.groupId;
            
            if (!targetGroupId) {
                targetGroupId = `group-temp-${Date.now()}`;
                const allGroupItems = [parentShape, ...newSeatsArray];
                currentGroups.push({
                    id: targetGroupId,
                    name: `${groupTitlePrefix} ${currentGroups.length + 1}`,
                    x: Math.min(...allGroupItems.map(s => s.x)),
                    y: Math.min(...allGroupItems.map(s => s.y))
                });
                parentShape.groupId = targetGroupId;
            }

            newSeatsArray.forEach(s => s.groupId = targetGroupId);
            updateStatus(`Generated ${newSeatsArray.length} items.`, "success");
            
            selectedItems.clear();
            currentSeats.concat(currentShapes).filter(s => s.groupId === targetGroupId).forEach(s => selectedItems.add(s.name));
            
            renderAll();
            showOptions(parentShape, 'shape');
        }

        window.removeSelectedItems = async function() {
            if (selectedItems.size === 0) return updateStatus("No items selected.", "warning");

            if (confirm(`Remove ${selectedItems.size} selected item(s)?`)) {
                const dbItemsToDelete = Array.from(selectedItems).filter(name => !name.startsWith('temp-'));
                currentSeats = currentSeats.filter(s => !selectedItems.has(s.name));
                currentShapes = currentShapes.filter(s => !selectedItems.has(s.name));

                if (dbItemsToDelete.length > 0) {
                    try {
                        await fetch('/Seat/DeleteMultipleSeats', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value },
                            body: JSON.stringify({ seatNames: dbItemsToDelete, layoutId: layoutId })
                        });
                        await fetch('/NonSelectable/DeleteElements', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ names: dbItemsToDelete, layoutId: layoutId })
                        });
                        updateStatus("Items permanently deleted.", "success");
                    } catch (err) {
                        updateStatus("Items removed from view, but database sync failed.", "warning");
                    }
                } else {
                    updateStatus("Unsaved items discarded.", "success");
                }
                selectedItems.clear();
                renderAll(); hideAllOptions();
            }
        };

