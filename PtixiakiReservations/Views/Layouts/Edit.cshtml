            }

            const isStageNode = type === 'shape' && ((data.name && data.name.toLowerCase().includes('stage')) || (data.backgroundColor && data.backgroundColor.toUpperCase() === '#4B5563') || (data.shapeType === 'rectangle' && data.width >= 200 && data.height >= 100));

            optionsPanel.innerHTML = `
