@using System.Linq
@model PtixiakiReservations.Models.Layout

@{
    ViewData["Title"] = "Edit Layout";
}

<!-- Main Application Container with Responsive Padding -->
<div class="container mx-auto bg-gradient-to-r from-blue-50 to-indigo-50 min-h-screen py-4 sm:py-8 px-2 sm:px-6 lg:px-8">
    <div class="w-full mx-auto">
        
        <!-- Contextual Page Header -->
        <div class="bg-white rounded-xl shadow-md overflow-hidden mb-4 sm:mb-8">
            <div class="bg-gradient-to-r from-blue-600 to-indigo-600 px-4 sm:px-6 py-6 sm:py-8">
                <div class="flex flex-col md:flex-row md:items-center md:justify-between">
                    <div>
                        <h1 class="text-xl sm:text-2xl md:text-3xl font-bold text-white">Edit Layout</h1>
                        <p class="mt-1 sm:mt-2 text-indigo-100 max-w-3xl text-sm sm:text-base">
                            Update details and seating arrangement for <span class="font-semibold">@Model.AreaName</span>
                        </p>
                    </div>
                    <div class="mt-4 md:mt-0">
                        <a href="@Url.Action("VenueLayouts", new { venueId = Model.VenueId })"
                           class="inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-indigo-700 bg-white hover:bg-indigo-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-colors w-full justify-center sm:w-auto">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                            </svg>
                            Back to List
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Primary Editor Workspace -->
        <div class="bg-white rounded-xl shadow-lg overflow-hidden">
            
            <!-- View Navigation Interface -->
            <div class="border-b border-gray-200 overflow-x-auto">
                <nav class="flex -mb-px px-2 sm:px-0" aria-label="Tabs">
                    <button id="tab-details" class="tab-button border-indigo-500 text-indigo-600 whitespace-nowrap py-4 px-4 sm:px-6 border-b-2 font-medium text-sm transition-colors" aria-current="page">
                        Basic Details
                    </button>
                    <button id="tab-seats" class="tab-button border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 whitespace-nowrap py-4 px-4 sm:px-6 border-b-2 font-medium text-sm transition-colors ml-2 sm:ml-8">
                        Seat Map Editor
                    </button>
                </nav>
            </div>

            <div class="p-4 sm:p-6">
                <!-- Metadata Form View -->
                <div id="details-content" class="tab-content">
                    <form asp-action="Edit" id="editLayoutForm" class="space-y-4 sm:space-y-6 max-w-xl mx-auto">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-red-500 text-sm"></div>
                        <input type="hidden" asp-for="Id"/>
                        <input type="hidden" asp-for="VenueId"/>

                        <div>
                            <label asp-for="AreaName" class="block text-sm font-medium text-gray-700 mb-1">Layout Name</label>
                            <div class="relative">
                                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
                                    </svg>
                                </div>
                                <input asp-for="AreaName" class="pl-10 w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-colors text-sm sm:text-base"/>
                            </div>
                            <span asp-validation-for="AreaName" class="text-red-500 text-xs mt-1"></span>
                        </div>

                        <div>
                            <label asp-for="Desc" class="block text-sm font-medium text-gray-700 mb-1">Description</label>
                            <div class="relative">
                                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"/>
                                    </svg>
                                </div>
                                <input asp-for="Desc" class="pl-10 w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-colors text-sm sm:text-base"/>
                            </div>
                            <span asp-validation-for="Desc" class="text-red-500 text-xs mt-1"></span>
                        </div>

                        <!-- Dimensional Configuration Container -->
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div>
                                <label asp-for="Width" class="block text-sm font-medium text-gray-700 mb-1">Width Constraint</label>
                                <div class="relative">
                                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5-5M4 16v4m0 0h4m-4 0l-5-5m11 5v-4m0 4h-4m4 0l-5-5"/>
                                        </svg>
                                    </div>
                                    <input asp-for="Width" type="number" min="0" class="pl-10 w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-colors text-sm sm:text-base"/>
                                </div>
                                <span asp-validation-for="Width" class="text-red-500 text-xs mt-1"></span>
                            </div>
                            <div>
                                <label asp-for="Height" class="block text-sm font-medium text-gray-700 mb-1">Height Constraint</label>
                                <div class="relative">
                                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5-5m11 5v-4m0 4h-4m4 0l-5-5"/>
                                        </svg>
                                    </div>
                                    <input asp-for="Height" type="number" min="0" class="pl-10 w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-colors text-sm sm:text-base"/>
                                </div>
                                <span asp-validation-for="Height" class="text-red-500 text-xs mt-1"></span>
                            </div>
                        </div>

                        <!-- Positional Configuration Container -->
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div>
                                <label asp-for="Left" class="block text-sm font-medium text-gray-700 mb-1">Origin X (Left)</label>
                                <div class="relative">
                                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                                        </svg>
                                    </div>
                                    <input asp-for="Left" type="number" class="pl-10 w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-colors text-sm sm:text-base"/>
                                </div>
                                <span asp-validation-for="Left" class="text-red-500 text-xs mt-1"></span>
                            </div>
                            <div>
                                <label asp-for="Top" class="block text-sm font-medium text-gray-700 mb-1">Origin Y (Top)</label>
                                <div class="relative">
                                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"/>
                                        </svg>
                                    </div>
                                    <input asp-for="Top" type="number" class="pl-10 w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-colors text-sm sm:text-base"/>
                                </div>
                                <span asp-validation-for="Top" class="text-red-500 text-xs mt-1"></span>
                            </div>
                        </div>

                        <div class="flex flex-col sm:flex-row items-center space-y-3 sm:space-y-0 sm:space-x-3 pt-5 border-t border-gray-200">
                            <button type="submit" class="w-full sm:w-auto px-5 py-2.5 bg-gradient-to-r from-blue-600 to-indigo-600 text-white font-medium rounded-md shadow transition duration-200 hover:from-blue-700 hover:to-indigo-700 focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 cursor-pointer">
                                <svg xmlns="http://www.w3.org/2000/svg" class="inline-block h-5 w-5 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                                </svg>
                                Save Changes
                            </button>
                            <a href="@Url.Action("VenueLayouts", new { venueId = Model.VenueId })" class="w-full sm:w-auto text-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-colors">
                                Cancel
                            </a>
                        </div>
                    </form>
                </div>

                <!-- Interactive Mapping Viewport Tab -->
                <div id="seats-content" class="tab-content hidden">
                    <div id="seat-status" class="hidden mb-4 font-medium text-sm transition-all duration-300"></div>

                    <!-- User Guide Section -->
                    <div class="flex flex-col w-full mb-4">
                        <h4 class="text-sm font-bold text-blue-800 flex items-center border-b border-blue-200 pb-2 mb-2 sm:mb-3">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                            </svg>
                            Editor Tips
                        </h4>
                        <ul class="text-xs sm:text-sm text-blue-700 space-y-1 sm:space-y-2 pl-4 list-disc">
                            <li><b>Click</b> an item to select and edit its properties.</li>
                            <li><b>Drag</b> seats and tables to position them.</li>
                            <li><b>Shift + Click</b> or <b>Click and Drag</b> the map to select multiple items.</li>
                            <li><b>Ctrl + Scroll</b> or use the buttons below to Zoom in and out.</li>
                        </ul>
                    </div>
                    
                    <!-- Primary Control Toolbar -->
                    <div class="bg-gray-50 rounded-t-lg border border-b-0 border-gray-200 p-3 sm:px-6 sm:py-4 mt-2 sm:mt-5">
                        <div class="flex flex-col xl:flex-row gap-3 sm:gap-4 items-start xl:items-center w-full justify-between">
                            
                            <!-- Entity Addition Controls -->
                            <div class="flex flex-wrap gap-2 w-full xl:w-auto justify-start">
                                <button type="button" id="show-seat" class="px-3 sm:px-4 py-2 text-xs sm:text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 rounded-md shadow-sm transition-colors flex-1 sm:flex-none">Seat</button>
                                <button type="button" id="show-table" class="px-3 sm:px-4 py-2 text-xs sm:text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 rounded-md shadow-sm transition-colors flex-1 sm:flex-none">Table</button>
                                <button type="button" id="show-scene" class="px-3 sm:px-4 py-2 text-xs sm:text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 rounded-md shadow-sm transition-colors flex-1 sm:flex-none">Scene</button>
                            </div>

                            <!-- Layout Action Controls -->
                            <div class="flex flex-wrap gap-2 sm:gap-4 w-full xl:w-auto justify-start xl:justify-end">
                                <button type="button" onclick="groupSelectedItems()" class="flex items-center px-3 sm:px-4 py-2 border border-blue-300 rounded-md shadow-sm text-xs sm:text-sm font-medium text-blue-700 bg-white hover:bg-blue-50 focus:outline-none transition-colors flex-1 sm:flex-none justify-center">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 sm:h-5 sm:w-5 mr-1 sm:mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
                                    </svg>
                                    Group
                                </button>
                                <button type="button" onclick="ungroupSelectedItems()" class="flex items-center px-3 sm:px-4 py-2 border border-gray-300 rounded-md shadow-sm text-xs sm:text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none transition-colors flex-1 sm:flex-none justify-center">
                                    Ungroup
                                </button>
                                <button type="button" id="save-seats" class="flex items-center px-3 sm:px-4 py-2 border border-transparent rounded-md shadow-sm text-xs sm:text-sm font-medium text-white bg-green-600 hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500 transition-colors flex-1 sm:flex-none justify-center w-full sm:w-auto mt-2 sm:mt-0">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 sm:h-5 sm:w-5 mr-1 sm:mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4"/>
                                    </svg>
                                    Save Map
                                </button>
                                <button type="button" id="deleteSeatBtn" onclick="removeSelectedItems()" class="flex items-center px-3 sm:px-4 py-2 border border-transparent rounded-md shadow-sm text-xs sm:text-sm font-medium text-white bg-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 transition-colors flex-1 sm:flex-none justify-center w-full sm:w-auto mt-2 sm:mt-0">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 sm:h-5 sm:w-5 mr-1 sm:mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                                    </svg>
                                    Delete
                                </button>
                            </div>
                        </div>

                        <!-- Secondary Object Creation Toolbars -->
                        <div class="AddContainer w-full hidden flex flex-wrap gap-2 justify-start rounded-md mt-4" id="seatContainer">
                            <button type="button" id="add-seat-single" draggable="true" class="px-3 py-1.5 text-xs sm:text-sm font-medium text-blue-700 bg-white border border-blue-300 hover:bg-blue-50 rounded-md shadow-sm">Single</button>
                            <button type="button" id="add-seat-hline" draggable="true" class="px-3 py-1.5 text-xs sm:text-sm font-medium text-blue-700 bg-white border border-blue-300 hover:bg-blue-50 rounded-md shadow-sm">Horizontal Line</button>
                            <button type="button" id="add-seat-vline" draggable="true" class="px-3 py-1.5 text-xs sm:text-sm font-medium text-blue-700 bg-white border border-blue-300 hover:bg-blue-50 rounded-md shadow-sm">Vertical Line</button>
                            <button type="button" id="add-seat-grid" draggable="true" class="px-3 py-1.5 text-xs sm:text-sm font-medium text-blue-700 bg-white border border-blue-300 hover:bg-blue-50 rounded-md shadow-sm">Grid</button>
                        </div>
                        <div class="AddContainer w-full hidden flex flex-wrap gap-2 justify-start rounded-md mt-4" id="tableContainer">
                            <button type="button" id="add-table-square" draggable="true" class="px-3 py-1.5 text-xs sm:text-sm font-medium text-blue-700 bg-white border border-blue-300 hover:bg-blue-50 rounded-md shadow-sm">Square</button>
                            <button type="button" id="add-table-circle" draggable="true" class="px-3 py-1.5 text-xs sm:text-sm font-medium text-blue-700 bg-white border border-blue-300 hover:bg-blue-50 rounded-md shadow-sm">Circle</button>
                            <button type="button" id="add-table-triangle" draggable="true" class="px-3 py-1.5 text-xs sm:text-sm font-medium text-blue-700 bg-white border border-blue-300 hover:bg-blue-50 rounded-md shadow-sm">Triangle</button>
                        </div>
                        <div class="AddContainer w-full hidden flex flex-wrap gap-2 justify-start rounded-md mt-4" id="sceneContainer">
                            <button type="button" id="add-scene-stage" draggable="true" class="px-3 py-1.5 text-xs sm:text-sm font-medium text-blue-700 bg-white border border-blue-300 hover:bg-blue-50 rounded-md shadow-sm">Stage/Scene</button>
                        </div>
                    </div>

                    <!-- Layout Rendering Canvas -->
                    <div class="flex gap-4 mt-0 sm:mt-4 relative">
                        <div class="bg-white rounded-b-lg sm:rounded-lg border border-t-0 sm:border-t border-gray-200 p-0 w-full overflow-hidden relative" style="height: 60vh; min-height: 400px; max-height: 800px;">
                            
                            <!-- Internal Canvas Viewport Controls -->
                            <div class="absolute bottom-4 right-4 z-50 flex items-center gap-1 bg-white p-1 sm:p-1.5 rounded-lg shadow-md border border-gray-200">
                                <button type="button" id="zoom-out" class="p-1 sm:p-1.5 hover:bg-gray-100 rounded text-gray-600 transition-colors" title="Zoom Out">
                                    <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM13 10H7"/></svg>
                                </button>
                                <span id="zoom-level" class="w-10 sm:w-12 text-center text-xs sm:text-sm font-bold text-gray-700 select-none">100%</span>
                                <button type="button" id="zoom-in" class="p-1 sm:p-1.5 hover:bg-gray-100 rounded text-gray-600 transition-colors" title="Zoom In">
                                    <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"/></svg>
                                </button>
                                <div class="w-px h-4 sm:h-5 bg-gray-300 mx-0.5 sm:mx-1"></div>
                                <button type="button" id="zoom-reset" class="p-1 sm:p-1.5 hover:bg-gray-100 rounded text-gray-600 transition-colors" title="Reset Zoom">
                                    <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                                </button>
                            </div>

                            <div id="seat-map" class="relative w-full h-full overflow-auto select-none bg-gray-50 touch-pan-x touch-pan-y">
                                <div id="zoom-container" class="absolute top-0 left-0 origin-top-left transition-transform duration-75 bg-[radial-gradient(#d1d5db_1px,transparent_1px)] [background-size:20px_20px]" style="width: 2500px; height: 2500px;">
                                    <div id="selection-box" class="selection-box"></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Dynamic Properties Configuration Panel -->
                    <div class="bg-white border border-gray-200 p-2 sm:p-4 shadow-md w-full flex flex-col items-center z-10 relative rounded-b-lg">
                        <div class="hidden flex flex-col bg-blue-50 border border-blue-200 rounded-lg p-3 sm:p-5 w-full gap-3 sm:gap-5" id="optionsPanel"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .selection-box {
        position: absolute;
        border: 2px dashed #3b82f6; 
        background-color: rgba(59, 130, 246, 0.2); 
        pointer-events: none;
        z-index: 100;
        display: none;
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        let currentSeats = [];
        let currentShapes = [];
        let currentGroups = [];
        let selectedItems = new Set();
        window.seatsInitialized = false;

        const layoutId = document.querySelector('input[name="Id"]').value;
        const seatMap = document.getElementById('seat-map');
        const zoomContainer = document.getElementById('zoom-container');
        const optionsPanel = document.getElementById("optionsPanel");

        let currentScale = 1;
        const zoomLevelText = document.getElementById('zoom-level');

        /** 
         * Applies hardware-accelerated CSS scaling to the internal mapping container.
         * @@param {number} scale - Absolute float representing magnification ratio.
         */
        function setZoom(scale) {
            currentScale = Math.max(0.1, Math.min(scale, 2.5)); 
            zoomContainer.style.transform = `scale(${currentScale})`;
            zoomLevelText.textContent = `${Math.round(currentScale * 100)}%`;
        }

        /** 
         * Evaluates current coordinate structures determining optimum viewport bounds,
         * mitigating clipping errors and centralizing content distribution.
         */
        function fitLayoutToViewport() {
            const allItems = currentSeats.concat(currentShapes).concat(currentGroups);
            if (allItems.length === 0) {
                setZoom(1);
                return;
            }

            const xs = allItems.map(s => parseFloat(s.x) || 0);
            const ys = allItems.map(s => parseFloat(s.y) || 0);
            const maxXs = allItems.map(s => (parseFloat(s.x) || 0) + (parseFloat(s.width) || 60)); 
            const maxYs = allItems.map(s => (parseFloat(s.y) || 0) + (parseFloat(s.height) || 60));

            const minX = Math.min(...xs);
            const minY = Math.min(...ys);
            const maxX = Math.max(...maxXs);
            const maxY = Math.max(...maxYs);

            const padding = 120; 

            const requiredWidth = Math.max(2500, maxX + padding);
            const requiredHeight = Math.max(2500, maxY + padding);
            zoomContainer.style.width = requiredWidth + 'px';
            zoomContainer.style.height = requiredHeight + 'px';

            const contentWidth = (maxX - minX) + (padding * 2);
            const contentHeight = (maxY - minY) + (padding * 2);

            const viewportWidth = seatMap.clientWidth || seatMap.parentElement.clientWidth || window.innerWidth * 0.7;
            const viewportHeight = seatMap.clientHeight || 600;

            const scaleX = viewportWidth / contentWidth;
            const scaleY = viewportHeight / contentHeight;
            
            const optimalScale = Math.max(0.2, Math.min(scaleX, scaleY, 1.1));
            setZoom(optimalScale);

            const centerX = (minX + maxX) / 2;
            const centerY = (minY + maxY) / 2;

            setTimeout(() => {
                const targetScrollLeft = (centerX * optimalScale) - (viewportWidth / 2);
                const targetScrollTop = (centerY * optimalScale) - (viewportHeight / 2);
                
                seatMap.scrollLeft = Math.max(0, targetScrollLeft);
                seatMap.scrollTop = Math.max(0, targetScrollTop);
            }, 100);
        }

        /** Binds magnification event listeners to UI controllers. */
        document.getElementById('zoom-in').addEventListener('click', () => setZoom(currentScale + 0.1));
        document.getElementById('zoom-out').addEventListener('click', () => setZoom(currentScale - 0.1));
        document.getElementById('zoom-reset').addEventListener('click', () => setZoom(1));
        
        /** Overrides browser scroll mapping translating scroll-wheel events into canvas zoom directives. */
        seatMap.addEventListener('wheel', (e) => {
            if (e.ctrlKey || e.metaKey) {
                e.preventDefault();
                const delta = e.deltaY > 0 ? -0.1 : 0.1;
                setZoom(currentScale + delta);
            }
        }, { passive: false });

