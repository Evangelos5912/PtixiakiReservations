@using System.Linq
@model PtixiakiReservations.Models.Layout

@{
    ViewData["Title"] = "Edit Layout";
    var boundaryWidth = Model.Width > 0 ? Model.Width : 1000;
    var boundaryHeight = Model.Height > 0 ? Model.Height : 1000;
}

<div class="container mx-auto bg-gradient-to-br from-gray-50 to-blue-50/50 min-h-screen py-4 sm:py-8 px-0 sm:px-6 lg:px-8">
    <div class="w-full max-w-screen-2xl mx-auto">
        
        <div class="bg-white rounded-none sm:rounded-2xl shadow-sm border-y sm:border border-gray-200 overflow-hidden mb-4 sm:mb-8">
            <div class="bg-gradient-to-r from-blue-600 to-indigo-700 px-4 sm:px-8 py-5 sm:py-8">
                <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
                    <div>
                        <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">Edit Layout</h1>
                        <p class="mt-1 sm:mt-2 text-blue-100 text-sm sm:text-base leading-snug">
                            Configure floor plan and assign seating mapping for <span class="font-bold text-white">@Model.AreaName</span>
                        </p>
                    </div>
                    <div class="shrink-0">
                        <a href="@Url.Action("VenueLayouts", new { venueId = Model.VenueId })"
                           class="inline-flex items-center px-4 py-2.5 bg-white/10 hover:bg-white/20 text-white border border-white/20 rounded-xl shadow-sm text-sm font-semibold transition-all w-full justify-center sm:w-auto backdrop-blur-sm">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                            </svg>
                            Back to Venue
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="bg-white sm:rounded-2xl shadow-lg border-y sm:border border-gray-200 overflow-hidden">
            
            <!-- HORIZONTALLY SCROLLABLE TABS -->
            <div class="border-b border-gray-200 bg-gray-50/50">
                <nav class="flex overflow-x-auto hide-scrollbar px-2 sm:px-4" aria-label="Tabs">
                    <button id="tab-details" class="tab-button shrink-0 flex items-center border-indigo-500 text-indigo-600 py-4 px-4 sm:px-6 border-b-2 font-bold text-sm transition-colors" aria-current="page">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                        Basic Details
                    </button>
                    <button id="tab-seats" class="tab-button shrink-0 flex items-center border-transparent text-gray-500 hover:text-gray-800 hover:border-gray-300 py-4 px-4 sm:px-6 border-b-2 font-semibold text-sm transition-colors ml-2">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z" /></svg>
                        Seat Map Editor
                    </button>
                </nav>
            </div>

            <div class="p-3 sm:p-8">
                
                <div id="details-content" class="tab-content">
                    <form asp-action="Edit" id="editLayoutForm" class="space-y-6 max-w-2xl mx-auto">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-red-500 text-sm bg-red-50 p-3 rounded-lg border border-red-200"></div>
                        <input type="hidden" asp-for="Id"/>
                        <input type="hidden" asp-for="VenueId"/>

                        <div class="bg-gray-50 p-4 sm:p-6 rounded-xl border border-gray-100 space-y-5 sm:space-y-6">
                            <div>
                                <label asp-for="AreaName" class="block text-sm font-bold text-gray-700 mb-1.5">Layout Name</label>
                                <input asp-for="AreaName" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-shadow shadow-sm text-sm" placeholder="e.g. Main Hall" />
                                <span asp-validation-for="AreaName" class="text-red-500 text-xs mt-1.5 block"></span>
                            </div>

                            <div>
                                <label asp-for="Desc" class="block text-sm font-bold text-gray-700 mb-1.5">Description</label>
                                <textarea asp-for="Desc" rows="3" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-shadow shadow-sm text-sm" placeholder="General info about this area..."></textarea>
                                <span asp-validation-for="Desc" class="text-red-500 text-xs mt-1.5 block"></span>
                            </div>

                            <div class="grid grid-cols-2 gap-3 sm:gap-5">
                                <div>
                                    <label asp-for="Width" class="block text-sm font-bold text-gray-700 mb-1.5">Map Width (px)</label>
                                    <input asp-for="Width" type="number" min="500" max="10000" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 shadow-sm text-sm" />
                                    <span asp-validation-for="Width" class="text-red-500 text-xs mt-1.5 block"></span>
                                </div>
                                <div>
                                    <label asp-for="Height" class="block text-sm font-bold text-gray-700 mb-1.5">Map Height (px)</label>
                                    <input asp-for="Height" type="number" min="500" max="10000" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 shadow-sm text-sm" />
                                    <span asp-validation-for="Height" class="text-red-500 text-xs mt-1.5 block"></span>
                                </div>
                            </div>
                        </div>

                        <div class="pt-2">
                            <button type="submit" class="w-full px-6 py-3.5 sm:py-2.5 bg-indigo-600 text-white font-bold rounded-xl shadow hover:bg-indigo-700 focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-all text-sm flex items-center justify-center">
                                Save Details & Update Map
                            </button>
                        </div>
                    </form>
                </div>

                <div id="seats-content" class="tab-content hidden">
                    <div id="seat-status" class="hidden mb-4 font-bold text-sm transition-all duration-300 shadow-sm"></div>

                    <!-- ========================================================= -->
                    <!-- COLLAPSIBLE MOBILE-FRIENDLY INSTRUCTIONS                  -->
                    <!-- ========================================================= -->
                    <details class="bg-indigo-50 border border-indigo-100 rounded-xl mb-4 sm:mb-6 shadow-sm group">
                        <summary class="flex items-center cursor-pointer p-3 sm:p-5 outline-none select-none">
                            <div class="flex-shrink-0">
                                <svg class="h-6 w-6 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                            </div>
                            <h3 class="ml-3 text-sm font-extrabold text-indigo-900 uppercase tracking-wider">How Configuration Works</h3>
                            <div class="ml-auto text-indigo-500 group-open:rotate-180 transition-transform duration-200">
                                <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" /></svg>
                            </div>
                        </summary>
                        <div class="p-4 sm:p-5 pt-0 border-t border-indigo-100/50">
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-sm mt-3">
                                <div class="bg-white/60 p-3 sm:p-4 rounded-xl border border-indigo-50">
                                    <strong class="text-indigo-900 block mb-1 flex items-center">
                                        <svg class="w-4 h-4 mr-1.5 text-indigo-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 11.5V14m0-2.5v-6a1.5 1.5 0 113 0m-3 6a1.5 1.5 0 00-3 0v2a7.5 7.5 0 0015 0v-5a1.5 1.5 0 00-3 0m-6-3V11m0-5.5v-1a1.5 1.5 0 013 0v1m0 0V11m0-5.5a1.5 1.5 0 013 0v3m0 0V11" /></svg>
                                        Canvas Navigation
                                    </strong>
                                    <ul class="list-disc pl-5 space-y-1 text-indigo-800/80 text-xs sm:text-sm">
                                        <li><strong>Pan (Move):</strong> Hold <kbd class="bg-indigo-100 px-1 rounded text-indigo-800">Ctrl</kbd> + Click & Drag to seamlessly move around the layout.</li>
                                        <li><strong>Zoom:</strong> Hold <kbd class="bg-indigo-100 px-1 rounded text-indigo-800">Ctrl</kbd> + Scroll Wheel to zoom to cursor.</li>
                                        <li><strong>Select:</strong> Click and drag on empty space to box-select. Hold <kbd class="bg-indigo-100 px-1 rounded text-indigo-800">Shift</kbd> to add to selection.</li>
                                    </ul>
                                </div>
                                <div class="bg-white/60 p-3 sm:p-4 rounded-xl border border-indigo-50">
                                    <strong class="text-indigo-900 block mb-1 flex items-center">
                                        <svg class="w-4 h-4 mr-1.5 text-indigo-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 002-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" /></svg>
                                        Generators & Import
                                    </strong>
                                    <ul class="list-disc pl-5 space-y-1 text-indigo-800/80 text-xs sm:text-sm">
                                        <li><strong>Generators:</strong> Drop a shape/table, click it, and use the bottom panel to auto-generate chairs.</li>
                                        <li><strong>JSON Configs:</strong> Use "Copy JSON" and "Paste JSON" to clone entire complex layouts!</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </details>

                    <!-- SWIPEABLE RIBBON TOOLBAR FOR MOBILE -->
                    <div class="bg-white rounded-t-xl border border-gray-200 p-2 sm:p-4 shadow-sm relative z-20">
                        <div class="flex flex-col gap-3 w-full">
                            
                            <!-- Ribbon 1: Actions -->
                            <div class="flex overflow-x-auto hide-scrollbar gap-2 w-full pb-1">
                                <button type="button" onclick="groupSelectedItems()" title="Group Selected" class="shrink-0 flex items-center px-3 py-2 bg-indigo-50 hover:bg-indigo-100 text-indigo-700 border border-indigo-200 rounded-lg shadow-sm text-xs sm:text-sm font-bold transition-all">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" /></svg>
                                    Group
                                </button>
                                <button type="button" onclick="ungroupSelectedItems()" title="Ungroup Selected" class="shrink-0 flex items-center px-3 py-2 bg-white hover:bg-gray-50 text-gray-700 border border-gray-300 rounded-lg shadow-sm text-xs sm:text-sm font-bold transition-all">
                                    Ungroup
                                </button>
                                <button type="button" id="deleteSeatBtn" onclick="removeSelectedItems()" title="Delete Selected" class="shrink-0 flex items-center px-3 py-2 bg-red-50 hover:bg-red-100 text-red-700 border border-red-200 rounded-lg shadow-sm text-xs sm:text-sm font-bold transition-all">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                                    Delete
                                </button>
                                <div class="w-px bg-gray-200 mx-1 shrink-0"></div>
                                <button type="button" onclick="exportLayoutJson()" title="Copy JSON" class="shrink-0 flex items-center px-3 py-2 bg-gray-50 hover:bg-gray-100 text-gray-700 border border-gray-300 rounded-lg shadow-sm text-xs sm:text-sm font-bold transition-all">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" /></svg>
                                    Copy
                                </button>
                                <button type="button" onclick="importLayoutJson()" title="Paste JSON" class="shrink-0 flex items-center px-3 py-2 bg-gray-50 hover:bg-gray-100 text-gray-700 border border-gray-300 rounded-lg shadow-sm text-xs sm:text-sm font-bold transition-all">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" /></svg>
                                    Paste
                                </button>
                                <div class="w-px bg-gray-200 mx-1 shrink-0"></div>
                                <button type="button" id="save-seats" class="shrink-0 flex items-center px-4 py-2 bg-green-600 hover:bg-green-700 text-white rounded-lg shadow text-xs sm:text-sm font-bold transition-all">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4"/></svg>
                                    Save Map
                                </button>
                            </div>

                            <!-- Ribbon 2: Categories -->
                            <div class="flex overflow-x-auto hide-scrollbar gap-2 w-full pb-1 border-t border-gray-100 pt-2">
                                <span class="shrink-0 self-center text-[10px] sm:text-xs font-bold text-gray-400 uppercase tracking-wider mr-1">Add Elements:</span>
                                <button type="button" id="show-seat" class="shrink-0 px-4 py-1.5 text-xs sm:text-sm font-bold text-blue-700 bg-blue-50 border border-blue-200 hover:bg-blue-600 hover:text-white rounded-lg shadow-sm transition-all">Seats</button>
                                <button type="button" id="show-table" class="shrink-0 px-4 py-1.5 text-xs sm:text-sm font-bold text-blue-700 bg-blue-50 border border-blue-200 hover:bg-blue-600 hover:text-white rounded-lg shadow-sm transition-all">Tables</button>
                                <button type="button" id="show-scene" class="shrink-0 px-4 py-1.5 text-xs sm:text-sm font-bold text-blue-700 bg-blue-50 border border-blue-200 hover:bg-blue-600 hover:text-white rounded-lg shadow-sm transition-all">Stages</button>
                            </div>

                            <!-- Ribbon 3: Contextual Tools -->
                            <div class="bg-gray-50 rounded-lg p-2 border border-gray-200 shadow-inner min-h-[50px] flex items-center">
                                <div id="toolbar-instruction" class="text-xs sm:text-sm text-gray-500 italic w-full text-center">
                                    Select a category above to view generators.
                                </div>
                                
                                <div class="AddContainer w-full hidden flex overflow-x-auto hide-scrollbar gap-2" id="seatContainer">
                                    <div class="flex items-center bg-white border border-gray-300 rounded-md shadow-sm overflow-hidden h-8 shrink-0">
                                        <button type="button" id="toggle-click-add" title="Enable crosshair mode" class="px-2 h-full text-xs sm:text-sm font-bold text-gray-700 hover:bg-gray-50 transition-colors flex items-center gap-1 border-r border-gray-300 outline-none">
                                            <svg class="w-3.5 h-3.5 text-indigo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5M7.188 2.239l.777 2.897M5.136 7.965l-2.898-.777M13.95 4.05l-2.122 2.122m-5.657 5.656l-2.12 2.122"></path></svg>
                                            Click-to-Add: <span id="click-add-status" class="text-red-500 ml-1">OFF</span>
                                        </button>
                                        <input type="text" id="click-add-prefix" value="S" placeholder="Prefix" class="w-10 sm:w-16 h-full text-xs px-2 outline-none focus:bg-indigo-50 font-bold text-gray-700">
                                        <div class="w-px h-5 bg-gray-300"></div>
                                        <input type="number" id="click-add-start" value="1" min="1" class="w-12 sm:w-16 h-full text-xs px-2 outline-none focus:bg-indigo-50 font-bold text-gray-700">
                                    </div>
                                    <div class="w-px h-6 bg-gray-300 mx-1 shrink-0 self-center"></div>

                                    <button type="button" id="add-seat-single" draggable="true" class="shrink-0 px-3 py-1.5 text-xs sm:text-sm font-bold text-gray-700 bg-white border border-gray-300 hover:border-blue-400 rounded-md shadow-sm">Single</button>
                                    <button type="button" id="add-seat-hline" class="shrink-0 px-3 py-1.5 text-xs sm:text-sm font-bold text-gray-700 bg-white border border-gray-300 hover:border-blue-400 rounded-md shadow-sm">Horiz. Row</button>
                                    <button type="button" id="add-seat-vline" class="shrink-0 px-3 py-1.5 text-xs sm:text-sm font-bold text-gray-700 bg-white border border-gray-300 hover:border-blue-400 rounded-md shadow-sm">Vert. Row</button>
                                    <button type="button" id="add-seat-grid" class="shrink-0 px-3 py-1.5 text-xs sm:text-sm font-bold text-gray-700 bg-white border border-gray-300 hover:border-blue-400 rounded-md shadow-sm">Grid</button>
                                </div>
                                
                                <div class="AddContainer w-full hidden flex overflow-x-auto hide-scrollbar gap-2" id="tableContainer">
                                    <button type="button" id="add-table-square" draggable="true" class="shrink-0 px-3 py-1.5 text-xs sm:text-sm font-bold text-gray-700 bg-white border border-gray-300 hover:border-blue-400 rounded-md shadow-sm">Square Table</button>
                                    <button type="button" id="add-table-circle" draggable="true" class="shrink-0 px-3 py-1.5 text-xs sm:text-sm font-bold text-gray-700 bg-white border border-gray-300 hover:border-blue-400 rounded-md shadow-sm">Circular Table</button>
                                    <button type="button" id="add-table-triangle" draggable="true" class="shrink-0 px-3 py-1.5 text-xs sm:text-sm font-bold text-gray-700 bg-white border border-gray-300 hover:border-blue-400 rounded-md shadow-sm">Triangular Table</button>
                                </div>
                                
                                <div class="AddContainer w-full hidden flex overflow-x-auto hide-scrollbar gap-2" id="sceneContainer">
                                    <button type="button" id="add-scene-stage" draggable="true" class="shrink-0 px-3 py-1.5 text-xs sm:text-sm font-bold text-gray-700 bg-white border border-gray-300 hover:border-blue-400 rounded-md shadow-sm">Performance Stage</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="relative mt-[-1px] z-10">
                        <!-- STATIC TOP-RIGHT ZOOM CONTROLS -->
                        <div class="absolute top-4 right-4 sm:right-6 z-[110] flex items-center pointer-events-none">
                            <div class="flex items-center gap-1 bg-white/90 backdrop-blur p-1 sm:p-1.5 rounded-lg shadow-md border border-gray-200 pointer-events-auto">
                                <button type="button" id="zoom-out" class="p-1 sm:p-1.5 hover:bg-gray-100 rounded text-gray-700 transition-colors" title="Zoom Out (Ctrl + Scroll Down)">
                                    <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM13 10H7"/></svg>
                                </button>
                                <span id="zoom-level" class="w-10 sm:w-12 text-center text-xs sm:text-sm font-extrabold text-gray-800 select-none">100%</span>
                                <button type="button" id="zoom-in" class="p-1 sm:p-1.5 hover:bg-gray-100 rounded text-gray-700 transition-colors" title="Zoom In (Ctrl + Scroll Up)">
                                    <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"/></svg>
                                </button>
                                <div class="w-px h-4 sm:h-5 bg-gray-300 mx-1"></div>
                                <button type="button" id="zoom-reset" class="p-1 sm:p-1.5 hover:bg-gray-100 rounded text-gray-700 transition-colors" title="Reset Zoom">
                                    <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                                </button>
                            </div>
                        </div>

                        <!-- Canvas container height adjusted for mobile screens -->
                        <div id="seat-map" class="bg-gray-200 rounded-b-xl border border-gray-200 p-0 w-full overflow-auto relative shadow-inner select-none z-[90]" style="height: 55vh; min-height: 400px; max-height: 900px;">
                            
                            <!-- THE PLAYABLE CANVAS BOUNDARY -->
                            <div id="zoom-container" class="absolute origin-top-left bg-white shadow-2xl border-2 border-indigo-400 overflow-visible" style="width: @(boundaryWidth)px; height: @(boundaryHeight)px; top: 40px; left: 40px; z-index: 10;">
                                <div class="absolute inset-0 bg-[radial-gradient(#cbd5e1_1px,transparent_1px)] [background-size:20px_20px] pointer-events-none opacity-60"></div>
                                <div class="boundary-label absolute -top-6 left-[-2px] bg-indigo-500 text-white font-extrabold text-[9px] sm:text-[10px] uppercase tracking-wider px-2 py-1 rounded-t-md shadow-sm whitespace-nowrap">
                                    Boundary (@(boundaryWidth)x@(boundaryHeight))
                                </div>
                                <div id="selection-box" class="selection-box"></div>
                            </div>

                        </div>
                    </div>

                    <!-- DYNAMIC PROPERTIES PANEL -->
                    <div class="mt-4 w-full relative z-30">
                        <div class="hidden flex flex-col bg-white shadow-xl border-t-4 border-indigo-500 rounded-xl p-3 sm:p-5 w-full gap-3 sm:gap-4 transition-all duration-300 animate-fade-in-up" id="optionsPanel"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .hide-scrollbar::-webkit-scrollbar { display: none; }
    .hide-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

    /* Remove transition from zoom-container to prevent dragging lag/rubberbanding */
    #zoom-container { transition: none; } 

    .selection-box {
        position: absolute;
        border: 2px dashed #4f46e5; 
        background-color: rgba(79, 70, 229, 0.15); 
        pointer-events: none;
        z-index: 100;
        display: none;
    }
    
    @@keyframes fadeInUp {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .animate-fade-in-up {
        animation: fadeInUp 0.3s ease-out forwards;
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        let currentSeats = [];
        let currentShapes = [];
        let currentGroups = [];
        let selectedItems = new Set();
        window.seatsInitialized = false;

        const layoutId = document.querySelector('input[name="Id"]').value;
        const seatMap = document.getElementById('seat-map');
        const zoomContainer = document.getElementById('zoom-container');
        const optionsPanel = document.getElementById("optionsPanel");
        const instructionBar = document.getElementById("toolbar-instruction");

        let baseW = @(boundaryWidth);
        let baseH = @(boundaryHeight);

        let currentScale = 1;
        const zoomLevelText = document.getElementById('zoom-level');

        let isClickToAddMode = false;
        const toggleClickAddBtn = document.getElementById('toggle-click-add');
        const clickAddStatus = document.getElementById('click-add-status');
        const prefixInput = document.getElementById('click-add-prefix');
        const startInput = document.getElementById('click-add-start');

        // ==========================================
        // AJAX SAVE DETAILS LOGIC
        // ==========================================
        const editForm = document.getElementById('editLayoutForm');
        if (editForm) {
            editForm.addEventListener('submit', async function(e) {
                e.preventDefault();
                const btn = this.querySelector('button[type="submit"]');
                const originalText = btn.innerHTML;
                btn.innerHTML = 'Saving...'; btn.disabled = true;

                try {
                    const response = await fetch(this.action, { method: this.method, body: new FormData(this) });
                    if (response.ok) {
                        const newW = parseInt(document.getElementById('Width').value) || 500;
                        const newH = parseInt(document.getElementById('Height').value) || 500;
                        
                        baseW = Math.max(500, Math.min(newW, 10000));
                        baseH = Math.max(500, Math.min(newH, 10000));

                        zoomContainer.style.width = baseW + 'px';
                        zoomContainer.style.height = baseH + 'px';
                        
                        const boundaryLabel = zoomContainer.querySelector('.boundary-label');
                        if (boundaryLabel) boundaryLabel.textContent = `Boundary (${baseW}x${baseH})`;

                        const statusDiv = document.createElement('div');
                        statusDiv.className = 'text-green-700 text-sm bg-green-50 p-4 rounded-xl border border-green-200 font-bold mb-5 animate-fade-in-up';
                        statusDiv.textContent = 'Layout dimensions & details updated! Map boundary has expanded.';
                        
                        const existingSummary = this.querySelector('[asp-validation-summary="ModelOnly"]');
                        if (existingSummary) existingSummary.style.display = 'none';

                        this.insertBefore(statusDiv, this.firstChild);
                        setTimeout(() => statusDiv.remove(), 4000);

                        if (window.seatsInitialized) fitLayoutToViewport();
                    } else alert('Failed to save layout details. Please verify your inputs.');
                } catch(err) {
                    console.error(err); alert('Network connection issue. Please try again.');
                } finally { btn.innerHTML = originalText; btn.disabled = false; }
            });
        }

        window.exportLayoutJson = function() {
            const exportData = { width: baseW, height: baseH, seats: currentSeats, shapes: currentShapes, groups: currentGroups };
            navigator.clipboard.writeText(JSON.stringify(exportData, null, 2)).then(() => {
                updateStatus("Layout successfully copied to your clipboard!", "success");
            }).catch(err => {
                updateStatus("Failed to copy to clipboard. Ensure your browser permits clipboard access.", "error");
            });
        };

        window.importLayoutJson = function() {
            const jsonStr = prompt("Paste your JSON layout data here. WARNING: This will overwrite your current unsaved canvas!");
            if (!jsonStr) return;

            try {
                const data = JSON.parse(jsonStr);
                const reqW = data.width || 0; const reqH = data.height || 0;
                
                if (reqW > baseW || reqH > baseH) {
                    updateStatus(`Import rejected: Pasted dimensions (${reqW}x${reqH}) exceed current bounds (${baseW}x${baseH}). Expand details first!`, "error");
                    return;
                }

                const idMap = new Map();
                const getNewId = (oldId) => {
                    if (!oldId) return undefined;
                    if (!idMap.has(oldId)) idMap.set(oldId, `temp-${Date.now()}-${Math.random().toString(36).substr(2, 5)}`);
                    return idMap.get(oldId);
                };

                currentSeats = []; currentShapes = []; currentGroups = []; selectedItems.clear();

                if (data.groups) data.groups.forEach(g => {
                    const newGroupId = `group-${getNewId(g.id)}`;
                    idMap.set(g.id, newGroupId); 
                    currentGroups.push({ id: newGroupId, name: g.name, x: g.x, y: g.y });
                });
                
                if (data.seats) data.seats.forEach(s => currentSeats.push({ ...s, id: getNewId(s.id), groupId: s.groupId ? idMap.get(s.groupId) : undefined }));
                if (data.shapes) data.shapes.forEach(s => currentShapes.push({ ...s, id: getNewId(s.id), groupId: s.groupId ? idMap.get(s.groupId) : undefined }));

                renderAll(); hideAllOptions(); fitLayoutToViewport();
                updateStatus("Layout imported successfully! Click 'Save Map' to apply to the database.", "success");

            } catch (err) { updateStatus("Import failed: Invalid JSON formatting.", "error"); }
        };

        function getUniqueItemName(prefix, startNum) {
            let num = startNum; let nameStr = `${prefix}${num}`;
            while (currentSeats.some(s => s.name === nameStr) || currentShapes.some(s => s.name === nameStr)) {
                num++; nameStr = `${prefix}${num}`;
            }
            return { name: nameStr, nextNum: num + 1 };
        }

        toggleClickAddBtn.addEventListener('click', () => {
            isClickToAddMode = !isClickToAddMode;
            if(isClickToAddMode) {
                clickAddStatus.textContent = "ON"; clickAddStatus.classList.replace('text-red-500', 'text-green-600');
                toggleClickAddBtn.classList.add('ring-2', 'ring-green-400', 'border-green-400'); seatMap.style.cursor = 'crosshair'; 
            } else turnOffClickToAdd();
        });

        function turnOffClickToAdd() {
            isClickToAddMode = false;
            if(clickAddStatus) {
                clickAddStatus.textContent = "OFF"; clickAddStatus.classList.replace('text-green-600', 'text-red-500');
                toggleClickAddBtn.classList.remove('ring-2', 'ring-green-400', 'border-green-400'); seatMap.style.cursor = 'default';
            }
        }

        zoomContainer.addEventListener('mousedown', function(e) {
            if (!isClickToAddMode) return;
            if (e.target === zoomContainer || e.target.id === 'layout-boundary') {
                e.preventDefault(); e.stopPropagation();
                const prefix = prefixInput.value.trim();
                let currentNum = parseInt(startInput.value) || 1;
                const u = getUniqueItemName(prefix, currentNum);

                const rect = zoomContainer.getBoundingClientRect();
                let dropX = Math.round(((e.clientX - rect.left) / currentScale) / 10) * 10;
                let dropY = Math.round(((e.clientY - rect.top) / currentScale) / 10) * 10;

                dropX = Math.max(0, Math.min(dropX, baseW - 60));
                dropY = Math.max(0, Math.min(dropY, baseH - 60));

                currentSeats.push({ id: `temp-${Date.now()}`, name: u.name, x: dropX, y: dropY, available: true });
                startInput.value = u.nextNum; renderAll();
            }
        });

        function findFreeSpace(reqWidth, reqHeight) {
            const gap = 40; const stepX = 50; const stepY = 50;
            const allItems = currentSeats.map(s => ({x: s.x, y: s.y, w: 60, h: 60})).concat(currentShapes.map(s => ({x: s.x, y: s.y, w: s.width || 60, h: s.height || 60})));

            if (allItems.length === 0) return { x: 50, y: 50 };

            let maxX = 50, maxY = 50;
            allItems.forEach(i => {
                if (i.x + i.w > maxX) maxX = i.x + i.w;
                if (i.y + i.h > maxY) maxY = i.y + i.h;
            });

            for (let y = 50; y <= Math.min(maxY + reqHeight + gap, baseH - reqHeight); y += stepY) {
                for (let x = 50; x <= Math.min(maxX + reqWidth + gap, baseW - reqWidth); x += stepX) {
                    let isFree = true;
                    for (let i = 0; i < allItems.length; i++) {
                        const item = allItems[i];
                        if (x < item.x + item.w + gap && x + reqWidth + gap > item.x && y < item.y + item.h + gap && y + reqHeight + gap > item.y) {
                            isFree = false; break;
                        }
                    }
                    if (isFree) return { x, y };
                }
            }
            return { x: 50, y: Math.min(maxY + gap, baseH - reqHeight) };
        }

        document.getElementById('add-seat-hline').addEventListener('click', () => {
            const countStr = prompt("How many seats in this horizontal row?", "5");
            if (!countStr) return; const count = parseInt(countStr); if (!count || count <= 0) return;
            const prefix = prompt("Seat Prefix:", "R1-"); if (prefix === null) return;
            const freePos = findFreeSpace(count * 70, 60);
            const newSeats = []; let currentNum = 1;
            for (let i = 0; i < count; i++) {
                const u = getUniqueItemName(prefix, currentNum);
                newSeats.push({ id: `temp-${Date.now()}-${i}`, name: u.name, x: Math.max(0, Math.min(freePos.x + (i * 70), baseW - 60)), y: freePos.y, available: true });
                currentNum = u.nextNum;
            }
            createAndInjectGroup(newSeats, 'Horizontal Row');
        });

        document.getElementById('add-seat-vline').addEventListener('click', () => {
            const countStr = prompt("How many seats in this vertical row?", "5");
            if (!countStr) return; const count = parseInt(countStr); if (!count || count <= 0) return;
            const prefix = prompt("Seat Prefix:", "C1-"); if (prefix === null) return;
            const freePos = findFreeSpace(60, count * 70);
            const newSeats = []; let currentNum = 1;
            for (let i = 0; i < count; i++) {
                const u = getUniqueItemName(prefix, currentNum);
                newSeats.push({ id: `temp-${Date.now()}-${i}`, name: u.name, x: freePos.x, y: Math.max(0, Math.min(freePos.y + (i * 70), baseH - 60)), available: true });
                currentNum = u.nextNum;
            }
            createAndInjectGroup(newSeats, 'Vertical Row');
        });

        document.getElementById('add-seat-grid').addEventListener('click', () => {
            const input = prompt("Enter grid dimensions (Rows x Columns), e.g. 4x5", "4x5");
            if (!input) return;
            const parts = input.toLowerCase().split('x');
            if (parts.length !== 2) return alert("Invalid format.");
            const rows = parseInt(parts[0].trim()); const cols = parseInt(parts[1].trim());
            if (!rows || !cols || rows <= 0 || cols <= 0) return alert("Invalid dimensions.");
            const prefix = prompt("Seat Prefix:", "G-"); if (prefix === null) return;

            const freePos = findFreeSpace(cols * 70, rows * 70);
            const newSeats = []; let currentNum = 1;
            for (let r = 0; r < rows; r++) {
                for (let c = 0; c < cols; c++) {
                    const u = getUniqueItemName(prefix, currentNum);
                    newSeats.push({ id: `temp-${Date.now()}-${r}-${c}`, name: u.name, x: Math.max(0, Math.min(freePos.x + (c * 70), baseW - 60)), y: Math.max(0, Math.min(freePos.y + (r * 70), baseH - 60)), available: true });
                    currentNum = u.nextNum;
                }
            }
            createAndInjectGroup(newSeats, 'Grid');
        });

        function createAndInjectGroup(newSeatsArray, groupTitlePrefix) {
            currentSeats.push(...newSeatsArray);
            const targetGroupId = `group-temp-${Date.now()}`;
            currentGroups.push({ id: targetGroupId, name: `${groupTitlePrefix} ${currentGroups.length + 1}`, x: Math.min(...newSeatsArray.map(s => s.x)), y: Math.min(...newSeatsArray.map(s => s.y)) });

            newSeatsArray.forEach(s => s.groupId = targetGroupId);
            updateStatus(`Generated ${newSeatsArray.length} items.`, "success");
            
            selectedItems.clear(); currentSeats.filter(s => s.groupId === targetGroupId).forEach(s => selectedItems.add(s.name));
            renderAll(); showOptions({ id: targetGroupId }, 'group');
        }

        // ==========================================
        // MATH-PERFECT ZOOM TO CURSOR LOGIC
        // ==========================================
        function setZoom(scale, cursorX = null, cursorY = null, skipScrollAdjustment = false) {
            const oldScale = currentScale;
            currentScale = Math.max(0.1, Math.min(scale, 2.5)); 
            zoomContainer.style.transform = `scale(${currentScale})`;
            zoomLevelText.textContent = `${Math.round(currentScale * 100)}%`;

            if (oldScale !== currentScale && !skipScrollAdjustment) {
                const rect = seatMap.getBoundingClientRect();
                
                // If cursor is not provided, default to zooming towards the center of the viewport
                const targetMouseX = cursorX !== null ? cursorX : rect.width / 2;
                const targetMouseY = cursorY !== null ? cursorY : rect.height / 2;

                // Where is this mouse point located inside the actual unscaled canvas grid?
                const unscaledX = (targetMouseX + seatMap.scrollLeft) / oldScale;
                const unscaledY = (targetMouseY + seatMap.scrollTop) / oldScale;

                // Adjust the scroll wrapper so the unscaled coordinate remains exactly under the mouse pointer
                seatMap.scrollLeft = (unscaledX * currentScale) - targetMouseX;
                seatMap.scrollTop = (unscaledY * currentScale) - targetMouseY;
            }
        }

        function fitLayoutToViewport() {
            const padding = 60; 
            const viewportWidth = seatMap.clientWidth || window.innerWidth * 0.9;
            const viewportHeight = seatMap.clientHeight || 500;

            const scaleX = viewportWidth / (baseW + padding);
            const scaleY = viewportHeight / (baseH + padding);
            
            // Set zoom but skip auto scroll adjustment so we can hard center it next
            setZoom(Math.max(0.1, Math.min(scaleX, scaleY, 1.0)), null, null, true);

            setTimeout(() => {
                seatMap.scrollLeft = Math.max(0, ((baseW * currentScale) - viewportWidth) / 2 + 40);
                seatMap.scrollTop = Math.max(0, ((baseH * currentScale) - viewportHeight) / 2 + 40);
            }, 100);
        }

        document.getElementById('zoom-in').addEventListener('click', () => setZoom(currentScale + 0.1));
        document.getElementById('zoom-out').addEventListener('click', () => setZoom(currentScale - 0.1));
        document.getElementById('zoom-reset').addEventListener('click', () => { setZoom(1, null, null, true); fitLayoutToViewport(); });
        
        seatMap.addEventListener('wheel', (e) => {
            if (e.ctrlKey || e.metaKey) { 
                e.preventDefault(); 
                const rect = seatMap.getBoundingClientRect();
                const mouseX = e.clientX - rect.left;
                const mouseY = e.clientY - rect.top;
                
                // Fine-tune wheel delta step
                const zoomFactor = e.deltaY > 0 ? -0.1 : 0.1; 
                setZoom(currentScale + zoomFactor, mouseX, mouseY); 
            }
        }, { passive: false });

        window.hideAllOptions = function() { optionsPanel.classList.add("hidden"); optionsPanel.innerHTML = ""; };

        window.updateStatus = function(message, type = "info") {
            const statusBar = document.getElementById('seat-status');
            if (!statusBar) return;
            statusBar.textContent = message; statusBar.classList.remove("hidden");
            
            statusBar.className = 'mt-2 p-3 rounded-lg w-full text-center border font-bold text-sm shadow-sm ' + 
                (type === 'success' ? 'bg-green-100 text-green-800 border-green-300' : 
                 type === 'error' ? 'bg-red-100 text-red-800 border-red-300' : 
                 type === 'warning' ? 'bg-yellow-100 text-yellow-800 border-yellow-300' : 
                 'bg-blue-100 text-blue-800 border-blue-300');
                 
            if(type === 'success') setTimeout(() => statusBar.classList.add("hidden"), 3000);
        };

        function updateSelectionVisuals() {
            zoomContainer.querySelectorAll('div[data-id]:not([data-type="shape"]):not([data-type="group"])').forEach(el => {
                if (selectedItems.has(el.dataset.name)) {
                    el.classList.replace('bg-blue-500', 'bg-red-500'); el.classList.replace('hover:bg-blue-600', 'hover:bg-red-600'); el.classList.add('ring-2', 'ring-red-200');
                } else {
                    el.classList.replace('bg-red-500', 'bg-blue-500'); el.classList.replace('hover:bg-red-600', 'hover:bg-blue-600'); el.classList.remove('ring-2', 'ring-red-200');
                }
            });

            zoomContainer.querySelectorAll('div[data-type="shape"]').forEach(el => {
                const visualBg = el.querySelector('.visual-bg');
                if (visualBg) {
                    if (selectedItems.has(el.dataset.name)) visualBg.classList.add('ring-4', 'ring-indigo-500');
                    else visualBg.classList.remove('ring-4', 'ring-indigo-500');
                }
            });
            
            zoomContainer.querySelectorAll('div[data-type="group"]').forEach(el => {
                const groupId = el.dataset.id;
                const groupChildren = currentSeats.concat(currentShapes).filter(s => s.groupId === groupId);
                const isSelected = Array.from(selectedItems).some(name => groupChildren.find(c => c.name === name));
                
                if (isSelected) {
                    el.classList.replace('border-gray-400', 'border-indigo-500'); el.classList.replace('bg-gray-400/10', 'bg-indigo-500/10');
                } else {
                    el.classList.replace('border-indigo-500', 'border-gray-400'); el.classList.replace('bg-indigo-500/10', 'bg-gray-400/10');
                }
            });
        }

        function toggleCategory(categoryId) {
            instructionBar.classList.add("hidden");
            document.querySelectorAll('.AddContainer').forEach(con => con.classList.add("hidden"));
            document.getElementById(categoryId).classList.remove('hidden');
            if (categoryId !== 'seatContainer') turnOffClickToAdd();
        }

        document.getElementById('show-seat').addEventListener('click', () => toggleCategory('seatContainer'));
        document.getElementById('show-table').addEventListener('click', () => toggleCategory('tableContainer'));
        document.getElementById('show-scene').addEventListener('click', () => toggleCategory('sceneContainer'));

        function generateSeatsAroundTable(shapeData, seatCount, prefix) {
            if (seatCount <= 0 || seatCount > 50) return updateStatus("Please enter a valid number (1-50).", "warning");

            const margin = 30; const seatW = 60; const seatH = 60;
            const cx = shapeData.x + (shapeData.width / 2); const cy = shapeData.y + (shapeData.height / 2);
            let rx = (shapeData.width / 2) + margin + (seatW / 2); let ry = (shapeData.height / 2) + margin + (seatH / 2);

            const requiredMinRadius = (seatCount * 75) / (2 * Math.PI);
            if (rx < requiredMinRadius) rx = requiredMinRadius; if (ry < requiredMinRadius) ry = requiredMinRadius;

            const newSeats = []; let currentNum = 1;
            for (let i = 0; i < seatCount; i++) {
                const angle = (i * 2 * Math.PI) / seatCount; const u = getUniqueItemName(prefix, currentNum);
                newSeats.push({
                    id: `temp-${Date.now()}-${i}`, name: u.name,
                    x: Math.max(0, Math.min(Math.round((cx + (rx * Math.cos(angle)) - (seatW / 2)) / 10) * 10, baseW - 60)),
                    y: Math.max(0, Math.min(Math.round((cy + (ry * Math.sin(angle)) - (seatH / 2)) / 10) * 10, baseH - 60)),
                    available: true
                });
                currentNum = u.nextNum;
            }
            injectGeneratedSetAndGroup(shapeData, newSeats, 'Table Group');
        }

        function generateStageSeats(shapeData, totalSeats, rowCount, template, prefix) {
            if (totalSeats <= 0 || totalSeats > 300) return updateStatus("Valid seats: 1-300.", "warning");
            if (rowCount <= 0 || rowCount > 20) return updateStatus("Valid rows: 1-20.", "warning");

            const seatW = 60; const seatH = 60; const margin = 40; const rowSpacing = 80; 
            const cx = shapeData.x + (shapeData.width / 2); const cy = shapeData.y + (shapeData.height / 2);
            let baseRx = (shapeData.width / 2) + margin + (seatW / 2); let baseRy = (shapeData.height / 2) + margin + (seatH / 2);

            let seatsPerRow = new Array(rowCount).fill(Math.floor(totalSeats / rowCount));
            for(let i = rowCount - 1; i >= rowCount - (totalSeats % rowCount); i--) if(i >= 0) seatsPerRow[i]++;
            
            const reqRadius = (Math.max(...seatsPerRow) * 75) / (template === 'stadium' ? (2 * Math.PI) : (0.8 * Math.PI));
            if (baseRx < reqRadius) baseRx = reqRadius; if (baseRy < reqRadius) baseRy = reqRadius;

            const newSeats = []; let counter = 0; let currentNum = 1;
            for (let r = 0; r < rowCount; r++) {
                if (seatsPerRow[r] <= 0) continue;
                for (let i = 0; i < seatsPerRow[r]; i++) {
                    let angle = (template === 'stadium') ? (i * 2 * Math.PI) / seatsPerRow[r] : (seatsPerRow[r] === 1 ? Math.PI / 2 : 0.1 * Math.PI + (i * (0.8 * Math.PI) / (seatsPerRow[r] - 1)));
                    const u = getUniqueItemName(prefix, currentNum);    
                    newSeats.push({
                        id: `temp-${Date.now()}-${counter}`, name: u.name,
                        x: Math.max(0, Math.min(Math.round((cx + ((baseRx + (r * rowSpacing)) * Math.cos(angle)) - (seatW / 2)) / 10) * 10, baseW - 60)),
                        y: Math.max(0, Math.min(Math.round((cy + ((baseRy + (r * rowSpacing)) * Math.sin(angle)) - (seatH / 2)) / 10) * 10, baseH - 60)),
                        available: true
                    });
                    currentNum = u.nextNum; counter++;
                }
            }
            injectGeneratedSetAndGroup(shapeData, newSeats, 'Stage Group');
        }

        function injectGeneratedSetAndGroup(parentShape, newSeatsArray, groupTitlePrefix) {
            currentSeats.push(...newSeatsArray);
            let targetGroupId = parentShape.groupId;
            
            if (!targetGroupId) {
                targetGroupId = `group-temp-${Date.now()}`;
                const allGroupItems = [parentShape, ...newSeatsArray];
                currentGroups.push({ id: targetGroupId, name: `${groupTitlePrefix} ${currentGroups.length + 1}`, x: Math.min(...allGroupItems.map(s => s.x)), y: Math.min(...allGroupItems.map(s => s.y)) });
                parentShape.groupId = targetGroupId;
            }

            newSeatsArray.forEach(s => s.groupId = targetGroupId);
            updateStatus(`Generated ${newSeatsArray.length} items.`, "success");
            
            selectedItems.clear(); currentSeats.concat(currentShapes).filter(s => s.groupId === targetGroupId).forEach(s => selectedItems.add(s.name));
            renderAll(); showOptions(parentShape, 'shape');
        }

        window.removeSelectedItems = async function() {
            if (selectedItems.size === 0) return updateStatus("No items selected.", "warning");

            if (confirm(`Remove ${selectedItems.size} selected item(s)?`)) {
                const dbItemsToDelete = Array.from(selectedItems).filter(name => !name.startsWith('temp-'));
                currentSeats = currentSeats.filter(s => !selectedItems.has(s.name));
                currentShapes = currentShapes.filter(s => !selectedItems.has(s.name));

                if (dbItemsToDelete.length > 0) {
                    try {
                        await fetch('/Seat/DeleteMultipleSeats', { method: 'POST', headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value }, body: JSON.stringify({ seatNames: dbItemsToDelete, layoutId: layoutId }) });
                        await fetch('/NonSelectable/DeleteElements', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ names: dbItemsToDelete, layoutId: layoutId }) });
                        updateStatus("Items permanently deleted.", "success");
                    } catch (err) { updateStatus("Items removed from view, but DB sync failed.", "warning"); }
                } else { updateStatus("Unsaved items discarded.", "success"); }
                selectedItems.clear(); renderAll(); hideAllOptions();
            }
        };

        window.showOptions = function(data, type) {
            optionsPanel.classList.remove("hidden");
            const isTemp = String(data.id).startsWith('temp-') || String(data.id).startsWith('group-temp-');
            const displayId = isTemp ? 'Unsaved' : data.id;

            if (type === 'group') {
                optionsPanel.innerHTML = `
                    <div class="flex flex-col md:flex-row items-end flex-wrap gap-4 w-full">
                        <div class="flex flex-col w-full md:w-auto">
                            <h3 class="font-bold text-gray-800 text-lg border-b border-gray-200 pb-1">Group Renamer</h3>
                            <p class="text-[10px] sm:text-xs text-gray-400 mt-1 font-mono">ID: ${displayId}</p>
                        </div>
                        <div class="grid grid-cols-2 gap-3 w-full sm:w-auto">
                            <div class="flex flex-col">
